<% var tierColor=tier==='beginner' ? '#16A34A' : tier==='intermediate' ? '#2563EB' : '#EA580C' ; %>
  <% var canClear=!!locals.isAdmin; %>
    <% var jNames=locals.judgeNames || {}; %>
      <% var meId=locals.myId; %>
        <% var groups=[]; if (locals.isJudge) { var mine=teams.filter(function (t) { return t.judge_id &&
          String(t.judge_id)===String(meId); }); var others=teams.filter(function (t) { return !(t.judge_id &&
          String(t.judge_id)===String(meId)); }); if (mine.length) { groups.push({ key: 'mine' , title: 'ทีมที่คุณดูแล'
          , teams: mine, open: true }); groups.push({ key: 'others' , title: 'ทีมอื่นในรุ่น' , teams: others, open:
          false, note: 'ใช้เมื่อได้รับมอบหมายให้ลงคะแนนแทนกรรมการท่านอื่น' }); } else { groups.push({ key: 'all' ,
          title: '' , teams: teams, open: true, note: 'ยังไม่ได้รับมอบหมายทีม — แสดงทุกทีมในรุ่น' }); } } else {
          groups.push({ key: 'all' , title: '' , teams: teams, open: true }); } %>
          <% function fmtTime(v) { if (v===null || v===undefined || v==='' ) return '' ; var
            total=Math.round(parseFloat(v) * 1000); if (isNaN(total)) return '' ; var m=Math.floor(total / 60000); var
            s=Math.floor((total % 60000) / 1000); var ms=total % 1000; return m + '.' + ('0' + s).slice(-2) + '.' +
            ('00' + ms).slice(-3); } %>

            <style>
              .sc-hd {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                flex-wrap: wrap;
                margin-bottom: 16px;
              }

              .sc-title {
                font-size: 22px;
                font-weight: 800;
                color: #0F172A;
              }

              .sc-max {
                font-size: 12px;
                color: #64748B;
                background: #fff;
                border: 1px solid #E2E8F0;
                padding: 6px 12px;
                border-radius: 8px;
              }

              .sc-search {
                position: relative;
                margin-bottom: 12px;
              }

              .sc-search i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #94A3B8;
              }

              .sc-search input {
                width: 100%;
                height: 44px;
                padding: 0 12px 0 36px;
                border: 1.5px solid #E2E8F0;
                border-radius: 12px;
                background: #fff;
                font-family: inherit;
                font-size: 15px;
                outline: none;
              }

              .sc-search input:focus {
                border-color: #2563EB;
              }

              .sc-tbl {
                width: 100%;
                border-collapse: collapse;
              }

              .sc-tbl th {
                padding: 12px 16px;
                background: #F8FAFC;
                border-bottom: 1px solid #E2E8F0;
                font-size: 12px;
                font-weight: 700;
                color: #64748B;
                text-align: left;
                white-space: nowrap;
              }

              .sc-tbl td {
                padding: 14px 16px;
                border-bottom: 1px solid #F1F5F9;
                vertical-align: middle;
              }

              .sc-tbl tbody tr:hover td {
                background: #FAFBFF;
              }

              .sc-team b {
                display: block;
                font-size: 15px;
                color: #0F172A;
              }

              .sc-team span {
                font-size: 12px;
                font-weight: 700;
                color: #2563EB;
              }

              .sc-team em {
                display: none;
                font-style: normal;
                font-size: 12px;
                color: #64748B;
              }

              .sc-inst {
                font-size: 13px;
                color: #64748B;
              }

              /* ช่องคะแนนแต่ละรอบ (คะแนน + ปุ่มของรอบนั้น) */
              .rd {
                min-width: 170px;
              }

              .rd-val {
                display: flex;
                align-items: baseline;
                gap: 8px;
              }

              .rd-score {
                font-size: 22px;
                font-weight: 800;
                color: #2563EB;
                line-height: 1.1;
              }

              .rd-time {
                font-family: ui-monospace, Menlo, Consolas, monospace;
                font-size: 12px;
                color: #64748B;
              }

              .rd-act {
                display: flex;
                gap: 6px;
                margin-top: 6px;
              }

              .rd-act form {
                margin: 0;
              }

              .sc-btn {
                box-sizing: border-box;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
                height: 36px;
                padding: 0 12px;
                border-radius: 9px;
                border: 1.5px solid #E2E8F0;
                background: #fff;
                color: #334155;
                font-family: inherit;
                font-size: 13px;
                font-weight: 700;
                text-decoration: none;
                white-space: nowrap;
                cursor: pointer;
                -webkit-tap-highlight-color: transparent;
              }

              .sc-btn:active {
                transform: scale(.97);
              }

              /* ยังไม่มีคะแนน → ปุ่มหลัก */
              .sc-btn.add {
                height: 40px;
                padding: 0 16px;
                border-color: transparent;
                color: #fff;
              }

              .sc-btn.add.r1 {
                background: #7C3AED;
              }

              .sc-btn.add.r2 {
                background: #D97706;
              }

              .sc-btn.edit:hover {
                border-color: #93C5FD;
                color: #2563EB;
              }

              /* ล้าง = ปุ่มไอคอนเล็ก สีแดงจาง แยกจากปุ่มแก้ไข */
              .sc-btn.clear {
                width: 36px;
                padding: 0;
                border-color: #FECACA;
                background: #FEF2F2;
                color: #DC2626;
              }

              .sc-btn.clear:hover {
                background: #FEE2E2;
              }

              .sc-best {
                min-width: 110px;
              }

              .sc-best b {
                font-size: 24px;
                font-weight: 800;
                color: #0F172A;
              }

              .sc-bar {
                height: 6px;
                margin-top: 6px;
                border-radius: 99px;
                background: #E2E8F0;
                overflow: hidden;
              }

              .sc-bar span {
                display: block;
                height: 100%;
                border-radius: 99px;
                background: #2563EB;
              }

              .sc-judge {
                display: inline-flex;
                align-items: center;
                gap: 3px;
                margin-top: 3px;
                padding: 1px 8px;
                border-radius: 99px;
                background: #F1F5F9;
                font-size: 11px;
                font-weight: 700;
                color: #475569;
              }

              .sc-group {
                margin-bottom: 14px;
              }

              .sc-group-hd {
                display: flex;
                align-items: baseline;
                gap: 10px;
                flex-wrap: wrap;
                padding: 10px 4px;
                font-size: 16px;
                font-weight: 800;
                color: #0F172A;
                cursor: pointer;
                list-style: none;
              }

              .sc-group-hd::-webkit-details-marker {
                display: none;
              }

              .sc-group-hd::before {
                content: "▸";
                color: #94A3B8;
              }

              .sc-group[open]>.sc-group-hd::before {
                content: "▾";
              }

              .sc-group-hd b {
                margin-left: 4px;
                padding: 1px 10px;
                border-radius: 99px;
                background: #EFF6FF;
                color: #2563EB;
                font-size: 13px;
              }

              .sc-group-hd small,
              .sc-group-note {
                font-size: 12px;
                font-weight: 500;
                color: #64748B;
              }

              .sc-group-note {
                margin-bottom: 10px;
              }

              .sc-empty {
                padding: 40px 16px;
                text-align: center;
                color: #94A3B8;
              }

              .sc-none td {
                display: none;
              }

              /* ---------- แท็บเล็ต: ซ่อนคอลัมน์สถาบัน (แสดงใต้ชื่อทีมแทน) ---------- */
              @media (max-width: 1100px) {
                .sc-col-inst {
                  display: none;
                }

                .sc-team em {
                  display: block;
                }

                .sc-tbl td,
                .sc-tbl th {
                  padding-left: 12px;
                  padding-right: 12px;
                }
              }

              /* ---------- มือถือ: การ์ดทีละทีม ---------- */
              @media (max-width: 700px) {
                .sc-title {
                  font-size: 19px;
                }

                .sc-wrap {
                  overflow: visible !important;
                  background: transparent !important;
                  border: 0 !important;
                  box-shadow: none !important;
                }

                .sc-tbl thead {
                  display: none;
                }

                .sc-tbl,
                .sc-tbl tbody {
                  display: block;
                }

                .sc-tbl tbody tr {
                  display: grid;
                  grid-template-columns: 1fr 1fr;
                  grid-template-areas:
                    "team best"
                    "r1 r2";
                  gap: 10px;
                  margin-bottom: 12px;
                  padding: 14px;
                  border: 1px solid #E2E8F0;
                  border-radius: 16px;
                  background: #fff;
                  box-shadow: 0 2px 10px rgba(15, 23, 42, .04);
                }

                .sc-tbl tbody tr:hover td {
                  background: transparent;
                }

                .sc-tbl td {
                  display: block;
                  padding: 0;
                  border: 0;
                }

                .sc-tbl td.sc-col-inst {
                  display: none;
                }

                .sc-tbl td.sc-col-team {
                  grid-area: team;
                }

                .sc-tbl td.sc-col-best {
                  grid-area: best;
                  text-align: right;
                }

                .sc-tbl td.sc-col-r1 {
                  grid-area: r1;
                }

                .sc-tbl td.sc-col-r2 {
                  grid-area: r2;
                }

                .sc-tbl td.sc-empty-cell {
                  grid-column: 1 / -1;
                }

                .sc-best {
                  min-width: 0;
                }

                .sc-best b {
                  font-size: 26px;
                }

                .sc-best small {
                  display: block;
                  font-size: 11px;
                  color: #94A3B8;
                }

                .rd {
                  box-sizing: border-box;
                  min-width: 0;
                  padding: 10px !important;
                  border-radius: 12px;
                  background: #F8FAFC;
                }

                .rd::before {
                  content: attr(data-label);
                  display: block;
                  margin-bottom: 4px;
                  font-size: 11px;
                  font-weight: 800;
                  color: #94A3B8;
                }

                .rd-val {
                  flex-direction: column;
                  gap: 0;
                }

                .rd-act {
                  margin-top: 8px;
                }

                .rd-act .sc-btn.edit {
                  flex: 1;
                }

                .sc-btn.add {
                  width: 100%;
                  height: 48px;
                  font-size: 14px;
                }

                .sc-btn,
                .sc-btn.clear {
                  height: 42px;
                }

                .sc-btn.clear {
                  width: 42px;
                }
              }

              .sc-best-label {
                display: none;
              }

              @media (max-width: 700px) {
                .sc-best-label {
                  display: block;
                }
              }
            </style>

            <div class="sc-hd">
              <div class="sc-title">ลงคะแนน — <span style="color:<%= tierColor %>">
                  <%= tier==='beginner' ? 'Beginner' : tier==='intermediate' ? 'Intermediate' : 'Advance' %>
                </span></div>
              <div class="sc-max">คะแนนสูงสุด <strong style="color:#2563EB">
                  <%= maxScore %> คะแนน
                </strong> ต่อรอบ</div>
            </div>

            <% if (teams.length> 6) { %>
              <div class="sc-search">
                <i class="ti ti-search"></i>
                <input type="search" id="scSearch" placeholder="ค้นหาชื่อทีม / รหัสทีม / สถาบัน" autocomplete="off">
              </div>
              <% } %>

                <% groups.forEach(function (g) { %>
                  <% if (g.title) { %>
                    <details class="sc-group" <%=g.open ? 'open' : '' %>>
                      <summary class="sc-group-hd">
                        <span>
                          <%= g.title %> <b>
                              <%= g.teams.length %> ทีม
                            </b>
                        </span>
                        <% if (g.note) { %><small>
                            <%= g.note %>
                          </small>
                          <% } %>
                      </summary>
                      <% } else if (g.note) { %>
                        <div class="sc-group-note">
                          <%= g.note %>
                        </div>
                        <% } %>
                          <div class="card sc-wrap" style="overflow-x:auto">
                            <table class="sc-tbl">
                              <thead>
                                <tr>
                                  <th>ทีม</th>
                                  <th class="sc-col-inst">สถาบัน</th>
                                  <th>รอบที่ 1</th>
                                  <th>รอบที่ 2</th>
                                  <th>คะแนนดีสุด</th>
                                </tr>
                              </thead>
                              <tbody class="sc-body">
                                <% if (g.teams.length===0) { %>
                                  <tr>
                                    <td colspan="5" class="sc-empty-cell">
                                      <div class="sc-empty"><i class="ti ti-clipboard-x"></i> ไม่มีทีม</div>
                                    </td>
                                  </tr>
                                  <% } %>

                                    <% g.teams.forEach(function (t) { %>
                                      <% var s1=parseFloat(t.r1_score) || 0; %>
                                        <% var s2=parseFloat(t.r2_score) || 0; %>
                                          <% var best=Math.max(s1, s2); %>
                                            <tr
                                              data-search="<%= (t.name + ' ' + t.id + ' ' + (t.institution || '')).toLowerCase() %>">
                                              <td class="sc-col-team">
                                                <div class="sc-team">
                                                  <b>
                                                    <%= t.name %>
                                                  </b>
                                                  <span>
                                                    <%= t.id %>
                                                  </span>
                                                  <em>
                                                    <%= t.institution || '' %>
                                                  </em>
                                                  <% if (!locals.isJudge && t.judge_id && jNames[t.judge_id]) { %>
                                                    <small class="sc-judge"><i class="ti ti-user-check"></i>
                                                      <%= jNames[t.judge_id] %>
                                                    </small>
                                                    <% } %>
                                                </div>
                                              </td>
                                              <td class="sc-col-inst">
                                                <div class="sc-inst">
                                                  <%= t.institution || '—' %>
                                                </div>
                                              </td>

                                              <% [1, 2].forEach(function (r) { %>
                                                <% var score=t['r' + r + '_score' ]; %>
                                                  <% var has=score !==null && score !==undefined; %>
                                                    <td class="rd sc-col-r<%= r %>" data-label="รอบที่ <%= r %>">
                                                      <% if (has) { %>
                                                        <div class="rd-val">
                                                          <span class="rd-score">
                                                            <%= parseFloat(score) %>
                                                          </span>
                                                          <% if (fmtTime(t['r' + r + '_time' ])) { %>
                                                            <span class="rd-time">
                                                              <%= fmtTime(t['r' + r + '_time' ]) %>
                                                            </span>
                                                            <% } %>
                                                        </div>
                                                        <div class="rd-act">
                                                          <a href="/scores/<%= encodeURIComponent(t.id) %>/<%= r %>"
                                                            class="sc-btn edit"><i class="ti ti-pencil"></i> แก้ไข</a>
                                                          <% if (canClear) { %>
                                                            <form method="POST"
                                                              action="/board/scores/<%= encodeURIComponent(t.id) %>/<%= r %>/clear?tier=<%= tier %>&back=scores"
                                                              onsubmit="return confirm(<%= JSON.stringify('ล้างคะแนนรอบที่ ' + r + ' ของทีม ' + t.name + ' ?\nคะแนน ' + parseFloat(score) + ' และเวลาจะถูกลบ') %>);">
                                                              <button type="submit" class="sc-btn clear"
                                                                title="ล้างคะแนนรอบที่ <%= r %>"
                                                                aria-label="ล้างคะแนนรอบที่ <%= r %>"><i
                                                                  class="ti ti-trash"></i></button>
                                                            </form>
                                                            <% } %>
                                                        </div>
                                                        <% } else { %>
                                                          <a href="/scores/<%= encodeURIComponent(t.id) %>/<%= r %>"
                                                            class="sc-btn add r<%= r %>"><i class="ti ti-plus"></i>
                                                            ลงคะแนน</a>
                                                          <% } %>
                                                    </td>
                                                    <% }) %>

                                                      <td class="sc-col-best">
                                                        <div class="sc-best">
                                                          <small class="sc-best-label">คะแนนดีสุด</small>
                                                          <b>
                                                            <%= best || '—' %>
                                                          </b>
                                                          <% if (best> 0 && maxScore > 0) { %>
                                                            <div class="sc-bar"><span
                                                                style="width:<%= Math.min(100, Math.round(best / maxScore * 100)) %>%"></span>
                                                            </div>
                                                            <% } %>
                                                        </div>
                                                      </td>
                                            </tr>
                                            <% }) %>
                              </tbody>
                            </table>
                          </div>
                          <% if (g.title) { %>
                    </details>
                    <% } %>
                      <% }) %>

                        <script>
                          (function () {
                            var input = document.getElementById('scSearch');
                            if (!input) return;
                            var rows = document.querySelectorAll('.sc-body tr[data-search]');
                            input.addEventListener('input', function () {
                              var q = input.value.trim().toLowerCase();
                              for (var i = 0; i < rows.length; i++) {
                                rows[i].style.display = !q || rows[i].getAttribute('data-search').indexOf(q) !== -1 ? '' : 'none';
                              }
                              if (q) {
                                var gs = document.querySelectorAll('details.sc-group');
                                for (var k = 0; k < gs.length; k++) gs[k].open = true;
                              }
                            });
                          })();
                        </script>