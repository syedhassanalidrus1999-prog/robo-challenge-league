<div class="page-hd">
  <div class="page-title">ลงคะแนน — <span
      style="color:<%= tier==='beginner'?'#16A34A':tier==='intermediate'?'#2563EB':'#EA580C' %>">
      <%= tier==='beginner' ?'Beginner':tier==='intermediate' ?'Intermediate':'Advance' %>
    </span></div>
  <div style="font-size:12px;color:#64748B;background:#fff;border:1px solid #E2E8F0;padding:5px 12px;border-radius:6px">
    คะแนนสูงสุด <strong style="color:#2563EB">
      <%= maxScore %> คะแนน
    </strong> ต่อรอบ
  </div>
</div>

<div class="card">
  <div style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>ทีม</th>
          <th>สถาบัน</th>
          <th>รอบที่ 1</th>
          <th>รอบที่ 2</th>
          <th>คะแนนดีสุด</th>
          <th>ลงคะแนน</th>
        </tr>
      </thead>
      <tbody>
        <% if (teams.length===0) { %>
          <tr>
            <td colspan="6">
              <div class="empty"><i class="ti ti-clipboard-x"></i>ยังไม่มีทีมในรุ่นนี้</div>
            </td>
          </tr>
          <% } %>
            <% teams.forEach(function(t) { %>
              <tr>
                <td>
                  <div class="team-name">
                    <%= t.name %>
                  </div>
                  <div class="team-id">
                    <%= t.id %>
                  </div>
                </td>
                <td style="color:#64748B;font-size:12px">
                  <%= t.institution || '—' %>
                </td>
                <td>
                  <% if ((parseFloat(t.r1_score)||0)> 0) { %>
                    <div class="score-num">
                      <%= parseFloat(t.r1_score) %>
                    </div>
                    <div class="score-time">
                      <%= t.r1_time ? t.r1_time + ' วิ' : '' %>
                    </div>
                    <% } else { %><span style="color:#CBD5E1">—</span>
                      <% } %>
                </td>
                <td>
                  <% if ((parseFloat(t.r2_score)||0)> 0) { %>
                    <div class="score-num" style="color:#EA580C">
                      <%= parseFloat(t.r2_score) %>
                    </div>
                    <div class="score-time">
                      <%= t.r2_time ? t.r2_time + ' วิ' : '' %>
                    </div>
                    <% } else { %><span style="color:#CBD5E1">—</span>
                      <% } %>
                </td>
                <td>
                  <div class="best-score">
                    <%= Math.max(parseFloat(t.r1_score)||0, parseFloat(t.r2_score)||0) || '—' %>
                  </div>
                  <% if (Math.max(parseFloat(t.r1_score)||0, parseFloat(t.r2_score)||0)> 0) { %>
                    <div class="bar-bg">
                      <div class="bar-fill"
                        style="width:<%= Math.round(Math.max(parseFloat(t.r1_score)||0, parseFloat(t.r2_score)||0)/maxScore*100) %>%">
                      </div>
                    </div>
                    <% } %>
                </td>
                <td>
                  <div class="action-row">
                    <a href="/scores/<%= t.id %>/1" class="btn btn-secondary btn-sm"
                      style="color:#7C3AED;border-color:#DDD6FE">รอบที่ 1</a>
                    <a href="/scores/<%= t.id %>/2" class="btn btn-secondary btn-sm"
                      style="color:#D97706;border-color:#FDE68A">รอบที่ 2</a>
                  </div>
                </td>
              </tr>
              <% }) %>
      </tbody>
    </table>
  </div>
</div>