<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> — RCL
  </title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .score-form-wrap {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 20px;
    }

    @media(max-width:900px) {
      .score-form-wrap {
        grid-template-columns: 1fr;
      }
    }

    .mission-card {
      background: #fff;
      border: 1.5px solid #E2E8F0;
      border-radius: 16px;
      padding: 18px 20px;
      margin-bottom: 14px;
      box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
    }

    .mission-title {
      font-size: 15px;
      font-weight: 800;
      color: #0F172A;
      margin-bottom: 3px;
    }

    .mission-sub {
      font-size: 12px;
      color: #94A3B8;
      margin-bottom: 14px;
    }

    .mission-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    @media(max-width:600px) {
      .mission-row {
        grid-template-columns: 1fr;
      }
    }

    .score-input-box {
      border: 1.5px solid #E2E8F0;
      border-radius: 12px;
      padding: 10px 14px;
      background: #F8FAFC;
    }

    .score-input-label {
      font-size: 11px;
      font-weight: 700;
      color: #64748B;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .score-input-label.full {
      color: #2563EB;
    }

    .score-input-label.partial {
      color: #F59E0B;
    }

    .score-num-input {
      width: 100%;
      border: none;
      background: transparent;
      font-size: 28px;
      font-weight: 900;
      color: #0F172A;
      text-align: center;
      outline: none;
      font-family: 'Sarabun', sans-serif;
    }

    .score-calc {
      font-size: 11px;
      color: #94A3B8;
      text-align: center;
      margin-top: 4px;
    }

    .mission-total {
      text-align: right;
      font-size: 13px;
      font-weight: 700;
      color: #2563EB;
      margin-top: 10px;
    }

    .side-card {
      background: #fff;
      border: 1.5px solid #E2E8F0;
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
      margin-bottom: 14px;
    }

    .side-title {
      font-size: 13px;
      font-weight: 800;
      color: #64748B;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .sig-canvas-wrap {
      border: 1.5px solid #E2E8F0;
      border-radius: 10px;
      overflow: hidden;
      background: #fff;
      position: relative;
    }

    #sigCanvas {
      display: block;
      width: 100%;
      touch-action: none;
      cursor: crosshair;
    }

    .sig-actions {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }

    .photo-preview {
      width: 100%;
      border-radius: 10px;
      cursor: zoom-in;
      border: 1px solid #E2E8F0;
      display: block;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 16px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
      font-family: 'Sarabun', sans-serif;
      transition: .15s;
    }

    .btn-primary {
      background: #2563EB;
      color: #fff;
      box-shadow: 0 6px 16px rgba(37, 99, 235, .22);
    }

    .btn-primary:hover {
      background: #1D4ED8;
    }

    .btn-outline {
      background: #fff;
      color: #64748B;
      border: 1.5px solid #E2E8F0;
    }

    .btn-outline:hover {
      background: #F8FAFC;
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 12px;
    }

    .btn-danger-sm {
      background: #FEF2F2;
      color: #DC2626;
      border: 1px solid #FECACA;
    }

    /* Lightbox */
    #lightbox {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .88);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      cursor: zoom-out;
    }

    #lightbox.show {
      display: flex;
    }

    #lightboxImg {
      max-width: 90vw;
      max-height: 90vh;
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, .5);
    }

    #lightboxClose {
      position: absolute;
      top: 20px;
      right: 20px;
      background: rgba(255, 255, 255, .15);
      border: none;
      color: #fff;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }


    /* ===== RCL SCORE PAGE — UI POLISH ===== */
    body {
      background: radial-gradient(circle at 8% 0%, rgba(37, 99, 235, .055), transparent 28%), #f1f5f9;
    }

    .score-form-wrap {
      max-width: 1240px;
      grid-template-columns: minmax(0, 1fr) 350px;
      gap: 24px;
      align-items: start;
    }

    .page-hd {
      max-width: 1240px;
      margin: 0 auto 20px;
    }

    .page-title {
      font-size: 24px !important;
      font-weight: 900 !important
    }

    .mission-card {
      position: relative;
      border: 1px solid #dce5f0;
      border-radius: 18px;
      padding: 0;
      margin-bottom: 16px;
      overflow: hidden;
      box-shadow: 0 5px 18px rgba(15, 23, 42, .045);
      transition: .18s ease;
    }

    .mission-card:hover {
      transform: translateY(-2px);
      border-color: #c8d9ef;
      box-shadow: 0 12px 28px rgba(15, 23, 42, .075);
    }

    .mission-card:before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: linear-gradient(180deg, #2563eb, #60a5fa);
    }

    .mission-title {
      padding: 17px 20px 2px 24px;
      margin: 0;
      font-size: 17px
    }

    .mission-sub {
      padding: 0 20px 14px 24px;
      margin: 0
    }

    .mission-row {
      padding: 0 18px;
      gap: 14px
    }

    .score-input-box {
      padding: 14px 15px 12px;
      background: #f8fafc;
      border-radius: 14px;
      border: 1px solid #dce5f0;
      transition: .18s ease;
    }

    .score-input-box:focus-within {
      background: #fff;
      border-color: #93c5fd;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, .07);
    }

    .score-input-label {
      font-size: 12px;
      margin-bottom: 8px
    }

    .score-num-input {
      height: 52px !important;
      border: 1px solid #d7e1ec !important;
      border-radius: 11px !important;
      background: #fff !important;
      font-size: 30px !important;
    }

    .score-num-input:focus {
      border-color: #2563eb !important;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
    }

    .partial-input:focus {
      border-color: #f59e0b !important;
      box-shadow: 0 0 0 4px rgba(245, 158, 11, .10);
    }

    .score-calc {
      min-height: 18px;
      margin-top: 6px
    }

    .mission-total {
      padding: 10px 20px 14px;
      margin: 0
    }

    .mission-total span {
      font-size: 16px;
      font-weight: 900
    }

    /* Sidebar */
    .score-form-wrap>div:last-child {
      position: sticky;
      top: 78px;
    }

    .side-card {
      border: 1px solid #dce5f0;
      border-radius: 18px;
      padding: 18px;
      margin-bottom: 14px;
      box-shadow: 0 6px 20px rgba(15, 23, 42, .05);
    }

    .side-title {
      color: #334155;
      font-size: 13px;
      margin-bottom: 11px
    }

    .fi {
      height: 48px;
      border: 1px solid #cbd5e1;
      border-radius: 11px;
      transition: .18s ease;
    }

    .fi:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, .09);
      outline: none;
    }

    /* Photo */
    .photo-preview {
      max-height: 300px;
      object-fit: contain;
      background: #f8fafc;
      padding: 5px;
      transition: .18s ease;
    }

    .photo-preview:hover {
      transform: scale(1.01);
      box-shadow: 0 10px 24px rgba(15, 23, 42, .10);
    }

    /* Signature */
    .sig-canvas-wrap {
      height: 150px;
      border: 1.5px solid #cbd5e1;
      border-radius: 13px;
      background: #fff;
      box-shadow: inset 0 0 0 4px #f8fafc;
    }

    #sigCanvas {
      height: 150px !important;
      width: 100% !important
    }

    .sig-actions {
      align-items: center;
      justify-content: space-between;
      margin-top: 9px
    }

    /* Total */
    #totalScore {
      font-size: 48px !important;
      line-height: 1.05;
      letter-spacing: -1px;
    }

    /* Save */
    .score-form-wrap>div:last-child>.btn-primary {
      position: sticky;
      bottom: 14px;
      z-index: 5;
      min-height: 54px;
      border-radius: 13px;
      font-size: 15px;
      box-shadow: 0 12px 26px rgba(37, 99, 235, .28);
    }

    .score-form-wrap>div:last-child>.btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 32px rgba(37, 99, 235, .34);
    }

    /* Lightbox */
    #lightbox {
      padding: 24px;
      backdrop-filter: blur(5px);
    }

    #lightboxImg {
      max-width: 94vw;
      max-height: 90vh;
      object-fit: contain;
      background: #fff;
      border: 4px solid #fff;
      border-radius: 14px;
    }

    #lightboxClose {
      z-index: 2;
      width: 44px;
      height: 44px;
      background: rgba(15, 23, 42, .55);
      backdrop-filter: blur(8px);
    }

    #lightboxClose:hover {
      background: rgba(15, 23, 42, .78);
      transform: scale(1.05)
    }

    @media(max-width:1050px) {
      .score-form-wrap {
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 16px
      }
    }

    @media(max-width:900px) {
      .score-form-wrap {
        grid-template-columns: 1fr
      }

      .score-form-wrap>div:last-child {
        position: static
      }

      .score-form-wrap>div:last-child>.btn-primary {
        position: sticky;
        bottom: 10px
      }
    }

    @media(max-width:600px) {
      .page-title {
        font-size: 20px !important
      }

      .mission-card {
        border-radius: 15px
      }

      .mission-title {
        padding: 15px 15px 2px 20px
      }

      .mission-sub {
        padding: 0 15px 12px 20px
      }

      .mission-row {
        padding: 0 12px;
        gap: 10px
      }

      .score-input-box {
        padding: 12px
      }

      .score-num-input {
        height: 54px !important;
        font-size: 28px !important
      }

      .mission-total {
        padding: 9px 15px 13px
      }

      .side-card {
        border-radius: 15px;
        padding: 15px
      }

      #totalScore {
        font-size: 42px !important
      }

      .photo-preview {
        max-height: 260px
      }
    }
  </style>
</head>

<body>
  <div class="layout">
    <%- include('../partials/sidebar') %>
      <div class="content">
        <%- include('../partials/topbar') %>
          <main class="main">
            <%- include('../partials/alert') %>

              <div class="page-hd">
                <div>
                  <div class="page-title">ลงคะแนน — <span>รอบที่ <%= round %></span></div>
                  <div style="font-size:13px;color:#64748B;margin-top:4px">
                    <span style="font-weight:700;color:#0F172A">
                      <%= team.name %>
                    </span>
                    · <%= team.institution %>
                      · <span
                        style="color:<%= team.tier==='beginner'?'#16A34A':team.tier==='intermediate'?'#2563EB':'#EA580C' %>;font-weight:700">
                        <%= team.tier==='beginner' ?'Beginner':team.tier==='intermediate' ?'Intermediate':'Advance' %>
                      </span>
                  </div>
                </div>
                <a href="/scores" class="btn btn-outline btn-sm"><i class="ti ti-arrow-left"></i> กลับ</a>
              </div>

              <form method="POST" action="/scores/<%= team.id %>/<%= round %>" enctype="multipart/form-data"
                id="scoreForm">

                <div class="score-form-wrap">

                  <!-- LEFT: missions -->
                  <div>
                    <% for (var i=0; i < criteria.length; i++) { %>
                      <% var c=criteria[i]; var n=i + 1; %>
                        <% var prevFull=existing && existing['mission_' + n + '_full' ] ? parseFloat(existing['mission_'
                          + n + '_full' ]) : 0; %>
                          <% var prevPartial=existing && existing['mission_' + n + '_partial' ] ?
                            parseFloat(existing['mission_' + n + '_partial' ]) : 0; %>
                            <div class="mission-card">
                              <div class="mission-title">
                                <%= n %>. <%= c.name %>
                              </div>
                              <div class="mission-sub">
                                เข้าเต็ม <%= parseFloat(c.max_score) %> คะแนน/ชิ้น
                                  <% if (c.score_type==='both' ) { %> · เข้าบางส่วน <%= parseFloat(c.score_partial) %>
                                      คะแนน/ชิ้น<% } %>
                              </div>
                              <div class="mission-row">
                                <div class="score-input-box">
                                  <div class="score-input-label full"><i class="ti ti-trophy"></i> เข้าเต็ม (ชิ้น)</div>
                                  <input type="number" name="mission_<%= n %>_full" class="score-num-input full-input"
                                    data-max="<%= parseFloat(c.max_score) %>" data-n="<%= n %>" value="<%= prevFull %>"
                                    min="0" step="1">
                                  <div class="score-calc" id="calc_full_<%= n %>">
                                    <%= prevFull %> × <%= parseFloat(c.max_score) %> = <strong>
                                          <%= (prevFull * parseFloat(c.max_score)).toFixed(1) %>
                                        </strong> คะแนน
                                  </div>
                                </div>
                                <div class="score-input-box"
                                  style="<%= c.score_type !== 'both' ? 'opacity:.4;pointer-events:none' : '' %>">
                                  <div class="score-input-label partial"><i class="ti ti-star-half"></i> เข้าบางส่วน
                                    (ชิ้น)</div>
                                  <input type="number" name="mission_<%= n %>_partial"
                                    class="score-num-input partial-input"
                                    data-partial="<%= parseFloat(c.score_partial || 0) %>" data-n="<%= n %>"
                                    value="<%= prevPartial %>" min="0" step="1" <%=c.score_type !=='both' ? 'disabled'
                                    : '' %>>
                                  <div class="score-calc" id="calc_partial_<%= n %>">
                                    <%= prevPartial %> × <%= parseFloat(c.score_partial || 0) %> = <strong>
                                          <%= (prevPartial * parseFloat(c.score_partial || 0)).toFixed(1) %>
                                        </strong> คะแนน
                                  </div>
                                </div>
                              </div>
                              <div class="mission-total" id="mission_total_<%= n %>">
                                รวม <span>
                                  <%= ((prevFull * parseFloat(c.max_score)) + (prevPartial * parseFloat(c.score_partial
                                    || 0))).toFixed(1) %>
                                </span> คะแนน
                              </div>
                            </div>
                            <% } %>
                  </div>

                  <!-- RIGHT: sidebar -->
                  <div>

                    <!-- เวลา -->
                    <div class="side-card">
                      <div class="side-title"><i class="ti ti-clock"></i> เวลา (วินาที)</div>
                      <input type="number" name="time_seconds" class="fi" step="0.01" min="0"
                        value="<%= existing && existing.time_seconds ? parseFloat(existing.time_seconds).toFixed(2) : '' %>"
                        placeholder="เช่น 45.30">
                    </div>

                    <!-- รูปภาพ -->
                    <div class="side-card">
                      <div class="side-title"><i class="ti ti-photo"></i> รูปภาพสนาม</div>
                      <% if (existing && existing.photo_url) { %>
                        <div style="margin-bottom:10px">
                          <img src="<%= existing.photo_url %>" class="photo-preview"
                            onclick="openLightbox('<%= existing.photo_url %>')" title="คลิกเพื่อดูรูปเต็ม"
                            style="margin-bottom:0">
                          <div style="text-align:center;font-size:11px;color:#64748B;margin-top:6px">
                            <i class="ti ti-zoom-in"></i> คลิกที่รูปเพื่อดูภาพเต็ม
                          </div>
                        </div>
                        <% } %>
                          <input type="file" name="photo" accept="image/*" class="fi" style="padding:6px">
                    </div>

                    <!-- ลายเซ็น -->
                    <div class="side-card">
                      <div class="side-title"><i class="ti ti-signature"></i> ลายเซ็นผู้แข่งขัน</div>

                      <% if (existing && existing.signature_url) { %>
                        <div style="margin-bottom:10px">
                          <img src="<%= existing.signature_url %>"
                            onclick="openLightbox('<%= existing.signature_url %>')"
                            style="width:100%;border-radius:8px;border:1px solid #E2E8F0;cursor:zoom-in;background:#fff">
                          <div style="font-size:11px;color:#94A3B8;margin-top:4px;text-align:center">ลายเซ็นเดิม
                            (วาดใหม่เพื่อเปลี่ยน)</div>
                        </div>
                        <% } %>

                          <div class="sig-canvas-wrap">
                            <canvas id="sigCanvas" width="280" height="140"></canvas>
                          </div>
                          <div class="sig-actions">
                            <button type="button" class="btn btn-outline btn-sm" onclick="clearSig()">
                              <i class="ti ti-eraser"></i> ล้าง
                            </button>
                            <span id="sigStatus"
                              style="font-size:11px;color:#94A3B8;align-self:center">ยังไม่ได้เซ็น</span>
                          </div>
                          <input type="hidden" name="signature_data" id="sigData">
                    </div>

                    <!-- Total -->
                    <div class="side-card"
                      style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border-color:#BFDBFE">
                      <div class="side-title" style="color:#1D4ED8"><i class="ti ti-calculator"></i> คะแนนรวม</div>
                      <div style="font-size:36px;font-weight:900;color:#1D4ED8;text-align:center" id="totalScore">0.0
                      </div>
                      <div style="text-align:center;font-size:12px;color:#64748B">จาก <%= maxScore %> คะแนน</div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:14px"
                      onclick="prepareSubmit()">
                      <i class="ti ti-device-floppy"></i> บันทึกคะแนนรอบที่ <%= round %>
                    </button>

                  </div>
                </div>
              </form>
          </main>
      </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" onclick="closeLightbox()">
    <img id="lightboxImg">
    <button id="lightboxClose" onclick="closeLightbox()">✕</button>
  </div>

  <script src="/js/main.js"></script>
  <script>
    // ── Score calculation ────────────────────────────────────────────────────────
    document.querySelectorAll('.full-input').forEach(function (input) {
      input.addEventListener('input', function () {
        var n = this.dataset.n;
        var max = parseFloat(this.dataset.max);
        var val = parseFloat(this.value) || 0;
        var score = val * max;
        document.getElementById('calc_full_' + n).innerHTML =
          val + ' × ' + max + ' = <strong>' + score.toFixed(1) + '</strong> คะแนน';
        updateMissionTotal(n);
      });
    });

    document.querySelectorAll('.partial-input').forEach(function (input) {
      input.addEventListener('input', function () {
        var n = this.dataset.n;
        var partial = parseFloat(this.dataset.partial) || 0;
        var val = parseFloat(this.value) || 0;
        var score = val * partial;
        document.getElementById('calc_partial_' + n).innerHTML =
          val + ' × ' + partial + ' = <strong>' + score.toFixed(1) + '</strong> คะแนน';
        updateMissionTotal(n);
      });
    });

    function updateMissionTotal(n) {
      var fullInput = document.querySelector('.full-input[data-n="' + n + '"]');
      var partialInput = document.querySelector('.partial-input[data-n="' + n + '"]');
      var max = parseFloat(fullInput.dataset.max) || 0;
      var partial = parseFloat(partialInput.dataset.partial) || 0;
      var fullVal = parseFloat(fullInput.value) || 0;
      var partialVal = parseFloat(partialInput.value) || 0;
      var total = (fullVal * max) + (partialVal * partial);
      document.getElementById('mission_total_' + n).innerHTML =
        'รวม <span>' + total.toFixed(1) + '</span> คะแนน';
      updateGrandTotal();
    }

    function updateGrandTotal() {
      var total = 0;
      document.querySelectorAll('.full-input').forEach(function (input) {
        var n = input.dataset.n;
        var max = parseFloat(input.dataset.max) || 0;
        var partialInput = document.querySelector('.partial-input[data-n="' + n + '"]');
        var partial = parseFloat(partialInput.dataset.partial) || 0;
        total += (parseFloat(input.value) || 0) * max;
        total += (parseFloat(partialInput.value) || 0) * partial;
      });
      document.getElementById('totalScore').textContent = total.toFixed(1);
    }

    updateGrandTotal();

    // ── Signature pad ────────────────────────────────────────────────────────────
    var canvas = document.getElementById('sigCanvas');
    var ctx = canvas.getContext('2d');
    var drawing = false;
    var hasSig = false;

    canvas.style.height = '140px';

    function getPos(e) {
      var rect = canvas.getBoundingClientRect();
      var scaleX = canvas.width / rect.width;
      var scaleY = canvas.height / rect.height;
      if (e.touches) {
        return {
          x: (e.touches[0].clientX - rect.left) * scaleX,
          y: (e.touches[0].clientY - rect.top) * scaleY
        };
      }
      return {
        x: (e.clientX - rect.left) * scaleX,
        y: (e.clientY - rect.top) * scaleY
      };
    }

    canvas.addEventListener('mousedown', function (e) {
      drawing = true;
      var pos = getPos(e);
      ctx.beginPath();
      ctx.moveTo(pos.x, pos.y);
    });
    canvas.addEventListener('mousemove', function (e) {
      if (!drawing) return;
      var pos = getPos(e);
      ctx.lineTo(pos.x, pos.y);
      ctx.strokeStyle = '#0F172A';
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      ctx.stroke();
      hasSig = true;
      document.getElementById('sigStatus').textContent = 'มีลายเซ็น';
      document.getElementById('sigStatus').style.color = '#16A34A';
    });
    canvas.addEventListener('mouseup', function () { drawing = false; });
    canvas.addEventListener('mouseleave', function () { drawing = false; });

    canvas.addEventListener('touchstart', function (e) {
      e.preventDefault();
      drawing = true;
      var pos = getPos(e);
      ctx.beginPath();
      ctx.moveTo(pos.x, pos.y);
    });
    canvas.addEventListener('touchmove', function (e) {
      e.preventDefault();
      if (!drawing) return;
      var pos = getPos(e);
      ctx.lineTo(pos.x, pos.y);
      ctx.strokeStyle = '#0F172A';
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      ctx.stroke();
      hasSig = true;
      document.getElementById('sigStatus').textContent = 'มีลายเซ็น';
      document.getElementById('sigStatus').style.color = '#16A34A';
    });
    canvas.addEventListener('touchend', function () { drawing = false; });

    function clearSig() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasSig = false;
      document.getElementById('sigData').value = '';
      document.getElementById('sigStatus').textContent = 'ยังไม่ได้เซ็น';
      document.getElementById('sigStatus').style.color = '#94A3B8';
    }

    function prepareSubmit() {
      if (hasSig) {
        document.getElementById('sigData').value = canvas.toDataURL('image/png');
      }
    }

    // ── Lightbox ─────────────────────────────────────────────────────────────────
    function openLightbox(src) {
      document.getElementById('lightboxImg').src = src;
      document.getElementById('lightbox').classList.add('show');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('show');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</body>

</html>