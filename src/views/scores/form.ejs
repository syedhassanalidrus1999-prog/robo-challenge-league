<div class="page-hd">
  <div style="display:flex;align-items:center;gap:10px">
    <a href="/scores" class="btn btn-ghost btn-sm"><i class="ti ti-arrow-left"></i> กลับ</a>
    <div class="page-title">ลงคะแนน — <span>
        <%= team.name %>
      </span></div>
    <span class="round-tag <%= round===1?'round-1':'round-2' %>">รอบที่ <%= round %></span>
  </div>
</div>

<form method="POST" action="/scores/<%= team.id %>/<%= round %>" enctype="multipart/form-data">
  <div style="display:grid;grid-template-columns:1fr 340px;gap:16px">

    <div>
      <div class="card" style="margin-bottom:16px">
        <div class="card-hd">
          <div class="card-title">คะแนนแต่ละภารกิจ</div>
        </div>
        <div class="card-body">
          <% criteria.forEach((c, i)=> {
            const fieldName = 'mission_' + (i + 1)
            const existingVal = existing ? (existing[fieldName] || 0) : 0
            %>
            <div style="margin-bottom:14px;padding:14px;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:8px">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px">
                <div>
                  <div style="font-size:13px;font-weight:700;color:#1E293B">
                    <%= c.name %>
                  </div>
                  <div style="font-size:11px;color:#94A3B8">คะแนนเต็ม <%= c.max_score %> คะแนน</div>
                </div>
                <span
                  style="font-size:11px;font-weight:700;color:#2563EB;background:#EFF6FF;padding:2px 8px;border-radius:20px">
                  max <%= c.max_score %>
                </span>
              </div>
              <div style="display:flex;align-items:center;gap:10px">
                <label class="fl" style="white-space:nowrap;width:80px">คะแนนที่ได้</label>
                <input class="fi" type="number" name="<%= fieldName %>" min="0" max="<%= c.max_score %>" step="0.5"
                  value="<%= existingVal %>"
                  style="max-width:100px;font-size:20px;font-weight:700;color:#2563EB;text-align:center"
                  oninput="updateTotal()">
              </div>
            </div>
            <% }) %>
        </div>
      </div>
    </div>

    <div>
      <div
        style="background:linear-gradient(135deg,#EFF6FF,#E0EEFF);border:1px solid #BFDBFE;border-radius:10px;padding:16px;text-align:center;margin-bottom:14px">
        <div
          style="font-size:10px;font-weight:700;color:#2563EB;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:4px">
          คะแนนรวม</div>
        <div id="totalScore"
          style="font-size:44px;font-weight:700;color:#1E293B;line-height:1;font-family:'Inter',sans-serif">
          <%= existing ? parseFloat(existing.total_score || 0) : 0 %>
        </div>
        <div style="font-size:12px;color:#64748B;margin-top:4px">จาก <%= maxScore %> คะแนน · <span id="totalPct">
              <%= existing && maxScore> 0 ? Math.round(parseFloat(existing.total_score||0)/maxScore*100) : 0 %>
            </span>%</div>
      </div>

      <div class="card" style="margin-bottom:14px">
        <div class="card-body">
          <div class="fg">
            <div class="fl"><i class="ti ti-clock" style="font-size:13px"></i> เวลาที่ใช้ (วินาที)</div>
            <input class="fi" type="number" name="time_seconds" step="0.01"
              value="<%= existing ? existing.time_seconds || '' : '' %>" placeholder="เช่น 77.65"
              style="font-size:18px;font-weight:700;text-align:center;font-family:'Inter',sans-serif">
          </div>
        </div>
      </div>

      <div class="card" style="margin-bottom:14px">
        <div class="card-hd">
          <div class="card-title">รูปภาพและลายเซ็น</div>
        </div>
        <div class="card-body">
          <div class="fg" style="margin-bottom:14px">
            <div class="fl"><i class="ti ti-camera"></i> รูปภาพสนาม</div>
            <% if (existing && existing.photo_url) { %>
              <img src="<%= existing.photo_url %>" alt="field photo"
                style="width:100%;border-radius:6px;margin-bottom:6px">
              <% } %>
                <input type="file" name="photo" accept="image/*" class="fi" style="padding:6px">
          </div>
          <div class="fg">
            <div class="fl"><i class="ti ti-signature"></i> ลายเซ็นผู้แข่ง</div>
            <% if (existing && existing.signature_url) { %>
              <div style="margin-bottom:8px">
                <div style="font-size:11px;color:#94A3B8;margin-bottom:4px">ลายเซ็นที่บันทึกไว้</div>
                <img src="<%= existing.signature_url %>" alt="signature"
                  style="width:100%;max-height:80px;object-fit:contain;border-radius:6px;background:#F8FAFC;border:1px solid #E2E8F0">
              </div>
              <% } %>
                <div
                  style="border:1.5px solid #CBD5E1;border-radius:8px;overflow:hidden;background:#fff;position:relative">
                  <canvas id="sigCanvas"
                    style="display:block;width:100%;height:120px;cursor:crosshair;touch-action:none"></canvas>
                  <button type="button" onclick="clearSig()"
                    style="position:absolute;top:6px;right:6px;background:#F1F5F9;border:1px solid #E2E8F0;color:#64748B;font-size:11px;padding:2px 8px;border-radius:4px;cursor:pointer">
                    ล้าง
                  </button>
                  <div id="sigHint"
                    style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#CBD5E1;font-size:12px;pointer-events:none">
                    เซ็นชื่อที่นี่
                  </div>
                </div>
                <input type="hidden" name="signature_data" id="sigData">
                <div id="sigStatus" style="font-size:11px;color:#94A3B8;margin-top:4px">ยังไม่ได้เซ็นชื่อ</div>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary"
        style="width:100%;justify-content:center;padding:11px;font-size:14px">
        <i class="ti ti-device-floppy"></i> บันทึกคะแนนรอบที่ <%= round %>
      </button>
    </div>
  </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
<script>
  const maxScore = <%= maxScore %>;

  function updateTotal() {
    let total = 0;
    document.querySelectorAll('input[type="number"][name^="mission_"]').forEach(inp => {
      total += parseFloat(inp.value) || 0;
    });
    document.getElementById('totalScore').textContent = total.toFixed(1);
    document.getElementById('totalPct').textContent = maxScore > 0 ? Math.round(total / maxScore * 100) : 0;
  }

  // ── Signature Pad ────────────────
  const canvas = document.getElementById('sigCanvas');
  const ratio = Math.max(window.devicePixelRatio || 1, 1);
  canvas.width = canvas.offsetWidth * ratio;
  canvas.height = canvas.offsetHeight * ratio;
  canvas.getContext('2d').scale(ratio, ratio);

  const sigPad = new SignaturePad(canvas, {
    minWidth: 1.5,
    maxWidth: 3,
    penColor: '#1E293B'
  });

  sigPad.addEventListener('beginStroke', () => {
    document.getElementById('sigHint').style.display = 'none';
  });

  sigPad.addEventListener('endStroke', () => {
    if (!sigPad.isEmpty()) {
      document.getElementById('sigData').value = sigPad.toDataURL('image/png');
      document.getElementById('sigStatus').textContent = '✅ เซ็นชื่อแล้ว';
      document.getElementById('sigStatus').style.color = '#16A34A';
    }
  });

  function clearSig() {
    sigPad.clear();
    document.getElementById('sigData').value = '';
    document.getElementById('sigHint').style.display = 'block';
    document.getElementById('sigStatus').textContent = 'ยังไม่ได้เซ็นชื่อ';
    document.getElementById('sigStatus').style.color = '#94A3B8';
  }

  document.querySelector('form').addEventListener('submit', () => {
    if (!sigPad.isEmpty()) {
      document.getElementById('sigData').value = sigPad.toDataURL('image/png');
    }
  });
</script>