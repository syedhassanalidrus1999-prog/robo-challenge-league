<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ดาวน์โหลดเกียรติบัตร — Robo Challenge League</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&family=Kanit:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&family=Kanit:wght@400;500;600;700;800&display=swap');

        :root {
            --primary: #2563EB;
            --primary-dark: #1D4ED8;
            --primary-soft: #EFF6FF;
            --text: #0F172A;
            --muted: #64748B;
            --muted-2: #94A3B8;
            --line: #E8EEF6;
            --bg: #F5F8FC;
            --card: #FFFFFF;
            --success: #16A34A;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        html {
            scroll-behavior: smooth
        }

        body {
            font-family: 'Sarabun', sans-serif;
            background:
                radial-gradient(circle at 50% -10%, rgba(37, 99, 235, .10), transparent 34%),
                linear-gradient(180deg, #F7FAFF 0%, #F4F7FB 48%, #F7F9FC 100%);
            color: var(--text);
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit
        }

        button,
        input {
            font: inherit
        }

        /* ---------- Top bar ---------- */
        .topbar {
            height: 72px;
            background: rgba(255, 255, 255, .88);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(226, 232, 240, .85);
            display: flex;
            align-items: center;
            padding: 0 clamp(18px, 4vw, 48px);
            gap: 14px;
            position: sticky;
            top: 0;
            z-index: 20;
            box-shadow: 0 5px 24px rgba(15, 23, 42, .045);
        }

        .topbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .topbar img {
            width: auto;
            height: 40px;
            object-fit: contain;
        }

        .topbar-title {
            font-size: 15px;
            font-weight: 700;
            color: #1E293B;
            white-space: nowrap;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            padding: 8px 13px;
            background: #fff;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            font-weight: 700;
            color: #334155;
            transition: .2s ease;
            box-shadow: 0 2px 8px rgba(15, 23, 42, .03);
        }

        .back-btn:hover {
            color: var(--primary);
            border-color: #BFDBFE;
            background: #F8FBFF;
            transform: translateY(-1px);
        }

        /* ---------- Main layout ---------- */
        .wrap {
            width: min(920px, calc(100% - 32px));
            margin: 0 auto;
            padding: 54px 0 80px;
        }

        /* ---------- Hero ---------- */
        .hero {
            text-align: center;
            margin-bottom: 28px;
        }

        .hero-icon {
            width: 52px;
            height: 52px;
            margin: 0 auto 15px;
            display: grid;
            place-items: center;
            border-radius: 16px;
            color: var(--primary);
            background: linear-gradient(145deg, #EFF6FF, #DBEAFE);
            border: 1px solid #DBEAFE;
            box-shadow: 0 10px 24px rgba(37, 99, 235, .10);
            font-size: 25px;
        }

        .hero-title {
            font-size: clamp(27px, 4vw, 34px);
            line-height: 1.2;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 8px;
            font-family: 'Kanit', sans-serif;
            letter-spacing: -.3px;
        }

        .hero-title span {
            color: var(--primary);
        }

        .hero-sub {
            font-size: 14px;
            color: var(--muted);
        }

        /* ---------- Search ---------- */
        .search-card {
            background: rgba(255, 255, 255, .96);
            border: 1px solid #E2E8F0;
            border-radius: 22px;
            padding: 22px;
            box-shadow: 0 14px 38px rgba(15, 23, 42, .075);
            margin-bottom: 22px;
        }

        .search-label {
            display: flex;
            align-items: center;
            gap: 7px;
            margin: 0 0 9px 2px;
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

        .search-label i {
            color: var(--primary);
        }

        .search-row {
            display: grid;
            grid-template-columns: 1fr 145px;
            gap: 10px;
        }

        .input-wrap {
            position: relative;
        }

        .fi {
            width: 100%;
            min-height: 48px;
            padding: 12px 15px 12px 43px;
            border: 1.5px solid #CBD5E1;
            border-radius: 12px;
            font-size: 14px;
            font-family: 'Sarabun', sans-serif;
            color: var(--text);
            background: #fff;
            outline: none;
            transition: .2s ease;
        }

        .fi::placeholder {
            color: #A0AEC0
        }

        .fi:focus {
            border-color: #60A5FA;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            pointer-events: none;
            font-size: 18px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 48px;
            padding: 12px 20px;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            font-weight: 700;
            font-family: 'Sarabun', sans-serif;
            transition: .2s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563EB, #1D4ED8);
            color: #fff;
            box-shadow: 0 9px 20px rgba(37, 99, 235, .22);
            width: 100%;
        }

        .btn-primary:hover {
            filter: brightness(.98);
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(37, 99, 235, .27);
        }

        .btn-primary:active {
            transform: translateY(0)
        }

        /* ---------- Loading ---------- */
        .loading {
            text-align: center;
            padding: 26px;
            color: var(--muted);
            display: none;
        }

        .loading i {
            color: var(--primary)
        }

        /* ---------- Result card ---------- */
        .result-card {
            background: rgba(255, 255, 255, .97);
            border: 1px solid #E2E8F0;
            border-radius: 22px;
            box-shadow: 0 14px 38px rgba(15, 23, 42, .065);
            overflow: hidden;
            display: none;
        }

        .result-card.show {
            display: block
        }

        .result-card>#resultContent>.team-block {
            border-bottom: 1px solid var(--line);
        }

        .result-card>#resultContent>.team-block:last-child {
            border-bottom: none;
        }

        .team-header {
            padding: 20px 22px;
            background: linear-gradient(180deg, #FFFFFF 0%, #FBFDFF 100%);
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .team-header::before {
            content: '';
            width: 4px;
            align-self: stretch;
            border-radius: 999px;
            background: linear-gradient(180deg, #60A5FA, #2563EB);
        }

        .team-meta {
            flex: 1;
            min-width: 0
        }

        .team-badges {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 7px;
            margin-bottom: 7px;
        }

        .team-badge,
        .rank-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            line-height: 1;
        }

        .team-name-big {
            font-size: 19px;
            line-height: 1.3;
            font-weight: 800;
            color: var(--text);
            word-break: break-word;
        }

        .team-inst {
            font-size: 12px;
            color: var(--muted-2);
            margin-top: 4px;
            word-break: break-word;
        }

        /* ---------- Student list ---------- */
        .student-list {
            padding: 5px 22px 7px;
        }

        .student-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 70px;
            padding: 11px 0;
            border-bottom: 1px solid #F1F5F9;
            gap: 16px;
        }

        .student-row:last-child {
            border-bottom: none
        }

        .student-info {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .student-number {
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: #F1F5F9;
            color: #64748B;
            font-size: 12px;
            font-weight: 800;
        }

        .student-name {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
            word-break: break-word;
        }

        .student-sub {
            font-size: 11px;
            color: var(--muted-2);
            margin-top: 2px;
        }

        .btn-download {
            flex: 0 0 auto;
            min-height: 38px;
            background: #F0FDF4;
            color: var(--success);
            border: 1px solid #BBF7D0;
            font-size: 13px;
            padding: 8px 13px;
            border-radius: 10px;
            white-space: nowrap;
        }

        .btn-download:hover {
            background: #DCFCE7;
            border-color: #86EFAC;
            transform: translateY(-1px);
        }

        /* ---------- Empty / error ---------- */
        .no-result {
            text-align: center;
            padding: 60px 24px;
            color: var(--muted-2);
        }

        .no-result i {
            display: block;
            font-size: 44px;
            margin-bottom: 12px;
            opacity: .45;
        }

        .no-result strong {
            display: block;
            color: #475569;
            font-size: 15px;
            margin-bottom: 3px;
        }

        .no-result span {
            font-size: 12px;
        }

        /* ---------- Responsive ---------- */
        @media (max-width:700px) {
            .topbar {
                height: 64px;
                padding: 0 16px
            }

            .topbar img {
                height: 34px
            }

            .topbar-title {
                font-size: 14px
            }

            .back-btn {
                padding: 7px 10px
            }

            .back-btn span {
                display: none
            }

            .wrap {
                width: min(100% - 24px, 620px);
                padding: 38px 0 54px;
            }

            .hero {
                margin-bottom: 22px
            }

            .hero-icon {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                font-size: 22px
            }

            .hero-sub {
                font-size: 13px
            }

            .search-card {
                padding: 16px;
                border-radius: 18px;
            }

            .search-row {
                grid-template-columns: 1fr
            }

            .btn-primary {
                min-height: 46px
            }

            .team-header {
                padding: 17px 16px
            }

            .student-list {
                padding-left: 16px;
                padding-right: 16px
            }

            .student-row {
                align-items: flex-start
            }

            .student-info {
                align-items: flex-start
            }

            .btn-download {
                padding: 8px 10px;
                font-size: 12px
            }
        }

        @media (max-width:440px) {
            .topbar-title {
                display: none
            }

            .topbar {
                justify-content: space-between
            }

            .team-header {
                gap: 9px
            }

            .team-name-big {
                font-size: 17px
            }

            .student-row {
                flex-direction: column;
                align-items: stretch;
                gap: 9px;
                padding: 13px 0;
            }

            .btn-download {
                width: 100%;
                justify-content: center;
            }
        }

        /* ---------- Motion ---------- */
        @keyframes spin {
            from {
                transform: rotate(0deg)
            }

            to {
                transform: rotate(360deg)
            }
        }

        @keyframes riseIn {
            from {
                opacity: 0;
                transform: translateY(8px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .result-card.show {
            animation: riseIn .25s ease both
        }

        @media (prefers-reduced-motion:reduce) {

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }


        /* ===== RCL CERTIFICATE — LAYOUT + CSS ONLY ===== */
        body {
            overflow-x: hidden;
            background:
                radial-gradient(circle at 8% 12%, rgba(59, 130, 246, .11), transparent 25%),
                radial-gradient(circle at 92% 22%, rgba(14, 165, 233, .08), transparent 24%),
                radial-gradient(circle at 50% 100%, rgba(37, 99, 235, .07), transparent 32%),
                linear-gradient(180deg, #F8FBFF 0%, #F2F6FC 52%, #F8FAFD 100%);
        }

        body::before,
        body::after {
            content: "";
            position: fixed;
            pointer-events: none;
            z-index: -1;
            border-radius: 50%;
        }

        body::before {
            width: 420px;
            height: 420px;
            left: -260px;
            top: 180px;
            border: 1px solid rgba(37, 99, 235, .08);
            box-shadow: 0 0 0 55px rgba(37, 99, 235, .025), 0 0 0 110px rgba(37, 99, 235, .018);
        }

        body::after {
            width: 360px;
            height: 360px;
            right: -240px;
            top: 330px;
            border: 1px solid rgba(14, 165, 233, .08);
            box-shadow: 0 0 0 48px rgba(14, 165, 233, .025), 0 0 0 96px rgba(14, 165, 233, .016);
        }

        .topbar {
            height: 78px;
            padding: 0 clamp(22px, 5vw, 64px);
            gap: 18px;
            background: rgba(255, 255, 255, .90);
            border-bottom: 1px solid rgba(226, 232, 240, .9);
            box-shadow: 0 5px 24px rgba(15, 23, 42, .045), 0 1px 0 rgba(255, 255, 255, .9) inset;
        }

        .topbar-brand {
            gap: 14px
        }

        .topbar img {
            height: 42px;
            filter: drop-shadow(0 3px 5px rgba(15, 23, 42, .08))
        }

        .topbar-title {
            position: relative;
            padding-left: 15px;
            font-size: 16px;
            font-weight: 800;
        }

        .topbar-title::before {
            content: "";
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 1px;
            height: 26px;
            background: #D8E1EE;
        }

        .back-btn {
            min-height: 40px;
            padding: 9px 15px;
            border-radius: 12px;
            background: linear-gradient(180deg, #fff, #F8FAFC);
            box-shadow: 0 4px 12px rgba(15, 23, 42, .045), inset 0 1px 0 #fff;
        }

        .back-btn:hover {
            box-shadow: 0 8px 20px rgba(37, 99, 235, .10), inset 0 1px 0 #fff;
        }

        .wrap {
            width: min(1080px, calc(100% - 40px));
            padding: 68px 0 100px;
        }

        .hero {
            position: relative;
            margin-bottom: 34px
        }

        .hero::after {
            content: "";
            width: 70px;
            height: 4px;
            display: block;
            margin: 15px auto 0;
            border-radius: 999px;
            background: linear-gradient(90deg, #60A5FA, #2563EB, #38BDF8);
            box-shadow: 0 4px 12px rgba(37, 99, 235, .20);
        }

        .hero-icon {
            width: 68px;
            height: 68px;
            margin: 0 auto 18px;
            border-radius: 20px;
            background: linear-gradient(145deg, rgba(255, 255, 255, .98), #EAF3FF);
            border: 1px solid #D7E7FF;
            box-shadow: 0 18px 38px rgba(37, 99, 235, .13), 0 4px 10px rgba(15, 23, 42, .04), inset 0 1px 0 rgba(255, 255, 255, .95);
            font-size: 30px;
        }

        .hero-icon i {
            filter: drop-shadow(0 4px 8px rgba(37, 99, 235, .16))
        }

        .hero-title {
            font-size: clamp(32px, 4vw, 42px);
            letter-spacing: -.6px;
            text-shadow: 0 4px 16px rgba(15, 23, 42, .04);
        }

        .hero-sub {
            margin-top: 4px;
            font-size: 15px
        }

        .search-card {
            position: relative;
            padding: 26px;
            margin-bottom: 28px;
            border-radius: 24px;
            border: 1px solid rgba(219, 228, 240, .95);
            background: rgba(255, 255, 255, .91);
            box-shadow: 0 24px 55px rgba(15, 23, 42, .075), 0 7px 20px rgba(37, 99, 235, .045), inset 0 1px 0 rgba(255, 255, 255, .95);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }

        .search-card::before {
            content: "";
            position: absolute;
            left: 24px;
            right: 24px;
            top: 0;
            height: 2px;
            border-radius: 0 0 99px 99px;
            background: linear-gradient(90deg, transparent, #60A5FA, #2563EB, #38BDF8, transparent);
        }

        .search-label {
            font-size: 14px;
            margin-bottom: 11px
        }

        .search-label i {
            width: 26px;
            height: 26px;
            display: grid;
            place-items: center;
            border-radius: 8px;
            background: #EFF6FF;
            color: #2563EB;
        }

        .search-row {
            grid-template-columns: minmax(0, 1fr) 150px;
            gap: 12px
        }

        .fi {
            min-height: 56px;
            border-radius: 14px;
            border-color: #C8D6E8;
            padding-left: 48px;
            box-shadow: inset 0 2px 5px rgba(15, 23, 42, .025), 0 1px 0 rgba(255, 255, 255, .9);
        }

        .fi:hover {
            border-color: #AFC4DE
        }

        .fi:focus {
            border-color: #3B82F6;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .09), 0 7px 18px rgba(37, 99, 235, .06);
        }

        .input-icon {
            left: 17px;
            font-size: 20px;
            color: #8AA0BC
        }

        .btn {
            min-height: 56px;
            border-radius: 14px
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
            box-shadow: 0 12px 25px rgba(37, 99, 235, .24), inset 0 1px 0 rgba(255, 255, 255, .16);
        }

        .btn-primary:hover {
            filter: none;
            transform: translateY(-2px);
            box-shadow: 0 17px 32px rgba(37, 99, 235, .30), inset 0 1px 0 rgba(255, 255, 255, .18);
        }

        .result-card {
            border-radius: 24px;
            border: 1px solid rgba(219, 228, 240, .95);
            box-shadow: 0 22px 50px rgba(15, 23, 42, .07), 0 5px 16px rgba(37, 99, 235, .035);
            background: rgba(255, 255, 255, .94);
            backdrop-filter: blur(12px);
        }

        .team-header {
            padding: 21px 25px;
            background: linear-gradient(135deg, #FFFFFF 0%, #F8FBFF 100%);
        }

        .team-header::before {
            width: 5px;
            background: linear-gradient(180deg, #3B82F6, #2563EB, #38BDF8);
            box-shadow: 0 4px 12px rgba(37, 99, 235, .20);
        }

        .team-name-big {
            font-size: 20px
        }

        .team-badge,
        .rank-badge {
            padding: 6px 11px;
            box-shadow: 0 2px 7px rgba(15, 23, 42, .035);
        }

        .student-list {
            padding: 7px 25px 9px
        }

        .student-row {
            min-height: 74px;
            padding: 13px 0;
            transition: .18s ease
        }

        .student-row:hover {
            padding-left: 7px;
            padding-right: 7px;
            background: #FBFDFF;
        }

        .student-number {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
            border: 1px solid #E2E8F0;
            background: linear-gradient(145deg, #F8FAFC, #EEF3F8);
        }

        .btn-download {
            min-height: 40px;
            border-radius: 11px;
            box-shadow: 0 3px 9px rgba(15, 23, 42, .035);
            transition: .18s ease;
        }

        .btn-download:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(15, 23, 42, .08);
        }

        .no-result {
            padding: 72px 24px
        }

        .no-result i {
            width: 72px;
            height: 72px;
            margin: 0 auto 16px;
            display: grid;
            place-items: center;
            border-radius: 22px;
            background: #F1F5F9;
            border: 1px solid #E2E8F0;
            color: #94A3B8;
            font-size: 34px;
        }

        @media(max-width:700px) {
            .topbar {
                height: 68px;
                padding: 0 16px
            }

            .topbar img {
                height: 36px
            }

            .topbar-title {
                font-size: 14px;
                padding-left: 12px
            }

            .wrap {
                width: min(100% - 24px, 620px);
                padding: 45px 0 65px
            }

            .hero {
                margin-bottom: 25px
            }

            .hero-icon {
                width: 58px;
                height: 58px;
                border-radius: 18px;
                font-size: 26px
            }

            .hero-title {
                font-size: 29px
            }

            .hero-sub {
                font-size: 13px
            }

            .search-card {
                padding: 19px;
                border-radius: 19px
            }

            .search-card::before {
                left: 18px;
                right: 18px
            }

            .search-row {
                grid-template-columns: 1fr
            }

            .fi,
            .btn {
                min-height: 52px
            }

            .result-card {
                border-radius: 19px
            }

            .team-header {
                padding: 18px
            }

            .student-list {
                padding-left: 18px;
                padding-right: 18px
            }
        }

        @media(max-width:440px) {
            .topbar-title {
                display: none
            }

            .topbar {
                justify-content: space-between
            }

            .hero-title {
                font-size: 26px
            }

            .search-card {
                padding: 15px
            }

            .student-row {
                flex-direction: column;
                align-items: stretch;
                gap: 10px
            }

            .btn-download {
                width: 100%;
                justify-content: center
            }
        }
    </style>

</head>

<body>

    <div class="topbar">
        <a href="/" class="topbar-brand">
            <img src="/RCL Logo.png" alt="RCL">
            <div class="topbar-title">ดาวน์โหลดเกียรติบัตร</div>
        </a>
        <div style="flex:1"></div>
        <a href="/" class="back-btn">
            <i class="ti ti-arrow-left"></i><span>กลับหน้าหลัก</span>
        </a>
    </div>

    <div class="wrap">
        <div class="hero">
            <div class="hero-icon"><i class="ti ti-certificate"></i></div>
            <div class="hero-title">ดาวน์โหลด<span>เกียรติบัตร</span></div>
            <div class="hero-sub">ค้นหาด้วย ID ทีม ชื่อทีม หรือชื่อโรงเรียน</div>
        </div>

        <div class="search-card">
            <div class="search-label"><i class="ti ti-search"></i> ค้นหาทีม</div>
            <div class="search-row">
                <div class="input-wrap">
                    <i class="ti ti-search input-icon"></i>
                    <input class="fi" type="text" id="searchInput"
                        placeholder="พิมพ์ ID ทีม / ชื่อทีม / ชื่อโรงเรียน...">
                </div>
                <button class="btn btn-primary" onclick="searchTeam()">
                    <i class="ti ti-search"></i> ค้นหา
                </button>
            </div>
        </div>

        <div class="loading" id="loading">
            <i class="ti ti-loader-2" style="font-size:24px;animation:spin 1s linear infinite"></i>
            <div style="margin-top:8px">กำลังค้นหา...</div>
        </div>

        <div class="result-card" id="resultCard">
            <div id="resultContent"></div>
        </div>
    </div>

    <script>
        var searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') searchTeam();
        });

        function searchTeam() {
            var q = searchInput.value.trim();
            if (!q) return;

            var loading = document.getElementById('loading');
            var resultCard = document.getElementById('resultCard');
            var resultContent = document.getElementById('resultContent');

            loading.style.display = 'block';
            resultCard.classList.remove('show');

            fetch('/certificate/search?q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    loading.style.display = 'none';
                    resultCard.classList.add('show');

                    if (!data.teams || data.teams.length === 0) {
                        resultContent.innerHTML = '<div class="no-result"><i class="ti ti-search-off"></i>ไม่พบทีมที่ค้นหา</div>';
                        return;
                    }

                    var html = '';
                    data.teams.forEach(function (team) {
                        var tierColor = team.tier === 'beginner' ? '#16A34A' : team.tier === 'intermediate' ? '#2563EB' : '#EA580C';
                        var tierLabel = team.tier === 'beginner' ? 'Beginner' : team.tier === 'intermediate' ? 'Intermediate' : 'Advance';

                        var rankLabel = '';
                        var rankEmoji = '';
                        if (team.rank === 1) { rankEmoji = '🥇'; rankLabel = 'อันดับ 1'; }
                        else if (team.rank === 2) { rankEmoji = '🥈'; rankLabel = 'อันดับ 2'; }
                        else if (team.rank === 3) { rankEmoji = '🥉'; rankLabel = 'อันดับ 3'; }

                        html += '<div class="team-block">';
                        html += '<div class="team-header">';
                        html += '<div class="team-meta">';
                        html += '<div class="team-badges">';
                        html += '<span class="team-badge" style="background:' + tierColor + '18;color:' + tierColor + '">' + tierLabel + '</span>';
                        if (rankLabel) {
                            html += '<span class="rank-badge" style="background:#FEF3C7;color:#D97706">' + rankEmoji + ' ' + rankLabel + '</span>';
                        } else {
                            html += '<span class="rank-badge" style="background:#F1F5F9;color:#64748B"><i class="ti ti-certificate"></i> เข้าร่วม</span>';
                        }
                        html += '</div>';
                        html += '<div class="team-name-big">' + team.name + '</div>';
                        html += '<div class="team-inst">' + (team.institution || '') + ' · ' + team.id + '</div>';
                        html += '</div></div>';

                        html += '<div class="student-list">';
                        var students = team.students || [];
                        if (students.length === 0) {
                            html += '<div style="color:#94A3B8;font-size:12px;text-align:center;padding:12px">ไม่มีรายชื่อนักเรียน</div>';
                        }
                        students.forEach(function (s, idx) {
                            html += '<div class="student-row">';
                            html += '<div class="student-info">';
                            html += '<div class="student-number">' + (idx + 1) + '</div>';
                            html += '<div>';
                            html += '<div class="student-name">' + s.name + '</div>';
                            html += '<div class="student-sub">นักเรียนคนที่ ' + (idx + 1) + '</div>';
                            html += '</div>';
                            html += '</div>';
                            team.cert_types.forEach(function (ct) {
                                var ctLabel, ctStyle;
                                if (ct === 'participation') {
                                    ctLabel = 'เกียรติบัตรเข้าร่วม';
                                    ctStyle = 'background:#F0FDF4;color:#16A34A;border:1px solid #BBF7D0';
                                } else if (ct === '1st') {
                                    ctLabel = 'เกียรติบัตรชนะเลิศ';
                                    ctStyle = 'background:linear-gradient(135deg,#FEF3C7,#FDE68A);color:#92400E;border:1px solid #F59E0B;font-weight:800';
                                } else if (ct === '2nd') {
                                    ctLabel = 'เกียรติบัตรรองชนะเลิศ อันดับ 1';
                                    ctStyle = 'background:linear-gradient(135deg,#F1F5F9,#E2E8F0);color:#475569;border:1px solid #94A3B8;font-weight:800';
                                } else if (ct === '3rd') {
                                    ctLabel = 'เกียรติบัตรรองชนะเลิศ อันดับ 2';
                                    ctStyle = 'background:linear-gradient(135deg,#FEF3E2,#FDE8C8);color:#92400E;border:1px solid #CD7F32;font-weight:800';
                                }
                                html += '<a href="/certificate/download?teamId=' + team.id + '&studentName=' + encodeURIComponent(s.name) + '&certType=' + ct + '" target="_blank" class="btn btn-download" style="' + ctStyle + '">';
                                html += '<i class="ti ti-download"></i> ' + ctLabel;
                                html += '</a>';
                            });
                            html += '</a>';
                            html += '</div>';
                        });
                        html += '</div>';
                        html += '</div>';

                        if (data.teams.indexOf(team) < data.teams.length - 1) {
                            html += '';
                        }
                    });

                    resultContent.innerHTML = html;
                })
                .catch(function () {
                    loading.style.display = 'none';
                    resultCard.classList.add('show');
                    resultContent.innerHTML = '<div class="no-result"><i class="ti ti-alert-circle"></i>เกิดข้อผิดพลาด กรุณาลองใหม่</div>';
                });
        }
    </script>
</body>

</html>