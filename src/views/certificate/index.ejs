                <i class="ti ti-shopping-cart"></i>
                <span class="mobile-menu-link-text"><strong>PRE-ORDER
                        MISSION</strong><small>พรีออเดอร์สนามภารกิจ</small></span>
            </a>

            <a href="/certificate" class="mobile-menu-link active" aria-current="page">
                <i class="ti ti-certificate"></i>
                <span class="mobile-menu-link-text"><strong>CERTIFICATE</strong><small>เกียรติบัตร</small></span>
            </a>

            <div class="mobile-menu-divider"></div>

            <a href="/auth/login" class="mobile-menu-link mobile-login">
                <i class="ti ti-lock"></i>
                <span class="mobile-menu-link-text"><strong>เข้าสู่ระบบ</strong><small>Login</small></span>
            </a>
        </div>
    </header>

    <main class="wrap">
        <div class="hero">
            <div class="hero-icon" aria-hidden="true"><i class="ti ti-certificate"></i></div>
            <h1 class="hero-title">ดาวน์โหลด<span>เกียรติบัตร</span></h1>
            <div class="hero-sub">ค้นหาด้วย ID ทีม ชื่อทีม หรือชื่อโรงเรียน</div>
        </div>

        <form class="search-card" id="searchForm" role="search">
            <div class="search-row">
                <label class="search-input-wrap">
                    <i class="ti ti-search"></i>
                    <input type="search" id="searchInput" placeholder="พิมพ์ ID ทีม / ชื่อทีม / ชื่อโรงเรียน..."
                        autocomplete="off" aria-label="ค้นหาทีม">
                </label>
                <button type="submit" class="btn-search" id="searchBtn">
                    <i class="ti ti-search"></i> ค้นหา
                </button>
            </div>
        </form>

        <div class="loading" id="loading" role="status">
            <i class="ti ti-loader-2"></i>
            กำลังค้นหา...
        </div>

        <div class="result-list" id="resultList" aria-live="polite"></div>
    </main>

    <script>
        /* ================= CERTIFICATE SEARCH ================= */
        (function () {
            var form = document.getElementById('searchForm');
            var input = document.getElementById('searchInput');
            var btn = document.getElementById('searchBtn');
            var loading = document.getElementById('loading');
            var resultList = document.getElementById('resultList');

            var TIERS = {
                beginner: 'Beginner',
                intermediate: 'Intermediate',
                advance: 'Advance'
            };
            var RANKS = { 1: '🥇 อันดับ 1', 2: '🥈 อันดับ 2', 3: '🥉 อันดับ 3' };
            var RANK_CERTS = {
                '1st': { backend: 'rank_1', cls: 'btn-1st', label: '🥇 เกียรติบัตรชนะเลิศ' },
                '2nd': { backend: 'rank_2', cls: 'btn-2nd', label: '🥈 รองชนะเลิศ อันดับ 1' },
                '3rd': { backend: 'rank_3', cls: 'btn-3rd', label: '🥉 รองชนะเลิศ อันดับ 2' }
            };
            var MEDALS = {
                gold: { cls: 'medal-gold', title: '🥇 คุณได้รับเกียรติบัตรทอง', btn: 'ดาวน์โหลดเกียรติบัตรทอง' },
                silver: { cls: 'medal-silver', title: '🥈 คุณได้รับเกียรติบัตรเงิน', btn: 'ดาวน์โหลดเกียรติบัตรเงิน' },
                bronze: { cls: 'medal-bronze', title: '🥉 คุณได้รับเกียรติบัตรทองแดง', btn: 'ดาวน์โหลดเกียรติบัตรทองแดง' }
            };

            /* Names come from public registration — always escape before putting into HTML */
            function esc(v) {
                return String(v == null ? '' : v)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function qs(params) {
                return Object.keys(params).map(function (k) {
                    return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
                }).join('&');
            }

            function pick(obj, keys, fallback) {
                for (var i = 0; i < keys.length; i++) {
                    if (obj[keys[i]] !== undefined && obj[keys[i]] !== null) return obj[keys[i]];
                }
                return fallback;
            }

            function medalHtml(team) {
                var medalKey = pick(team, ['medal', 'medal_type', 'medalType'], '');
                var medal = MEDALS[medalKey] || (medalKey ? MEDALS.bronze : null);
                if (!medal) return '';

                var best = Number(pick(team, ['bestScore', 'best_score', 'score'], 0)) || 0;
                var max = Number(pick(team, ['maxScore', 'max_score'], 0)) || 0;
                var label = pick(team, ['medalLabel', 'medal_label', 'medalName'], '');
                var percent = max > 0 ? Math.round(best / max * 100) : 0;
                var info = 'คะแนน ' + best + ' / ' + max + ' คะแนน (' + percent + '%)' + (label ? ' — ' + label : '');

                return '<div class="medal-cert ' + medal.cls + '">' +
                    '<div class="medal-cert-info">' +
                    '<div class="medal-cert-title">' + medal.title + '</div>' +
                    '<div class="medal-cert-score">' + esc(info) + '</div>' +
                    '</div>' +
                    '<a class="btn-medal" target="_blank" rel="noopener" href="/certificate/download?' +
                    qs({ team_id: team.id, type: medalKey }) + '">' +
                    '<i class="ti ti-download"></i> ' + medal.btn + '</a>' +
                    '</div>';
            }

            function studentHtml(team, s, i, medalBlock) {
                var html = '<div class="student-row">' +
                    '<div class="student-num">' + (i + 1) + '</div>' +
                    '<div class="student-info">' +
                    '<div class="student-name">' + esc(s.name) + '</div>' +
                    '<div class="student-sub">นักเรียนคนที่ ' + (i + 1) + '</div>' +
                    '</div>' +
                    '<div class="cert-btns">';

                if (s.checked_in) {
                    html += '<a class="btn-cert btn-participation" target="_blank" rel="noopener" href="/certificate/download?' +
                        qs({ teamId: team.id, studentName: s.name, certType: 'participation' }) + '">' +
                        '<i class="ti ti-download"></i> เกียรติบัตรเข้าร่วม</a>';

                    (team.team_cert_types || []).forEach(function (ct) {
                        var rc = RANK_CERTS[ct] || { backend: ct, cls: 'btn-3rd', label: ct };
                        html += '<a class="btn-cert ' + rc.cls + '" target="_blank" rel="noopener" href="/certificate/download?' +
                            qs({ teamId: team.id, studentName: s.name, certType: rc.backend }) + '">' +
                            '<i class="ti ti-download"></i> ' + esc(rc.label) + '</a>';
                    });
                } else {
                    html += '<span class="not-checked"><i class="ti ti-clock"></i> ไม่ได้เข้าร่วมงานแข่งขัน</span>';
                }

                html += '</div>' + medalBlock + '</div>';
                return html;
            }

            function teamHtml(team) {
                var tierKey = TIERS[team.tier] ? team.tier : 'advance';
                var students = team.students || [];
                var medalBlock = medalHtml(team);
                var sub = [team.institution, team.id].filter(Boolean).map(esc).join(' · ');

                var html = '<article class="team-card tier-' + tierKey + '">' +
                    '<div class="team-header">' +
                    '<div class="team-badges">' +
                    '<span class="badge badge-tier">' + TIERS[tierKey] + '</span>' +
                    (RANKS[team.rank] ? '<span class="badge badge-rank">' + RANKS[team.rank] + '</span>' : '') +
                    '</div>' +
                    '<div class="team-name">' + esc(team.name) + '</div>' +
                    '<div class="team-sub">' + sub + '</div>' +
                    '</div>';

                if (students.length === 0) {
                    html += '<div class="empty-row">ไม่มีรายชื่อนักเรียน</div>';
                } else {
                    students.forEach(function (s, i) { html += studentHtml(team, s, i, medalBlock); });
                }

                return html + '</article>';
            }

            function showMessage(icon, text) {
                resultList.innerHTML = '<div class="no-result"><i class="ti ' + icon + '"></i>' + text + '</div>';
            }

            function searchTeam() {
                var q = input.value.trim();
                if (!q) { input.focus(); return; }

                loading.classList.add('show');
                btn.disabled = true;
                resultList.innerHTML = '';

                fetch('/certificate/search?q=' + encodeURIComponent(q))
                    .then(function (r) {
                        if (!r.ok) throw new Error('Search request failed: ' + r.status);
                        return r.json();
                    })
                    .then(function (data) {
                        var teams = (data && data.teams) || [];
                        if (teams.length === 0) return showMessage('ti-search-off', 'ไม่พบทีมที่ค้นหา');
                        resultList.innerHTML = teams.map(teamHtml).join('');
                    })
                    .catch(function (error) {
                        console.error('Certificate search error:', error);
                        showMessage('ti-alert-circle', 'เกิดข้อผิดพลาด กรุณาลองใหม่');
                    })
                    .then(function () {
                        loading.classList.remove('show');
                        btn.disabled = false;
                    });
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                searchTeam();
            });
        })();

        /* Mobile / tablet hamburger menu */
        (function () {
            var toggle = document.querySelector('.mobile-menu-toggle');
            var mobileMenu = document.querySelector('.mobile-menu');
            var competitionToggle = document.querySelector('.mobile-menu-competition-toggle');
            var subMenu = document.querySelector('.mobile-submenu');
            if (!toggle || !mobileMenu) return;

            function closeMobileMenu() {
                toggle.classList.remove('is-open');
                toggle.setAttribute('aria-expanded', 'false');
                toggle.setAttribute('aria-label', 'เปิดเมนู');
                mobileMenu.classList.remove('is-open');
                mobileMenu.setAttribute('aria-hidden', 'true');
            }

            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = mobileMenu.classList.toggle('is-open');
                toggle.classList.toggle('is-open', isOpen);
                toggle.setAttribute('aria-expanded', String(isOpen));
                toggle.setAttribute('aria-label', isOpen ? 'ปิดเมนู' : 'เปิดเมนู');
                mobileMenu.setAttribute('aria-hidden', String(!isOpen));
            });

            if (competitionToggle && subMenu) {
                competitionToggle.addEventListener('click', function () {
                    var isOpen = subMenu.classList.toggle('is-open');
                    competitionToggle.classList.toggle('is-open', isOpen);
                    competitionToggle.setAttribute('aria-expanded', String(isOpen));
                });
            }

            mobileMenu.querySelectorAll('a').forEach(function (link) {
                link.addEventListener('click', closeMobileMenu);
            });

            document.addEventListener('click', function (e) {
                if (!mobileMenu.contains(e.target) && !toggle.contains(e.target)) closeMobileMenu();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeMobileMenu();
            });

            window.addEventListener('resize', function () {
                if (window.innerWidth > 1100) closeMobileMenu();
            });
        })();

        /* Desktop dropdown (hover with small delay, click also works) */
        document.querySelectorAll('.dropdown').forEach(function (dd) {
            var menu = dd.querySelector('.dropdown-menu');
            var btn = dd.querySelector('button');
            var timer;

            function show() { clearTimeout(timer); menu.style.display = 'block'; }
            function hideSoon() { timer = setTimeout(function () { menu.style.display = 'none'; }, 200); }

            dd.addEventListener('mouseenter', show);
            dd.addEventListener('mouseleave', hideSoon);
            btn.addEventListener('click', function () {
                menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
            });
        });
    </script>

</body>

</html>