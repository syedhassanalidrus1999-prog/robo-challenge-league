<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ดาวน์โหลดเกียรติบัตร — Robo Challenge League</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&family=Kanit:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Kanit;
            background: radial-gradient(circle at 12% 18%, rgba(37, 99, 235, .10), transparent 24%), radial-gradient(circle at 88% 78%, rgba(14, 165, 233, .08), transparent 24%), linear-gradient(180deg, #F7FAFF, #F3F7FC);
            color: #1E293B;
            min-height: 100vh;
        }

        /* RCL 2026 — MASTER TOPBAR */
        .topbar {
            position: fixed;
            inset: 0 0 auto 0;
            z-index: 1000;
            width: 100%;
            height: 84px;
            padding: 0 30px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-sizing: border-box;
            background: transparent;
            border-bottom: 1px solid transparent;
            transition: background .25s ease, border-color .25s ease, box-shadow .25s ease
        }

        .topbar.scrolled {
            background: #fff;
            border-bottom-color: #E2E8F0;
            box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px)
        }

        .topbar-logo {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center
        }

        .topbar-logo img {
            display: block;
            width: auto;
            max-width: 130px;
            height: 120px;
            object-fit: contain
        }

        .topbar-nav {
            flex: 1 1 auto;
            min-width: 0;
            margin-left: 18px;
            display: flex;
            align-items: center;
            gap: 6px
        }

        .nav-link {
            min-height: 52px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 4px;
            flex: 0 0 auto;
            border: 0 !important;
            border-radius: 11px;
            background: transparent !important;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
            transition: color .2s ease, background .2s ease, transform .2s ease
        }

        .nav-link span:first-child {
            font-size: 16px;
            line-height: 1.05;
            font-weight: 700;
            letter-spacing: 1px
        }

        .nav-link span:last-child {
            font-size: 13px;
            line-height: 1.05;
            font-weight: 500
        }

        .nav-link i {
            font-size: 17px
        }

        .nav-link:hover {
            color: #2563EB;
            background: #F4F8FF !important;
            transform: translateY(-1px)
        }

        .certificate-btn {
            background: linear-gradient(135deg, #FFF7D6, #FEF3C7) !important;
            color: #92400E !important;
            border: 1px solid #FCD34D !important;
            border-radius: 90px !important;
            box-shadow: 0 4px 12px rgba(180, 120, 20, .18)
        }

        .topbar-actions {
            flex: 0 0 auto;
            margin-left: auto;
            display: flex;
            align-items: center
        }

        .btn-login {
            min-height: 52px;
            padding: 0 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 11px;
            font: 800 16px 'Sarabun', sans-serif;
            text-decoration: none;
            white-space: nowrap;
            color: #334155;
            background: #fff;
            border: 1px solid #E2E8F0;
            transition: all .2s ease
        }

        .btn-login:hover {
            color: #2563EB;
            background: #F8FAFC;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(15, 23, 42, .07)
        }

        .dropdown {
            position: relative
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            z-index: 1100;
            display: none;
            min-width: 215px;
            padding: 8px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
            backdrop-filter: blur(14px)
        }

        .dropdown-item {
            min-height: 44px;
            padding: 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 10px;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none
        }

        .dropdown-item:hover {
            color: #2563EB;
            background: #EFF6FF
        }

        .mobile-menu-toggle {
            display: none;
            position: relative;
            z-index: 1202;
            flex: 0 0 44px;
            width: 44px;
            height: 44px;
            padding: 0;
            margin-left: auto;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(148, 163, 184, .35);
            border-radius: 12px;
            background: rgba(255, 255, 255, .96);
            color: #334155;
            box-shadow: 0 6px 18px rgba(15, 23, 42, .07);
            cursor: pointer
        }

        .mobile-menu-toggle i {
            font-size: 25px
        }

        .mobile-menu-toggle.is-open {
            color: #2563EB;
            background: #EFF6FF;
            border-color: #BFDBFE
        }

        .mobile-menu {
            display: none;
            position: fixed;
            top: 94px;
            left: 12px;
            right: 12px;
            z-index: 1201;
            max-height: calc(100dvh - 106px);
            overflow-y: auto;
            padding: 8px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #DBEAFE;
            border-radius: 17px;
            box-shadow: 0 20px 50px rgba(15, 23, 42, .16);
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px) scale(.985);
            transition: .18s ease
        }

        .mobile-menu.is-open {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            pointer-events: auto !important;
            transform: none
        }

        .mobile-menu-item {
            width: 100%;
            min-height: 52px;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 11px;
            border: 0;
            border-radius: 11px;
            background: transparent;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            text-decoration: none;
            text-align: left;
            cursor: pointer
        }

        .mobile-menu-item:hover {
            background: #F4F8FF;
            color: #2563EB
        }

        .mobile-menu-item>i:first-child {
            width: 28px;
            min-width: 28px;
            text-align: center;
            font-size: 20px;
            color: #64748B
        }

        .mobile-menu-item>span {
            min-width: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
            line-height: 1.1
        }

        .mobile-menu-item b {
            font-size: 15px;
            font-weight: 800
        }

        .mobile-menu-item small {
            margin-top: 3px;
            font-size: 11px;
            color: #94A3B8
        }

        .mobile-menu-arrow {
            font-size: 18px !important;
            color: #94A3B8 !important;
            transition: transform .2s
        }

        .mobile-competition-toggle.is-open {
            background: #EFF6FF;
            color: #2563EB
        }

        .mobile-competition-toggle.is-open .mobile-menu-arrow {
            transform: rotate(180deg)
        }

        .mobile-submenu {
            display: none;
            margin: 0 8px 6px 51px;
            padding: 5px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 12px
        }

        .mobile-submenu.is-open {
            display: block
        }

        .mobile-submenu-item {
            min-height: 42px;
            padding: 0 10px;
            display: flex;
            align-items: center;
            gap: 9px;
            border-radius: 8px;
            color: #475569;
            font: 700 13px 'Kanit', 'Sarabun', sans-serif;
            text-decoration: none
        }

        .mobile-submenu-item:hover {
            color: #2563EB;
            background: #EFF6FF
        }

        .mobile-login-item {
            margin-top: 4px;
            border-top: 1px solid #EEF2F6
        }

        @media (min-width:901px) and (max-width:1199px) {
            .topbar {
                height: 78px;
                padding: 0 20px
            }

            .topbar-logo img {
                height: 96px;
                max-width: 112px
            }

            .topbar-nav {
                margin-left: 8px;
                gap: 2px
            }

            .nav-link {
                min-height: 48px;
                padding: 0 10px
            }

            .nav-link span:first-child {
                font-size: 14px
            }

            .nav-link span:last-child {
                font-size: 11px
            }

            .btn-login {
                min-height: 48px;
                padding: 0 14px;
                font-size: 14px
            }
        }

        @media (min-width:641px) and (max-width:900px) {
            .topbar {
                height: 72px;
                padding: 0 16px
            }

            .topbar-logo img {
                height: 76px;
                max-width: 92px
            }

            .topbar-nav {
                margin-left: 4px;
                gap: 1px
            }

            .nav-link {
                min-height: 46px;
                padding: 0 8px
            }

            .nav-link span:first-child {
                font-size: 12px
            }

            .nav-link span:last-child {
                font-size: 10px
            }

            .btn-login {
                min-height: 44px;
                padding: 0 11px;
                font-size: 13px
            }
        }

        @media (max-width:640px) {
            .topbar {
                height: 62px;
                padding: 0 12px;
                background: rgba(255, 255, 255, .94);
                border-bottom-color: #E2E8F0;
                box-shadow: 0 4px 18px rgba(15, 23, 42, .07)
            }

            .topbar-logo img {
                height: 44px;
                max-width: 86px
            }

            .topbar-nav,
            .topbar-actions {
                display: none !important
            }

            .mobile-menu-toggle {
                display: inline-flex !important
            }

            .mobile-menu {
                top: 72px
            }
        }

        @media (max-width:430px) {
            .topbar {
                height: 60px;
                padding: 0 9px
            }

            .topbar-logo img {
                height: 40px;
                max-width: 76px
            }

            .mobile-menu-toggle {
                width: 42px;
                height: 42px
            }

            .mobile-menu {
                top: 70px;
                left: 9px;
                right: 9px
            }
        }

        .wrap {
            width: min(900px, 92%);
            margin: 0 auto;
            padding: 118px 0 72px;
        }

        .hero {
            text-align: center;
            margin-bottom: 32px;
        }

        .hero-title {
            font-size: 40px;
            font-weight: 900;
            color: #0F172A;
            font-family: 'Kanit', sans-serif;
            margin-bottom: 6px;
        }

        .hero-title span {
            color: #2563EB;
        }

        .hero-sub {
            font-size: 18px;
            color: #64748B;
        }

        .hero-line {
            width: 48px;
            height: 3px;
            background: linear-gradient(90deg, #2563EB, #7C3AED);
            border-radius: 999px;
            margin: 12px auto 0;
        }

        .search-card {
            background: #fff;
            border: 1px solid #E2E8F0;
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
            margin-bottom: 22px
        }

        .search-row {
            display: flex;
            gap: 10px;
        }

        .search-input-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1.5px solid #E2E8F0;
            border-radius: 12px;
            padding: 10px 14px;
            background: #F8FAFC;
            transition: .15s;
        }

        .search-input-wrap:focus-within {
            border-color: #2563EB;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .1);
        }

        .search-input-wrap i {
            color: #94A3B8;
            font-size: 18px;
        }

        .search-input-wrap input {
            border: none;
            outline: none;
            font-size: 14px;
            font-family: 'Sarabun', sans-serif;
            background: transparent;
            flex: 1;
        }

        .btn-search {
            background: #2563EB;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 700;
            font-family: 'Sarabun', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            transition: .15s;
            box-shadow: 0 4px 12px rgba(37, 99, 235, .25);
        }

        .btn-search:hover {
            background: #1D4ED8;
        }

        .result-card {
            background: #fff;
            border: 1px solid #E2E8F0;
            border-radius: 18px;
            box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
            overflow: hidden;
            display: none
        }

        .result-card.show {
            display: block;
        }

        .team-header {
            padding: 16px 20px;
            border-bottom: 1px solid #F1F5F9;
        }

        .team-badges {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            flex-wrap: wrap;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
        }

        .team-name {
            font-size: 20px;
            font-weight: 900;
            color: #0F172A;
        }

        .team-sub {
            font-size: 12px;
            color: #94A3B8;
            margin-top: 2px;
        }

        .student-list {
            padding: 4px 0;
        }

        .student-row {
            display: flex;
            align-items: center;
            padding: 14px 20px;
            border-bottom: 1px solid #F8FAFC;
            gap: 14px;
        }

        .student-row:last-child {
            border-bottom: none;
        }

        .student-num {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #F1F5F9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 800;
            color: #64748B;
            flex-shrink: 0;
        }

        .student-info {
            flex: 1;
        }

        .student-name {
            font-size: 15px;
            font-weight: 700;
            color: #0F172A;
        }

        .student-sub {
            font-size: 11px;
            color: #94A3B8;
            margin-top: 1px;
        }

        .cert-btns {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .btn-cert {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 700;
            font-family: 'Sarabun', sans-serif;
            text-decoration: none;
            transition: .15s;
            border: none;
            cursor: pointer;
            white-space: nowrap;
        }

        .btn-participation {
            font-family: Kanit;
            background: #F0FDF4;
            color: #16A34A;
            border: 1.5px solid #BBF7D0;
        }

        .btn-participation:hover {
            background: #DCFCE7;
            transform: translateY(-1px);
        }

        .btn-1st {
            background: linear-gradient(135deg, #FEF9C3, #FDE68A);
            color: #92400E;
            border: 1.5px solid #F59E0B;
        }

        .btn-1st:hover {
            opacity: .85;
            transform: translateY(-1px);
        }

        .btn-2nd {
            font-family: Kanit;
            background: linear-gradient(135deg, #F1F5F9, #E2E8F0);
            color: #475569;
            border: 1.5px solid #94A3B8;
        }

        .btn-2nd:hover {
            opacity: .85;
            transform: translateY(-1px);
        }

        .btn-3rd {
            background: linear-gradient(135deg, #FEF3E2, #FDE8C8);
            color: #92400E;
            border: 1.5px solid #CD7F32;
        }

        .btn-3rd:hover {
            opacity: .85;
            transform: translateY(-1px);
        }

        .not-checked {
            font: size 15px;
            px;
            color: #94A3B8;
            font-style: italic;
        }

        .no-result {
            text-align: center;
            padding: 48px 24px;
            color: #94A3B8;
        }

        .no-result i {
            display: block;
            font-size: 40px;
            margin-bottom: 10px;
            opacity: .3;
        }

        .loading {
            text-align: center;
            padding: 28px;
            color: #64748B;
            display: none;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        @media (max-width:640px) {
            .wrap {
                width: calc(100% - 24px);
                padding: 92px 0 48px
            }

            .hero {
                margin-bottom: 22px
            }

            .hero-title {
                font-size: 27px
            }

            .search-card {
                padding: 14px
            }

            .search-row {
                flex-direction: column
            }

            .search-input-wrap,
            .btn-search {
                width: 100%
            }

            .btn-search {
                justify-content: center
            }

            .team-header {
                padding: 16px
            }

            .student-row {
                align-items: flex-start;
                padding: 14px 16px;
                gap: 10px;
                flex-wrap: wrap
            }

            .cert-btns {
                width: 100%;
                justify-content: flex-start;
                padding-left: 40px
            }

            .btn-cert {
                white-space: normal;
                text-align: left
            }
        }
    </style>
</head>

<body>
    <div class="topbar">
        <a href="/" class="topbar-logo"><img src="/RCL Logo.png" alt="RCL"></a>
        <nav class="topbar-nav">
            <a href="/" class="nav-link"><span>HOME</span><span>หน้าหลัก</span></a>
            <a href="/#about" class="nav-link"><span>ABOUT US</span><span>เกี่ยวกับเรา</span></a>
            <div class="dropdown">
                <button class="nav-link" type="button"><span>COMPETITION</span><span>การแข่งขัน <i
                            class="ti ti-chevron-down"></i></span></button>
                <div class="dropdown-menu">
                    <a href="/#tiers" class="dropdown-item"><i class="ti ti-pencil-plus"></i>สมัครแข่งขัน</a>
                    <a href="/competition?view=teams" class="dropdown-item"><i class="ti ti-users"></i>ทีมที่สมัคร</a>
                    <a href="/competition?view=board" class="dropdown-item"><i
                            class="ti ti-chart-bar"></i>ผลสรุปคะแนน</a>
                </div>
            </div>
            <a href="/docs" class="nav-link"><span>DOCUMENT</span><span>เอกสาร</span></a>
            <a href="/preorder" class="nav-link"><span>PRE-ORDER MISSION</span><span>พรีออเดอร์สนามภารกิจ</span></a>
            <a href="/certificate" class="nav-link certificate-btn"
                target="_blank"><span>CERTIFICATE</span><span>เกียรติบัตร</span></a>
        </nav>
        <button class="mobile-menu-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false"><i
                class="ti ti-menu-2"></i></button>
        <div class="mobile-menu" id="mobileMenu">
            <a href="/" class="mobile-menu-item"><i
                    class="ti ti-home-2"></i><span><b>HOME</b><small>หน้าหลัก</small></span></a>
            <a href="/#about" class="mobile-menu-item"><i class="ti ti-users"></i><span><b>ABOUT
                        US</b><small>เกี่ยวกับเรา</small></span></a>
            <button class="mobile-menu-item mobile-competition-toggle" type="button" aria-expanded="false"><i
                    class="ti ti-trophy"></i><span><b>COMPETITION</b><small>การแข่งขัน</small></span><i
                    class="ti ti-chevron-down mobile-menu-arrow"></i></button>
            <div class="mobile-submenu" id="mobileCompetitionSubmenu">
                <a href="/#tiers" class="mobile-submenu-item"><i class="ti ti-pencil-plus"></i>สมัครแข่งขัน</a>
                <a href="/competition?view=teams" class="mobile-submenu-item"><i class="ti ti-users"></i>ทีมที่สมัคร</a>
                <a href="/competition?view=board" class="mobile-submenu-item"><i
                        class="ti ti-chart-bar"></i>ผลสรุปคะแนน</a>
            </div>
            <a href="/docs" class="mobile-menu-item"><i
                    class="ti ti-file-text"></i><span><b>DOCUMENT</b><small>เอกสาร</small></span></a>
            <a href="/preorder" class="mobile-menu-item"><i class="ti ti-shopping-cart"></i><span><b>PRE-ORDER
                        MISSION</b><small>พรีออเดอร์สนามภารกิจ</small></span></a>
            <a href="/certificate" class="mobile-menu-item" target="_blank"><i
                    class="ti ti-award"></i><span><b>CERTIFICATE</b><small>เกียรติบัตร</small></span></a>
            <a href="/auth/login" class="mobile-menu-item mobile-login-item"><i
                    class="ti ti-lock"></i><span><b>LOGIN</b><small>เข้าสู่ระบบ</small></span></a>
        </div>
        <div class="topbar-actions"><a href="/auth/login" class="btn-login"><i
                    class="ti ti-lock"></i><span>เข้าสู่ระบบ</span></a></div>
    </div>

    <div class="wrap">
        <div class="hero">
            <div class="hero-title">ดาวน์โหลด<span>เกียรติบัตร</span></div>
            <div class="hero-sub">ค้นหาด้วย ID ทีม ชื่อทีม หรือชื่อโรงเรียน</div>
            <div class="hero-line"></div>
        </div>

        <div class="search-card">
            <div class="search-row">
                <div class="search-input-wrap">
                    <i class="ti ti-search"></i>
                    <input type="text" id="searchInput" placeholder="พิมพ์ ID ทีม / ชื่อทีม / ชื่อโรงเรียน...">
                </div>
                <button class="btn-search" onclick="searchTeam()">
                    <i class="ti ti-search"></i> ค้นหา
                </button>
            </div>
        </div>

        <div class="loading" id="loading">
            <i class="ti ti-loader-2"
                style="font-size:28px;animation:spin 1s linear infinite;display:block;margin-bottom:8px"></i>
            กำลังค้นหา...
        </div>

        <div class="result-card" id="resultCard">
            <div id="resultContent"></div>
        </div>
    </div>

    <script>
        document.getElementById('searchInput').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') searchTeam();
        });

        function searchTeam() {
            var q = document.getElementById('searchInput').value.trim();
            if (!q) return;
            var loading = document.getElementById('loading');
            var resultCard = document.getElementById('resultCard');
            var resultContent = document.getElementById('resultContent');

            loading.style.display = 'block';
            resultCard.classList.remove('show');

            fetch('/certificate/search?q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    loading.style.display = 'none';
                    resultCard.classList.add('show');

                    if (!data.teams || data.teams.length === 0) {
                        resultContent.innerHTML = '<div class="no-result"><i class="ti ti-search-off"></i>ไม่พบทีมที่ค้นหา</div>';
                        return;
                    }

                    var html = '';
                    for (var ti = 0; ti < data.teams.length; ti++) {
                        var team = data.teams[ti];
                        var tierColor = team.tier === 'beginner' ? '#16A34A' : team.tier === 'intermediate' ? '#2563EB' : '#EA580C';
                        var tierLabel = team.tier === 'beginner' ? 'Beginner' : team.tier === 'intermediate' ? 'Intermediate' : 'Advance';

                        var rankLabel = '';
                        var rankEmoji = '';
                        if (team.rank === 1) { rankEmoji = '🥇'; rankLabel = 'อันดับ 1'; }
                        else if (team.rank === 2) { rankEmoji = '🥈'; rankLabel = 'อันดับ 2'; }
                        else if (team.rank === 3) { rankEmoji = '🥉'; rankLabel = 'อันดับ 3'; }

                        // Team header
                        html += '<div class="team-header">';
                        html += '<div class="team-badges">';
                        html += '<span class="badge" style="background:' + tierColor + '18;color:' + tierColor + '">' + tierLabel + '</span>';
                        if (rankLabel) {
                            html += '<span class="badge" style="background:#FEF3C7;color:#D97706">' + rankEmoji + ' ' + rankLabel + '</span>';
                        }
                        html += '</div>';
                        html += '<div class="team-name">' + team.name + '</div>';
                        html += '<div class="team-sub">' + (team.institution || '') + ' · ' + team.id + '</div>';
                        html += '</div>';

                        // Students
                        html += '<div class="student-list">';
                        var students = team.students || [];

                        if (students.length === 0) {
                            html += '<div style="padding:20px;text-align:center;color:#94A3B8;font-size:13px">ไม่มีรายชื่อนักเรียน</div>';
                        }

                        for (var si = 0; si < students.length; si++) {
                            var s = students[si];
                            html += '<div class="student-row">';
                            html += '<div class="student-num">' + (si + 1) + '</div>';
                            html += '<div class="student-info"><div class="student-name">' + s.name + '</div><div class="student-sub">นักเรียนคนที่ ' + (si + 1) + '</div></div>';
                            html += '<div class="cert-btns">';

                            if (s.checked_in) {
                                // เกียรติบัตรเข้าร่วม (เฉพาะคนที่เช็คชื่อ)
                                html += '<a href="/certificate/download?teamId=' + team.id + '&studentName=' + encodeURIComponent(s.name) + '&certType=participation" target="_blank" class="btn-cert btn-participation">';
                                html += '<i class="ti ti-download"></i> เกียรติบัตรเข้าร่วม';
                                html += '</a>';
                                for (var ci = 0; ci < team.team_cert_types.length; ci++) {
                                    var ct = team.team_cert_types[ci];
                                    var ctClass = ct === '1st' ? 'btn-1st' : ct === '2nd' ? 'btn-2nd' : 'btn-3rd';
                                    var ctLabel = ct === '1st' ? '🥇 เกียรติบัตรชนะเลิศ' : ct === '2nd' ? '🥈 รองชนะเลิศ อันดับ 1' : '🥉 รองชนะเลิศ อันดับ 2';
                                    html += '<a href="/certificate/download?teamId=' + team.id + '&studentName=' + encodeURIComponent(s.name) + '&certType=' + ct + '" target="_blank" class="btn-cert ' + ctClass + '">';
                                    html += '<i class="ti ti-download"></i> ' + ctLabel;
                                    html += '</a>';
                                }
                            } else {
                                html += '<span class="not-checked"><i class="ti ti-clock"></i>ไม่ได้เข้ารวมงานแข่งขัน</span>';
                            }

                            // เกียรติบัตรอันดับ (ทุกคนในทีมได้)


                            html += '</div></div>';
                        }

                        html += '</div>';

                        if (ti < data.teams.length - 1) {
                            html += '<div style="height:1px;background:#F1F5F9"></div>';
                        }
                    }

                    resultContent.innerHTML = html;
                })
                .catch(function () {
                    loading.style.display = 'none';
                    resultCard.classList.add('show');
                    resultContent.innerHTML = '<div class="no-result"><i class="ti ti-alert-circle"></i>เกิดข้อผิดพลาด กรุณาลองใหม่</div>';
                });
        }
    </script>

    <script>
        (function () {
            var topbar = document.querySelector('.topbar');
            var toggle = document.querySelector('.mobile-menu-toggle');
            var menu = document.getElementById('mobileMenu');
            var competition = document.querySelector('.mobile-competition-toggle');
            var submenu = document.getElementById('mobileCompetitionSubmenu');

            function updateTopbar() {
                if (topbar) topbar.classList.toggle('scrolled', window.scrollY > 10);
            }

            function setMobile(open) {
                if (!toggle || !menu) return;
                menu.classList.toggle('is-open', open);
                toggle.classList.toggle('is-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                toggle.setAttribute('aria-label', open ? 'ปิดเมนู' : 'เปิดเมนู');
                toggle.innerHTML = open ? '<i class="ti ti-x"></i>' : '<i class="ti ti-menu-2"></i>';
                if (!open && competition && submenu) {
                    competition.classList.remove('is-open');
                    competition.setAttribute('aria-expanded', 'false');
                    submenu.classList.remove('is-open');
                }
            }

            document.querySelectorAll('.dropdown').forEach(function (dd) {
                var trigger = dd.querySelector('.nav-link');
                var dropdown = dd.querySelector('.dropdown-menu');
                if (!trigger || !dropdown) return;
                trigger.addEventListener('click', function (e) {
                    if (window.innerWidth <= 640) return;
                    e.preventDefault();
                    dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
                });
                var closeTimer;
                dd.addEventListener('mouseenter', function () {
                    if (window.innerWidth > 640) { clearTimeout(closeTimer); dropdown.style.display = 'block'; }
                });
                dd.addEventListener('mouseleave', function () {
                    if (window.innerWidth > 640) { closeTimer = setTimeout(function () { dropdown.style.display = 'none'; }, 350); }
                });
                dropdown.addEventListener('mouseenter', function () {
                    clearTimeout(closeTimer); dropdown.style.display = 'block';
                });
                dropdown.addEventListener('mouseleave', function () {
                    if (window.innerWidth > 640) { closeTimer = setTimeout(function () { dropdown.style.display = 'none'; }, 350); }
                });
            });

            if (toggle) toggle.addEventListener('click', function (e) {
                e.preventDefault(); e.stopPropagation(); setMobile(!menu.classList.contains('is-open'));
            });

            if (competition && submenu) competition.addEventListener('click', function (e) {
                e.preventDefault(); e.stopPropagation();
                var open = submenu.classList.toggle('is-open');
                competition.classList.toggle('is-open', open);
                competition.setAttribute('aria-expanded', open ? 'true' : 'false');
            });

            if (menu) menu.querySelectorAll('a').forEach(function (link) {
                link.addEventListener('click', function () { setMobile(false) });
            });

            document.addEventListener('click', function (e) {
                if (window.innerWidth <= 640 && menu && menu.classList.contains('is-open') && !menu.contains(e.target) && !toggle.contains(e.target)) setMobile(false);
            });

            window.addEventListener('resize', function () { if (window.innerWidth > 640) setMobile(false) });
            window.addEventListener('scroll', updateTopbar, { passive: true });
            updateTopbar();
        })();
    </script>

</body>

</html>