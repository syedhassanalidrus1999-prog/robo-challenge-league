<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ดาวน์โหลดเกียรติบัตร — Robo Challenge League</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800;900&family=Sarabun:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
    <style>
        /* =========================================================
       RCL 2026 — CERTIFICATE PAGE
       01 Tokens / Reset
       02 Topbar + Dropdown   (same as every page)
       03 Mobile menu         (same as every page)
       04 Hero + search
       05 Results
       06 Certificate buttons + medal box
       07 Responsive
    ========================================================= */

        /* 01 — TOKENS / RESET */
        :root {
            --primary: #2563EB;
            --primary-soft: #EFF6FF;
            --text: #0F172A;
            --muted: #64748B;
            --line: #E2E8F0;
            --content: 900px;
            --gutter: 24px;
            --topbar-h: 82px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-width: 320px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            color: #1E293B;
            background:
                radial-gradient(circle at 12% 18%, rgba(37, 99, 235, .10), transparent 24%),
                radial-gradient(circle at 88% 78%, rgba(14, 165, 233, .08), transparent 24%),
                linear-gradient(180deg, #F7FAFF, #F3F7FC);
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input {
            font: inherit;
        }

        :focus-visible {
            outline: 3px solid #93C5FD;
            outline-offset: 2px;
        }

        /* 02 — TOPBAR + DROPDOWN (solid on this page — no hero behind it) */
        .topbar {
            position: fixed;
            inset: 0 0 auto;
            z-index: 1000;
            height: var(--topbar-h);
            padding: 0 30px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, .92);
            border-bottom: 1px solid rgba(226, 232, 240, .9);
            box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .topbar-logo {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
        }

        .topbar-logo img {
            display: block;
            width: auto;
            height: 58px;
            max-width: 150px;
            object-fit: contain;
        }

        .topbar-nav {
            flex: 1 1 auto;
            min-width: 0;
            margin-left: 18px;
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .nav-link {
            min-height: 52px;
            padding: 0 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2px;
            border: 0;
            border-radius: 11px;
            background: transparent;
            color: #334155;
            font-family: 'Kanit', sans-serif;
            font-weight: 700;
            letter-spacing: 1px;
            line-height: 1.15;
            white-space: nowrap;
            cursor: pointer;
            transition: color .2s ease, transform .2s ease;
        }

        .nav-link span:first-child {
            font-size: 17px;
            font-weight: 800;
        }

        .nav-link span:last-child {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 1px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .2px;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--primary);
            transform: translateY(-1px);
        }

        .certificate-btn {
            min-width: 150px;
            padding: 8px 16px;
            border: 1px solid #F6D365;
            border-radius: 999px;
            background: linear-gradient(135deg, #FFF8D8, #FFF0B8);
            color: #92400E;
            box-shadow: 0 6px 16px rgba(180, 120, 20, .12);
        }

        .certificate-btn.active {
            border-color: #F59E0B;
            color: #78350F;
            box-shadow: 0 0 0 2px rgba(245, 158, 11, .25), 0 6px 16px rgba(180, 120, 20, .12);
        }

        .certificate-btn:hover {
            background: linear-gradient(135deg, #FDE68A, #FCD34D);
            border-color: #F59E0B;
            color: #78350F;
        }

        .topbar-actions {
            flex: 0 0 auto;
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-login {
            min-height: 52px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: 1px solid #E2E8F0;
            border-radius: 11px;
            background: #fff;
            color: #334155;
            white-space: nowrap;
            transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
        }

        .btn-login:hover {
            background: #F8FAFC;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
        }

        .dropdown {
            position: relative;
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            z-index: 1100;
            display: none;
            min-width: 205px;
            padding: 8px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
        }

        .dropdown-item {
            min-height: 42px;
            padding: 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 10px;
            color: #334155;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
        }

        .dropdown-item i {
            color: #64748B;
            font-size: 17px;
        }

        .dropdown-item:hover,
        .dropdown-item.active {
            background: var(--primary-soft);
            color: var(--primary);
        }

        .dropdown-item.active i {
            color: var(--primary);
        }

        /* 03 — MOBILE MENU (shown ≤1100px) */
        .mobile-menu-toggle,
        .mobile-menu {
            display: none;
        }

        .mobile-menu-toggle {
            margin-left: auto;
            width: 44px;
            height: 44px;
            flex: 0 0 44px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            border: 1px solid rgba(148, 163, 184, .35);
            border-radius: 12px;
            background: rgba(255, 255, 255, .92);
            color: #1E3A8A;
            box-shadow: 0 5px 16px rgba(15, 23, 42, .08);
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .mobile-menu-toggle span {
            width: 21px;
            height: 2px;
            border-radius: 999px;
            background: currentColor;
            transition: transform .22s ease, opacity .18s ease;
        }

        .mobile-menu-toggle.is-open span:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .mobile-menu-toggle.is-open span:nth-child(2) {
            opacity: 0;
        }

        .mobile-menu-toggle.is-open span:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        .mobile-menu {
            position: fixed;
            top: calc(var(--topbar-h) + 6px);
            right: 12px;
            z-index: 999;
            width: min(380px, calc(100% - 24px));
            max-height: calc(100dvh - var(--topbar-h) - 18px);
            overflow-y: auto;
            padding: 8px;
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px) scale(.985);
            transform-origin: top right;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #DBEAFE;
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(15, 23, 42, .18);
            transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
        }

        .mobile-menu.is-open {
            visibility: visible;
            opacity: 1;
            pointer-events: auto;
            transform: none;
        }

        .mobile-menu-link,
        .mobile-menu-competition-toggle {
            width: 100%;
            min-height: 50px;
            padding: 9px 12px;
            display: flex;
            align-items: center;
            gap: 11px;
            border: 0;
            border-radius: 12px;
            background: transparent;
            color: #334155;
            font-family: 'Kanit', sans-serif;
            font-size: 15px;
            font-weight: 700;
            text-align: left;
            cursor: pointer;
        }

        .mobile-menu-link:hover,
        .mobile-menu-link.active,
        .mobile-menu-competition-toggle:hover,
        .mobile-menu-competition-toggle.active {
            color: var(--primary);
            background: var(--primary-soft);
        }

        .mobile-menu-link>i,
        .mobile-menu-competition-toggle>i:first-child {
            width: 28px;
            flex: 0 0 28px;
            display: grid;
            place-items: center;
            color: var(--primary);
            font-size: 19px;
        }

        .mobile-menu-link-text {
            min-width: 0;
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

        .mobile-menu-link-text strong {
            font-size: 15px;
            font-weight: 800;
        }

        .mobile-menu-link-text small {
            margin-top: 2px;
            color: #64748B;
            font-size: 11px;
            font-weight: 500;
        }

        .mobile-chevron {
            margin-left: auto;
            color: #64748B;
            font-size: 17px;
            transition: transform .2s ease;
        }

        .mobile-menu-competition-toggle.is-open .mobile-chevron {
            transform: rotate(180deg);
        }

        .mobile-submenu {
            display: none;
            margin: 0 8px 6px 51px;
            padding: 5px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
        }

        .mobile-submenu.is-open {
            display: block;
        }

        .mobile-submenu a {
            min-height: 42px;
            padding: 8px 10px;
            display: flex;
            align-items: center;
            gap: 9px;
            border-radius: 9px;
            color: #475569;
            font-size: 13px;
            font-weight: 600;
        }

        .mobile-submenu a:hover,
        .mobile-submenu a.active {
            color: var(--primary);
            background: var(--primary-soft);
        }

        .mobile-submenu a i {
            color: #64748B;
            font-size: 16px;
        }

        .mobile-menu-divider {
            height: 1px;
            margin: 6px 4px;
            background: #E2E8F0;
        }

        .mobile-login>i {
            color: #475569 !important;
        }

        /* 04 — HERO + SEARCH */
        .wrap {
            flex: 1;
            width: 100%;
            max-width: calc(var(--content) + var(--gutter) * 2);
            margin: 0 auto;
            padding: calc(var(--topbar-h) + 40px) var(--gutter) 72px;
        }

        .hero {
            margin-bottom: 28px;
            text-align: center;
        }

        .hero-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 12px;
            display: grid;
            place-items: center;
            border-radius: 20px;
            background: linear-gradient(135deg, #FFF8D8, #FDE68A);
            border: 1px solid #F6D365;
            color: #B45309;
            font-size: 32px;
            box-shadow: 0 10px 24px rgba(180, 120, 20, .16);
        }

        .hero-title {
            margin-bottom: 6px;
            color: var(--text);
            font-size: 40px;
            font-weight: 800;
            line-height: 1.2;
        }

        .hero-title span {
            color: var(--primary);
        }

        .hero-sub {
            color: var(--muted);
            font-size: 17px;
        }

        .search-card {
            margin-bottom: 22px;
            padding: 16px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
        }

        .search-row {
            display: flex;
            gap: 10px;
        }

        .search-input-wrap {
            flex: 1;
            min-width: 0;
            min-height: 50px;
            padding: 0 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: #F8FAFC;
            border: 1.5px solid var(--line);
            border-radius: 12px;
            transition: border-color .15s ease, background .15s ease, box-shadow .15s ease;
        }

        .search-input-wrap:focus-within {
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .1);
        }

        .search-input-wrap i {
            color: #94A3B8;
            font-size: 18px;
        }

        .search-input-wrap input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            background: transparent;
            font-size: 16px;
        }

        .btn-search {
            min-height: 50px;
            padding: 0 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border: none;
            border-radius: 12px;
            background: var(--primary);
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(37, 99, 235, .25);
            transition: background .15s ease;
        }

        .btn-search:hover {
            background: #1D4ED8;
        }

        .btn-search:disabled {
            opacity: .6;
            cursor: wait;
        }

        /* 05 — RESULTS */
        .loading {
            padding: 28px;
            display: none;
            color: var(--muted);
            text-align: center;
        }

        .loading.show {
            display: block;
        }

        .loading i {
            display: block;
            margin-bottom: 8px;
            font-size: 28px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .result-list {
            display: grid;
            gap: 16px;
        }

        .team-card {
            --tier: #16A34A;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--line);
            border-top: 4px solid var(--tier);
            border-radius: 18px;
            box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
        }

        .team-card.tier-intermediate {
            --tier: #2563EB;
        }

        .team-card.tier-advance {
            --tier: #EA580C;
        }

        .team-header {
            padding: 16px 20px;
            border-bottom: 1px solid #F1F5F9;
        }

        .team-badges {
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .badge {
            padding: 3px 11px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }

        .badge-tier {
            background: color-mix(in srgb, var(--tier) 10%, white);
            color: var(--tier);
        }

        .badge-rank {
            background: #FEF3C7;
            color: #B45309;
        }

        .team-name {
            color: var(--tier);
            font-size: 22px;
            font-weight: 700;
            line-height: 1.3;
            overflow-wrap: anywhere;
        }

        .team-sub {
            margin-top: 2px;
            color: #94A3B8;
            font-size: 14px;
        }

        .student-row {
            padding: 16px 20px;
            display: grid;
            grid-template-columns: 32px minmax(0, 1fr) auto;
            align-items: center;
            gap: 8px 14px;
        }

        .student-row+.student-row {
            border-top: 1px solid #EDF2F7;
        }

        .student-num {
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #F1F5F9;
            color: #64748B;
            font-size: 13px;
            font-weight: 700;
        }

        .student-info {
            min-width: 0;
        }

        .student-name {
            color: var(--text);
            font-size: 17px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .student-sub {
            margin-top: 1px;
            color: #94A3B8;
            font-size: 12px;
        }

        .empty-row,
        .no-result {
            padding: 44px 24px;
            color: #94A3B8;
            font-size: 15px;
            text-align: center;
        }

        .empty-row {
            padding: 22px;
            font-size: 14px;
        }

        .no-result {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
        }

        .no-result i {
            display: block;
            margin-bottom: 10px;
            font-size: 40px;
            opacity: .35;
        }

        /* 06 — CERTIFICATE BUTTONS + MEDAL BOX */
        .cert-btns {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 8px;
        }

        .btn-cert {
            min-height: 38px;
            padding: 0 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            transition: transform .15s ease, background .15s ease, opacity .15s ease;
        }

        .btn-cert:hover {
            transform: translateY(-1px);
        }

        .btn-participation {
            background: #F0FDF4;
            border: 1.5px solid #BBF7D0;
            color: #16A34A;
        }

        .btn-participation:hover {
            background: #DCFCE7;
        }

        .btn-1st {
            background: linear-gradient(135deg, #FEF9C3, #FDE68A);
            border: 1.5px solid #F59E0B;
            color: #92400E;
        }

        .btn-2nd {
            background: linear-gradient(135deg, #F1F5F9, #E2E8F0);
            border: 1.5px solid #94A3B8;
            color: #475569;
        }

        .btn-3rd {
            background: linear-gradient(135deg, #FEF3E2, #FDE8C8);
            border: 1.5px solid #CD7F32;
            color: #92400E;
        }

        .btn-1st:hover,
        .btn-2nd:hover,
        .btn-3rd:hover {
            opacity: .88;
        }

        .not-checked {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #94A3B8;
            font-size: 14px;
        }

        /* Medal box spans the full row under the name + buttons */
        .medal-cert {
            grid-column: 2 / -1;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            border-radius: 11px;
        }

        .medal-cert-info {
            flex: 1 1 220px;
            min-width: 0;
        }

        .medal-cert-title {
            font-size: 14px;
            font-weight: 700;
            line-height: 1.35;
        }

        .medal-cert-score {
            margin-top: 2px;
            color: #64748B;
            font-size: 13px;
        }

        .btn-medal {
            min-height: 38px;
            padding: 0 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border-radius: 9px;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            transition: transform .15s ease, opacity .15s ease;
        }

        .btn-medal:hover {
            transform: translateY(-1px);
            opacity: .9;
        }

        .medal-gold {
            background: #FFFBEB;
            border: 1.5px solid #F59E0B;
        }

        .medal-gold .medal-cert-title {
            color: #92400E;
        }

        .medal-gold .btn-medal {
            background: #D97706;
        }

        .medal-silver {
            background: #F8FAFC;
            border: 1.5px solid #94A3B8;
        }

        .medal-silver .medal-cert-title {
            color: #334155;
        }

        .medal-silver .btn-medal {
            background: #475569;
        }

        .medal-bronze {
            background: #FFF7ED;
            border: 1.5px solid #B45309;
        }

        .medal-bronze .medal-cert-title {
            color: #7C2D12;
        }

        .medal-bronze .btn-medal {
            background: #92400E;
        }

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation: none !important;
                transition: none !important;
            }
        }

        /* 07 — RESPONSIVE */
        @media (min-width: 1440px) {
            .topbar {
                padding-inline: 48px;
            }

            .topbar-nav {
                margin-left: 22px;
                gap: 4px;
            }

            .nav-link {
                padding-inline: 16px;
            }
        }

        @media (max-width: 1199px) {
            :root {
                --gutter: 20px;
            }

            .topbar {
                padding-inline: 20px;
            }

            .topbar-logo img {
                height: 54px;
                max-width: 136px;
            }

            .topbar-nav {
                margin-left: 10px;
                gap: 0;
            }

            .nav-link {
                padding-inline: 9px;
                letter-spacing: .5px;
            }

            .nav-link span:first-child {
                font-size: 15px;
            }

            .nav-link span:last-child {
                font-size: 10px;
            }

            .certificate-btn {
                min-width: 126px;
                padding-inline: 12px;
            }

            .btn-login {
                padding-inline: 13px;
                font-size: 14px;
            }
        }

        @media (max-width: 1100px) {
            :root {
                --topbar-h: 70px;
            }

            .topbar-nav,
            .topbar-actions {
                display: none;
            }

            .mobile-menu-toggle {
                display: flex;
            }

            .mobile-menu {
                display: block;
            }

            .topbar-logo img {
                height: 50px;
                max-width: 124px;
            }
        }

        @media (max-width: 700px) {

            /* Buttons move under the name */
            .student-row {
                grid-template-columns: 32px minmax(0, 1fr);
            }

            .cert-btns {
                grid-column: 2 / -1;
                justify-content: flex-start;
            }
        }

        @media (max-width: 640px) {
            :root {
                --gutter: 12px;
                --topbar-h: 60px;
            }

            .topbar {
                padding: 0 12px;
            }

            .topbar-logo img {
                height: 42px;
                max-width: 90px;
            }

            .wrap {
                padding-top: calc(var(--topbar-h) + 26px);
                padding-bottom: 48px;
            }

            .hero {
                margin-bottom: 20px;
            }

            .hero-icon {
                width: 54px;
                height: 54px;
                border-radius: 16px;
                font-size: 27px;
            }

            .hero-title {
                font-size: 28px;
            }

            .hero-sub {
                font-size: 14px;
            }

            .search-card {
                padding: 12px;
            }

            .search-row {
                flex-direction: column;
            }

            .team-header {
                padding: 14px 16px;
            }

            .team-name {
                font-size: 19px;
            }

            .student-row {
                padding: 14px 16px;
                column-gap: 10px;
            }

            .btn-cert,
            .btn-medal {
                flex: 1 1 100%;
                white-space: normal;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <!-- TOPBAR -->
    <header class="topbar">
        <a href="/" class="topbar-logo">
            <img src="/RCL Logo.png" alt="RCL">
        </a>

        <button class="mobile-menu-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false">
            <span></span>
            <span></span>
