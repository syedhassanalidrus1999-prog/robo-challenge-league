<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ดาวน์โหลดเกียรติบัตร — Robo Challenge League</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&family=Kanit:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Sarabun', sans-serif;
            background: #F4F7FB;
            color: #1E293B;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .topbar {
            height: 68px;
            background: rgba(255, 255, 255, .92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, .9);
            display: flex;
            align-items: center;
            padding: 0 28px;
            gap: 14px;
            position: sticky;
            top: 0;
            z-index: 10;
            box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
        }

        .topbar img {
            height: 42px;
            object-fit: contain;
        }

        .wrap {
            max-width: 760px;
            margin: 0 auto;
            padding: 42px 20px 64px;
        }

        .hero {
            text-align: center;
            margin-bottom: 32px;
        }

        .hero-title {
            font-size: 28px;
            font-weight: 800;
            color: #0F172A;
            margin-bottom: 6px;
            font-family: 'Kanit', sans-serif;
        }

        .hero-title span {
            color: #2563EB;
        }

        .hero-sub {
            font-size: 14px;
            color: #64748B;
        }

        .search-card {
            background: #fff;
            border: 1px solid #E2E8F0;
            border-radius: 18px;
            padding: 24px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
            margin-bottom: 24px;
        }

        .fi {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid #CBD5E1;
            border-radius: 10px;
            font-size: 14px;
            font-family: 'Sarabun', sans-serif;
            outline: none;
            transition: .15s;
        }

        .fi:focus {
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 12px 20px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            font-weight: 700;
            font-family: 'Sarabun', sans-serif;
            transition: .15s;
        }

        .btn-primary {
            background: #2563EB;
            color: #fff;
            box-shadow: 0 8px 18px rgba(37, 99, 235, .22);
            width: 100%;
        }

        .btn-primary:hover {
            background: #1D4ED8;
        }

        .btn-download {
            background: #F0FDF4;
            color: #16A34A;
            border: 1px solid #BBF7D0;
            font-size: 13px;
            padding: 8px 14px;
        }

        .btn-download:hover {
            background: #DCFCE7;
            transform: translateY(-1px);
        }

        .result-card {
            background: #fff;
            border: 1px solid #E2E8F0;
            border-radius: 18px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
            overflow: hidden;
            display: none;
        }

        .result-card.show {
            display: block;
        }

        .team-header {
            padding: 18px 20px;
            border-bottom: 1px solid #F1F5F9;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .team-badge {
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
        }

        .team-name-big {
            font-size: 18px;
            font-weight: 800;
            color: #0F172A;
        }

        .team-inst {
            font-size: 12px;
            color: #94A3B8;
            margin-top: 2px;
        }

        .rank-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
        }

        .student-list {
            padding: 16px 20px;
        }

        .student-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #F1F5F9;
            gap: 12px;
        }

        .student-row:last-child {
            border-bottom: none;
        }

        .student-name {
            font-size: 15px;
            font-weight: 700;
            color: #0F172A;
        }

        .student-sub {
            font-size: 11px;
            color: #94A3B8;
            margin-top: 2px;
        }

        .no-result {
            text-align: center;
            padding: 48px 24px;
            color: #94A3B8;
        }

        .no-result i {
            display: block;
            font-size: 40px;
            margin-bottom: 10px;
            opacity: .4;
        }

        .loading {
            text-align: center;
            padding: 24px;
            color: #64748B;
            display: none;
        }
    </style>
</head>

<body>

    <div class="topbar">
        <a href="/"><img src="/RCL Logo.png" alt="RCL"></a>
        <div style="font-size:15px;font-weight:700;color:#1E293B;flex:1">ดาวน์โหลดเกียรติบัตร</div>
        <a href="/"
            style="font-size:12px;padding:6px 12px;background:#fff;border:1px solid #E2E8F0;border-radius:8px;font-weight:700;color:#334155">
            <i class="ti ti-arrow-left"></i> กลับหน้าหลัก
        </a>
    </div>

    <div class="wrap">
        <div class="hero">
            <div class="hero-title">ดาวน์โหลด<span>เกียรติบัตร</span></div>
            <div class="hero-sub">ค้นหาด้วย ID ทีม ชื่อทีม หรือชื่อโรงเรียน</div>
        </div>

        <div class="search-card">
            <div style="margin-bottom:12px">
                <input class="fi" type="text" id="searchInput" placeholder="พิมพ์ ID ทีม / ชื่อทีม / ชื่อโรงเรียน...">
            </div>
            <button class="btn btn-primary" onclick="searchTeam()">
                <i class="ti ti-search"></i> ค้นหา
            </button>
        </div>

        <div class="loading" id="loading">
            <i class="ti ti-loader-2" style="font-size:24px;animation:spin 1s linear infinite"></i>
            <div style="margin-top:8px">กำลังค้นหา...</div>
        </div>

        <div class="result-card" id="resultCard">
            <div id="resultContent"></div>
        </div>
    </div>

    <style>
        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }
    </style>

    <script>
        var searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') searchTeam();
        });

        function searchTeam() {
            var q = searchInput.value.trim();
            if (!q) return;

            var loading = document.getElementById('loading');
            var resultCard = document.getElementById('resultCard');
            var resultContent = document.getElementById('resultContent');

            loading.style.display = 'block';
            resultCard.classList.remove('show');

            fetch('/certificate/search?q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    loading.style.display = 'none';
                    resultCard.classList.add('show');

                    if (!data.teams || data.teams.length === 0) {
                        resultContent.innerHTML = '<div class="no-result"><i class="ti ti-search-off"></i>ไม่พบทีมที่ค้นหา</div>';
                        return;
                    }

                    var html = '';
                    data.teams.forEach(function (team) {
                        var tierColor = team.tier === 'beginner' ? '#16A34A' : team.tier === 'intermediate' ? '#2563EB' : '#EA580C';
                        var tierLabel = team.tier === 'beginner' ? 'Beginner' : team.tier === 'intermediate' ? 'Intermediate' : 'Advance';

                        var rankLabel = '';
                        var rankEmoji = '';
                        if (team.rank === 1) { rankEmoji = '🥇'; rankLabel = 'อันดับ 1'; }
                        else if (team.rank === 2) { rankEmoji = '🥈'; rankLabel = 'อันดับ 2'; }
                        else if (team.rank === 3) { rankEmoji = '🥉'; rankLabel = 'อันดับ 3'; }

                        html += '<div class="team-header">';
                        html += '<div style="flex:1">';
                        html += '<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">';
                        html += '<span class="team-badge" style="background:' + tierColor + '18;color:' + tierColor + '">' + tierLabel + '</span>';
                        if (rankLabel) {
                            html += '<span class="rank-badge" style="background:#FEF3C7;color:#D97706">' + rankEmoji + ' ' + rankLabel + '</span>';
                        } else {
                            html += '<span class="rank-badge" style="background:#F1F5F9;color:#64748B"><i class="ti ti-certificate"></i> เข้าร่วม</span>';
                        }
                        html += '</div>';
                        html += '<div class="team-name-big">' + team.name + '</div>';
                        html += '<div class="team-inst">' + (team.institution || '') + ' · ' + team.id + '</div>';
                        html += '</div></div>';

                        html += '<div class="student-list">';
                        var students = team.students || [];
                        if (students.length === 0) {
                            html += '<div style="color:#94A3B8;font-size:12px;text-align:center;padding:12px">ไม่มีรายชื่อนักเรียน</div>';
                        }
                        students.forEach(function (s, idx) {
                            html += '<div class="student-row">';
                            html += '<div>';
                            html += '<div class="student-name">' + s.name + '</div>';
                            html += '<div class="student-sub">นักเรียนคนที่ ' + (idx + 1) + '</div>';
                            html += '</div>';
                            html += '<a href="/certificate/download?teamId=' + team.id + '&studentName=' + encodeURIComponent(s.name) + '&certType=' + (team.cert_type || 'participation') + '" target="_blank" class="btn btn-download">';
                            html += '<i class="ti ti-download"></i> ดาวน์โหลด PDF';
                            html += '</a>';
                            html += '</div>';
                        });
                        html += '</div>';

                        if (data.teams.indexOf(team) < data.teams.length - 1) {
                            html += '<div style="height:1px;background:#F1F5F9"></div>';
                        }
                    });

                    resultContent.innerHTML = html;
                })
                .catch(function () {
                    loading.style.display = 'none';
                    resultCard.classList.add('show');
                    resultContent.innerHTML = '<div class="no-result"><i class="ti ti-alert-circle"></i>เกิดข้อผิดพลาด กรุณาลองใหม่</div>';
                });
        }
    </script>
</body>

</html>