<% var sbRole=locals.userRole || (user ? (user.role==='viewer' ? 'staff_welfare' : user.role) : '' ); %>
  <% var SB_ROLE={ admin: 'ผู้ดูแลระบบ' , judge: 'กรรมการ' , staff_welfare: 'สตาฟสวัสดิการ' , staff_it: 'สตาฟไอที' }; %>
    <% var sbTierLabel=user && user.tier==='beginner' ? 'Beginner' : user && user.tier==='intermediate' ? 'Intermediate'
      : 'Advance' ; %>
      <nav class="sidebar">
        <div class="sb-logo">
          <div class="sb-logo-icon" style="background:transparent;padding:0">
            <img src="/RCL Logo.png" style="width:34px;height:34px;object-fit:contain">
          </div>
          <div class="sb-logo-text">
            <div class="sb-logo-name">ROBO CHALLENGE LEAGUE</div>
            <div class="sb-logo-role">
              <% if (sbRole==='admin' ) { %>Admin Panel
                <% } else if (sbRole==='judge' ) { %>กรรมการ — <%= sbTierLabel %>
                    <% } else if (user) { %>
                      <%= SB_ROLE[sbRole] || '' %>
                        <% } %>
            </div>
          </div>
        </div>

        <div class="sb-nav">
          <% if (sbRole==='admin' ) { %>
            <div class="sb-section">จัดการ</div>

            <a href="/teams" class="sb-item <%= currentPath.startsWith('/teams') ? 'active' : '' %>">
              <i class="ti ti-users"></i> จัดการทีม
            </a>

            <a href="/board" class="sb-item <%= currentPath === '/board' ? 'active' : '' %>">
              <i class="ti ti-chart-bar"></i> สรุปผลคะแนน
            </a>

            <a href="/board/criteria" class="sb-item <%= currentPath.startsWith('/board/criteria') ? 'active' : '' %>">
              <i class="ti ti-list-check"></i> เกณฑ์คะแนน
            </a>

            <a href="/board/settings" class="sb-item <%= currentPath.startsWith('/board/settings') ? 'active' : '' %>">
              <i class="ti ti-adjustments-horizontal"></i> ตั้งค่าหน้าสาธารณะ
            </a>

            <a href="/board/preorders"
              class="sb-item <%= currentPath.startsWith('/board/preorders') ? 'active' : '' %>">
              <i class="ti ti-shopping-cart"></i> Pre-order สนาม
            </a>

            <a href="/board/certificates"
              class="sb-item <%= currentPath.startsWith('/board/certificates') ? 'active' : '' %>">
              <i class="ti ti-certificate"></i> เกียรติบัตร
            </a>

            <a href="/board/documents"
              class="sb-item <%= currentPath.startsWith('/board/documents') ? 'active' : '' %>">
              <i class="ti ti-file-text"></i> เอกสาร
            </a>

            <a href="/board/survey" class="sb-item <%= currentPath.startsWith('/board/survey') ? 'active' : '' %>">
              <i class="ti ti-message-star"></i> แบบประเมิน
            </a>

            <a href="/board/coupons" class="sb-item <%= currentPath.startsWith('/board/coupons') ? 'active' : '' %>">
              <i class="ti ti-ticket"></i> คูปองอาหาร
            </a>

            <a href="/board/badges" class="sb-item <%= currentPath.startsWith('/board/badges') ? 'active' : '' %>">
              <i class="ti ti-id-badge-2"></i> ป้ายชื่อ
            </a>

            <a href="/board/judges" class="sb-item <%= currentPath.startsWith('/board/judges') ? 'active' : '' %>">
              <i class="ti ti-user-check"></i> มอบหมายกรรมการ
            </a>

            <a href="/screen/control" class="sb-item <%= currentPath.startsWith('/screen') ? 'active' : '' %>">
              <i class="ti ti-device-tv"></i> จอแสดงผล
            </a>

            <a href="/board/users" class="sb-item <%= currentPath.startsWith('/board/users') ? 'active' : '' %>">
              <i class="ti ti-users-group"></i> จัดการผู้ใช้
            </a>
            <% } %>

              <% if (sbRole==='staff_welfare' ) { %>
                <div class="sb-section">สวัสดิการ</div>

                <a href="/teams" class="sb-item <%= currentPath.startsWith('/teams') ? 'active' : '' %>">
                  <i class="ti ti-user-check"></i> Check-in ทีม
                </a>

                <a href="/coupons/scan" class="sb-item <%= currentPath.startsWith('/coupons') ? 'active' : '' %>">
                  <i class="ti ti-scan"></i> สแกนคูปอง
                </a>

                <a href="/board/coupons"
                  class="sb-item <%= currentPath.startsWith('/board/coupons') ? 'active' : '' %>">
                  <i class="ti ti-table"></i> ตารางคูปอง
                </a>
                <% } %>

                  <% if (sbRole==='staff_it' ) { %>
                    <div class="sb-section">ไอที</div>

                    <a href="/board" class="sb-item <%= currentPath === '/board' ? 'active' : '' %>">
                      <i class="ti ti-chart-bar"></i> สรุปผลคะแนน
                    </a>

                    <a href="/screen/control" class="sb-item <%= currentPath.startsWith('/screen') ? 'active' : '' %>">
                      <i class="ti ti-device-tv"></i> จอแสดงผล
                    </a>

                    <a href="/teams" class="sb-item <%= currentPath.startsWith('/teams') ? 'active' : '' %>">
                      <i class="ti ti-users"></i> รายชื่อทีม
                    </a>

                    <div class="sb-section">งานพิมพ์</div>

                    <a href="/board/badges"
                      class="sb-item <%= currentPath.startsWith('/board/badges') ? 'active' : '' %>">
                      <i class="ti ti-id-badge-2"></i> ป้ายชื่อ
                    </a>

                    <a href="/board/coupons"
                      class="sb-item <%= currentPath.startsWith('/board/coupons') ? 'active' : '' %>">
                      <i class="ti ti-ticket"></i> คูปองอาหาร
                    </a>

                    <a href="/board/cert-export"
                      class="sb-item <%= currentPath.startsWith('/board/cert-export') ? 'active' : '' %>">
                      <i class="ti ti-certificate"></i> เกียรติบัตร
                    </a>
                    <% } %>

                      <% if (sbRole==='admin' || sbRole==='judge' ) { %>
                        <div class="sb-section">การแข่งขัน</div>
                        <a href="/scores" class="sb-item <%= currentPath.startsWith('/scores') ? 'active' : '' %>">
                          <i class="ti ti-clipboard-check"></i> ลงคะแนน
                        </a>
                        <% } %>

                          <% if (!user || sbRole !=='judge' ) { %>
                            <div class="sb-section">ทั่วไป</div>
                            <a href="/" class="sb-item" target="_blank">
                              <i class="ti ti-world"></i> หน้าสาธารณะ
                            </a>
                            <% } %>
        </div>

        <div class="sb-foot">
          <div class="sb-user">
            <div class="sb-avatar">
              <%= user && user.name ? user.name.charAt(0).toUpperCase() : '?' %>
            </div>
            <div class="sb-user-info">
              <div class="sb-uname">
                <%= user ? user.name : '' %>
              </div>
              <div class="sb-urole">
                <%= SB_ROLE[sbRole] || '' %>
              </div>
            </div>
            <a href="/auth/logout" class="sb-logout" title="ออกจากระบบ">
              <i class="ti ti-logout"></i>
            </a>
          </div>
        </div>
      </nav>