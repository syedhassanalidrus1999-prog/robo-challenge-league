<% if (success && success.length > 0) { %>
  <% success.forEach(msg => { %>
  <div class="alert alert-success">
    <i class="ti ti-circle-check"></i> <%= msg %>
  </div>
  <% }) %>
<% } %>
<% if (error && error.length > 0) { %>
  <% error.forEach(msg => { %>
  <div class="alert alert-error">
    <i class="ti ti-alert-circle"></i> <%= msg %>
  </div>
  <% }) %>
<% } %>
