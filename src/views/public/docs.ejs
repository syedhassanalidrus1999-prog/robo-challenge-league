<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เอกสารการแข่งขัน — Robo Challenge League</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&family=Kanit:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* =========================================================
           VARIABLES / RESET
        ========================================================= */
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-soft: #eff6ff;
            --navy: #0f172a;
            --text: #1e293b;
            --muted: #64748b;
            --line: #e2e8f0;
            --surface: #ffffff;
            --page: #f5f8fc;
            --shadow: 0 12px 32px rgba(15, 23, 42, .08);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background:
                radial-gradient(circle at 15% 4%, rgba(37, 99, 235, .10), transparent 27%),
                radial-gradient(circle at 88% 18%, rgba(14, 165, 233, .08), transparent 24%),
                var(--page);
            font-family: 'Sarabun', sans-serif;
            color: var(--text);
            min-height: 100vh;
        }

        a {
            color: inherit;
        }

        /* =========================================================
           RCL TOPBAR
        ========================================================= */
        .topbar {
            position: fixed;
            inset: 0 0 auto;
            z-index: 1000;
            height: 84px;
            padding: 0 30px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: transparent;
            border-bottom: 1px solid transparent;
            transition: all .3s ease;
        }

        .topbar.scrolled {
            background: rgba(255, 255, 255, .92);
            border-bottom-color: rgba(226, 232, 240, .9);
            box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
            backdrop-filter: blur(16px);
        }

        .topbar-logo {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
        }

        .topbar-logo img {
            width: auto;
            height: 120px;
            object-fit: contain;
        }

        .topbar-nav {
            flex: 1;
            margin-left: 18px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-link {
            min-height: 52px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 5px;
            border: 0 !important;
            border-radius: 11px;
            background: transparent !important;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 17px;
            font-weight: 600;
            letter-spacing: 1px;
            line-height: 1.15;
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
            transition: all .2s ease;
        }

        .nav-link span:first-child {
            font-size: 16px;
            font-weight: 700;
        }

        .nav-link span:last-child {
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0;
        }

        .nav-link i {
            font-size: 17px;
        }

        .nav-link:hover {
            color: #2563EB;
            background: #F4F8FF !important;
            transform: translateY(-1px);
        }

        .nav-link.active {
            color: #2563EB !important;
            background: #EFF6FF !important;
        }

        /* Certificate */
        .certificate-btn {
            background: linear-gradient(135deg, #FFF7D6, #FEF3C7) !important;
            color: #92400E !important;
            border: 1px solid #FCD34D !important;
            border-radius: 90px !important;
            box-shadow: 0 4px 12px rgba(180, 120, 20, .18);
        }

        .certificate-btn:hover {
            background: linear-gradient(135deg, #FDE68A, #FCD34D) !important;
            color: #78350F !important;
            border-color: #F59E0B !important;
            box-shadow: 0 7px 18px rgba(180, 120, 20, .28);
            transform: translateY(-2px);
        }

        .certificate-btn:active {
            transform: translateY(0);
            box-shadow: 0 3px 8px rgba(180, 120, 20, .20);
        }

        .topbar-actions {
            flex: 0 0 auto;
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-reg,
        .btn-login {
            min-height: 52px;
            padding: 0 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 11px;
            font: 800 16px 'Sarabun', sans-serif;
            text-decoration: none;
            transition: all .2s ease;
        }

        .btn-reg {
            color: #fff;
            background: linear-gradient(135deg, #3478F6, #2563EB);
            border: 1px solid transparent;
            box-shadow: 0 10px 24px rgba(37, 99, 235, .24);
        }

        .btn-reg:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(37, 99, 235, .30);
        }

        .btn-login {
            color: #334155;
            background: #fff;
            border: 1px solid #E2E8F0;
        }

        .btn-login:hover {
            color: #2563EB;
            background: #F8FAFC;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
        }

        /* DROPDOWN */
        .dropdown {
            position: relative;
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            z-index: 1100;
            display: none;
            min-width: 215px;
            padding: 8px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
        }

        .dropdown-item {
            min-height: 44px;
            padding: 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 10px;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: all .18s ease;
        }

        .dropdown-item:hover,
        .dropdown-item.active {
            color: #2563EB;
            background: #EFF6FF;
        }

        .dropdown-item:first-child:hover {
            background: #FEF2F2;
            color: #DC2626;
        }

        .dropdown-item i {
            font-size: 17px;
            color: #64748B;
        }

        /* Responsive — Laptop */
        @media (min-width:901px) and (max-width:1199px) {
            .topbar {
                padding: 0 20px;
            }

            .topbar-logo img {
                height: 92px;
            }

            .nav-link {
                padding: 0 11px;
            }

            .nav-link span:first-child {
                font-size: 14px;
            }

            .nav-link span:last-child {
                font-size: 12px;
            }

            .btn-reg,
            .btn-login {
                padding: 0 14px;
                font-size: 14px;
            }
        }

        /* Responsive — Tablet */
        @media (min-width:641px) and (max-width:900px) {
            .topbar {
                height: 72px;
                padding: 0 16px;
            }

            .topbar-logo img {
                height: 70px;
            }

            .topbar-nav {
                margin-left: 4px;
                gap: 2px;
            }

            .nav-link {
                min-height: 44px;
                padding: 0 8px;
            }

            .nav-link span:first-child {
                font-size: 12px;
            }

            .nav-link span:last-child {
                font-size: 10px;
            }

            .btn-reg,
            .btn-login {
                min-height: 44px;
                padding: 0 12px;
                font-size: 13px;
            }
        }

        /* Responsive — Mobile */
        @media (max-width:640px) {
            .topbar {
                height: 60px;
                padding: 0 12px;
            }

            .topbar-logo img {
                height: 46px;
                max-width: 92px;
            }

            .topbar-nav {
                margin-left: 2px;
                gap: 0;
            }

            .topbar-nav>a.nav-link {
                display: none;
            }

            .nav-link {
                min-height: 40px;
                padding: 0 7px;
            }

            .nav-link span:first-child {
                font-size: 11px;
            }

            .nav-link span:last-child {
                font-size: 9px;
            }

            .topbar-actions {
                gap: 4px;
            }

            .btn-reg {
                min-height: 40px;
                padding: 0 10px;
                font-size: 12px;
            }

            .btn-login {
                width: 40px;
                min-width: 40px;
                min-height: 40px;
                padding: 0;
                font-size: 0;
            }

            .btn-login i {
                font-size: 18px;
            }

            .dropdown-menu {
                position: fixed;
                top: 58px;
                left: 10px;
                right: 10px;
                min-width: 0;
            }
        }

        @media (max-width:430px) {
            .topbar-logo img {
                height: 40px;
                max-width: 76px;
            }

            .nav-link {
                padding: 0 5px;
            }
        }

        @media (max-width:360px) {
            .topbar-logo img {
                max-width: 64px;
            }

            .nav-link {
                padding: 0 4px;
            }
        }


        /* =========================================================
           PAGE CONTENT
        ========================================================= */
        .page-shell {
            width: min(1060px, calc(100% - 32px));
            margin: 0 auto;
            padding: 120px 0 56px;
        }

        .hero {
            position: relative;
            overflow: hidden;
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            gap: 28px;
            padding: 34px 36px;
            border: 1px solid rgba(191, 219, 254, .9);
            border-radius: 26px;
            background: linear-gradient(135deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .98));
            box-shadow: var(--shadow);
            margin-bottom: 24px;
        }

        .hero::before,
        .hero::after {
            content: "";
            position: absolute;
            border-radius: 999px;
            pointer-events: none;
        }

        .hero::before {
            width: 280px;
            height: 280px;
            right: -90px;
            top: -130px;
            background: rgba(37, 99, 235, .10);
        }

        .hero::after {
            width: 150px;
            height: 150px;
            right: 120px;
            bottom: -100px;
            background: rgba(14, 165, 233, .10);
        }

        .hero-copy {
            position: relative;
            z-index: 1;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 12px;
            padding: 7px 12px;
            border-radius: 999px;
            color: var(--primary-dark);
            background: #dbeafe;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .25px;
        }

        .hero h1 {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0;
            color: var(--navy);
            font-size: clamp(27px, 4vw, 40px);
            line-height: 1.22;
            font-weight: 800;
        }

        .hero h1 .title-icon {
            width: 52px;
            height: 52px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            border-radius: 16px;
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            box-shadow: 0 10px 22px rgba(37, 99, 235, .24);
            font-size: 27px;
        }

        .hero p {
            max-width: 620px;
            margin: 14px 0 0;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.75;
        }

        .hero-art {
            position: relative;
            z-index: 1;
            width: 128px;
            height: 128px;
            display: grid;
            place-items: center;
            border-radius: 28px;
            color: var(--primary);
            background: rgba(255, 255, 255, .75);
            border: 1px solid rgba(191, 219, 254, .9);
            box-shadow: 0 18px 38px rgba(37, 99, 235, .12);
            font-size: 62px;
        }

        .notice {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 28px;
            padding: 16px 18px;
            border: 1px solid #fde68a;
            border-radius: 16px;
            background: linear-gradient(135deg, #fffbeb, #fffdf5);
            color: #92400e;
            font-size: 14px;
            line-height: 1.65;
        }

        .notice-icon {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 10px;
            background: #fef3c7;
            color: #b45309;
            font-size: 18px;
        }

        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 260px;
            gap: 24px;
            align-items: start;
        }

        .main-column,
        .side-card {
            min-width: 0;
        }

        .section {
            margin-bottom: 28px;
        }

        .section-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 13px;
        }

        .section-title {
            margin: 0;
            color: var(--navy);
            font-size: 18px;
            font-weight: 800;
        }

        .section-subtitle {
            margin-top: 4px;
            color: var(--muted);
            font-size: 12px;
        }

        .section-count {
            padding: 5px 10px;
            border-radius: 999px;
            color: #475569;
            background: #eaf0f7;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .doc-list {
            display: grid;
            gap: 12px;
        }

        .doc-card {
            position: relative;
            display: flex;
            align-items: center;
            gap: 15px;
            min-height: 86px;
            padding: 16px 17px;
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: 18px;
            background: rgba(255, 255, 255, .94);
            box-shadow: 0 3px 10px rgba(15, 23, 42, .035);
            text-decoration: none;
            transition: .22s ease;
        }

        a.doc-card:hover {
            transform: translateY(-2px);
            border-color: #bfdbfe;
            box-shadow: 0 14px 30px rgba(37, 99, 235, .10);
        }

        a.doc-card::after {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: var(--accent, #2563eb);
            opacity: 0;
            transition: .2s ease;
        }

        a.doc-card:hover::after {
            opacity: 1;
        }

        .doc-icon {
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 15px;
            font-size: 24px;
        }

        .doc-icon.red {
            color: #dc2626;
            background: #fef2f2;
        }

        .doc-icon.blue {
            color: #2563eb;
            background: #eff6ff;
        }

        .doc-icon.green {
            color: #16a34a;
            background: #f0fdf4;
        }

        .doc-icon.orange {
            color: #ea580c;
            background: #fff7ed;
        }

        .doc-info {
            flex: 1;
            min-width: 0;
        }

        .doc-name {
            color: var(--text);
            font-size: 15px;
            font-weight: 800;
            line-height: 1.45;
        }

        .doc-desc {
            margin-top: 4px;
            color: var(--muted);
            font-size: 12.5px;
            line-height: 1.55;
        }

        .doc-btn,
        .coming-soon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            flex: 0 0 auto;
            white-space: nowrap;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 800;
        }

        .doc-btn {
            padding: 9px 12px;
            color: var(--primary-dark);
            border: 1px solid #bfdbfe;
            background: var(--primary-soft);
        }

        .coming-soon {
            padding: 8px 11px;
            color: #64748b;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
        }

        .tier-tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            padding: 6px;
            margin-bottom: 14px;
            border: 1px solid var(--line);
            border-radius: 16px;
            background: #edf2f8;
        }

        .tier-tab {
            min-height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 0;
            border-radius: 11px;
            background: transparent;
            color: #64748b;
            font-family: 'Sarabun', sans-serif;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            transition: .2s ease;
        }

        .tier-dot {
            width: 9px;
            height: 9px;
            display: inline-block;
            border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(148, 163, 184, .12);
        }

        .tier-tab:hover {
            color: #334155;
        }

        .tier-tab.active {
            background: #fff;
            box-shadow: 0 6px 14px rgba(15, 23, 42, .07);
        }

        .tier-tab.t-b.active {
            color: #15803d;
        }

        .tier-tab.t-i.active {
            color: #1d4ed8;
        }

        .tier-tab.t-a.active {
            color: #dc2626;
        }

        .t-b .tier-dot {
            background: #22c55e;
        }

        .t-i .tier-dot {
            background: #3b82f6;
        }

        .t-a .tier-dot {
            background: #ef4444;
        }

        .tier-content {
            display: none;
        }

        .tier-content.active {
            display: block;
            animation: fadeIn .22s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .side-card {
            position: sticky;
            top: 108px;
            padding: 20px;
            border: 1px solid var(--line);
            border-radius: 20px;
            background: rgba(255, 255, 255, .94);
            box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
        }

        .side-card-icon {
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            margin-bottom: 14px;
            border-radius: 14px;
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            font-size: 22px;
        }

        .side-card h3 {
            margin: 0;
            color: var(--navy);
            font-size: 16px;
            font-weight: 800;
        }

        .side-card p {
            margin: 8px 0 16px;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.65;
        }

        .side-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 11px 12px;
            border-radius: 12px;
            color: var(--primary-dark);
            background: var(--primary-soft);
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
        }

        .side-meta {
            display: grid;
            gap: 10px;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px dashed #cbd5e1;
        }

        .side-meta div {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #475569;
            font-size: 12px;
        }

        .footer {
            margin-top: 20px;
            padding: 28px 20px;
            text-align: center;
            background: linear-gradient(135deg, #0f172a, #1e293b);
        }

        .footer-logo img {
            height: 36px;
            width: auto;
            object-fit: contain;
            margin-bottom: 10px;
        }

        .footer-text {
            color: rgba(255, 255, 255, .58);
            font-size: 12px;
        }

        /* =========================================================
           RESPONSIVE — PAGE CONTENT
        ========================================================= */
        @media (max-width: 860px) {
            .content-grid {
                grid-template-columns: 1fr;
            }

            .side-card {
                position: static;
            }

            .hero-art {
                display: none;
            }

            .hero {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 620px) {
            .page-shell {
                padding-top: 84px;
            }

            .hero {
                padding: 24px 20px;
                border-radius: 21px;
            }

            .hero h1 {
                align-items: flex-start;
                font-size: 26px;
            }

            .hero h1 .title-icon {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                font-size: 23px;
            }

            .doc-card {
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .doc-info {
                min-width: calc(100% - 70px);
            }

            .doc-btn,
            .coming-soon {
                margin-left: 67px;
            }

            .tier-tabs {
                grid-template-columns: 1fr;
            }

            .tier-tab {
                justify-content: flex-start;
                padding-left: 16px;
            }
        }
    </style>
</head>

<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a href="/" class="topbar-logo">
            <img src="/RCL Logo.png" alt="RCL">
        </a>

        <nav class="topbar-nav">

            <a href="/" class="nav-link">
                <span>HOME</span>
                <span>หน้าหลัก</span>
            </a>

            <a href="/#about" class="nav-link">
                <span>ABOUT US</span>
                <span>เกี่ยวกับเรา</span>
            </a>

            <div class="dropdown">
                <button class="nav-link" type="button">
                    <span>COMPETITION</span>
                    <span>
                        การแข่งขัน
                        <i class="ti ti-chevron-down"></i>
                    </span>
                </button>

                <div class="dropdown-menu">
                    <a href="/#tiers" class="dropdown-item">
                        <i class="ti ti-pencil-plus"></i>
                        สมัครแข่งขัน
                    </a>
                    <a href="/competition?view=teams" class="dropdown-item">
                        <i class="ti ti-users"></i>
                        ทีมที่สมัคร
                    </a>
