    <script>
        /* MASTER TOPBAR JS — single controller */
        (function () {
            var dropdowns = document.querySelectorAll('.dropdown')
            for (var i = 0; i < dropdowns.length; i++) {
                (function (dd) {
                    var menu = dd.querySelector('.dropdown-menu'), trigger = dd.querySelector('.nav-link'), timer
                    if (!menu || !trigger) return
                    trigger.addEventListener('click', function (e) {
                        if (window.innerWidth <= 640) { e.preventDefault(); e.stopPropagation(); return }
                        e.preventDefault(); menu.style.display = menu.style.display === 'block' ? 'none' : 'block'
                    })
                    dd.addEventListener('mouseenter', function () { if (window.innerWidth > 640) { clearTimeout(timer); menu.style.display = 'block' } })
                    dd.addEventListener('mouseleave', function () { if (window.innerWidth > 640) { timer = setTimeout(function () { menu.style.display = 'none' }, 200) } })
                })(dropdowns[i])
            }
        })();

            (function () {
                var toggle = document.querySelector('.mobile-menu-toggle'), menu = document.getElementById('mobileMenu'), competition = document.querySelector('.mobile-competition-toggle'), submenu = document.querySelector('.mobile-submenu')
                if (!toggle || !menu) return
                function setOpen(open) {
                    menu.classList.toggle('is-open', open); toggle.classList.toggle('is-open', open)
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false'); toggle.setAttribute('aria-label', open ? 'ปิดเมนู' : 'เปิดเมนู')
                    toggle.innerHTML = open ? '<i class="ti ti-x"></i>' : '<i class="ti ti-menu-2"></i>'
                    if (!open) { if (competition) { competition.classList.remove('is-open'); competition.setAttribute('aria-expanded', 'false') } if (submenu) submenu.classList.remove('is-open') }
                }
                toggle.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); setOpen(!menu.classList.contains('is-open')) }, true)
                var links = menu.querySelectorAll('a'); for (var j = 0; j < links.length; j++)links[j].addEventListener('click', function () { setOpen(false) })
                document.addEventListener('click', function (e) { if (window.innerWidth <= 640 && menu.classList.contains('is-open') && !menu.contains(e.target) && !toggle.contains(e.target)) setOpen(false) })
                window.addEventListener('resize', function () { if (window.innerWidth > 640) setOpen(false) })
            })();

            // Scroll effect
            (function () {
                var topbar = document.querySelector('.topbar')
                if (!topbar) return

                function updateTopbar() {
                    if (window.scrollY > 10) {
                        topbar.classList.add('scrolled')
                    } else {
                        topbar.classList.remove('scrolled')
                    }
                }

                window.addEventListener('scroll', updateTopbar, { passive: true })
                updateTopbar()
            })();

        // Tier tabs
        function switchTier(tier, button) {
            document.querySelectorAll('.tier-content').forEach(function (el) {
                el.classList.remove('active');
            });
            document.querySelectorAll('.tier-tab').forEach(function (el) {
                el.classList.remove('active');
                el.setAttribute('aria-selected', 'false');
            });
            document.getElementById('tier-' + tier).classList.add('active');
            button.classList.add('active');
            button.setAttribute('aria-selected', 'true');
        }

    </script>

</body>

</html>