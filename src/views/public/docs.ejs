<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เอกสารการแข่งขัน — Robo Challenge League</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800&family=Sarabun:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
    <style>
        /* =========================================================
       RCL 2026 — DOCUMENTS PAGE
       01 Tokens / Reset
       02 Topbar + Dropdown   (same as home / competition)
       03 Mobile menu         (same as home / competition)
       04 Page hero + notice
       05 Layout / sections
       06 Doc cards
       07 Tier tabs
       08 Sidebar
       09 Footer
       10 Responsive
    ========================================================= */

        /* 01 — TOKENS / RESET */
        :root {
            --primary: #2563EB;
            --primary-dark: #1D4ED8;
            --primary-soft: #EFF6FF;
            --navy: #0F172A;
            --text: #1E293B;
            --muted: #64748B;
            --line: #E2E8F0;
            --page: #F5F8FC;
            --shadow: 0 12px 32px rgba(15, 23, 42, .08);
            --content: 1180px;
            --gutter: 24px;
            --topbar-h: 82px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-width: 320px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            color: var(--text);
            background:
                radial-gradient(circle at 15% 4%, rgba(37, 99, 235, .10), transparent 27%),
                radial-gradient(circle at 88% 18%, rgba(14, 165, 233, .08), transparent 24%),
                var(--page);
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font: inherit;
        }

        :focus-visible {
            outline: 3px solid #93C5FD;
            outline-offset: 2px;
        }

        /* 02 — TOPBAR + DROPDOWN (solid on this page — no hero behind it) */
        .topbar {
            position: fixed;
            inset: 0 0 auto;
            z-index: 1000;
            height: var(--topbar-h);
            padding: 0 30px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, .92);
            border-bottom: 1px solid rgba(226, 232, 240, .9);
            box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .topbar-logo {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
        }

        .topbar-logo img {
            display: block;
            width: auto;
            height: 58px;
            max-width: 150px;
            object-fit: contain;
        }

        .topbar-nav {
            flex: 1 1 auto;
            min-width: 0;
            margin-left: 18px;
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .nav-link {
            min-height: 52px;
            padding: 0 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2px;
            border: 0;
            border-radius: 11px;
            background: transparent;
            color: #334155;
            font-family: 'Kanit', sans-serif;
            font-weight: 700;
            letter-spacing: 1px;
            line-height: 1.15;
            white-space: nowrap;
            cursor: pointer;
            transition: color .2s ease, transform .2s ease;
        }

        .nav-link span:first-child {
            font-size: 17px;
            font-weight: 800;
        }

        .nav-link span:last-child {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 1px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .2px;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--primary);
            transform: translateY(-1px);
        }

        .certificate-btn {
            min-width: 150px;
            padding: 8px 16px;
            border: 1px solid #F6D365;
            border-radius: 999px;
            background: linear-gradient(135deg, #FFF8D8, #FFF0B8);
            color: #92400E;
            box-shadow: 0 6px 16px rgba(180, 120, 20, .12);
        }

        .certificate-btn:hover {
            background: linear-gradient(135deg, #FDE68A, #FCD34D);
            border-color: #F59E0B;
            color: #78350F;
        }

        .topbar-actions {
            flex: 0 0 auto;
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-login {
            min-height: 52px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: 1px solid #E2E8F0;
            border-radius: 11px;
            background: #fff;
            color: #334155;
            white-space: nowrap;
            transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
        }

        .btn-login:hover {
            background: #F8FAFC;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
        }

        .dropdown {
            position: relative;
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            z-index: 1100;
            display: none;
            min-width: 205px;
            padding: 8px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
        }

        .dropdown-item {
            min-height: 42px;
            padding: 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 10px;
            color: #334155;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
        }

        .dropdown-item i {
            color: #64748B;
            font-size: 17px;
        }

        .dropdown-item:hover,
        .dropdown-item.active {
            background: var(--primary-soft);
            color: var(--primary);
        }

        .dropdown-item.active i {
            color: var(--primary);
        }

        /* 03 — MOBILE MENU (shown ≤1100px) */
        .mobile-menu-toggle,
        .mobile-menu {
            display: none;
        }

        .mobile-menu-toggle {
            margin-left: auto;
            width: 44px;
            height: 44px;
            flex: 0 0 44px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            border: 1px solid rgba(148, 163, 184, .35);
            border-radius: 12px;
            background: rgba(255, 255, 255, .92);
            color: #1E3A8A;
            box-shadow: 0 5px 16px rgba(15, 23, 42, .08);
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .mobile-menu-toggle span {
            width: 21px;
            height: 2px;
            border-radius: 999px;
            background: currentColor;
            transition: transform .22s ease, opacity .18s ease;
        }

        .mobile-menu-toggle.is-open span:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .mobile-menu-toggle.is-open span:nth-child(2) {
            opacity: 0;
        }

        .mobile-menu-toggle.is-open span:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        .mobile-menu {
            position: fixed;
            top: calc(var(--topbar-h) + 6px);
            right: 12px;
            z-index: 999;
            width: min(380px, calc(100% - 24px));
            max-height: calc(100dvh - var(--topbar-h) - 18px);
            overflow-y: auto;
            padding: 8px;
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px) scale(.985);
            transform-origin: top right;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #DBEAFE;
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(15, 23, 42, .18);
            transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
        }

        .mobile-menu.is-open {
            visibility: visible;
            opacity: 1;
            pointer-events: auto;
            transform: none;
        }

        .mobile-menu-link,
        .mobile-menu-competition-toggle {
            width: 100%;
            min-height: 50px;
            padding: 9px 12px;
            display: flex;
            align-items: center;
            gap: 11px;
            border: 0;
            border-radius: 12px;
            background: transparent;
            color: #334155;
            font-family: 'Kanit', sans-serif;
            font-size: 15px;
            font-weight: 700;
            text-align: left;
            cursor: pointer;
        }

        .mobile-menu-link:hover,
        .mobile-menu-link.active,
        .mobile-menu-competition-toggle:hover,
        .mobile-menu-competition-toggle.active {
            color: var(--primary);
            background: var(--primary-soft);
        }

        .mobile-menu-link>i,
        .mobile-menu-competition-toggle>i:first-child {
            width: 28px;
            flex: 0 0 28px;
            display: grid;
            place-items: center;
            color: var(--primary);
            font-size: 19px;
        }

        .mobile-menu-link-text {
            min-width: 0;
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

        .mobile-menu-link-text strong {
            font-size: 15px;
            font-weight: 800;
        }

        .mobile-menu-link-text small {
            margin-top: 2px;
            color: #64748B;
            font-size: 11px;
            font-weight: 500;
        }

        .mobile-chevron {
            margin-left: auto;
            color: #64748B;
            font-size: 17px;
            transition: transform .2s ease;
        }

        .mobile-menu-competition-toggle.is-open .mobile-chevron {
            transform: rotate(180deg);
        }

        .mobile-submenu {
            display: none;
            margin: 0 8px 6px 51px;
            padding: 5px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
        }

        .mobile-submenu.is-open {
            display: block;
        }

        .mobile-submenu a {
            min-height: 42px;
            padding: 8px 10px;
            display: flex;
            align-items: center;
            gap: 9px;
            border-radius: 9px;
            color: #475569;
            font-size: 13px;
            font-weight: 600;
        }

        .mobile-submenu a:hover,
        .mobile-submenu a.active {
            color: var(--primary);
            background: var(--primary-soft);
        }

        .mobile-submenu a i {
            color: #64748B;
            font-size: 16px;
        }

        .mobile-menu-divider {
            height: 1px;
            margin: 6px 4px;
            background: #E2E8F0;
        }

        .mobile-login>i {
            color: #475569 !important;
        }

        /* 04 — PAGE HERO + NOTICE */
        .page-shell {
            flex: 1;
            width: 100%;
            max-width: calc(var(--content) + var(--gutter) * 2);
            margin: 0 auto;
            padding: calc(var(--topbar-h) + 36px) var(--gutter) 56px;
        }

        .docs-hero {
            position: relative;
            overflow: hidden;
            margin-bottom: 20px;
            padding: 34px 36px;
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 28px;
            background: linear-gradient(135deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .98));
            border: 1px solid rgba(191, 219, 254, .9);
            border-radius: 26px;
            box-shadow: var(--shadow);
        }

        .docs-hero::before,
        .docs-hero::after {
            content: '';
            position: absolute;
            border-radius: 999px;
            pointer-events: none;
        }

        .docs-hero::before {
            width: 280px;
            height: 280px;
            right: -90px;
            top: -130px;
            background: rgba(37, 99, 235, .10);
        }

        .docs-hero::after {
            width: 150px;
            height: 150px;
            right: 120px;
            bottom: -100px;
            background: rgba(14, 165, 233, .10);
        }

        .docs-hero>* {
            position: relative;
            z-index: 1;
        }

        .eyebrow {
            margin-bottom: 12px;
            padding: 7px 12px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 999px;
            background: #DBEAFE;
            color: var(--primary-dark);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .25px;
        }

        .docs-hero h1 {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--navy);
            font-size: clamp(27px, 4vw, 40px);
            font-weight: 800;
            line-height: 1.22;
        }

        .title-icon {
            flex: 0 0 auto;
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            border-radius: 16px;
            background: linear-gradient(135deg, #2563EB, #0EA5E9);
            color: #fff;
            font-size: 27px;
            box-shadow: 0 10px 22px rgba(37, 99, 235, .24);
        }

        .docs-hero p {
            max-width: 640px;
            margin-top: 14px;
            color: var(--muted);
            font-size: 16px;
            line-height: 1.75;
        }

        .hero-art {
            width: 128px;
            height: 128px;
            display: grid;
            place-items: center;
            border-radius: 28px;
            background: rgba(255, 255, 255, .75);
            border: 1px solid rgba(191, 219, 254, .9);
            color: var(--primary);
            font-size: 62px;
            box-shadow: 0 18px 38px rgba(37, 99, 235, .12);
        }

        .notice {
            margin-bottom: 28px;
            padding: 16px 18px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            background: linear-gradient(135deg, #FFFBEB, #FFFDF5);
            border: 1px solid #FDE68A;
            border-radius: 16px;
            color: #92400E;
            font-size: 15px;
            line-height: 1.65;
        }

        .notice-icon {
            flex: 0 0 auto;
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: #FEF3C7;
            color: #B45309;
            font-size: 18px;
        }

        /* 05 — LAYOUT / SECTIONS */
        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 280px;
            gap: 24px;
            align-items: start;
        }

        .main-column {
            min-width: 0;
        }

        .doc-section+.doc-section {
            margin-top: 32px;
        }

        .section-head {
            margin-bottom: 14px;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 16px;
        }

        .section-title {
            color: var(--navy);
            font-size: 25px;
            font-weight: 800;
            line-height: 1.3;
        }

        .section-subtitle {
            margin-top: 4px;
            color: var(--muted);
            font-size: 15px;
        }

        .section-count {
            flex: 0 0 auto;
            padding: 5px 11px;
            border-radius: 999px;
            background: #EAF0F7;
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        /* 06 — DOC CARDS (markup comes from the _doc-card partial) */
        .doc-list {
            display: grid;
            gap: 12px;
        }

        .doc-card {
            position: relative;
            overflow: hidden;
            min-height: 86px;
            padding: 16px 18px;
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(255, 255, 255, .96);
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: 0 3px 10px rgba(15, 23, 42, .035);
            transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
        }

        a.doc-card:hover {
            transform: translateY(-2px);
            border-color: #BFDBFE;
            box-shadow: 0 14px 30px rgba(37, 99, 235, .10);
        }

        a.doc-card::after {
            content: '';
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: var(--accent, #2563EB);
            opacity: 0;
            transition: opacity .2s ease;
        }

        a.doc-card:hover::after {
            opacity: 1;
        }

        .doc-icon {
            flex: 0 0 auto;
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            border-radius: 15px;
            font-size: 24px;
        }

        .doc-icon.red {
            color: #DC2626;
            background: #FEF2F2;
        }

        .doc-icon.blue {
            color: #2563EB;
            background: #EFF6FF;
        }

        .doc-icon.green {
            color: #16A34A;
            background: #F0FDF4;
        }

        .doc-icon.orange {
            color: #EA580C;
            background: #FFF7ED;
        }

        .doc-icon.yellow {
            color: #F59E0B;
            background: #FFFBEB;
        }

        .doc-info {
            flex: 1;
            min-width: 0;
        }

        .doc-name {
            color: var(--text);
            font-size: 19px;
            font-weight: 700;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .doc-desc {
            margin-top: 4px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.55;
        }

        .doc-btn,
        .coming-soon {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .doc-btn {
            padding: 9px 13px;
            background: var(--primary-soft);
            border: 1px solid #BFDBFE;
            color: var(--primary-dark);
            transition: background .2s ease, color .2s ease;
        }

        a.doc-card:hover .doc-btn {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }

        .coming-soon {
            padding: 8px 12px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            color: #64748B;
        }

        /* 07 — TIER TABS (colors match the rest of the site) */
        .tier-tabs {
            margin-bottom: 14px;
            padding: 6px;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            background: #EDF2F8;
            border: 1px solid var(--line);
            border-radius: 16px;
        }

        .tier-tab {
            --c: #16A34A;
            min-height: 48px;
            padding: 0 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 0;
            border-radius: 11px;
            background: transparent;
            color: #64748B;
            font-size: 18px;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            transition: background .2s ease, color .2s ease, box-shadow .2s ease;
        }

        .tier-tab.t-i {
            --c: #2563EB;
        }

        .tier-tab.t-a {
            --c: #EA580C;
        }

        .tier-tab:hover {
            color: var(--c);
        }

        .tier-tab.active {
            background: #fff;
            color: var(--c);
            box-shadow: 0 6px 14px rgba(15, 23, 42, .07);
        }

        .tier-dot {
            flex: 0 0 auto;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--c);
            box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 14%, transparent);
        }

        .tier-content {
            display: none;
        }

        .tier-content.active {
            display: block;
            animation: fadeIn .22s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        /* 08 — SIDEBAR */
        .side-card {
            position: sticky;
            top: calc(var(--topbar-h) + 20px);
            min-width: 0;
            padding: 20px;
            background: rgba(255, 255, 255, .95);
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
        }

        .side-card-icon {
            width: 44px;
            height: 44px;
            margin-bottom: 14px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: linear-gradient(135deg, #2563EB, #0EA5E9);
            color: #fff;
            font-size: 22px;
        }

        .side-card h3 {
            color: var(--navy);
            font-size: 18px;
            font-weight: 700;
        }

        .side-card p {
            margin: 8px 0 16px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.65;
        }

        .side-link {
            padding: 11px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            border-radius: 12px;
            background: var(--primary-soft);
            color: var(--primary-dark);
            font-size: 14px;
            font-weight: 700;
            transition: background .2s ease;
        }

        .side-link:hover {
            background: #DBEAFE;
        }

        .side-link span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .side-meta {
            margin-top: 16px;
            padding-top: 16px;
            display: grid;
            gap: 10px;
            border-top: 1px dashed #CBD5E1;
        }

        .side-meta div {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #475569;
            font-size: 13px;
        }

        .side-meta i {
            color: var(--primary);
            font-size: 17px;
        }

        /* 09 — FOOTER */
        .footer {
            padding: 26px 20px;
            background: linear-gradient(135deg, #0F172A, #1E293B);
            text-align: center;
        }

        .footer img {
            height: 36px;
            margin-bottom: 10px;
            object-fit: contain;
        }

        .footer-text {
            color: rgba(255, 255, 255, .58);
            font-size: 12px;
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation: none !important;
                transition: none !important;
            }
        }

        /* 10 — RESPONSIVE */
        @media (min-width: 1440px) {
            .topbar {
                padding-inline: 48px;
            }

            .topbar-nav {
                margin-left: 22px;
                gap: 4px;
            }

            .nav-link {
                padding-inline: 16px;
            }
        }

        @media (max-width: 1199px) {
            :root {
                --gutter: 20px;
            }

            .topbar {
                padding-inline: 20px;
            }

            .topbar-logo img {
                height: 54px;
                max-width: 136px;
            }

            .topbar-nav {
                margin-left: 10px;
                gap: 0;
            }

            .nav-link {
                padding-inline: 9px;
                letter-spacing: .5px;
            }

            .nav-link span:first-child {
                font-size: 15px;
            }

            .nav-link span:last-child {
                font-size: 10px;
            }

            .certificate-btn {
                min-width: 126px;
                padding-inline: 12px;
            }

            .btn-login {
                padding-inline: 13px;
                font-size: 14px;
            }
        }

        @media (max-width: 1100px) {
            :root {
                --topbar-h: 70px;
            }

            .topbar-nav,
            .topbar-actions {
                display: none;
            }

            .mobile-menu-toggle {
                display: flex;
            }

            .mobile-menu {
                display: block;
            }

            .topbar-logo img {
                height: 50px;
                max-width: 124px;
            }
        }

        @media (max-width: 900px) {
            .content-grid {
                grid-template-columns: 1fr;
            }

            .side-card {
                position: static;
            }

            .docs-hero {
                grid-template-columns: 1fr;
            }

            .hero-art {
                display: none;
            }
        }

        @media (max-width: 640px) {
            :root {
                --gutter: 12px;
                --topbar-h: 60px;
            }

            .topbar {
                padding: 0 12px;
            }

            .topbar-logo img {
                height: 42px;
                max-width: 90px;
            }

            .page-shell {
                padding-top: calc(var(--topbar-h) + 20px);
                padding-bottom: 40px;
            }

            .docs-hero {
                padding: 22px 18px;
                border-radius: 20px;
            }

            .docs-hero h1 {
                align-items: flex-start;
                font-size: 25px;
            }

            .title-icon {
                width: 44px;
                height: 44px;
                border-radius: 13px;
                font-size: 22px;
            }

            .docs-hero p {
                font-size: 14px;
            }

            .notice {
                padding: 14px;
                font-size: 14px;
            }

            .section-head {
                align-items: flex-start;
            }

            .section-title {
                font-size: 22px;
            }

            .section-subtitle {
                font-size: 13px;
            }

            /* Doc card: icon + text on top row, button full width below */
            .doc-card {
                padding: 14px;
                flex-wrap: wrap;
                align-items: flex-start;
                gap: 12px;
            }

            .doc-icon {
                width: 44px;
                height: 44px;
                border-radius: 13px;
                font-size: 21px;
            }

            .doc-info {
                flex: 1 1 calc(100% - 56px);
            }

            .doc-name {
                font-size: 17px;
            }

            .doc-desc {
                font-size: 13px;
            }

            .doc-btn,
            .coming-soon {
                flex: 1 1 100%;
                min-height: 40px;
            }

            .tier-tabs {
                padding: 5px;
                gap: 5px;
            }

            .tier-tab {
                min-height: 44px;
                padding: 0 4px;
                gap: 6px;
                font-size: 14px;
            }

            .tier-dot {
                width: 7px;
                height: 7px;
            }
        }

        @media (max-width: 380px) {
            .tier-tab {
                font-size: 12px;
            }

            .tier-dot {
                display: none;
            }
        }
    </style>
</head>

<body>

    <!-- TOPBAR -->
    <header class="topbar">
        <a href="/" class="topbar-logo">
            <img src="/RCL Logo.png" alt="RCL">
        </a>

        <button class="mobile-menu-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="topbar-nav">
            <a href="/" class="nav-link">
                <span>HOME</span>
                <span>หน้าหลัก</span>
            </a>

            <a href="/#about" class="nav-link">
                <span>ABOUT US</span>
                <span>เกี่ยวกับเรา</span>
            </a>

            <a href="/#awards" class="nav-link">
                <span>AWARDS</span>
                <span>รางวัล</span>
            </a>

            <div class="dropdown">
                <button class="nav-link" type="button">
                    <span>COMPETITION</span>
                    <span>การแข่งขัน <i class="ti ti-chevron-down"></i></span>
                </button>

                <div class="dropdown-menu">
                    <a href="/#tiers" class="dropdown-item"><i class="ti ti-pencil-plus"></i>สมัครแข่งขัน</a>
                    <a href="/competition?view=teams" class="dropdown-item"><i class="ti ti-users"></i>ทีมที่สมัคร</a>
                    <a href="/competition?view=board" class="dropdown-item"><i
                            class="ti ti-chart-bar"></i>ผลสรุปคะแนน</a>
                </div>
            </div>

            <a href="/docs" class="nav-link active" aria-current="page">
                <span>DOCUMENT</span>
                <span>เอกสาร</span>
            </a>

            <a href="/preorder" class="nav-link">
                <span>PRE-ORDER MISSION</span>
                <span>พรีออเดอร์สนามภารกิจ</span>
            </a>

            <a href="/certificate" class="nav-link certificate-btn">
                <span>CERTIFICATE</span>
                <span>เกียรติบัตร</span>
            </a>
        </nav>

        <div class="topbar-actions">
            <a href="/auth/login" class="btn-login">
                <i class="ti ti-lock"></i>
                <span>เข้าสู่ระบบ</span>
            </a>
        </div>

        <!-- MOBILE / TABLET MENU -->
        <div class="mobile-menu" aria-hidden="true">
            <a href="/" class="mobile-menu-link">
                <i class="ti ti-home"></i>
                <span class="mobile-menu-link-text"><strong>HOME</strong><small>หน้าหลัก</small></span>
            </a>

            <a href="/#about" class="mobile-menu-link">
                <i class="ti ti-info-circle"></i>
                <span class="mobile-menu-link-text"><strong>ABOUT US</strong><small>เกี่ยวกับเรา</small></span>
            </a>

            <a href="/#awards" class="mobile-menu-link">
                <i class="ti ti-award"></i>
                <span class="mobile-menu-link-text"><strong>AWARDS</strong><small>รางวัล</small></span>
            </a>

            <button class="mobile-menu-competition-toggle" type="button" aria-expanded="false">
                <i class="ti ti-trophy"></i>
                <span class="mobile-menu-link-text"><strong>COMPETITION</strong><small>การแข่งขัน</small></span>
                <i class="ti ti-chevron-down mobile-chevron"></i>
            </button>

            <div class="mobile-submenu">
                <a href="/#tiers"><i class="ti ti-pencil-plus"></i>สมัครแข่งขัน</a>
                <a href="/competition?view=teams"><i class="ti ti-users"></i>ทีมที่สมัคร</a>
                <a href="/competition?view=board"><i class="ti ti-chart-bar"></i>ผลสรุปคะแนน</a>
            </div>

            <a href="/docs" class="mobile-menu-link active" aria-current="page">
                <i class="ti ti-file-text"></i>
                <span class="mobile-menu-link-text"><strong>DOCUMENT</strong><small>เอกสาร</small></span>
            </a>

            <a href="/preorder" class="mobile-menu-link">
                <i class="ti ti-shopping-cart"></i>
                <span class="mobile-menu-link-text"><strong>PRE-ORDER
                        MISSION</strong><small>พรีออเดอร์สนามภารกิจ</small></span>
            </a>

            <a href="/certificate" class="mobile-menu-link" target="_blank">
                <i class="ti ti-certificate"></i>
                <span class="mobile-menu-link-text"><strong>CERTIFICATE</strong><small>เกียรติบัตร</small></span>
            </a>

            <div class="mobile-menu-divider"></div>

            <a href="/auth/login" class="mobile-menu-link mobile-login">
                <i class="ti ti-lock"></i>
                <span class="mobile-menu-link-text"><strong>เข้าสู่ระบบ</strong><small>Login</small></span>
            </a>
        </div>
    </header>

    <main class="page-shell">

        <section class="docs-hero">
            <div>
                <div class="eyebrow"><i class="ti ti-trophy"></i> ROBO CHALLENGE LEAGUE</div>
                <h1>
                    <span class="title-icon"><i class="ti ti-files"></i></span>
                    เอกสารการแข่งขัน
                </h1>
                <p>ดาวน์โหลดเอกสารโครงการ หนังสือเชิญ และกติกาการแข่งขันในแต่ละรุ่นได้จากหน้านี้
                    กรุณาตรวจสอบเอกสารให้ครบถ้วนก่อนดำเนินการสมัครแข่งขัน</p>
            </div>
            <div class="hero-art" aria-hidden="true"><i class="ti ti-file-certificate"></i></div>
        </section>

        <div class="notice">
            <div class="notice-icon"><i class="ti ti-info-circle"></i></div>
            <div>กรุณาอ่านเอกสารให้ครบถ้วนก่อนสมัครแข่งขัน หากมีข้อสงสัยติดต่อ LINE <strong>@rcl.robo</strong></div>
        </div>

        <div class="content-grid">
            <div class="main-column">

                <!-- เอกสารทั่วไป -->
                <section class="doc-section">
                    <div class="section-head">
                        <div>
                            <h2 class="section-title">เอกสารทั่วไป</h2>
                            <div class="section-subtitle">ข้อมูลหลักสำหรับสถานศึกษา โค้ช และผู้สมัคร</div>
                        </div>
                        <span class="section-count">
                            <%= generalDocs.length %> รายการ
                        </span>
                    </div>

                    <div class="doc-list">
                        <% generalDocs.forEach(function (item) { %>
                            <%- include('_doc-card', { item: item }) %>
                                <% }); %>
                    </div>
                </section>

                <!-- เอกสารแยกรุ่น -->
                <section class="doc-section">
                    <div class="section-head">
                        <div>
                            <h2 class="section-title">เอกสารแยกรุ่น</h2>
                            <div class="section-subtitle">กติกาและวิธีต่อตัวภารกิจของแต่ละรุ่น</div>
                        </div>
                        <span class="section-count">3 รุ่น</span>
                    </div>

                    <div class="tier-tabs" role="tablist" aria-label="เลือกรุ่นการแข่งขัน">
                        <button class="tier-tab t-b active" type="button" role="tab" aria-selected="true"
                            aria-controls="tier-beginner" data-tier="beginner">
                            <span class="tier-dot"></span>Beginner
                        </button>
                        <button class="tier-tab t-i" type="button" role="tab" aria-selected="false"
                            aria-controls="tier-intermediate" data-tier="intermediate">
                            <span class="tier-dot"></span>Intermediate
                        </button>
                        <button class="tier-tab t-a" type="button" role="tab" aria-selected="false"
                            aria-controls="tier-advance" data-tier="advance">
                            <span class="tier-dot"></span>Advance
                        </button>
                    </div>

                    <% tierDocs.forEach(function (t, idx) { %>
                        <div class="tier-content<%= idx === 0 ? ' active' : '' %>" id="tier-<%= t.tier %>"
                            role="tabpanel">
                            <div class="doc-list">
                                <% t.docs.forEach(function (item) { %>
                                    <%- include('_doc-card', { item: item }) %>
                                        <% }); %>
                            </div>
                        </div>
                        <% }); %>
                </section>

            </div>

            <!-- Sidebar -->
            <aside class="side-card">
                <div class="side-card-icon"><i class="ti ti-help"></i></div>
                <h3>ต้องการความช่วยเหลือ?</h3>
                <p>ตรวจสอบรายละเอียดในเอกสารก่อนสมัคร หากยังมีข้อสงสัยสามารถติดต่อทีมงานผ่าน LINE ได้โดยตรง</p>
                <a href="https://line.me/R/ti/p/@rcl.robo" target="_blank" rel="noopener" class="side-link">
                    <span><i class="ti ti-brand-line"></i> LINE @rcl.robo</span>
                    <i class="ti ti-arrow-up-right"></i>
                </a>
                <div class="side-meta">
                    <div><i class="ti ti-shield-check"></i> เอกสารจากผู้จัดการแข่งขัน</div>
                    <div><i class="ti ti-download"></i> เปิดดูและดาวน์โหลดได้ทันที</div>
                    <div><i class="ti ti-device-mobile"></i> รองรับมือถือและแท็บเล็ต</div>
                </div>
            </aside>
        </div>

    </main>

    <footer class="footer">
        <img src="/RCL Logo.png" alt="RCL">
        <div class="footer-text">ROBO CHALLENGE LEAGUE — สร้างสรรค์นวัตกรรม พัฒนาทักษะ สู่อนาคต</div>
    </footer>

    <script>
        /* Tier tabs */
        (function () {
            var tabs = Array.prototype.slice.call(document.querySelectorAll('.tier-tab'));

            function activate(tab) {
                tabs.forEach(function (t) {
                    var on = t === tab;
                    t.classList.toggle('active', on);
                    t.setAttribute('aria-selected', String(on));
                    var panel = document.getElementById('tier-' + t.dataset.tier);
                    if (panel) panel.classList.toggle('active', on);
                });
            }

            tabs.forEach(function (tab, i) {
                tab.addEventListener('click', function () { activate(tab); });
                tab.addEventListener('keydown', function (e) {
                    var next = null;
                    if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
                    if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
                    if (next) { e.preventDefault(); next.focus(); activate(next); }
                });
            });
        })();

        /* Mobile / tablet hamburger menu */
        (function () {
            var toggle = document.querySelector('.mobile-menu-toggle');
            var mobileMenu = document.querySelector('.mobile-menu');
            var competitionToggle = document.querySelector('.mobile-menu-competition-toggle');
            var subMenu = document.querySelector('.mobile-submenu');
            if (!toggle || !mobileMenu) return;

            function closeMobileMenu() {
                toggle.classList.remove('is-open');
                toggle.setAttribute('aria-expanded', 'false');
                toggle.setAttribute('aria-label', 'เปิดเมนู');
                mobileMenu.classList.remove('is-open');
                mobileMenu.setAttribute('aria-hidden', 'true');
            }

            toggle.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = mobileMenu.classList.toggle('is-open');
                toggle.classList.toggle('is-open', isOpen);
                toggle.setAttribute('aria-expanded', String(isOpen));
                toggle.setAttribute('aria-label', isOpen ? 'ปิดเมนู' : 'เปิดเมนู');
                mobileMenu.setAttribute('aria-hidden', String(!isOpen));
            });

            if (competitionToggle && subMenu) {
                competitionToggle.addEventListener('click', function () {
                    var isOpen = subMenu.classList.toggle('is-open');
                    competitionToggle.classList.toggle('is-open', isOpen);
                    competitionToggle.setAttribute('aria-expanded', String(isOpen));
                });
            }

            mobileMenu.querySelectorAll('a').forEach(function (link) {
                link.addEventListener('click', closeMobileMenu);
            });

            document.addEventListener('click', function (e) {
                if (!mobileMenu.contains(e.target) && !toggle.contains(e.target)) closeMobileMenu();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeMobileMenu();
            });

            window.addEventListener('resize', function () {
                if (window.innerWidth > 1100) closeMobileMenu();
            });
        })();

        /* Desktop dropdown (hover with small delay, click also works) */
        document.querySelectorAll('.dropdown').forEach(function (dd) {
            var menu = dd.querySelector('.dropdown-menu');
            var btn = dd.querySelector('button');
            var timer;

            function show() { clearTimeout(timer); menu.style.display = 'block'; }
            function hideSoon() { timer = setTimeout(function () { menu.style.display = 'none'; }, 200); }

            dd.addEventListener('mouseenter', show);
            dd.addEventListener('mouseleave', hideSoon);
            btn.addEventListener('click', function () {
                menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
            });
        });
    </script>

</body>

</html>