<% var tierKey=activeTier==='beginner' ? 'beginner' : activeTier==='intermediate' ? 'intermediate' : 'advance' ; var
    isTeams=view==='teams' ; %>
    <!DOCTYPE html>
    <html lang="th">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
            <%= isTeams ? 'ทีมที่สมัคร' : 'ผลสรุปคะแนน' %> — Robo Challenge League
        </title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800&family=Sarabun:wght@400;500;600;700;800&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/css/style.css">
        <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
        <style>
            /* =========================================================
       RCL 2026 — COMPETITION PAGE (teams / board)
       01 Tokens / Reset
       02 Topbar + Dropdown   (same as home page)
       03 Mobile menu         (same as home page)
       04 Page header / toggles
       05 Card / search / table
       06 Board
       07 Footer
       08 Responsive
    ========================================================= */

            /* 01 — TOKENS / RESET */
            :root {
                --primary: #2563EB;
                --primary-soft: #EFF6FF;
                --navy: #0F172A;
                --text: #172033;
                --muted: #64748B;
                --line: #E5EAF2;
                --page: #F4F7FB;
                --shadow-sm: 0 4px 14px rgba(15, 23, 42, .05);
                --shadow-md: 0 12px 30px rgba(15, 23, 42, .08);
                --content: 1180px;
                --gutter: 24px;
                --topbar-h: 82px;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                min-width: 320px;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                overflow-x: hidden;
                color: #1E293B;
                background: var(--page);
                font-family: 'Kanit', 'Sarabun', sans-serif;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            button,
            input {
                font: inherit;
            }

            :focus-visible {
                outline: 3px solid #93C5FD;
                outline-offset: 2px;
            }

            /* 02 — TOPBAR + DROPDOWN (solid on this page — no hero behind it) */
            .topbar {
                position: fixed;
                inset: 0 0 auto;
                z-index: 1000;
                height: var(--topbar-h);
                padding: 0 30px;
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255, 255, 255, .92);
                border-bottom: 1px solid rgba(226, 232, 240, .9);
                box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
            }

            .topbar-logo {
                flex: 0 0 auto;
                display: inline-flex;
                align-items: center;
            }

            .topbar-logo img {
                display: block;
                width: auto;
                height: 58px;
                max-width: 150px;
                object-fit: contain;
            }

            .topbar-nav {
                flex: 1 1 auto;
                min-width: 0;
                margin-left: 18px;
                display: flex;
                align-items: center;
                gap: 2px;
            }

            .nav-link {
                min-height: 52px;
                padding: 0 14px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 2px;
                border: 0;
                border-radius: 11px;
                background: transparent;
                color: #334155;
                font-family: 'Kanit', sans-serif;
                font-weight: 700;
                letter-spacing: 1px;
                line-height: 1.15;
                white-space: nowrap;
                cursor: pointer;
                transition: color .2s ease, transform .2s ease;
            }

            .nav-link span:first-child {
                font-size: 17px;
                font-weight: 800;
            }

            .nav-link span:last-child {
                display: flex;
                align-items: center;
                gap: 5px;
                margin-top: 1px;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: .2px;
            }

            .nav-link:hover,
            .nav-link.active {
                color: var(--primary);
                transform: translateY(-1px);
            }

            .certificate-btn {
                min-width: 150px;
                padding: 8px 16px;
                border: 1px solid #F6D365;
                border-radius: 999px;
                background: linear-gradient(135deg, #FFF8D8, #FFF0B8);
                color: #92400E;
                box-shadow: 0 6px 16px rgba(180, 120, 20, .12);
            }

            .certificate-btn:hover {
                background: linear-gradient(135deg, #FDE68A, #FCD34D);
                border-color: #F59E0B;
                color: #78350F;
            }

            .topbar-actions {
                flex: 0 0 auto;
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .btn-login {
                min-height: 52px;
                padding: 0 18px;
                display: inline-flex;
                align-items: center;
                gap: 7px;
                border: 1px solid #E2E8F0;
                border-radius: 11px;
                background: #fff;
                color: #334155;
                white-space: nowrap;
                transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
            }

            .btn-login:hover {
                background: #F8FAFC;
                transform: translateY(-1px);
                box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
            }

            .dropdown {
                position: relative;
            }

            .dropdown-menu {
                position: absolute;
                top: calc(100% + 8px);
                left: 0;
                z-index: 1100;
                display: none;
                min-width: 205px;
                padding: 8px;
                background: rgba(255, 255, 255, .98);
                border: 1px solid #E2E8F0;
                border-radius: 14px;
                box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
            }

            .dropdown-item {
                min-height: 42px;
                padding: 0 12px;
                display: flex;
                align-items: center;
                gap: 10px;
                border-radius: 10px;
                color: #334155;
                font-size: 14px;
                font-weight: 700;
                white-space: nowrap;
            }

            .dropdown-item i {
                color: #64748B;
                font-size: 17px;
            }

            .dropdown-item:hover,
            .dropdown-item.active {
                background: var(--primary-soft);
                color: var(--primary);
            }

            .dropdown-item.active i {
                color: var(--primary);
            }

            /* 03 — MOBILE MENU (shown ≤1100px) */
            .mobile-menu-toggle,
            .mobile-menu {
                display: none;
            }

            .mobile-menu-toggle {
                margin-left: auto;
                width: 44px;
                height: 44px;
                flex: 0 0 44px;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 5px;
                border: 1px solid rgba(148, 163, 184, .35);
                border-radius: 12px;
                background: rgba(255, 255, 255, .92);
                color: #1E3A8A;
                box-shadow: 0 5px 16px rgba(15, 23, 42, .08);
                cursor: pointer;
                -webkit-tap-highlight-color: transparent;
            }

            .mobile-menu-toggle span {
                width: 21px;
                height: 2px;
                border-radius: 999px;
                background: currentColor;
                transition: transform .22s ease, opacity .18s ease;
            }

            .mobile-menu-toggle.is-open span:nth-child(1) {
                transform: translateY(7px) rotate(45deg);
            }

            .mobile-menu-toggle.is-open span:nth-child(2) {
                opacity: 0;
            }

            .mobile-menu-toggle.is-open span:nth-child(3) {
                transform: translateY(-7px) rotate(-45deg);
            }

            .mobile-menu {
                position: fixed;
                top: calc(var(--topbar-h) + 6px);
                right: 12px;
                z-index: 999;
                width: min(380px, calc(100% - 24px));
                max-height: calc(100dvh - var(--topbar-h) - 18px);
                overflow-y: auto;
                padding: 8px;
                visibility: hidden;
                opacity: 0;
                pointer-events: none;
                transform: translateY(-8px) scale(.985);
                transform-origin: top right;
                background: rgba(255, 255, 255, .98);
                border: 1px solid #DBEAFE;
                border-radius: 18px;
                box-shadow: 0 20px 50px rgba(15, 23, 42, .18);
                transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
            }

            .mobile-menu.is-open {
                visibility: visible;
                opacity: 1;
                pointer-events: auto;
                transform: none;
            }

            .mobile-menu-link,
            .mobile-menu-competition-toggle {
                width: 100%;
                min-height: 50px;
                padding: 9px 12px;
                display: flex;
                align-items: center;
                gap: 11px;
                border: 0;
                border-radius: 12px;
                background: transparent;
                color: #334155;
                font-family: 'Kanit', sans-serif;
                font-size: 15px;
                font-weight: 700;
                text-align: left;
                cursor: pointer;
            }

            .mobile-menu-link:hover,
            .mobile-menu-competition-toggle:hover,
            .mobile-menu-competition-toggle.active {
                color: var(--primary);
                background: var(--primary-soft);
            }

            .mobile-menu-link>i,
            .mobile-menu-competition-toggle>i:first-child {
                width: 28px;
                flex: 0 0 28px;
                display: grid;
                place-items: center;
                color: var(--primary);
                font-size: 19px;
            }

            .mobile-menu-link-text {
                min-width: 0;
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }

            .mobile-menu-link-text strong {
                font-size: 15px;
                font-weight: 800;
            }

            .mobile-menu-link-text small {
                margin-top: 2px;
                color: #64748B;
                font-size: 11px;
                font-weight: 500;
            }

            .mobile-chevron {
                margin-left: auto;
                color: #64748B;
                font-size: 17px;
                transition: transform .2s ease;
            }

            .mobile-menu-competition-toggle.is-open .mobile-chevron {
                transform: rotate(180deg);
            }

            .mobile-submenu {
                display: none;
                margin: 0 8px 6px 51px;
                padding: 5px;
                background: #F8FAFC;
                border: 1px solid #E2E8F0;
                border-radius: 12px;
            }

            .mobile-submenu.is-open {
                display: block;
            }

            .mobile-submenu a {
                min-height: 42px;
                padding: 8px 10px;
                display: flex;
                align-items: center;
                gap: 9px;
                border-radius: 9px;
                color: #475569;
                font-size: 13px;
                font-weight: 600;
            }

            .mobile-submenu a:hover,
            .mobile-submenu a.active {
                color: var(--primary);
                background: var(--primary-soft);
            }

            .mobile-submenu a i {
                color: #64748B;
                font-size: 16px;
            }

            .mobile-menu-divider {
                height: 1px;
                margin: 6px 4px;
                background: #E2E8F0;
            }

            .mobile-login>i {
                color: #475569 !important;
            }

            /* 04 — PAGE HEADER / TOGGLES */
            .page {
                flex: 1;
                width: 100%;
                max-width: calc(var(--content) + var(--gutter) * 2);
                margin: 0 auto;
                padding: calc(var(--topbar-h) + 40px) var(--gutter) 64px;
            }

            .page-hd {
                margin-bottom: 22px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                flex-wrap: wrap;
            }

            .page-title {
                position: relative;
                padding-left: 16px;
                color: var(--text);
                font-size: 32px;
                font-weight: 800;
                line-height: 1.2;
            }

            .page-title::before {
                content: '';
                position: absolute;
                left: 0;
                top: 5px;
                bottom: 5px;
                width: 5px;
                border-radius: 999px;
                background: linear-gradient(180deg, #60A5FA, #2563EB);
            }

            .page-title span {
                color: var(--primary);
            }

            .view-toggle {
                display: flex;
                gap: 4px;
                padding: 4px;
                background: rgba(255, 255, 255, .9);
                border: 1px solid #E2E8F0;
                border-radius: 13px;
                box-shadow: var(--shadow-sm);
            }

            .view-btn {
                min-height: 44px;
                padding: 0 18px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                border-radius: 10px;
                color: #64748B;
                font-size: 17px;
                font-weight: 600;
                transition: all .18s ease;
            }

            .view-btn:hover {
                color: var(--text);
                background: #F8FAFC;
            }

            .view-btn.active {
                color: #fff;
                background: #DE8705;
                box-shadow: 0 6px 14px rgba(222, 135, 5, .28);
            }

            .tier-tabs {
                margin-bottom: 20px;
                padding: 7px;
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 8px;
                background: rgba(255, 255, 255, .9);
                border: 1px solid #E2E8F0;
                border-radius: 16px;
                box-shadow: var(--shadow-sm);
            }

            .tier-tab {
                --c: #16A34A;
                --c2: #15803D;
                min-height: 48px;
                padding: 0 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                border-radius: 11px;
                color: #64748B;
                font-size: 17px;
                font-weight: 600;
                white-space: nowrap;
                transition: all .18s ease;
            }

            .tier-tab.tier-intermediate {
                --c: #2563EB;
                --c2: #1D4ED8;
            }

            .tier-tab.tier-advance {
                --c: #EA580C;
                --c2: #C2410C;
            }

            .tier-tab:hover {
                color: var(--c);
                background: #F8FAFC;
            }

            .tier-dot {
                flex: 0 0 auto;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--c);
            }

            .tier-tab.active {
                color: #fff;
                background: linear-gradient(135deg, var(--c), var(--c2));
                box-shadow: 0 8px 18px color-mix(in srgb, var(--c) 28%, transparent);
            }

            .tier-tab.active .tier-dot {
                background: #fff;
            }

            /* 05 — CARD / SEARCH / TABLE */
            .card {
                --tier: #16A34A;
                --head-a: #ECFDF5;
                --head-b: #D1FAE5;
                overflow: hidden;
                background: #fff;
                border: 1px solid #E2E8F0;
                border-radius: 18px;
                box-shadow: var(--shadow-md);
            }

            .card.tier-intermediate {
                --tier: #2563EB;
                --head-a: #DBEAFE;
                --head-b: #BFDBFE;
            }

            .card.tier-advance {
                --tier: #EA580C;
                --head-a: #FFEDD5;
                --head-b: #FED7AA;
            }

            .search-row {
                padding: 18px 22px;
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
                background: linear-gradient(180deg, #fff, #FBFCFE);
                border-bottom: 1px solid #EDF1F6;
            }

            .search-box {
                flex: 1;
                min-width: 240px;
                min-height: 48px;
                padding: 0 14px;
                display: flex;
                align-items: center;
                gap: 10px;
                background: #F8FAFC;
                border: 1px solid #DDE5EF;
                border-radius: 12px;
                transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
            }

            .search-box:focus-within {
                background: #fff;
                border-color: #93C5FD;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, .09);
            }

            .search-box i {
                color: #94A3B8;
                font-size: 17px;
            }

            .search-box input {
                flex: 1;
                min-width: 0;
                border: none;
                outline: none;
                background: transparent;
                color: var(--text);
                font-size: 15px;
            }

            .search-box input::placeholder {
                color: #9AA8BA;
            }

            .count-badge {
                min-height: 32px;
                padding: 0 12px;
                display: inline-flex;
                align-items: center;
                border-radius: 999px;
                background: var(--primary-soft);
                color: var(--primary);
                font-size: 13px;
                font-weight: 700;
                white-space: nowrap;
            }

            .time-info {
                display: flex;
                align-items: center;
                gap: 5px;
                color: #94A3B8;
                font-size: 12px;
                white-space: nowrap;
            }

            .table-scroll {
                width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            table {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0;
            }

            th {
                padding: 14px 16px;
                text-align: left;
                background: linear-gradient(180deg, var(--head-a), var(--head-b));
                border-bottom: 1px solid #E5EAF2;
                color: var(--tier);
                font-size: 17px;
                font-weight: 700;
                white-space: nowrap;
            }

            td {
                padding: 16px;
                background: #fff;
                border-bottom: 1px solid #EEF2F6;
                color: #334155;
                font-size: 14px;
                vertical-align: middle;
                transition: background .16s ease;
            }

            tbody tr:last-child td {
                border-bottom: none;
            }

            tbody tr:hover td {
                background: #F8FBFF;
            }

            .col-num {
                width: 72px;
                text-align: center;
            }

            td.col-num {
                color: #94A3B8;
                font-size: 18px;
            }

            .c-beginner {
                color: #16A34A !important;
            }

            .c-intermediate {
                color: #2563EB !important;
            }

            .c-advance {
                color: #EA580C !important;
            }

            .team-name {
                font-size: 18px;
                font-weight: 700;
                line-height: 1.25;
            }

            .team-id {
                margin-top: 3px;
                font-size: 12px;
                font-weight: 600;
                opacity: .85;
            }

            .team-inst {
                display: flex;
                align-items: flex-start;
                gap: 6px;
                font-size: 17px;
                line-height: 1.4;
            }

            .team-inst i {
                flex: 0 0 auto;
                margin-top: 2px;
                font-size: 18px;
            }

            .empty {
                padding: 58px 24px;
                color: #94A3B8;
                font-size: 15px;
                text-align: center;
            }

            .empty i {
                display: block;
                margin-bottom: 10px;
                font-size: 40px;
                opacity: .45;
            }

            /* 06 — BOARD */
            .rank-cell {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 16px;
                font-weight: 800;
            }

            .rank-medal {
                font-size: 22px;
            }

            .rank-gold {
                color: #D97706;
            }

            .rank-silver {
                color: #64748B;
            }

            .rank-bronze {
                color: #92400E;
            }

            .rank-other {
                color: #94A3B8;
            }

            .score-num {
                color: var(--primary);
                font-size: 17px;
                font-weight: 800;
            }

            .score-time {
                display: block;
                margin-top: 2px;
                color: #94A3B8;
                font-size: 11px;
            }

            .best-score {
                color: var(--text);
                font-size: 21px;
                font-weight: 900;
            }

            .score-empty {
                color: #CBD5E1;
            }

            .team-sub {
                margin-top: 2px;
                color: #94A3B8;
                font-size: 12px;
            }

            .bar-bg {
                max-width: 110px;
                height: 5px;
                margin-top: 7px;
                overflow: hidden;
                background: #E2E8F0;
                border-radius: 999px;
            }

            .bar-fill {
                height: 100%;
                border-radius: 999px;
                background: #2563EB;
            }

            .bar-fill.rank-1 {
                background: #D97706;
            }

            .bar-fill.rank-2 {
                background: #94A3B8;
            }

            .bar-fill.rank-3 {
                background: #92400E;
            }

            .board-mobile {
                display: none;
                padding: 10px;
            }

            .board-mobile-item {
                margin-bottom: 10px;
                padding: 15px;
                background: #fff;
                border: 1px solid #E2E8F0;
                border-radius: 15px;
                box-shadow: 0 5px 16px rgba(15, 23, 42, .045);
            }

            .board-mobile-item:last-child {
                margin-bottom: 0;
            }

            .board-top {
                margin-bottom: 12px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
            }

            .board-rank-left {
                min-width: 0;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .board-pos {
                flex: 0 0 auto;
                font-size: 16px;
                font-weight: 900;
            }

            .board-name {
                font-size: 16px;
                font-weight: 700;
                line-height: 1.25;
            }

            .board-inst {
                margin-top: 3px;
                color: #94A3B8;
                font-size: 11px;
            }

            .board-best-score {
                color: var(--primary);
                font-size: 28px;
                font-weight: 900;
                line-height: 1;
                text-align: right;
            }

            .board-best-time {
                margin-top: 4px;
                color: #94A3B8;
                font-size: 10px;
                text-align: right;
            }

            .board-rounds {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }

            .board-round {
                padding: 11px 8px;
                background: #F8FAFC;
                border: 1px solid #EEF2F6;
                border-radius: 11px;
                text-align: center;
            }

            .board-round-label {
                margin-bottom: 3px;
                color: #64748B;
                font-size: 11px;
            }

            .board-round-score {
                color: var(--text);
                font-size: 19px;
                font-weight: 800;
            }

            .board-round-time {
                color: #94A3B8;
                font-size: 10px;
            }

            /* 07 — FOOTER */
            .footer {
                padding: 22px 20px;
                background: #1E293B;
                text-align: center;
            }

            .footer img {
                height: 36px;
                margin-bottom: 8px;
                object-fit: contain;
            }

            .footer-text {
                color: rgba(255, 255, 255, .5);
                font-size: 12px;
                letter-spacing: .35px;
            }

            @media (prefers-reduced-motion: reduce) {

                *,
                *::before,
                *::after {
                    transition: none !important;
                }
            }

            /* 08 — RESPONSIVE */
            @media (min-width: 1440px) {
                .topbar {
                    padding-inline: 48px;
                }

                .topbar-nav {
                    margin-left: 22px;
                    gap: 4px;
                }

                .nav-link {
                    padding-inline: 16px;
                }
            }

            @media (max-width: 1199px) {
                :root {
                    --gutter: 20px;
                }

                .topbar {
                    padding-inline: 20px;
                }

                .topbar-logo img {
                    height: 54px;
                    max-width: 136px;
                }

                .topbar-nav {
                    margin-left: 10px;
                    gap: 0;
                }

                .nav-link {
                    padding-inline: 9px;
                    letter-spacing: .5px;
                }

                .nav-link span:first-child {
                    font-size: 15px;
                }

                .nav-link span:last-child {
                    font-size: 10px;
                }

                .certificate-btn {
                    min-width: 126px;
                    padding-inline: 12px;
                }

                .btn-login {
                    padding-inline: 13px;
                    font-size: 14px;
                }
            }

            @media (max-width: 1100px) {
                :root {
                    --topbar-h: 70px;
                }

                .topbar-nav,
                .topbar-actions {
                    display: none;
                }

                .mobile-menu-toggle {
                    display: flex;
                }

                .mobile-menu {
                    display: block;
                }

                .topbar-logo img {
                    height: 50px;
                    max-width: 124px;
                }
            }

            @media (max-width: 900px) {
                .page {
                    padding-top: calc(var(--topbar-h) + 28px);
                }

                .page-hd {
                    flex-direction: column;
                    align-items: stretch;
                }

                .view-toggle {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                }
            }

            @media (max-width: 639px) {
                :root {
                    --gutter: 10px;
                    --topbar-h: 60px;
                }

                .topbar {
                    padding: 0 12px;
                }

                .topbar-logo img {
                    height: 42px;
                    max-width: 90px;
                }

                .page {
                    padding-top: calc(var(--topbar-h) + 22px);
                    padding-bottom: 32px;
                }

                .page-hd {
                    margin-bottom: 16px;
                    gap: 14px;
                }

                .page-title {
                    padding-left: 14px;
                    font-size: 26px;
                }

                .page-title::before {
                    width: 4px;
                }

                .view-btn {
                    min-height: 46px;
                    padding: 0 8px;
                    font-size: 15px;
                }

                .tier-tabs {
                    margin-bottom: 14px;
                    padding: 5px;
                    gap: 5px;
                    border-radius: 14px;
                }

                .tier-tab {
                    min-height: 46px;
                    padding: 0 4px;
                    gap: 5px;
                    font-size: 13px;
                }

                .tier-dot {
                    width: 6px;
                    height: 6px;
                }

                .card {
                    border-radius: 16px;
                }

                .search-row {
                    padding: 12px;
                    gap: 8px;
                }

                .search-box {
                    width: 100%;
                    min-width: 0;
                    flex-basis: 100%;
                }

                /* Teams: keep the real table, scroll sideways */
                .teams-table {
                    min-width: 560px;
                    table-layout: fixed;
                }

                .teams-table .col-num {
                    width: 54px;
                }

                .teams-table .col-name {
                    width: 220px;
                }

                th {
                    padding: 12px;
                    font-size: 14px;
                }

                td {
                    padding: 14px 12px;
                }

                .team-name {
                    font-size: 16px;
                }

                .team-inst {
                    font-size: 15px;
                }

                /* Board: cards instead of table */
                .board-table {
                    display: none;
                }

                .board-mobile {
                    display: block;
                }
            }

            @media (max-width: 380px) {
                .page-title {
                    font-size: 23px;
                }

                .view-btn {
                    font-size: 14px;
                }

                .tier-tab {
                    font-size: 11px;
                }

                .board-best-score {
                    font-size: 24px;
                }
            }
        </style>
    </head>

    <body>

        <!-- TOPBAR -->
        <header class="topbar">
            <a href="/" class="topbar-logo">
                <img src="/RCL Logo.png" alt="RCL">
            </a>

            <button class="mobile-menu-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav class="topbar-nav">
                <a href="/" class="nav-link">
                    <span>HOME</span>
                    <span>หน้าหลัก</span>
                </a>

                <a href="/#about" class="nav-link">
                    <span>ABOUT US</span>
                    <span>เกี่ยวกับเรา</span>
                </a>

                <a href="/#awards" class="nav-link">
                    <span>AWARDS</span>
                    <span>รางวัล</span>
                </a>

                <div class="dropdown">
                    <button class="nav-link active" type="button">
                        <span>COMPETITION</span>
                        <span>การแข่งขัน <i class="ti ti-chevron-down"></i></span>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/#tiers" class="dropdown-item"><i class="ti ti-pencil-plus"></i>สมัครแข่งขัน</a>
                        <a href="/competition?view=teams" class="dropdown-item <%= isTeams ? 'active' : '' %>"><i
                                class="ti ti-users"></i>ทีมที่สมัคร</a>
                        <a href="/competition?view=board" class="dropdown-item <%= !isTeams ? 'active' : '' %>"><i
                                class="ti ti-chart-bar"></i>ผลสรุปคะแนน</a>
                    </div>
                </div>

                <a href="/docs" class="nav-link">
                    <span>DOCUMENT</span>
                    <span>เอกสาร</span>
                </a>

                <a href="/preorder" class="nav-link">
                    <span>PRE-ORDER MISSION</span>
                    <span>พรีออเดอร์สนามภารกิจ</span>
                </a>

                <a href="/certificate" class="nav-link certificate-btn">
                    <span>CERTIFICATE</span>
                    <span>เกียรติบัตร</span>
                </a>
            </nav>

            <div class="topbar-actions">
                <a href="/auth/login" class="btn-login">
                    <i class="ti ti-lock"></i>
                    <span>เข้าสู่ระบบ</span>
                </a>
            </div>

            <!-- MOBILE / TABLET MENU -->
            <div class="mobile-menu" aria-hidden="true">
                <a href="/" class="mobile-menu-link">
                    <i class="ti ti-home"></i>
                    <span class="mobile-menu-link-text"><strong>HOME</strong><small>หน้าหลัก</small></span>
                </a>

                <a href="/#about" class="mobile-menu-link">
                    <i class="ti ti-info-circle"></i>
                    <span class="mobile-menu-link-text"><strong>ABOUT US</strong><small>เกี่ยวกับเรา</small></span>
                </a>

                <a href="/#awards" class="mobile-menu-link">
                    <i class="ti ti-award"></i>
                    <span class="mobile-menu-link-text"><strong>AWARDS</strong><small>รางวัล</small></span>
                </a>

                <button class="mobile-menu-competition-toggle active" type="button" aria-expanded="false">
                    <i class="ti ti-trophy"></i>
                    <span class="mobile-menu-link-text"><strong>COMPETITION</strong><small>การแข่งขัน</small></span>
                    <i class="ti ti-chevron-down mobile-chevron"></i>
                </button>

                <div class="mobile-submenu">
                    <a href="/#tiers"><i class="ti ti-pencil-plus"></i>สมัครแข่งขัน</a>
                    <a href="/competition?view=teams" class="<%= isTeams ? 'active' : '' %>"><i
                            class="ti ti-users"></i>ทีมที่สมัคร</a>
                    <a href="/competition?view=board" class="<%= !isTeams ? 'active' : '' %>"><i
                            class="ti ti-chart-bar"></i>ผลสรุปคะแนน</a>
                </div>

                <a href="/docs" class="mobile-menu-link">
                    <i class="ti ti-file-text"></i>
                    <span class="mobile-menu-link-text"><strong>DOCUMENT</strong><small>เอกสาร</small></span>
                </a>

                <a href="/preorder" class="mobile-menu-link">
                    <i class="ti ti-shopping-cart"></i>
                    <span class="mobile-menu-link-text"><strong>PRE-ORDER
                            MISSION</strong><small>พรีออเดอร์สนามภารกิจ</small></span>
                </a>

                <a href="/certificate" class="mobile-menu-link" target="_blank">
                    <i class="ti ti-certificate"></i>
                    <span class="mobile-menu-link-text"><strong>CERTIFICATE</strong><small>เกียรติบัตร</small></span>
                </a>

                <div class="mobile-menu-divider"></div>

                <a href="/auth/login" class="mobile-menu-link mobile-login">
                    <i class="ti ti-lock"></i>
                    <span class="mobile-menu-link-text"><strong>เข้าสู่ระบบ</strong><small>Login</small></span>
                </a>
            </div>
        </header>

        <main class="page">
            <div class="page-hd">
                <h1 class="page-title">
                    <% if (isTeams) { %><span>ทีม</span>ที่สมัคร<% } else { %><span>ผลสรุป</span>คะแนน<% } %>
                </h1>

                <div class="view-toggle">
                    <a href="/competition?view=teams&tier=<%= activeTier %>"
                        class="view-btn <%= isTeams ? 'active' : '' %>">
                        <i class="ti ti-users"></i> ทีมที่สมัคร
                    </a>
                    <a href="/competition?view=board&tier=<%= activeTier %>"
                        class="view-btn <%= !isTeams ? 'active' : '' %>">
                        <i class="ti ti-trophy"></i> ผลสรุปคะแนน
                    </a>
                </div>
            </div>

            <!-- Tier tabs -->
            <nav class="tier-tabs" aria-label="เลือกรุ่น">
                <a href="/competition?view=<%= view %>&tier=beginner"
                    class="tier-tab tier-beginner <%= tierKey === 'beginner' ? 'active' : '' %>">
                    <span class="tier-dot"></span>Beginner
                </a>
                <a href="/competition?view=<%= view %>&tier=intermediate"
                    class="tier-tab tier-intermediate <%= tierKey === 'intermediate' ? 'active' : '' %>">
                    <span class="tier-dot"></span>Intermediate
                </a>
                <a href="/competition?view=<%= view %>&tier=advance"
                    class="tier-tab tier-advance <%= tierKey === 'advance' ? 'active' : '' %>">
                    <span class="tier-dot"></span>Advance
                </a>
            </nav>

            <section class="card tier-<%= tierKey %>">
                <% if (isTeams) { %>

                    <!-- ================= TEAMS ================= -->
                    <div class="search-row">
                        <label class="search-box">
                            <i class="ti ti-search"></i>
                            <input id="teamSearch" type="search" placeholder="ค้นหา ID ชื่อทีม หรือสถาบัน..."
                                autocomplete="off">
                        </label>
                        <span class="count-badge" id="visibleCount">
                            <%= teams ? teams.length : 0 %> ทีม
                        </span>
                        <span class="time-info"><i class="ti ti-clock"></i>
                            <%= timeStr %>
                        </span>
                    </div>

                    <div class="table-scroll">
                        <table class="teams-table">
                            <thead>
                                <tr>
                                    <th class="col-num">#</th>
                                    <th class="col-name">ชื่อทีม</th>
                                    <th>สถาบัน</th>
                                </tr>
                            </thead>
                            <tbody id="teamTableBody">
                                <% if (!teams || teams.length===0) { %>
                                    <tr>
                                        <td colspan="3">
                                            <div class="empty"><i class="ti ti-robot-off"></i>ยังไม่มีทีมในรุ่นนี้</div>
                                        </td>
                                    </tr>
                                    <% } else { %>
                                        <% teams.forEach(function (t, i) { var c='c-' + (t.tier || tierKey); %>
                                            <tr
                                                data-search="<%= ((t.id || '') + ' ' + (t.name || '') + ' ' + (t.institution || '')).toLowerCase() %>">
                                                <td class="col-num">
                                                    <%= i + 1 %>
                                                </td>
                                                <td>
                                                    <div class="team-name <%= c %>">
                                                        <%= t.name %>
                                                    </div>
                                                    <div class="team-id <%= c %>">
                                                        <%= t.id %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="team-inst <%= c %>">
                                                        <i class="ti ti-school"></i>
                                                        <span>
                                                            <%= t.institution || '—' %>
                                                        </span>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <tr id="noResult" hidden>
                                                    <td colspan="3">
                                                        <div class="empty"><i
                                                                class="ti ti-search-off"></i>ไม่พบทีมที่ค้นหา</div>
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% } else { %>

                        <!-- ================= BOARD: DESKTOP ================= -->
                        <div class="table-scroll board-table">
                            <table>
                                <thead>
                                    <tr>
                                        <th>อันดับ</th>
                                        <th>ชื่อทีม</th>
                                        <th>รอบที่ 1</th>
                                        <th>รอบที่ 2</th>
                                        <th>คะแนนที่ดีที่สุด</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!ranked || ranked.length===0) { %>
                                        <tr>
                                            <td colspan="5">
                                                <div class="empty"><i class="ti ti-trophy-off"></i>ยังไม่มีผลการแข่งขัน
                                                </div>
                                            </td>
                                        </tr>
                                        <% } else { %>
                                            <% ranked.forEach(function (t, i) { var c='c-' + (t.tier || tierKey); var
                                                r1=parseFloat(t.r1_score), r2=parseFloat(t.r2_score),
                                                best=parseFloat(t.best_score); %>
                                                <tr>
                                                    <td>
                                                        <div class="rank-cell">
                                                            <% if (i===0) { %><span class="rank-medal">🥇</span><span
                                                                    class="rank-gold">1</span>
                                                                <% } else if (i===1) { %><span
                                                                        class="rank-medal">🥈</span><span
                                                                        class="rank-silver">2</span>
                                                                    <% } else if (i===2) { %><span
                                                                            class="rank-medal">🥉</span><span
                                                                            class="rank-bronze">3</span>
                                                                        <% } else { %><span class="rank-other">#<%= i +
                                                                                    1 %></span>
                                                                            <% } %>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="team-name <%= c %>">
                                                            <%= t.name %>
                                                        </div>
                                                        <div class="team-sub">
                                                            <%= t.institution || '' %>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <% if (r1> 0) { %>
                                                            <span class="score-num">
                                                                <%= r1 %> pts
                                                            </span>
                                                            <span class="score-time">
                                                                <%= t.r1_time ? parseFloat(t.r1_time).toFixed(2)
                                                                    + ' sec' : '' %>
                                                            </span>
                                                            <% } else { %><span class="score-empty">—</span>
                                                                <% } %>
                                                    </td>
                                                    <td>
                                                        <% if (r2> 0) { %>
                                                            <span class="score-num">
                                                                <%= r2 %> pts
                                                            </span>
                                                            <span class="score-time">
                                                                <%= t.r2_time ? parseFloat(t.r2_time).toFixed(2)
                                                                    + ' sec' : '' %>
                                                            </span>
                                                            <% } else { %><span class="score-empty">—</span>
                                                                <% } %>
                                                    </td>
                                                    <td>
                                                        <% if (best> 0) { %>
                                                            <span class="best-score">
                                                                <%= best %> pts
                                                            </span>
                                                            <span class="score-time">
                                                                <%= t.best_time ? parseFloat(t.best_time).toFixed(2)
                                                                    + ' sec' : '' %>
                                                            </span>
                                                            <div class="bar-bg">
                                                                <div class="bar-fill <%= i < 3 ? 'rank-' + (i + 1) : '' %>"
                                                                    style="width:<%= maxScore > 0 ? Math.round(best / maxScore * 100) : 0 %>%">
                                                                </div>
                                                            </div>
                                                            <% } else { %><span class="score-empty">—</span>
                                                                <% } %>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- ================= BOARD: MOBILE ================= -->
                        <div class="board-mobile">
                            <% if (!ranked || ranked.length===0) { %>
                                <div class="empty"><i class="ti ti-trophy-off"></i>ยังไม่มีผลการแข่งขัน</div>
                                <% } else { %>
                                    <% ranked.forEach(function (t, i) { var c='c-' + (t.tier || tierKey); var
                                        r1=parseFloat(t.r1_score), r2=parseFloat(t.r2_score),
                                        best=parseFloat(t.best_score); %>
                                        <div class="board-mobile-item">
                                            <div class="board-top">
                                                <div class="board-rank-left">
                                                    <% if (i===0) { %><span class="rank-medal">🥇</span><span
                                                            class="board-pos rank-gold">1</span>
                                                        <% } else if (i===1) { %><span class="rank-medal">🥈</span><span
                                                                class="board-pos rank-silver">2</span>
                                                            <% } else if (i===2) { %><span
                                                                    class="rank-medal">🥉</span><span
                                                                    class="board-pos rank-bronze">3</span>
                                                                <% } else { %><span class="board-pos rank-other">#<%= i
                                                                            + 1 %></span>
                                                                    <% } %>
                                                                        <div>
                                                                            <div class="board-name <%= c %>">
                                                                                <%= t.name %>
                                                                            </div>
                                                                            <div class="board-inst">
                                                                                <%= t.institution || '' %>
                                                                            </div>
                                                                        </div>
                                                </div>
                                                <% if (best> 0) { %>
                                                    <div>
                                                        <div class="board-best-score">
                                                            <%= best %>
                                                        </div>
                                                        <div class="board-best-time">
                                                            <%= t.best_time ? parseFloat(t.best_time).toFixed(2)
                                                                + ' sec' : '' %>
                                                        </div>
                                                    </div>
                                                    <% } %>
                                            </div>

                                            <div class="board-rounds">
                                                <div class="board-round">
                                                    <div class="board-round-label">รอบที่ 1</div>
                                                    <% if (r1> 0) { %>
                                                        <div class="board-round-score">
                                                            <%= r1 %>
                                                        </div>
                                                        <div class="board-round-time">
                                                            <%= t.r1_time ? parseFloat(t.r1_time).toFixed(2) + ' sec'
                                                                : '' %>
                                                        </div>
                                                        <% } else { %>
                                                            <div class="score-empty">—</div>
                                                            <% } %>
                                                </div>
                                                <div class="board-round">
                                                    <div class="board-round-label">รอบที่ 2</div>
                                                    <% if (r2> 0) { %>
                                                        <div class="board-round-score">
                                                            <%= r2 %>
                                                        </div>
                                                        <div class="board-round-time">
                                                            <%= t.r2_time ? parseFloat(t.r2_time).toFixed(2) + ' sec'
                                                                : '' %>
                                                        </div>
                                                        <% } else { %>
                                                            <div class="score-empty">—</div>
                                                            <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                            <% } %>
                        </div>

                        <% } %>
            </section>
        </main>

        <footer class="footer">
            <img src="/RCL Logo.png" alt="RCL">
            <div class="footer-text">ROBO CHALLENGE LEAGUE 2026</div>
        </footer>

        <script>
            /* Team search */
            (function () {
                var input = document.getElementById('teamSearch');
                if (!input) return;

                var rows = Array.prototype.slice.call(document.querySelectorAll('#teamTableBody tr[data-search]'));
                var count = document.getElementById('visibleCount');
                var noResult = document.getElementById('noResult');

                input.addEventListener('input', function () {
                    var kw = input.value.trim().toLowerCase();
                    var visible = 0;

                    rows.forEach(function (r) {
                        var match = !kw || r.dataset.search.indexOf(kw) !== -1;
                        r.hidden = !match;
                        if (match) visible++;
                    });

                    if (count) count.textContent = visible + ' ทีม';
                    if (noResult) noResult.hidden = visible !== 0;
                });
            })();

            /* Mobile / tablet hamburger menu */
            (function () {
                var toggle = document.querySelector('.mobile-menu-toggle');
                var mobileMenu = document.querySelector('.mobile-menu');
                var competitionToggle = document.querySelector('.mobile-menu-competition-toggle');
                var subMenu = document.querySelector('.mobile-submenu');
                if (!toggle || !mobileMenu) return;

                function closeMobileMenu() {
                    toggle.classList.remove('is-open');
                    toggle.setAttribute('aria-expanded', 'false');
                    toggle.setAttribute('aria-label', 'เปิดเมนู');
                    mobileMenu.classList.remove('is-open');
                    mobileMenu.setAttribute('aria-hidden', 'true');
                }

                toggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var isOpen = mobileMenu.classList.toggle('is-open');
                    toggle.classList.toggle('is-open', isOpen);
                    toggle.setAttribute('aria-expanded', String(isOpen));
                    toggle.setAttribute('aria-label', isOpen ? 'ปิดเมนู' : 'เปิดเมนู');
                    mobileMenu.setAttribute('aria-hidden', String(!isOpen));
                });

                if (competitionToggle && subMenu) {
                    competitionToggle.addEventListener('click', function () {
                        var isOpen = subMenu.classList.toggle('is-open');
                        competitionToggle.classList.toggle('is-open', isOpen);
                        competitionToggle.setAttribute('aria-expanded', String(isOpen));
                    });
                }

                mobileMenu.querySelectorAll('a').forEach(function (link) {
                    link.addEventListener('click', closeMobileMenu);
                });

                document.addEventListener('click', function (e) {
                    if (!mobileMenu.contains(e.target) && !toggle.contains(e.target)) closeMobileMenu();
                });

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') closeMobileMenu();
                });

                window.addEventListener('resize', function () {
                    if (window.innerWidth > 1100) closeMobileMenu();
                });
            })();

            /* Desktop dropdown (hover with small delay, click also works) */
            document.querySelectorAll('.dropdown').forEach(function (dd) {
                var menu = dd.querySelector('.dropdown-menu');
                var btn = dd.querySelector('button');
                var timer;

                function show() { clearTimeout(timer); menu.style.display = 'block'; }
                function hideSoon() { timer = setTimeout(function () { menu.style.display = 'none'; }, 200); }

                dd.addEventListener('mouseenter', show);
                dd.addEventListener('mouseleave', hideSoon);
                btn.addEventListener('click', function () {
                    menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
                });
            });
        </script>

    </body>

    </html>