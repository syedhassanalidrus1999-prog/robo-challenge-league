                <span>เกียรติบัตร</span>
            </a>

        </nav>

        <!-- MOBILE HAMBURGER -->
        <button class="mobile-menu-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false"
            onclick="(function(b){var m=document.getElementById('mobileMenu');var o=m.classList.toggle('is-open');b.classList.toggle('is-open',o);b.setAttribute('aria-expanded',o?'true':'false');b.setAttribute('aria-label',o?'ปิดเมนู':'เปิดเมนู');b.innerHTML=o?'<i class=&quot;ti ti-x&quot;></i>':'<i class=&quot;ti ti-menu-2&quot;></i>';})(this)">
            <i class="ti ti-menu-2"></i>
        </button>

        <!-- MOBILE MENU -->
        <div class="mobile-menu" id="mobileMenu">
            <a href="/" class="mobile-menu-item">
                <i class="ti ti-home-2"></i>
                <span><b>HOME</b><small>หน้าหลัก</small></span>
            </a>
            <a href="/#about" class="mobile-menu-item">
                <i class="ti ti-users"></i>
                <span><b>ABOUT US</b><small>เกี่ยวกับเรา</small></span>
            </a>

            <button class="mobile-menu-item mobile-competition-toggle" type="button" aria-expanded="false"
                aria-controls="mobileCompetitionSubmenu"
                onclick="(function(b,e){e.preventDefault();e.stopPropagation();var s=document.getElementById('mobileCompetitionSubmenu');if(!s)return;var o=s.classList.toggle('is-open');b.classList.toggle('is-open',o);b.setAttribute('aria-expanded',o?'true':'false');})(this,event)">
                <i class="ti ti-trophy"></i>
                <span><b>COMPETITION</b><small>การแข่งขัน</small></span>
                <i class="ti ti-chevron-down mobile-menu-arrow"></i>
            </button>

            <div class="mobile-submenu" id="mobileCompetitionSubmenu">
                <a href="/#tiers" class="mobile-submenu-item">
                    <i class="ti ti-pencil-plus"></i>สมัครแข่งขัน
                </a>
                <a href="/competition?view=teams" class="mobile-submenu-item">
                    <i class="ti ti-users"></i>ทีมที่สมัคร
                </a>
                <a href="/competition?view=board" class="mobile-submenu-item">
                    <i class="ti ti-chart-bar"></i>ผลสรุปคะแนน
                </a>
            </div>

            <a href="/docs" class="mobile-menu-item">
                <i class="ti ti-file-text"></i>
