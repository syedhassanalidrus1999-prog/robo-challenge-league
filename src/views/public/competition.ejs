<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title style="font-family: Kanit;">
        <%= view==='board' ?'ผลสรุปคะแนน':'ทีมที่สมัคร' %> — Robo Challenge League
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* =========================================================
   RCL 2026 — MASTER TOPBAR
   SINGLE SOURCE OF TRUTH — use on every page
========================================================= */
        .topbar {
            position: fixed;
            inset: 0 0 auto 0;
            z-index: 1000;
            width: 100%;
            height: 84px;
            padding: 0 30px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-sizing: border-box;
            background: transparent;
            border-bottom: 1px solid transparent;
            transition: background .25s ease, border-color .25s ease, box-shadow .25s ease
        }

        .topbar.scrolled{
            background: rgba(255, 255, 255, .92);
            border-bottom-color: rgba(226, 232, 240, .9);
            box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px)
        }

        .topbar-logo {
            flex: 0 0 auto;
            width: auto;
            display: inline-flex;
            align-items: center;
            justify-content: center
        }

        .topbar-logo img {
            display: block;
            width: auto;
            max-width: 130px;
            height: 120px;
            object-fit: contain
        }

        .topbar-nav {
            flex: 1 1 auto;
            min-width: 0;
            margin-left: 18px;
            display: flex;
            align-items: center;
            gap: 6px
        }

        .nav-link {
            min-height: 52px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 4px;
            flex: 0 0 auto;
            border: 0 !important;
            border-radius: 11px;
            background: transparent !important;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
            transition: color .2s ease, background .2s ease, transform .2s ease
        }

        .nav-link span:first-child {
            font-size: 16px;
            line-height: 1.05;
            font-weight: 700;
            letter-spacing: 1px
        }

        .nav-link span:last-child {
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 13px;
            line-height: 1.05;
            font-weight: 500;
            letter-spacing: 0
        }

        .nav-link i {
            font-size: 17px
        }

        .nav-link:hover {
            color: #2563EB;
            background: #F4F8FF !important;
            transform: translateY(-1px)
        }

        .nav-link.active {
            color: #2563EB !important;
            background: #EFF6FF !important
        }

        .certificate-btn {
            background: linear-gradient(135deg, #FFF7D6, #FEF3C7) !important;
            color: #92400E !important;
            border: 1px solid #FCD34D !important;
            border-radius: 90px !important;
            box-shadow: 0 4px 12px rgba(180, 120, 20, .18)
        }

        .certificate-btn:hover {
            background: linear-gradient(135deg, #FDE68A, #FCD34D) !important;
            color: #78350F !important;
            border-color: #F59E0B !important;
            box-shadow: 0 7px 18px rgba(180, 120, 20, .28);
            transform: translateY(-2px)
        }

        .topbar-actions {
            flex: 0 0 auto;
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px
        }

        .btn-reg,
        .btn-login {
            min-height: 52px;
            padding: 0 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 11px;
            font: 800 16px 'Sarabun', sans-serif;
            text-decoration: none;
            white-space: nowrap;
            box-sizing: border-box;
            transition: all .2s ease
        }

        .btn-reg {
            color: #fff;
            background: linear-gradient(135deg, #3478F6, #2563EB);
            border: 1px solid transparent;
            box-shadow: 0 10px 24px rgba(37, 99, 235, .24)
        }

        .btn-reg:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(37, 99, 235, .30)
        }

        .btn-login {
            color: #334155;
            background: #fff;
            border: 1px solid #E2E8F0
        }

        .btn-login:hover {
            color: #2563EB;
            background: #F8FAFC;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(15, 23, 42, .07)
        }

        .btn-login i {
            font-size: 16px
        }

        .dropdown {
            position: relative
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            z-index: 1100;
            display: none;
            min-width: 215px;
            padding: 8px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px)
        }

        .dropdown-item {
            min-height: 44px;
            padding: 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 10px;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: color .18s ease, background .18s ease
        }

        .dropdown-item:hover,
        .dropdown-item.active {
            color: #2563EB;
            background: #EFF6FF
        }

        .dropdown-item:first-child:hover {
            background: #FEF2F2;
            color: #DC2626
        }

        .dropdown-item i {
            font-size: 17px;
            color: #64748B
        }

        .mobile-menu-toggle {
            display: none;
            position: relative;
            z-index: 1202;
            flex: 0 0 44px;
            width: 44px;
            height: 44px;
            padding: 0;
            margin-left: auto;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(148, 163, 184, .35);
            border-radius: 12px;
            background: rgba(255, 255, 255, .96);
            color: #334155;
            box-shadow: 0 6px 18px rgba(15, 23, 42, .07);
            cursor: pointer;
            -webkit-tap-highlight-color: transparent
        }

        .mobile-menu-toggle i {
            font-size: 25px;
            line-height: 1
        }

        .mobile-menu-toggle.is-open {
            color: #2563EB;
            background: #EFF6FF;
            border-color: #BFDBFE
        }

        .mobile-menu {
            display: none;
            position: fixed;
            top: 94px;
            left: 12px;
            right: 12px;
            z-index: 1201;
            max-height: calc(100dvh - 106px);
            overflow-y: auto;
            box-sizing: border-box;
            padding: 8px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #DBEAFE;
            border-radius: 17px;
            box-shadow: 0 20px 50px rgba(15, 23, 42, .16);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px) scale(.985);
            transform-origin: top center;
            transition: opacity .18s ease, transform .18s ease, visibility .18s ease
        }

        .mobile-menu.is-open {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            pointer-events: auto !important;
            transform: translateY(0) scale(1)
        }

        .mobile-menu-item {
            width: 100%;
            min-height: 52px;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 11px;
            box-sizing: border-box;
            border: 0;
            border-radius: 11px;
            background: transparent;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            text-decoration: none;
            text-align: left;
            cursor: pointer
        }

        .mobile-menu-item:hover,
        .mobile-menu-item:active {
            background: #F4F8FF;
            color: #2563EB
        }

        .mobile-menu-item>i:first-child {
            width: 28px;
            min-width: 28px;
            text-align: center;
            font-size: 20px;
            color: #64748B
        }

        .mobile-menu-item>span {
            min-width: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
            line-height: 1.1
        }

        .mobile-menu-item b {
            font-size: 15px;
            font-weight: 800;
            letter-spacing: .2px
        }

        .mobile-menu-item small {
            margin-top: 3px;
            font-size: 11px;
            font-weight: 500;
            color: #94A3B8
        }

        .mobile-menu-arrow {
            width: auto !important;
            min-width: 0 !important;
            font-size: 18px !important;
            color: #94A3B8 !important;
            transition: transform .2s ease
        }

        .mobile-competition-toggle.is-open {
            background: #EFF6FF;
            color: #2563EB
        }

        .mobile-competition-toggle.is-open .mobile-menu-arrow {
            transform: rotate(180deg)
        }

        .mobile-submenu {
            display: none;
            margin: 0 8px 6px 51px;
            padding: 5px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 12px
        }

        .mobile-submenu.is-open {
            display: block
        }

        .mobile-submenu-item {
            min-height: 42px;
            padding: 0 10px;
            display: flex;
            align-items: center;
            gap: 9px;
            border-radius: 8px;
            color: #475569;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none
        }

        .mobile-submenu-item:hover {
            color: #2563EB;
            background: #EFF6FF
        }

        .mobile-submenu-item i {
            font-size: 16px;
            color: #64748B
        }

        .mobile-login-item {
            margin-top: 4px;
            border-top: 1px solid #EEF2F6;
            border-radius: 0 0 11px 11px
        }

        @media (min-width:901px) and (max-width:1199px) {
            .topbar {
                height: 78px;
                padding: 0 20px;
                gap: 7px
            }

            .topbar-logo img {
                height: 96px;
                max-width: 112px
            }

            .topbar-nav {
                margin-left: 8px;
                gap: 2px
            }

            .nav-link {
                min-height: 48px;
                padding: 0 10px
            }

            .nav-link span:first-child {
                font-size: 14px;
                letter-spacing: .7px
            }

            .nav-link span:last-child {
                font-size: 11px
            }

            .btn-reg,
            .btn-login {
                min-height: 48px;
                padding: 0 14px;
                font-size: 14px
            }
        }

        @media (min-width:641px) and (max-width:900px) {
            .topbar {
                height: 72px;
                padding: 0 16px;
                gap: 6px
            }

            .topbar-logo img {
                height: 76px;
                max-width: 92px
            }

            .topbar-nav {
                margin-left: 4px;
                gap: 1px
            }

            .nav-link {
                min-height: 46px;
                padding: 0 8px
            }

            .nav-link span:first-child {
                font-size: 12px;
                letter-spacing: .4px
            }

            .nav-link span:last-child {
                font-size: 10px
            }

            .btn-reg,
            .btn-login {
                min-height: 44px;
                padding: 0 11px;
                font-size: 13px
            }

            .mobile-menu-toggle,
            .mobile-menu {
                display: none !important
            }
        }

        @media (max-width:640px) {
            .topbar {
                height: 62px;
                padding: 0 12px;
                gap: 8px;
                background: rgba(255, 255, 255, .94);
                border-bottom-color: rgba(226, 232, 240, .9);
                box-shadow: 0 4px 18px rgba(15, 23, 42, .07);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px)
            }

            .topbar-logo img {
                height: 44px;
                max-width: 86px
            }

            .topbar-nav,
            .topbar-actions {
                display: none !important
            }

            .mobile-menu-toggle {
                display: inline-flex !important
            }

            .mobile-menu {
                top: 72px;
                left: 12px;
                right: 12px;
                max-height: calc(100dvh - 84px)
            }
        }

        @media (max-width:430px) {
            .topbar {
                height: 60px;
                padding: 0 9px
            }

            .topbar-logo img {
                height: 40px;
                max-width: 76px
            }

            .mobile-menu-toggle {
                flex-basis: 42px;
                width: 42px;
                height: 42px
            }

            .mobile-menu {
                top: 70px;
                left: 9px;
                right: 9px;
                max-height: calc(100dvh - 80px)
            }
        }

        @media (max-width:380px) {
            .topbar {
                height: 58px;
                padding: 0 8px
            }

            .topbar-logo img {
                height: 38px;
                max-width: 72px
            }

            .mobile-menu-toggle {
                flex-basis: 40px;
                width: 40px;
                height: 40px
            }

            .mobile-menu {
                top: 67px;
                left: 8px;
                right: 8px
            }

            .mobile-menu-item {
                min-height: 48px
            }
        }

        @media (max-width:900px) and (orientation:landscape) {
            .mobile-menu {
                max-height: calc(100dvh - 76px)
            }
        }


        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --primary: #2563EB;
            --primary-dark: #1D4ED8;
            --primary-soft: #EFF6FF;
            --text: #172033;
            --muted: #64748B;
            --line: #E5EAF2;
            --surface: #FFFFFF;
            --surface-soft: #F8FAFC;
            --page: #F3F6FB;
            --shadow-sm: 0 4px 14px rgba(15, 23, 42, .05);
            --shadow-md: 0 12px 30px rgba(15, 23, 42, .08);
        }

        html {
            background: var(--page);
        }

        body {
            font-family: Kanit;
            background: #F4F7FB;
            color: #1E293B;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input {
            font: inherit;
        }


        .wrap {
            width: min(1280px, 92%);
            max-width: none;
            margin: 40px auto;
            padding: 70px;
            flex: 1;
        }

        .card {
            margin-top: 22px;
        }

        .page-hd {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 34px;
            flex-wrap: wrap;
        }

        .page-title {
            position: relative;
            padding-left: 16px;
            font-size: 28px;
            line-height: 1.2;
            font-weight: 800;
            letter-spacing: -.4px;
            color: var(--text);
        }

        .page-title::before {
            content: '';
            position: absolute;
            left: 0;
            top: 4px;
            bottom: 4px;
            width: 5px;
            border-radius: 999px;
            background: linear-gradient(180deg, #60A5FA, #2563EB);
        }

        .page-title span {
            color: var(--primary);
        }

        .view-toggle {
            display: flex;
            padding: 4px;
            gap: 4px;
            background: rgba(255, 255, 255, .9);
            border: 1px solid #E2E8F0;
            border-radius: 13px;
            box-shadow: var(--shadow-sm);
        }

        .view-btn {
            min-height: 40px;
            padding: 0 16px;
            border-radius: 10px;
            border: none;
            background: transparent;
            color: #64748B;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: all .18s ease;
        }

        .view-btn:hover {
            color: var(--text);
            background: #F8FAFC;
        }

        .view-btn.active {
            color: #fff;
            background: #de8705;
            box-shadow: 0 6px 14px rgba(15, 23, 42, .18);
        }

        .tier-tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            padding: 7px;
            background: rgba(255, 255, 255, .9);
            border: 1px solid #E2E8F0;
            border-radius: 16px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 24px;
        }

        .tier-tab {
            min-height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 0 12px;
            border-radius: 11px;
            border: 1px solid transparent;
            background: transparent;
            color: #64748B;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            transition: all .18s ease;
        }

        .tier-tab:hover {
            color: var(--text);
            background: #F8FAFC;
        }

        .tier-tab.active-beginner {
            color: #fff;
            background: linear-gradient(135deg, #16A34A, #15803D);
            box-shadow: 0 8px 18px rgba(22, 163, 74, .28);
        }

        .tier-tab.active-intermediate {
            color: #fff;
            background: linear-gradient(135deg, #2563EB, #1D4ED8);
            box-shadow: 0 8px 18px rgba(37, 99, 235, .28);
        }

        .tier-tab.active-advance {
            color: #fff;
            background: linear-gradient(135deg, #EA580C, #C2410C);
            box-shadow: 0 8px 18px rgba(234, 88, 12, .28);
        }

        .tier-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, .18);
        }

        .card {
            overflow: hidden;
            background: rgba(255, 255, 255, .97);
            border-radius: 18px;

        }


        thead.active-beginner th {
            background: linear-gradient(180deg, #ECFDF5, #D1FAE5);
            color: #16A34A;
            font-size: 18px;
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        thead.active-intermediate th {
            background: linear-gradient(180deg, #DBEAFE, #BFDBFE);
            color: #2563EB;
            font-size: 18px;
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        thead.active-advance th {
            background: linear-gradient(180deg, #FFEDD5, #FED7AA);
            color: #EA580C;
            font-size: 18px;
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        .search-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 20px 24px;
            border-bottom: 1px solid #EDF1F6;
            background: linear-gradient(180deg, #FFFFFF, #FBFCFE);
            flex-wrap: wrap;
        }

        .search-box {
            flex: 1;
            min-width: 240px;
            min-height: 50px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 14px;
            background: #F8FAFC;
            border: 1px solid #DDE5EF;
            border-radius: 12px;
            transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
        }

        .search-box:focus-within {
            background: #fff;
            border-color: #93C5FD;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .09);
        }

        .search-box i {
            color: #94A3B8;
            font-size: 17px;
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            border: none;
            background: transparent;
            color: var(--text);
            font-size: 13px;
            outline: none;
        }

        .search-box input::placeholder {
            color: #9AA8BA;
        }

        .count-badge {
            display: inline-flex;
            align-items: center;
            min-height: 32px;
            padding: 0 11px;
            border-radius: 999px;
            background: var(--primary-soft);
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

        .time-info {
            display: flex;
            align-items: center;
            gap: 5px;
            color: #94A3B8;
            font-size: 11px;
            white-space: nowrap;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        th {
            padding: 13px 16px;
            text-align: left;
            background: #F8FAFC;
            border-bottom: 1px solid #E5EAF2;
            color: #718096;
            font-size: 11px;
            letter-spacing: .55px;
            text-transform: uppercase;
            font-weight: 800;
            white-space: nowrap;
        }

        td {
            padding: 16px;
            border-bottom: 1px solid #EEF2F6;
            color: #334155;
            font-size: 13px;
            vertical-align: middle;
            background: #fff;
            transition: background .16s ease;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover td {
            background: #F8FBFF;
        }

        .team-name {
            color: var(--text);
            font-size: 18px;
            font-weight: 800;
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        .team-id {
            margin-top: 3px;
            color: var(--primary);
            font-size: 11px;
            font-weight: 700;
        }

        .team-id.active-beginner {
            color: #16A34A !important;
        }

        .score-num {
            color: var(--primary);
            font-size: 17px;
            font-weight: 800;
        }

        .score-time {
            display: block;
            margin-top: 2px;
            color: #94A3B8;
            font-size: 11px;
        }

        .best-score {
            color: var(--text);
            font-size: 21px;
            font-weight: 900;
        }

        .bar-bg {
            max-width: 92px;
            height: 5px;
            margin-top: 7px;
            overflow: hidden;
            background: #E2E8F0;
            border-radius: 999px;
        }

        .bar-fill {
            height: 100%;
            border-radius: 999px;
            background: var(--primary);
        }

        .rank-cell {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 15px;
            font-weight: 800;
        }

        .rank-gold {
            color: #D97706;
        }

        .rank-silver {
            color: #64748B;
        }

        .rank-bronze {
            color: #92400E;
        }

        .rank-other {
            color: #94A3B8;
        }

        .empty {
            padding: 58px 24px;
            text-align: center;
            color: #94A3B8;
        }

        .empty i {
            display: block;
            margin-bottom: 10px;
            font-size: 40px;
            opacity: .45;
        }

        .mobile-list {
            padding: 10px;
        }

        .mobile-item {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
            padding: 13px 12px;
            border: 1px solid #EDF1F6;
            border-radius: 13px;
            background: #fff;
        }

        .mobile-item:last-child {
            margin-bottom: 0;
        }

        .mobile-num {
            width: 32px;
            height: 32px;
            margin-right: 12px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--primary-soft);
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
        }

        .mobile-info {
            flex: 1;
        }

        .mobile-name {
            color: var(--text);
            font-size: 14px;
            font-weight: 800;
        }

        .mobile-id {
            margin-top: 2px;
            color: var(--primary);
            font-size: 11px;
            font-weight: 700;
        }

        .mobile-inst {
            margin-top: 3px;
            display: flex;
            align-items: center;
            gap: 4px;
            color: #94A3B8;
            font-size: 11px;
        }

        .mobile-arrow {
            color: #CBD5E1;
            font-size: 15px;
        }

        .board-mobile-item {
            margin: 10px;
            padding: 15px 14px;
            border: 1px solid #EDF1F6;
            border-radius: 14px;
            background: #fff;
        }

        .board-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
        }

        .board-rank-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .board-medal {
            font-size: 21px;
        }

        .board-pos {
            font-size: 15px;
            font-weight: 900;
        }

        .board-name {
            color: var(--text);
            font-size: 14px;
            font-weight: 800;
        }

        .board-inst {
            color: #94A3B8;
            font-size: 11px;
        }

        .board-best-score {
            color: var(--primary);
            font-size: 23px;
            font-weight: 900;
            text-align: right;
        }

        .board-best-time {
            color: #94A3B8;
            font-size: 10px;
            text-align: right;
        }

        .board-rounds {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-top: 10px;
        }

        .board-round {
            padding: 10px;
            text-align: center;
            background: #F8FAFC;
            border: 1px solid #EEF2F6;
            border-radius: 11px;
        }

        .board-round-label {
            margin-bottom: 3px;
            color: #64748B;
            font-size: 10px;
        }

        .board-round-score {
            color: var(--text);
            font-size: 15px;
            font-weight: 800;
        }

        .board-round-time {
            color: #94A3B8;
            font-size: 10px;
        }

        .footer {
            background: #1E293B;
            padding: 20px;
            text-align: center;
            margin-top: 32px;
        }

        .wrap {
            width: min(1400px, 92%);
            margin: 48px auto;
        }

        .footer img {
            height: 32px;
            margin-bottom: 9px;
            object-fit: contain;
        }

        .footer-text {
            color: rgba(255, 255, 255, .48);
            font-size: 12px;
            letter-spacing: .35px;
        }

        @media (min-width: 640px) {

            .mobile-list,
            .board-mobile-item,
            .mobile-item {
                display: none;
            }
        }


        .page-title {
            font-size: 23px;
        }

        .page-hd {
            align-items: stretch;
        }

        .page-hd>div:last-child {
            width: 100%;
        }

        .view-toggle {
            width: 100%;
        }

        .view-btn {
            flex: 1;
            justify-content: center;
        }

        .tier-tab {
            min-height: 42px;
            padding: 0 6px;
            font-size: 11px;
        }

        .search-row {
            padding: 13px;
        }

        .search-box {
            min-width: 100%;
        }
        }


        @media (max-width: 639px) {

            html,
            body {
                width: 100%;
                max-width: 100%;
                overflow-x: hidden;
            }

            /* ---------- PAGE ---------- */
            .wrap {
                width: calc(100% - 20px) !important;
                max-width: 100% !important;
                margin: 84px auto 24px !important;
                padding: 0 !important;
            }

            .page-hd {
                display: block !important;
                margin-bottom: 18px !important;
            }

            .page-title {
                margin-bottom: 16px;
                padding-left: 14px;
                font-size: 27px !important;
                line-height: 1.2;
            }

            .page-title::before {
                width: 4px;
            }

            .page-hd>div:last-child {
                width: 100% !important;
            }

            /* ---------- VIEW TOGGLE ---------- */
            .view-toggle {
                width: 100% !important;
                display: grid !important;
                grid-template-columns: 1fr 1fr;
                padding: 4px !important;
                gap: 4px;
                border-radius: 14px;
            }

            .view-btn {
                min-height: 48px !important;
                padding: 0 8px !important;
                font-size: 16px !important;
                gap: 7px;
            }

            /* ---------- TIER TABS ---------- */
            .tier-tabs {
                grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
                gap: 5px !important;
                padding: 5px !important;
                margin-bottom: 18px !important;
                border-radius: 14px;
            }

            .tier-tab {
                min-height: 48px !important;
                padding: 0 4px !important;
                gap: 5px;
                font-size: 13px !important;
                white-space: nowrap;
            }

            .tier-dot {
                width: 6px;
                height: 6px;
            }

            /* ---------- MAIN CARD ---------- */
            .card {
                margin-top: 0 !important;
                border-radius: 16px !important;
                overflow: hidden;
            }

            /* ---------- SEARCH ---------- */
            .search-row {
                padding: 14px !important;
                gap: 9px !important;
                flex-wrap: wrap !important;
            }

            .search-box {
                width: 100% !important;
                min-width: 0 !important;
                min-height: 50px !important;
            }

            .count-badge {
                min-height: 32px;
                font-size: 12px;
            }

            .time-info {
                font-size: 11px;
            }

            /* =====================================================
       TEAM VIEW — KEEP A REAL TABLE ON MOBILE
       Do NOT convert # / ชื่อทีม / สถาบัน into cards.
    ===================================================== */

            .desktop-table {
                display: block !important;
                width: 100% !important;
                overflow-x: auto !important;
                overflow-y: hidden !important;
                -webkit-overflow-scrolling: touch;
            }

            .desktop-table table {
                width: 100% !important;
                min-width: 620px !important;
                table-layout: fixed;
            }

            .desktop-table th,
            .desktop-table td {
                white-space: normal;
            }

            .desktop-table th {
                padding: 13px 12px !important;
                font-size: 12px !important;
            }

            .desktop-table td {
                padding: 15px 12px !important;
                font-size: 13px !important;
            }

            .desktop-table th:nth-child(1),
            .desktop-table td:nth-child(1) {
                width: 62px;
                text-align: center;
            }

            .desktop-table th:nth-child(2),
            .desktop-table td:nth-child(2) {
                width: 235px;
            }

            .desktop-table th:nth-child(3),
            .desktop-table td:nth-child(3) {
                width: 323px;
            }

            .desktop-table .team-name {
                font-size: 17px !important;
                line-height: 1.2;
            }

            .desktop-table .team-id {
                font-size: 11px !important;
            }

            .desktop-table td:nth-child(3) {
                font-size: 16px !important;
                line-height: 1.35;
            }

            .mobile-list {
                display: none !important;
            }

            /* ---------- TEAM VIEW: REAL TABLE ---------- */
            .view-teams .desktop-table {
                display: block !important;
            }

            .view-teams .mobile-list {
                display: none !important;
            }

            /* ---------- BOARD VIEW: MOBILE CARDS ---------- */
            .view-board .desktop-table {
                display: none !important;
            }

            .view-board #boardMobile {
                display: block !important;
                padding: 8px !important;
            }

            .view-board .board-mobile-item {
                display: block !important;
                margin: 0 0 10px !important;
                padding: 15px !important;
                border: 1px solid #E2E8F0;
                border-radius: 15px;
                background: #fff;
                box-shadow: 0 5px 16px rgba(15, 23, 42, .045);
            }

            .view-board .board-mobile-item:last-child {
                margin-bottom: 0 !important;
            }

            .view-board .board-top {
                margin-bottom: 12px !important;
            }

            .view-board .board-name {
                font-size: 16px !important;
            }

            .view-board .board-inst {
                margin-top: 3px;
                font-size: 11px !important;
            }

            .view-board .board-best-score {
                font-size: 30px !important;
                line-height: 1;
            }

            .view-board .board-best-time {
                margin-top: 4px;
                font-size: 10px !important;
            }

            .view-board .board-rounds {
                grid-template-columns: 1fr 1fr !important;
                gap: 8px !important;
                margin-top: 12px !important;
            }

            .view-board .board-round {
                min-height: 76px;
                padding: 11px 8px !important;
            }

            .view-board .board-round-label {
                font-size: 10px !important;
            }

            .view-board .board-round-score {
                font-size: 20px !important;
            }
        }

        .wrap {
            width: min(94%, 900px) !important;
            margin-top: 96px !important;
            padding: 0 !important;
        }

        .desktop-table {
            display: block !important;
            overflow-x: auto !important;
        }

        .mobile-list {
            display: none !important;
        }
        }


        /* PAGE RESPONSIVE — Competition content only. Master Topbar above owns all Topbar rules. */
        @media (min-width:640px) {

            .mobile-list,
            #boardMobile,
            .mobile-item,
            .board-mobile-item {
                display: none !important
            }
        }

        @media (max-width:639px) {
            .body {
                padding-top: 0
            }

            .wrap {
                width: calc(100% - 20px);
                max-width: 100%;
                margin: 84px auto 24px;
                padding: 0
            }
        }

        @media (max-width:430px) {
            .wrap {
                width: calc(100% - 16px) !important;
                margin-top: 80px !important
            }

            .page-title {
                font-size: 25px !important
            }

            .view-btn {
                min-height: 46px !important;
                font-size: 15px !important
            }

            .tier-tab {
                min-height: 46px !important;
                font-size: 12px !important
            }

            .desktop-table table {
                min-width: 570px !important
            }

            .desktop-table th:nth-child(1),
            .desktop-table td:nth-child(1) {
                width: 54px
            }

            .desktop-table th:nth-child(2),
            .desktop-table td:nth-child(2) {
                width: 215px
            }

            .desktop-table th:nth-child(3),
            .desktop-table td:nth-child(3) {
                width: 301px
            }
        }

        @media (max-width:380px) {
            .wrap {
                margin-top: 76px !important
            }

            .page-title {
                font-size: 23px !important
            }

            .view-btn {
                font-size: 14px !important
            }

            .tier-tab {
                font-size: 11px !important
            }

            .desktop-table table {
                min-width: 540px !important
            }
        }

        @media (min-width:641px) and (max-width:900px) {
            .wrap {
                width: min(94%, 900px) !important;
                margin-top: 96px !important;
                padding: 0 !important
            }

            .desktop-table {
                display: block !important;
                overflow-x: auto !important
            }

            .mobile-list {
                display: none !important
            }
        }

        /* =========================================================
           RCL 2026 — BOARD MOBILE / TABLE OVERLAP FIX
           Only one board representation is visible at a time.
        ========================================================= */
        @media (max-width: 639px) {
            .view-board .desktop-table {
                display: none !important;
                visibility: hidden !important;
                height: 0 !important;
                overflow: hidden !important;
            }

            .view-board #boardMobile {
                display: block !important;
                visibility: visible !important;
                height: auto !important;
                overflow: visible !important;
                padding: 8px !important;
            }

            .view-board #boardMobile .board-mobile-item {
                display: block !important;
                position: relative !important;
                width: 100% !important;
                height: auto !important;
                margin: 0 0 10px !important;
                clear: both !important;
            }

            .view-board #boardMobile .board-mobile-item:last-child {
                margin-bottom: 0 !important;
            }
        }

        @media (min-width: 640px) {
            .view-board .desktop-table {
                display: block !important;
                visibility: visible !important;
                height: auto !important;
                overflow-x: auto !important;
            }

            .view-board #boardMobile {
                display: none !important;
                visibility: hidden !important;
                height: 0 !important;
                overflow: hidden !important;
            }
        }
    </style>
</head>

<body>

    <!-- TOPBAR -->
    <div class="topbar">
