<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title style="font-family: Kanit;">
        <%= view==='board' ?'ผลสรุปคะแนน':'ทีมที่สมัคร' %> — Robo Challenge League
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* =========================================================
   RCL TOPBAR
========================================================= */
        .topbar {
            position: fixed;
            inset: 0 0 auto;
            z-index: 1000;
            height: 84px;
            padding: 0 30px;
            display: flex;
            align-items: center;
            gap: 10px;
            background: transparent;
            border-bottom: 1px solid transparent;
            transition: all .3s ease;
        }

        .topbar.scrolled {
            background: rgba(255, 255, 255, .92);
            border-bottom-color: rgba(226, 232, 240, .9);
            box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
            backdrop-filter: blur(16px);
        }

        .topbar-logo {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
        }

        .topbar-logo img {
            width: auto;
            height: 120px;
            object-fit: contain;
        }

        .topbar-nav {
            flex: 1;
            margin-left: 18px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-link {
            min-height: 52px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 5px;
            border: 0 !important;
            border-radius: 11px;
            background: transparent !important;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 17px;
            font-weight: 600;
            letter-spacing: 1px;
            line-height: 1.15;
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
            transition: all .2s ease;
        }

        .nav-link span:first-child {
            font-size: 16px;
            font-weight: 700;
        }

        .nav-link span:last-child {
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: 0;
        }

        .nav-link i {
            font-size: 17px;
        }

        .nav-link:hover {
            color: #2563EB;
            background: #F4F8FF !important;
            transform: translateY(-1px);
        }

        .nav-link.active {
            color: #2563EB !important;
            background: #EFF6FF !important;
        }

        /* Certificate */
        .certificate-btn {
            background: linear-gradient(135deg, #FFF7D6, #FEF3C7) !important;
            color: #92400E !important;
            border: 1px solid #FCD34D !important;
            border-radius: 90px !important;
            box-shadow: 0 4px 12px rgba(180, 120, 20, .18);
        }

        .certificate-btn:hover {
            background: linear-gradient(135deg, #FDE68A, #FCD34D) !important;
            color: #78350F !important;
            border-color: #F59E0B !important;
            box-shadow: 0 7px 18px rgba(180, 120, 20, .28);
            transform: translateY(-2px);
        }

        .certificate-btn:active {
            transform: translateY(0);
            box-shadow: 0 3px 8px rgba(180, 120, 20, .20);
        }

        .topbar-actions {
            flex: 0 0 auto;
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-reg,
        .btn-login {
            min-height: 52px;
            padding: 0 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 11px;
            font: 800 16px 'Sarabun', sans-serif;
            text-decoration: none;
            transition: all .2s ease;
        }

        .btn-reg {
            color: #fff;
            background: linear-gradient(135deg, #3478F6, #2563EB);
            border: 1px solid transparent;
            box-shadow: 0 10px 24px rgba(37, 99, 235, .24);
        }

        .btn-reg:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(37, 99, 235, .30);
        }

        .btn-login {
            color: #334155;
            background: #fff;
            border: 1px solid #E2E8F0;
        }

        .btn-login:hover {
            color: #2563EB;
            background: #F8FAFC;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
        }

        /* DROPDOWN */
        .dropdown {
            position: relative;
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            z-index: 1100;
            display: none;
            min-width: 215px;
            padding: 8px;
            background: rgba(255, 255, 255, .98);
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
        }

        .dropdown-item {
            min-height: 44px;
            padding: 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 10px;
            color: #334155;
            font-family: 'Kanit', 'Sarabun', sans-serif;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: all .18s ease;
        }

        .dropdown-item:hover,
        .dropdown-item.active {
            color: #2563EB;
            background: #EFF6FF;
        }

        .dropdown-item:first-child:hover {
            background: #FEF2F2;
            color: #DC2626;
        }

        .dropdown-item i {
            font-size: 17px;
            color: #64748B;
        }

        /* Responsive — Laptop */
        @media (min-width:901px) and (max-width:1199px) {
            .topbar {
                padding: 0 20px;
            }

            .topbar-logo img {
                height: 92px;
            }

            .nav-link {
                padding: 0 11px;
            }

            .nav-link span:first-child {
                font-size: 14px;
            }

            .nav-link span:last-child {
                font-size: 12px;
            }

            .btn-reg,
            .btn-login {
                padding: 0 14px;
                font-size: 14px;
            }
        }

        /* Responsive — Tablet */
        @media (min-width:641px) and (max-width:900px) {
            .topbar {
                height: 72px;
                padding: 0 16px;
            }

            .topbar-logo img {
                height: 70px;
            }

            .topbar-nav {
                margin-left: 4px;
                gap: 2px;
            }

            .nav-link {
                min-height: 44px;
                padding: 0 8px;
            }

            .nav-link span:first-child {
                font-size: 12px;
            }

            .nav-link span:last-child {
                font-size: 10px;
            }

            .btn-reg,
            .btn-login {
                min-height: 44px;
                padding: 0 12px;
                font-size: 13px;
            }
        }

        /* Responsive — Mobile */
        @media (max-width:640px) {
            .topbar {
                height: 60px;
                padding: 0 12px;
            }

            .topbar-logo img {
                height: 46px;
                max-width: 92px;
            }

            .topbar-nav {
                margin-left: 2px;
                gap: 0;
            }

            .topbar-nav>a.nav-link {
                display: none;
            }

            .nav-link {
                min-height: 40px;
                padding: 0 7px;
            }

            .nav-link span:first-child {
                font-size: 11px;
            }

            .nav-link span:last-child {
                font-size: 9px;
            }

            .topbar-actions {
                gap: 4px;
            }

            .btn-reg {
                min-height: 40px;
                padding: 0 10px;
                font-size: 12px;
            }

            .btn-login {
                width: 40px;
                min-width: 40px;
                min-height: 40px;
                padding: 0;
                font-size: 0;
            }

            .btn-login i {
                font-size: 18px;
            }

            .dropdown-menu {
                position: fixed;
                top: 58px;
                left: 10px;
                right: 10px;
                min-width: 0;
            }
        }

        @media (max-width:430px) {
            .topbar-logo img {
                height: 40px;
                max-width: 76px;
            }

            .nav-link {
                padding: 0 5px;
            }
        }

        @media (max-width:360px) {
            .topbar-logo img {
                max-width: 64px;
            }

            .nav-link {
                padding: 0 4px;
            }
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --primary: #2563EB;
            --primary-dark: #1D4ED8;
            --primary-soft: #EFF6FF;
            --text: #172033;
            --muted: #64748B;
            --line: #E5EAF2;
            --surface: #FFFFFF;
            --surface-soft: #F8FAFC;
            --page: #F3F6FB;
            --shadow-sm: 0 4px 14px rgba(15, 23, 42, .05);
            --shadow-md: 0 12px 30px rgba(15, 23, 42, .08);
        }

        html {
            background: var(--page);
        }

        body {
            font-family: 'Sarabun', sans-serif;
            background: #F4F7FB;
            color: #1E293B;

            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input {
            font: inherit;
        }


        .btn-reg,


        .wrap {
            width: min(1280px, 92%);
            max-width: none;
            margin: 40px auto;
            padding: 70px;
            flex: 1;
        }

        .card {
            margin-top: 22px;
        }

        .page-hd {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 34px;
            flex-wrap: wrap;
        }

        .page-title {
            position: relative;
            padding-left: 16px;
            font-size: 28px;
            line-height: 1.2;
            font-weight: 800;
            letter-spacing: -.4px;
            color: var(--text);
        }

        .page-title::before {
            content: '';
            position: absolute;
            left: 0;
            top: 4px;
            bottom: 4px;
            width: 5px;
            border-radius: 999px;
            background: linear-gradient(180deg, #60A5FA, #2563EB);
        }

        .page-title span {
            color: var(--primary);
        }

        .view-toggle {
            display: flex;
            padding: 4px;
            gap: 4px;
            background: rgba(255, 255, 255, .9);
            border: 1px solid #E2E8F0;
            border-radius: 13px;
            box-shadow: var(--shadow-sm);
        }

        .view-btn {
            min-height: 40px;
            padding: 0 16px;
            border-radius: 10px;
            border: none;
            background: transparent;
            color: #64748B;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: all .18s ease;
        }

        .view-btn:hover {
            color: var(--text);
            background: #F8FAFC;
        }

        .view-btn.active {
            color: #fff;
            background: #de8705;
            box-shadow: 0 6px 14px rgba(15, 23, 42, .18);
        }

        .tier-tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            padding: 7px;
            background: rgba(255, 255, 255, .9);
            border: 1px solid #E2E8F0;
            border-radius: 16px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 24px;
        }

        .tier-tab {
            min-height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 0 12px;
            border-radius: 11px;
            border: 1px solid transparent;
            background: transparent;
            color: #64748B;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            transition: all .18s ease;
        }

        .tier-tab:hover {
            color: var(--text);
            background: #F8FAFC;
        }

        .tier-tab.active-beginner {
            color: #fff;
            background: linear-gradient(135deg, #16A34A, #15803D);
            box-shadow: 0 8px 18px rgba(22, 163, 74, .28);
        }

        .tier-tab.active-intermediate {
            color: #fff;
            background: linear-gradient(135deg, #2563EB, #1D4ED8);
            box-shadow: 0 8px 18px rgba(37, 99, 235, .28);
        }

        .tier-tab.active-advance {
            color: #fff;
            background: linear-gradient(135deg, #EA580C, #C2410C);
            box-shadow: 0 8px 18px rgba(234, 88, 12, .28);
        }

        .tier-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, .18);
        }

        .card {
            overflow: hidden;
            background: rgba(255, 255, 255, .97);
            border-radius: 18px;

        }


        thead.active-beginner th {
            background: linear-gradient(180deg, #ECFDF5, #D1FAE5);
            color: #16A34A;
            font-size: 18px;
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        thead.active-intermediate th {
            background: linear-gradient(180deg, #DBEAFE, #BFDBFE);
            color: #2563EB;
            font-size: 18px;
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        thead.active-advance th {
            background: linear-gradient(180deg, #FFEDD5, #FED7AA);
            color: #EA580C;
            font-size: 18px;
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        .search-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 20px 24px;
            border-bottom: 1px solid #EDF1F6;
            background: linear-gradient(180deg, #FFFFFF, #FBFCFE);
            flex-wrap: wrap;
        }

        .search-box {
            flex: 1;
            min-width: 240px;
            min-height: 50px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 14px;
            background: #F8FAFC;
            border: 1px solid #DDE5EF;
            border-radius: 12px;
            transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
        }

        .search-box:focus-within {
            background: #fff;
            border-color: #93C5FD;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .09);
        }

        .search-box i {
            color: #94A3B8;
            font-size: 17px;
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            border: none;
            background: transparent;
            color: var(--text);
            font-size: 13px;
            outline: none;
        }

        .search-box input::placeholder {
            color: #9AA8BA;
        }

        .count-badge {
            display: inline-flex;
            align-items: center;
            min-height: 32px;
            padding: 0 11px;
            border-radius: 999px;
            background: var(--primary-soft);
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

        .time-info {
            display: flex;
            align-items: center;
            gap: 5px;
            color: #94A3B8;
            font-size: 11px;
            white-space: nowrap;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        th {
            padding: 13px 16px;
            text-align: left;
            background: #F8FAFC;
            border-bottom: 1px solid #E5EAF2;
            color: #718096;
            font-size: 11px;
            letter-spacing: .55px;
            text-transform: uppercase;
            font-weight: 800;
            white-space: nowrap;
        }

        td {
            padding: 16px;
            border-bottom: 1px solid #EEF2F6;
            color: #334155;
            font-size: 13px;
            vertical-align: middle;
            background: #fff;
            transition: background .16s ease;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover td {
            background: #F8FBFF;
        }

        .team-name {
            color: var(--text);
            font-size: 18px;
            font-weight: 800;
            font-family: 'Kanit', 'Sarabun', sans-serif;
        }

        .team-id {
            margin-top: 3px;
            color: var(--primary);
            font-size: 11px;
            font-weight: 700;
        }

        .team-id.active-beginner {
            color: #16A34A !important;
        }

        .score-num {
            color: var(--primary);
            font-size: 17px;
            font-weight: 800;
        }

        .score-time {
            display: block;
            margin-top: 2px;
            color: #94A3B8;
            font-size: 11px;
        }

        .best-score {
            color: var(--text);
            font-size: 21px;
            font-weight: 900;
        }

        .bar-bg {
            max-width: 92px;
            height: 5px;
            margin-top: 7px;
            overflow: hidden;
            background: #E2E8F0;
            border-radius: 999px;
        }

        .bar-fill {
            height: 100%;
            border-radius: 999px;
            background: var(--primary);
        }

        .rank-cell {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 15px;
            font-weight: 800;
        }

        .rank-gold {
            color: #D97706;
        }

        .rank-silver {
            color: #64748B;
        }

        .rank-bronze {
            color: #92400E;
        }

        .rank-other {
            color: #94A3B8;
        }

        .empty {
            padding: 58px 24px;
            text-align: center;
            color: #94A3B8;
        }

        .empty i {
            display: block;
            margin-bottom: 10px;
            font-size: 40px;
            opacity: .45;
        }

        .mobile-list {
            padding: 10px;
        }

        .mobile-item {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
            padding: 13px 12px;
            border: 1px solid #EDF1F6;
            border-radius: 13px;
            background: #fff;
        }

        .mobile-item:last-child {
            margin-bottom: 0;
        }

        .mobile-num {
            width: 32px;
            height: 32px;
            margin-right: 12px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--primary-soft);
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
        }

        .mobile-info {
            flex: 1;
        }

        .mobile-name {
            color: var(--text);
            font-size: 14px;
            font-weight: 800;
        }

        .mobile-id {
            margin-top: 2px;
            color: var(--primary);
            font-size: 11px;
            font-weight: 700;
        }

        .mobile-inst {
            margin-top: 3px;
            display: flex;
            align-items: center;
            gap: 4px;
            color: #94A3B8;
            font-size: 11px;
        }

        .mobile-arrow {
            color: #CBD5E1;
            font-size: 15px;
        }

        .board-mobile-item {
            margin: 10px;
            padding: 15px 14px;
            border: 1px solid #EDF1F6;
            border-radius: 14px;
            background: #fff;
        }

        .board-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
        }

        .board-rank-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .board-medal {
            font-size: 21px;
        }

        .board-pos {
            font-size: 15px;
            font-weight: 900;
        }

        .board-name {
            color: var(--text);
            font-size: 14px;
            font-weight: 800;
        }

        .board-inst {
            color: #94A3B8;
            font-size: 11px;
        }

        .board-best-score {
            color: var(--primary);
            font-size: 23px;
            font-weight: 900;
            text-align: right;
        }

        .board-best-time {
            color: #94A3B8;
            font-size: 10px;
            text-align: right;
        }

        .board-rounds {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-top: 10px;
        }

        .board-round {
            padding: 10px;
            text-align: center;
            background: #F8FAFC;
            border: 1px solid #EEF2F6;
            border-radius: 11px;
        }

        .board-round-label {
            margin-bottom: 3px;
            color: #64748B;
            font-size: 10px;
        }

        .board-round-score {
            color: var(--text);
            font-size: 15px;
            font-weight: 800;
        }

        .board-round-time {
            color: #94A3B8;
            font-size: 10px;
        }

        .footer {
            background: #1E293B;
            padding: 20px;
            text-align: center;
            margin-top: 32px;
        }

        .wrap {
            width: min(1400px, 92%);
            margin: 48px auto;
        }

        .footer img {
            height: 32px;
            margin-bottom: 9px;
            object-fit: contain;
        }

        .footer-text {
            color: rgba(255, 255, 255, .48);
            font-size: 12px;
            letter-spacing: .35px;
        }

        @media (min-width: 640px) {

            .mobile-list,
            .board-mobile-item,
            .mobile-item {
                display: none;
            }
        }

        .btn-reg,



        .btn-login i {
            font-size: 16px;
        }

        .page-title {
            font-size: 23px;
        }

        .page-hd {
            align-items: stretch;
        }

        .page-hd>div:last-child {
            width: 100%;
        }

        .view-toggle {
            width: 100%;
        }

        .view-btn {
            flex: 1;
            justify-content: center;
        }

        .tier-tab {
            min-height: 42px;
            padding: 0 6px;
            font-size: 11px;
        }

        .search-row {
            padding: 13px;
        }

        .search-box {
            min-width: 100%;
        }
        }

        @media (max-width: 639px) {
            .desktop-table {
                display: none;
            }

            .card {
                border-radius: 15px;
            }

            .footer {
                margin-top: 0;
            }
        }
    </style>
</head>

<body>

    <!-- TOPBAR -->
    <div class="topbar">
        <a href="/" class="topbar-logo">
            <img src="/RCL Logo.png" alt="RCL">
        </a>

        <nav class="topbar-nav">

            <a href="/" class="nav-link">
                <span>HOME</span>
                <span>หน้าหลัก</span>
            </a>

            <a href="/#about" class="nav-link">
                <span>ABOUT US</span>
                <span>เกี่ยวกับเรา</span>
            </a>

            <div class="dropdown">
                <button class="nav-link" type="button">
                    <span>COMPETITION</span>
                    <span>
                        การแข่งขัน
                        <i class="ti ti-chevron-down"></i>
                    </span>
                </button>

                <div class="dropdown-menu">
                    <a href="/#tiers" class="dropdown-item">
                        <i class="ti ti-pencil-plus"></i>
                        สมัครแข่งขัน
                    </a>
                    <a href="/competition?view=teams" class="dropdown-item">
                        <i class="ti ti-users"></i>
                        ทีมที่สมัคร
                    </a>
                    <a href="/competition?view=board" class="dropdown-item">
                        <i class="ti ti-chart-bar"></i>
                        ผลสรุปคะแนน
                    </a>
                </div>
            </div>

            <a href="/docs" class="nav-link">
                <span>DOCUMENT</span>
                <span>เอกสาร</span>
            </a>

            <a href="/preorder" class="nav-link">
                <span>PRE-ORDER MISSION</span>
                <span>พรีออเดอร์สนามภารกิจ</span>
            </a>

            <a href="/certificate" class="nav-link certificate-btn" target="_blank">
                <span>CERTIFICATE</span>
                <span>เกียรติบัตร</span>
            </a>

        </nav>

        <div class="topbar-actions">
            <a href="/auth/login" class="btn-login">
                <i class="ti ti-lock"></i>
                <span>เข้าสู่ระบบ</span>
            </a>
        </div>
    </div>

    <div class="wrap">
        <div class="page-hd">
            <div class="page-title">
                <% if (view==='teams' ) { %><span>ทีม</span>ที่สมัคร<% } else { %><span>ผลสรุป</span>คะแนน<% } %>
            </div>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <div class="view-toggle">
                    <a href="/competition?view=teams&tier=<%= activeTier %>"
                        class="view-btn <%= view==='teams'?'active':'' %>"
                        style="font-size: large; font-family: Kanit;">
                        <i class="ti ti-users"></i> ทีมที่สมัคร
                    </a>
                    <a href="/competition?view=board&tier=<%= activeTier %>"
                        class="view-btn <%= view==='board'?'active':'' %>"
                        style="font-size: large; font-family: Kanit;">
                        <i class="ti ti-trophy"></i> ผลสรุปคะแนน
                    </a>
                </div>
            </div>
        </div>

        <!-- Tier tabs -->
        <div style="margin-bottom:14px">
            <div class="tier-tabs">
                <a href="/competition?view=<%= view %>&tier=beginner"
                    class="tier-tab <%= activeTier==='beginner' ? 'active-beginner' : '' %>"
                    style="font-size: large; font-family: Kanit ;">
                    <span class="tier-dot"
                        style="background:<%= activeTier==='beginner'?'#fff':'#16A34A'%> "></span>Beginner
                </a>

                <a href="/competition?view=<%= view %>&tier=intermediate"
                    class="tier-tab <%= activeTier==='intermediate' ? 'active-intermediate' : '' %> "
                    style="font-size: large; font-family: Kanit ;">
                    <span class="tier-dot"
                        style="background:<%= activeTier==='intermediate'?'#fff':'#2563EB' %>"></span>Intermediate
                </a>

                <a href="/competition?view=<%= view %>&tier=advance"
                    class="tier-tab <%= activeTier==='advance' ? 'active-advance' : '' %>"
                    style="font-size: large; font-family: Kanit ;">
                    <span class="tier-dot"
                        style="background:<%= activeTier==='advance'?'#fff':'#EA580C' %>"></span>Advance
                </a>
            </div>
        </div>

        <div
            class="card <%= activeTier==='beginner'?'active-beginner':activeTier==='intermediate'?'active-intermediate':'active-advance' %>">
            <% if (view==='teams' ) { %>
                <div class="search-row">
                    <div class="search-box">
                        <i class="ti ti-search"></i>
                        <input id="teamSearch" placeholder="ค้นหา ID ชื่อทีม หรือสถาบัน...">
                    </div>
                    <span class="count-badge" id="visibleCount">
                        <%= teams ? teams.length : 0 %> ทีม
                    </span>
                    <span class="time-info"><i class="ti ti-clock"></i>
                        <%= timeStr %>
                    </span>
                </div>

                <!-- Desktop table -->
                <div class="desktop-table" style="overflow-x:auto">
                    <table>
                        <thead
                            class="table-head  <%= activeTier==='beginner'?'active-beginner':activeTier==='intermediate'?'active-intermediate':'active-advance' %>">
                            <tr>
                                <th>#</th>
                                <th>ชื่อทีม</th>
                                <th>สถาบัน</th>
                            </tr>
                        </thead>
                        <tbody id="teamTableBody">
                            <% if (!teams || teams.length===0) { %>
                                <tr>
                                    <td colspan="3">
                                        <div class="empty"><i class="ti ti-robot-off"></i>ยังไม่มีทีมในรุ่นนี้</div>
                                    </td>
                                </tr>
                                <% } %>
                                    <% if (teams) { teams.forEach(function(t, i) { %>
                                        <tr
                                            data-search="<%= ((t.id||'')+' '+(t.name||'')+' '+(t.institution||'')).toLowerCase() %>">
                                            <td style="color:#94A3B8;font-size:18px">
                                                <%= i+1 %>
                                            </td>
                                            <td>
                                                <div class="team-name"
                                                    style="color:<%= t.tier==='beginner'?'#16A34A':t.tier==='intermediate'?'#2563EB':'#EA580C' %>">
                                                    <%= t.name %>
                                                </div>
                                                <div class="team-id"
                                                    style="color:<%= t.tier==='beginner'?'#16A34A':t.tier==='intermediate'?'#2563EB':'#EA580C' %>">
                                                    <%= t.id %>
                                                </div>
                                            </td>
                                            <td
                                                style="font-size:18px; font-family: 'Kanit', 'Sarabun', sans-serif; color:<%= t.tier==='beginner'?'#16A34A':t.tier==='intermediate'?'#2563EB':'#EA580C' %>">
                                                <i class="ti ti-school" style="font-size:18px"></i>
                                                <%= t.institution || '—' %>
                                            </td>
                                        </tr>
                                        <% }) } %>
                                            <tr id="noResult" style="display:none">
                                                <td colspan="3">
                                                    <div class="empty"><i class="ti ti-search-off"></i>ไม่พบทีมที่ค้นหา
                                                    </div>
                                                </td>
                                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile list -->
                <div class="mobile-list" id="mobileList">
                    <% if (!teams || teams.length===0) { %>
                        <div class="empty"><i class="ti ti-robot-off"></i>ยังไม่มีทีมในรุ่นนี้</div>
                        <% } %>
                            <% if (teams) { teams.forEach(function(t, i) { %>
                                <div class="mobile-item"
                                    data-search="<%= ((t.id||'')+' '+(t.name||'')+' '+(t.institution||'')).toLowerCase() %>">
                                    <div class="mobile-num">
                                        <%= i+1 %>
                                    </div>
                                    <div class="mobile-info">
                                        <div class="mobile-name">
                                            <%= t.name %>
                                        </div>
                                        <div class="mobile-id">
                                            <%= t.id %>
                                        </div>
                                        <div class="mobile-inst"><i class="ti ti-school"></i>
                                            <%= t.institution || '—' %>
                                        </div>
                                    </div>
                                    <i class="ti ti-chevron-right mobile-arrow"></i>
                                </div>
                                <% }) } %>
                                    <div id="noMobileResult" style="display:none" class="empty"><i
                                            class="ti ti-search-off"></i>ไม่พบทีมที่ค้นหา</div>
                </div>

                <% } else { %>

                    <!-- Board desktop -->
                    <div class="desktop-table" style="overflow-x:auto">
                        <table>
                            <thead>
                                <tr>
                                    <th>อันดับ</th>
                                    <th>ชื่อทีม</th>
                                    <th>รอบที่ 1</th>
                                    <th>รอบที่ 2</th>
                                    <th>คะแนนที่ดีที่สุด</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!ranked || ranked.length===0) { %>
                                    <tr>
                                        <td colspan="5">
                                            <div class="empty"><i class="ti ti-trophy-off"></i>ยังไม่มีผลการแข่งขัน
                                            </div>
                                        </td>
                                    </tr>
                                    <% } %>
                                        <% if (ranked) { ranked.forEach(function(t, i) { %>
                                            <tr>
                                                <td>
                                                    <div class="rank-cell">
                                                        <% if (i===0) { %><span style="font-size:20px">🥇</span><span
                                                                class="rank-gold">1</span>
                                                            <% } else if (i===1) { %><span
                                                                    style="font-size:20px">🥈</span><span
                                                                    class="rank-silver">2</span>
                                                                <% } else if (i===2) { %><span
                                                                        style="font-size:20px">🥉</span><span
                                                                        class="rank-bronze">3</span>
                                                                    <% } else { %><span class="rank-other">#<%= i+1 %>
                                                                        </span>
                                                                        <% } %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="team-name"
                                                        style="color: <%= t.tier==='beginner'?'#16A34A':t.tier==='intermediate'?'#2563EB':'#EA580C' %>">
                                                        <%= t.name %>
                                                    </div>
                                                    <div style="font-size:11px;color:#94A3B8">
                                                        <%= t.institution || '' %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <% if (parseFloat(t.r1_score)>0) { %>
                                                        <span class="score-num">
                                                            <%= parseFloat(t.r1_score) %> pts
                                                        </span>
                                                        <span class="score-time">
                                                            <%= t.r1_time ? parseFloat(t.r1_time).toFixed(2)+' วิ' : ''
                                                                %>
                                                        </span>
                                                        <% } else { %><span style="color:#CBD5E1">—</span>
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <% if (parseFloat(t.r2_score)>0) { %>
                                                        <span class="score-num">
                                                            <%= parseFloat(t.r2_score) %> pts
                                                        </span>
                                                        <span class="score-time">
                                                            <%= t.r2_time ? parseFloat(t.r2_time).toFixed(2)+' วิ' : ''
                                                                %>
                                                        </span>
                                                        <% } else { %><span style="color:#CBD5E1">—</span>
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <% if (parseFloat(t.best_score)>0) { %>
                                                        <span class="best-score">
                                                            <%= parseFloat(t.best_score) %> pts
                                                        </span>
                                                        <span class="score-time">
                                                            <%= t.best_time ? parseFloat(t.best_time).toFixed(2)+' วิ'
                                                                : '' %>
                                                        </span>
                                                        <div class="bar-bg">
                                                            <div class="bar-fill"
                                                                style="width:<%= maxScore>0?Math.round(parseFloat(t.best_score)/maxScore*100):0 %>%;background:<%= i===0?'#D97706':i===1?'#94A3B8':i===2?'#92400E':'#2563EB' %>">
                                                            </div>
                                                        </div>
                                                        <% } else { %><span style="color:#CBD5E1">—</span>
                                                            <% } %>
                                                </td>
                                            </tr>
                                            <% }) } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Board mobile -->
                    <div style="display:none" id="boardMobile">
                        <% if (!ranked || ranked.length===0) { %>
                            <div class="empty"><i class="ti ti-trophy-off"></i>ยังไม่มีผลการแข่งขัน</div>
                            <% } %>
                                <% if (ranked) { ranked.forEach(function(t, i) { %>
                                    <div class="board-mobile-item">
                                        <div class="board-top">
                                            <div class="board-rank-left">
                                                <% if (i===0) { %><span class="board-medal">🥇</span><span
                                                        class="board-pos rank-gold">1</span>
                                                    <% } else if (i===1) { %><span class="board-medal">🥈</span><span
                                                            class="board-pos rank-silver">2</span>
                                                        <% } else if (i===2) { %><span
                                                                class="board-medal">🥉</span><span
                                                                class="board-pos rank-bronze">3</span>
                                                            <% } else { %><span class="board-pos rank-other"
                                                                    style="margin-left:4px">#<%= i+1 %></span>
                                                                <% } %>
                                                                    <div>
                                                                        <div class="board-name">
                                                                            <%= t.name %>
                                                                        </div>
                                                                        <div class="board-inst">
                                                                            <%= t.institution || '' %>
                                                                        </div>
                                                                    </div>
                                            </div>
                                            <% if (parseFloat(t.best_score)>0) { %>
                                                <div>
                                                    <div class="board-best-score">
                                                        <%= parseFloat(t.best_score) %>
                                                    </div>
                                                    <div class="board-best-time">
                                                        <%= t.best_time ? parseFloat(t.best_time).toFixed(2)+' วิ' : ''
                                                            %>
                                                    </div>
                                                </div>
                                                <% } %>
                                        </div>
                                        <div class="board-rounds">
                                            <div class="board-round">
                                                <div class="board-round-label">รอบที่ 1</div>
                                                <% if (parseFloat(t.r1_score)>0) { %>
                                                    <div class="board-round-score">
                                                        <%= parseFloat(t.r1_score) %>
                                                    </div>
                                                    <div class="board-round-time">
                                                        <%= t.r1_time ? parseFloat(t.r1_time).toFixed(2)+' วิ' : '' %>
                                                    </div>
                                                    <% } else { %>
                                                        <div style="color:#CBD5E1;font-size:14px">—</div>
                                                        <% } %>
                                            </div>
                                            <div class="board-round">
                                                <div class="board-round-label">รอบที่ 2</div>
                                                <% if (parseFloat(t.r2_score)>0) { %>
                                                    <div class="board-round-score">
                                                        <%= parseFloat(t.r2_score) %>
                                                    </div>
                                                    <div class="board-round-time">
                                                        <%= t.r2_time ? parseFloat(t.r2_time).toFixed(2)+' วิ' : '' %>
                                                    </div>
                                                    <% } else { %>
                                                        <div style="color:#CBD5E1;font-size:14px">—</div>
                                                        <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) } %>
                    </div>
                    <% } %>
        </div>
    </div>

    <div class="footer">
        <img src="/RCL Logo.png" alt="RCL">
        <div class="footer-text">ROBO CHALLENGE LEAGUE 2026</div>
    </div>

    <script>
        (function () {
            if (window.innerWidth < 640) {
                var bm = document.getElementById('boardMobile')
                if (bm) bm.style.display = 'block'
            }
            var input = document.getElementById('teamSearch')
            if (!input) return
            var rows = Array.from(document.querySelectorAll('#teamTableBody tr[data-search]'))
            var items = Array.from(document.querySelectorAll('#mobileList .mobile-item'))
            var count = document.getElementById('visibleCount')
            var noResult = document.getElementById('noResult')
            var noMobile = document.getElementById('noMobileResult')
            input.addEventListener('input', function () {
                var kw = input.value.trim().toLowerCase()
                var visible = 0
                rows.forEach(function (r) { var m = !kw || r.dataset.search.includes(kw); r.style.display = m ? '' : 'none'; if (m) visible++ })
                items.forEach(function (r) { var m = !kw || r.dataset.search.includes(kw); r.style.display = m ? '' : 'none' })
                if (count) count.textContent = visible + ' ทีม'
                if (noResult) noResult.style.display = visible === 0 ? '' : 'none'
                if (noMobile) noMobile.style.display = visible === 0 ? 'block' : 'none'
            })
        })()

        document.querySelectorAll('.dropdown').forEach(function (dd) {
            var menu = dd.querySelector('.dropdown-menu')
            var timer
            dd.addEventListener('mouseenter', function () {
                clearTimeout(timer)
                menu.style.display = 'block'
            })
            dd.addEventListener('mouseleave', function () {
                timer = setTimeout(function () { menu.style.display = 'none' }, 200)
            })
            menu.addEventListener('mouseenter', function () { clearTimeout(timer) })
            menu.addEventListener('mouseleave', function () {
                timer = setTimeout(function () { menu.style.display = 'none' }, 200)
            })
            // Scroll effect
            window.addEventListener('scroll', function () {
                var topbar = document.querySelector('.topbar');
                if (window.scrollY > 10) {
                    topbar.classList.add('scrolled');
                } else {
                    topbar.classList.remove('scrolled');
                }
            });
        })
    </script>
</body>

</html>