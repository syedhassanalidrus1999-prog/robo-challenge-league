    <script>
      /* Mobile / tablet hamburger menu */
      (function () {
        var toggle = document.querySelector('.mobile-menu-toggle');
        var mobileMenu = document.querySelector('.mobile-menu');
        var competitionToggle = document.querySelector('.mobile-menu-competition-toggle');
        var subMenu = document.querySelector('.mobile-submenu');
        if (!toggle || !mobileMenu) return;

        function closeMobileMenu() {
          toggle.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'เปิดเมนู');
          mobileMenu.classList.remove('is-open');
          mobileMenu.setAttribute('aria-hidden', 'true');
        }

        toggle.addEventListener('click', function (e) {
          e.stopPropagation();
          var isOpen = mobileMenu.classList.toggle('is-open');
          toggle.classList.toggle('is-open', isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
          toggle.setAttribute('aria-label', isOpen ? 'ปิดเมนู' : 'เปิดเมนู');
          mobileMenu.setAttribute('aria-hidden', String(!isOpen));
        });

        if (competitionToggle && subMenu) {
          competitionToggle.addEventListener('click', function () {
            var isOpen = subMenu.classList.toggle('is-open');
            competitionToggle.classList.toggle('is-open', isOpen);
            competitionToggle.setAttribute('aria-expanded', String(isOpen));
          });
        }

        mobileMenu.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', closeMobileMenu);
        });

        document.addEventListener('click', function (e) {
          if (!mobileMenu.contains(e.target) && !toggle.contains(e.target)) closeMobileMenu();
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeMobileMenu();
        });

        window.addEventListener('resize', function () {
          if (window.innerWidth > 1100) closeMobileMenu();
        });
      })();

      /* Desktop dropdown (hover with small delay) */
      document.querySelectorAll('.dropdown').forEach(function (dd) {
        var menu = dd.querySelector('.dropdown-menu');
        var btn = dd.querySelector('button');
        var timer;

        function show() { clearTimeout(timer); menu.style.display = 'block'; }
        function hideSoon() { timer = setTimeout(function () { menu.style.display = 'none'; }, 200); }

        dd.addEventListener('mouseenter', show);
        dd.addEventListener('mouseleave', hideSoon);
        btn.addEventListener('click', function () {
          menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        });
      });

      /* Scrollspy: highlight HOME / ABOUT US / AWARDS / COMPETITION while scrolling */
      (function () {
        var map = {
          home: '/',
          about: '/#about',
          awards: '/#awards',
          tiers: '/#tiers'
        };
        var sections = Object.keys(map)
          .map(function (id) { return document.getElementById(id); })
          .filter(Boolean);
        if (!sections.length) return;

        function linksFor(id) {
          var href = map[id];
          var els = Array.prototype.slice.call(
            document.querySelectorAll('.topbar-nav > a.nav-link[href="' + href + '"], .mobile-menu > a.mobile-menu-link[href="' + href + '"]')
          );
          if (id === 'tiers') {
            els.push(document.querySelector('.dropdown > .nav-link'));
            els.push(document.querySelector('.mobile-menu-competition-toggle'));
          }
          return els.filter(Boolean);
        }

        var current = null;
        function setActive(id) {
          if (id === current) return;
          if (current) linksFor(current).forEach(function (el) { el.classList.remove('active'); });
          linksFor(id).forEach(function (el) { el.classList.add('active'); });
          current = id;
        }

        function update() {
          var offset = window.innerHeight * 0.35;
          var active = sections[0].id;
          sections.forEach(function (sec) {
            if (sec.getBoundingClientRect().top <= offset) active = sec.id;
          });
          setActive(active);
        }

        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();

      /* Topbar background on scroll */
      (function () {
        var topbar = document.querySelector('.topbar');
        function update() { topbar.classList.toggle('scrolled', window.scrollY > 10); }
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();
    </script>

</body>

