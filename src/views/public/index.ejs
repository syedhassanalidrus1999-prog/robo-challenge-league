<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Robo Challenge League 2026</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800&family=Sarabun:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
  <style>
    /* =========================================================
       RCL 2026 — HOME (single source of truth, no override layers)
       01 Tokens / Reset
       02 Section helpers
       03 Topbar + Dropdown
       04 Mobile menu
       05 Hero
       06 Event date card
       07 About
       08 Awards
       09 Competition (countdown / fee bar / tier cards)
       10 Organizers / Partners / Sponsors
       11 Contact footer
       12 Animation
       13 Responsive
    ========================================================= */

    /* 01 — TOKENS / RESET */
    :root {
      --primary: #2563EB;
      --primary-dark: #1D4ED8;
      --primary-soft: #EFF6FF;
      --navy: #0F172A;
      --text: #1E293B;
      --muted: #64748B;
      --line: #E2E8F0;
      --page: #F6F9FE;
      --green: #16A34A;
      --orange: #EA580C;
      --gold: #D97706;
      --shadow-sm: 0 8px 24px rgba(15, 23, 42, .07);
      --content: 1180px;
      --gutter: 24px;
      --topbar-h: 82px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-width: 320px;
      overflow-x: hidden;
      color: var(--text);
      background: var(--page);
      font-family: 'Kanit', 'Sarabun', sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img,
    iframe {
      max-width: 100%;
    }

    button {
      font: inherit;
    }

    :focus-visible {
      outline: 3px solid #93C5FD;
      outline-offset: 2px;
    }

    /* 02 — SECTION HELPERS */
    .section {
      padding: 88px var(--gutter);
      scroll-margin-top: var(--topbar-h);
    }

    .section-inner {
      width: 100%;
      max-width: var(--content);
      margin: 0 auto;
    }

    .section-label {
      width: max-content;
      margin: 0 auto 12px;
      padding: 7px 14px;
      border-radius: 999px;
      background: var(--primary-soft);
      border: 1px solid #DBEAFE;
      color: var(--primary);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.4px;
    }

    .section-title {
      margin-bottom: 12px;
      color: #054394;
      font-size: clamp(30px, 4vw, 48px);
      font-weight: 600;
      line-height: 1.2;
      text-align: center;
    }

    .section-sub {
      max-width: 920px;
      margin: 0 auto 40px;
      color: #334155;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.8;
      text-align: center;
    }

    /* 03 — TOPBAR + DROPDOWN */
    .topbar {
      position: fixed;
      inset: 0 0 auto;
      z-index: 1000;
      height: var(--topbar-h);
      padding: 0 30px;
      display: flex;
      align-items: center;
      gap: 10px;
      background: transparent;
      border-bottom: 1px solid transparent;
      transition: background .25s ease, border-color .25s ease, box-shadow .25s ease;
    }

    .topbar.scrolled {
      background: rgba(255, 255, 255, .92);
      border-bottom-color: rgba(226, 232, 240, .9);
      box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .topbar-logo {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
    }

    .topbar-logo img {
      display: block;
      width: auto;
      height: 58px;
      max-width: 150px;
      object-fit: contain;
    }

    .topbar-nav {
      flex: 1 1 auto;
      min-width: 0;
      margin-left: 18px;
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .nav-link {
      min-height: 52px;
      padding: 0 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      border: 0;
      border-radius: 11px;
      background: transparent;
      color: #334155;
      font-family: 'Kanit', sans-serif;
      font-weight: 700;
      letter-spacing: 1px;
      line-height: 1.15;
      white-space: nowrap;
      cursor: pointer;
      transition: color .2s ease, transform .2s ease;
    }

    .nav-link span:first-child {
      font-size: 17px;
      font-weight: 800;
    }

    .nav-link span:last-child {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-top: 1px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .2px;
    }

    .nav-link:hover,
    .nav-link.active {
      color: var(--primary);
      transform: translateY(-1px);
    }

    .mobile-menu-link.active,
    .mobile-menu-competition-toggle.active {
      color: var(--primary);
      background: var(--primary-soft);
    }

    .certificate-btn {
      min-width: 150px;
      padding: 8px 16px;
      border: 1px solid #F6D365;
      border-radius: 999px;
      background: linear-gradient(135deg, #FFF8D8, #FFF0B8);
      color: #92400E;
      box-shadow: 0 6px 16px rgba(180, 120, 20, .12);
    }

    .certificate-btn:hover {
      background: linear-gradient(135deg, #FDE68A, #FCD34D);
      border-color: #F59E0B;
      color: #78350F;
    }

    .topbar-actions {
      flex: 0 0 auto;
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-login {
      min-height: 52px;
      padding: 0 18px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border: 1px solid var(--line);
      border-radius: 11px;
      background: #fff;
      color: #334155;
      white-space: nowrap;
      transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
    }

    .btn-login:hover {
      background: #F8FAFC;
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }

    .dropdown {
      position: relative;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      z-index: 1100;
      display: none;
      min-width: 205px;
      padding: 8px;
      background: rgba(255, 255, 255, .98);
      border: 1px solid var(--line);
      border-radius: 14px;
      box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
    }

    .dropdown-item {
      min-height: 42px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-radius: 10px;
      color: #334155;
      font-size: 14px;
      font-weight: 700;
      white-space: nowrap;
    }

    .dropdown-item i {
      color: #64748B;
      font-size: 17px;
    }

    .dropdown-item:hover {
      background: var(--primary-soft);
      color: var(--primary);
    }

    /* 04 — MOBILE MENU (shown ≤1100px) */
    .mobile-menu-toggle,
    .mobile-menu {
      display: none;
    }

    .mobile-menu-toggle {
      margin-left: auto;
      width: 44px;
      height: 44px;
      flex: 0 0 44px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      border: 1px solid rgba(148, 163, 184, .35);
      border-radius: 12px;
      background: rgba(255, 255, 255, .92);
      color: #1E3A8A;
      box-shadow: 0 5px 16px rgba(15, 23, 42, .08);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .mobile-menu-toggle span {
      width: 21px;
      height: 2px;
      border-radius: 999px;
      background: currentColor;
      transition: transform .22s ease, opacity .18s ease;
    }

    .mobile-menu-toggle.is-open span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .mobile-menu-toggle.is-open span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu-toggle.is-open span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .mobile-menu {
      position: fixed;
      top: calc(var(--topbar-h) + 6px);
      right: 12px;
      z-index: 999;
      width: min(380px, calc(100% - 24px));
      max-height: calc(100dvh - var(--topbar-h) - 18px);
      overflow-y: auto;
      padding: 8px;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px) scale(.985);
      transform-origin: top right;
      background: rgba(255, 255, 255, .98);
      border: 1px solid #DBEAFE;
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, .18);
      transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
    }

    .mobile-menu.is-open {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    .mobile-menu-link,
    .mobile-menu-competition-toggle {
      width: 100%;
      min-height: 50px;
      padding: 9px 12px;
      display: flex;
      align-items: center;
      gap: 11px;
      border: 0;
      border-radius: 12px;
      background: transparent;
      color: #334155;
      font-family: 'Kanit', sans-serif;
      font-size: 15px;
      font-weight: 700;
      text-align: left;
      cursor: pointer;
    }

    .mobile-menu-link:hover,
    .mobile-menu-competition-toggle:hover {
      color: var(--primary);
      background: var(--primary-soft);
    }

    .mobile-menu-link>i,
    .mobile-menu-competition-toggle>i:first-child {
      width: 28px;
      flex: 0 0 28px;
      display: grid;
      place-items: center;
      color: var(--primary);
      font-size: 19px;
    }

    .mobile-menu-link-text {
      min-width: 0;
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

    .mobile-menu-link-text strong {
      font-size: 15px;
      font-weight: 800;
    }

    .mobile-menu-link-text small {
      margin-top: 2px;
      color: #64748B;
      font-size: 11px;
      font-weight: 500;
    }

    .mobile-chevron {
      margin-left: auto;
      color: #64748B;
      font-size: 17px;
      transition: transform .2s ease;
    }

    .mobile-menu-competition-toggle.is-open .mobile-chevron {
      transform: rotate(180deg);
    }

    .mobile-submenu {
      display: none;
      margin: 0 8px 6px 51px;
      padding: 5px;
      background: #F8FAFC;
      border: 1px solid var(--line);
      border-radius: 12px;
    }

    .mobile-submenu.is-open {
      display: block;
    }

    .mobile-submenu a {
      min-height: 42px;
      padding: 8px 10px;
      display: flex;
      align-items: center;
      gap: 9px;
      border-radius: 9px;
      color: #475569;
      font-size: 13px;
      font-weight: 600;
    }

    .mobile-submenu a:hover {
      color: var(--primary);
      background: var(--primary-soft);
    }

    .mobile-menu-divider {
      height: 1px;
      margin: 6px 4px;
      background: var(--line);
    }

    .mobile-login>i {
      color: #475569 !important;
    }

    /* 05 — HERO */
    .hero {
      position: relative;
      overflow: hidden;
      min-height: 100vh;
      min-height: 100svh;
      padding: 140px var(--gutter) 96px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      background: linear-gradient(rgba(255, 255, 255, .20), rgba(255, 255, 255, .90)), url('/images/hero-bg.png') center/cover no-repeat;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -230px;
      left: 50%;
      width: 760px;
      height: 760px;
      transform: translateX(-50%);
      border: 1px solid rgba(37, 99, 235, .10);
      border-radius: 50%;
      box-shadow: 0 0 0 70px rgba(37, 99, 235, .025), 0 0 0 150px rgba(37, 99, 235, .018);
    }

    .hero::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 190px;
      background: linear-gradient(135deg, transparent 48%, rgba(37, 99, 235, .04) 49%, rgba(37, 99, 235, .04) 51%, transparent 52%) 0 0/42px 42px;
      -webkit-mask-image: linear-gradient(to top, black, transparent);
      mask-image: linear-gradient(to top, black, transparent);
    }

    .hero>* {
      position: relative;
      z-index: 1;
    }

    .hero-logo {
      width: min(1000px, 78vw);
      height: auto;
      margin-bottom: 6px;
      object-fit: contain;
      filter: drop-shadow(0 24px 40px rgba(37, 99, 235, .25));
      animation: floatLogo 4s ease-in-out infinite;
    }

    .hero-desc {
      width: min(920px, 100%);
      margin: 16px auto 26px;
      padding: 16px 22px;
      background: radial-gradient(circle at 50% 0%, rgba(37, 99, 235, .08), transparent 80%), #fff;
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
      color: #334155;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.8;
    }

    .hero-actions {
      width: min(100%, 680px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .hero-actions-bottom {
      width: min(100%, 520px);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .hero-btn-register,
    .hero-btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      font-family: 'Kanit', sans-serif;
      font-weight: 650;
      transition: .22s ease;
    }

    .hero-btn-register {
      width: min(100%, 520px);
      min-height: 72px;
      padding: 0 36px;
      border: 1px solid transparent;
      border-radius: 18px;
      background: linear-gradient(135deg, #3478F6, #2563EB);
      color: #fff;
      font-size: 40px;
      letter-spacing: 2px;
      box-shadow: 0 14px 30px rgba(37, 99, 235, .26);
    }

    .hero-btn-register i {
      transition: transform .8s ease;
    }

    .hero-btn-register:hover {
      color: #333;
      transform: translateY(-3px);
      background: linear-gradient(135deg, #f2d13d, #e6d405);
      box-shadow: 0 18px 38px rgba(248, 215, 28, .34);
    }

    .hero-btn-register:hover i {
      transform: rotate(360deg);
    }

    .hero-btn-secondary {
      width: 100%;
      min-height: 56px;
      padding: 0 16px;
      border: 1px solid rgba(203, 213, 225, .9);
      border-radius: 14px;
      background: rgba(255, 255, 255, .84);
      color: #334155;
      font-size: 23px;
      box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
      backdrop-filter: blur(10px);
    }

    .hero-btn-secondary:hover {
      color: var(--primary);
      border-color: #93C5FD;
      transform: translateY(-3px);
    }

    .hero-scroll {
      position: absolute;
      bottom: 22px;
      left: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      color: #94A3B8;
      font-size: 12px;
      transform: translateX(-50%);
      animation: bounce 2s ease-in-out infinite;
    }

    /* 06 — EVENT DATE CARD */
    .event-date-card {
      width: 100%;
      min-height: 205px;
      margin-top: 10px;
      display: grid;
      grid-template-columns: 285px minmax(0, 1fr);
      background: rgba(255, 255, 255, .97);
      border: 1px solid rgba(147, 197, 253, .65);
      border-radius: 27px;
      box-shadow: 0 20px 45px rgba(37, 99, 235, .15), 0 5px 16px rgba(15, 23, 42, .05);
      text-align: left;
    }

    .event-date-main {
      position: relative;
      overflow: hidden;
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #fff;
      text-align: center;
      border-radius: 26px 0 0 26px;
      background: radial-gradient(circle at 80% 15%, rgba(56, 189, 248, .28), transparent 38%), linear-gradient(145deg, #1554C7, #0B347F 55%, #08265E);
    }

    .event-date-main::before {
      content: '';
      position: absolute;
      width: 240px;
      height: 240px;
      top: -95px;
      right: -70px;
      border: 1px solid rgba(255, 255, 255, .07);
      border-radius: 50%;
      box-shadow: 0 0 0 45px rgba(255, 255, 255, .025), 0 0 0 90px rgba(255, 255, 255, .015);
    }

    .event-date-main>* {
      position: relative;
      z-index: 1;
    }

    .event-date-icon {
      width: 43px;
      height: 43px;
      margin-bottom: 5px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: rgba(255, 255, 255, .08);
      border: 1px solid rgba(255, 255, 255, .20);
      font-size: 22px;
    }

    .event-date-label {
      margin-bottom: 2px;
      font-size: 20px;
      font-weight: 600;
      line-height: 1.2;
    }

    .event-day-number {
      font-size: 70px;
      font-weight: 500;
      line-height: .9;
      letter-spacing: -3px;
      white-space: nowrap;
      text-shadow: 0 5px 15px rgba(0, 0, 0, .25);
    }

    .event-day-number.is-range {
      font-size: 54px;
      letter-spacing: -1px;
    }

    .event-day-number.is-empty {
      font-size: 48px;
      letter-spacing: 0;
    }

    .event-month {
      margin-top: 6px;
      font-size: 22px;
      font-weight: 500;
      line-height: 1;
    }

    .event-date-to {
      margin-top: 4px;
      color: rgba(255, 255, 255, .7);
      font-size: 13px;
    }

    .event-date-range {
      margin-top: 5px;
      color: #ACD6FF;
      font-size: 16px;
      font-weight: 500;
      line-height: 1.2;
    }

    .event-location-main {
      position: relative;
      overflow: hidden;
      min-width: 0;
      padding: 28px 28px 26px 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-radius: 0 26px 26px 0;
      background: radial-gradient(circle at 100% 15%, rgba(56, 189, 248, .08), transparent 34%), linear-gradient(135deg, #fff, #F8FBFF);
    }

    .event-location-heading {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .event-location-icon {
      flex: 0 0 auto;
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: var(--primary);
      background: linear-gradient(145deg, #F0F7FF, #E5F1FF);
      border: 1px solid #D5E8FF;
      font-size: 23px;
    }

    .event-location-title {
      color: #1452C5;
      font-size: 22px;
      font-weight: 600;
      line-height: 1.2;
    }

    .event-location-line {
      height: 1px;
      margin: 12px 0 14px;
      background: linear-gradient(90deg, #BFDBFE, #DCEBFA, transparent);
    }

    .event-location-name {
      color: #102B5C;
      font-size: 25px;
      font-weight: 500;
      line-height: 1.3;
      overflow-wrap: anywhere;
    }

    .event-location-name .is-empty {
      color: #94A3B8;
      font-size: 18px;
    }

    /* 07 — ABOUT */
    .about-section {
      position: relative;
      overflow: hidden;
      background: radial-gradient(circle at 12% 18%, rgba(37, 99, 235, .10), transparent 24%), radial-gradient(circle at 88% 78%, rgba(14, 165, 233, .08), transparent 24%), linear-gradient(180deg, #F7FAFF, #F3F7FC);
      border-top: 1px solid #EAF0F7;
    }

    .about-section::before {
      content: '';
      position: absolute;
      top: -150px;
      left: -210px;
      width: 420px;
      height: 420px;
      border: 1px solid rgba(37, 99, 235, .10);
      border-radius: 50%;
      box-shadow: 0 0 0 55px rgba(37, 99, 235, .025), 0 0 0 110px rgba(37, 99, 235, .015);
    }

    .about-section .section-inner {
      position: relative;
      z-index: 1;
    }

    .about-heading {
      max-width: 940px;
      margin: 0 auto 42px;
      text-align: center;
    }

    .about-heading .section-sub {
      margin-bottom: 0;
    }

    .about-video-wrap {
      max-width: 960px;
      margin: 0 auto 48px;
      padding: 12px;
      background: rgba(255, 255, 255, .84);
      border: 1px solid rgba(191, 219, 254, .8);
      border-radius: 26px;
      box-shadow: 0 24px 60px rgba(37, 99, 235, .11), 0 4px 14px rgba(15, 23, 42, .04);
    }

    .about-video-head {
      padding: 7px 8px 15px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .about-video-icon {
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      color: #fff;
      background: linear-gradient(135deg, #2563EB, #38BDF8);
      box-shadow: 0 8px 20px rgba(37, 99, 235, .25);
      font-size: 21px;
    }

    .about-video-kicker {
      margin-bottom: 2px;
      color: var(--primary);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.8px;
    }

    .about-video-title {
      color: var(--navy);
      font-size: 18px;
      font-weight: 600;
    }

    .about-video {
      overflow: hidden;
      aspect-ratio: 16 / 9;
      background: var(--navy);
      border-radius: 18px;
    }

    .about-video iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .about-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
      align-items: stretch;
    }

    .about-card {
      position: relative;
      overflow: hidden;
      padding: 30px 30px 26px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      border: 1px solid rgba(226, 232, 240, .95);
      border-radius: 28px;
      box-shadow: 0 18px 48px rgba(37, 99, 235, .08);
      transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }

    .about-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 6px;
    }

    .about-card:hover {
      transform: translateY(-7px);
      border-color: #BFDBFE;
      box-shadow: 0 24px 52px rgba(37, 99, 235, .12);
    }

    .about-card-robo {
      background: radial-gradient(circle at 8% 55%, rgba(37, 99, 235, .10), transparent 25%), linear-gradient(135deg, #fff, #F7FAFF);
    }

    .about-card-robo::before {
      background: linear-gradient(90deg, #2563EB, #60A5FA);
    }

    .about-card-tiers {
      background: radial-gradient(circle at 92% 18%, rgba(74, 222, 128, .10), transparent 25%), linear-gradient(135deg, #fff, #FBFFF9);
    }

    .about-card-tiers::before {
      background: linear-gradient(90deg, #16A34A, #86EFAC);
    }

    .about-card-content {
      width: 100%;
    }

    .about-visual {
      position: relative;
      height: 225px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .about-visual::before {
      content: '';
      position: absolute;
      width: 190px;
      height: 190px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37, 99, 235, .08), transparent 68%);
    }

    .about-visual-green::before {
      background: radial-gradient(circle, rgba(34, 197, 94, .10), transparent 68%);
    }

    .about-visual img {
      position: relative;
      z-index: 1;
      width: auto;
      height: 205px;
      object-fit: contain;
      filter: drop-shadow(0 16px 18px rgba(15, 23, 42, .10));
      transition: transform .25s ease;
    }

    .about-card:hover .about-visual img {
      transform: translateY(-4px) scale(1.025);
    }

    .about-spark {
      position: absolute;
      width: 8px;
      height: 8px;
      border-radius: 2px;
      background: #60A5FA;
      opacity: .65;
    }

    .about-spark::after {
      content: '';
      position: absolute;
      top: 18px;
      left: 18px;
      width: 4px;
      height: 4px;
      border-radius: 1px;
      background: inherit;
    }

    .spark-1 {
      left: 13%;
      top: 27%;
    }

    .spark-2 {
      right: 16%;
      top: 20%;
    }

    .spark-3 {
      left: 18%;
      bottom: 19%;
    }

    .spark-4 {
      right: 9%;
      top: 22%;
      background: #4ADE80;
    }

    .spark-5 {
      right: 18%;
      bottom: 18%;
      background: #86EFAC;
    }

    .about-card-title {
      margin-bottom: 10px;
      font-size: 36px;
      font-weight: 800;
      line-height: 1.15;
    }

    .about-title-blue {
      background: linear-gradient(90deg, #2563EB, #60A5FA);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .about-title-green {
      background: linear-gradient(90deg, #15803D, #4ADE80);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .about-card-desc {
      max-width: 560px;
      margin: 0 auto;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.85;
    }

    .about-card-desc strong {
      color: var(--primary);
      font-weight: 800;
    }

    .about-feature-row {
      margin-top: 22px;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 9px;
    }

    .about-feature {
      min-height: 112px;
      padding: 12px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 7px;
      background: rgba(255, 255, 255, .78);
      border: 1px solid #DCE8F8;
      border-radius: 16px;
    }

    .about-feature i {
      font-size: 28px;
      color: var(--primary);
    }

    .about-feature:nth-child(2) i {
      color: #F59E0B;
    }

    .about-feature:nth-child(3) i {
      color: #16A34A;
    }

    .about-feature:nth-child(4) i {
      color: #8B5CF6;
    }

    .about-feature span {
      color: #334155;
      font-size: 12px;
      font-weight: 600;
      line-height: 1.45;
    }

    .about-category-head {
      min-height: 225px;
      display: grid;
      grid-template-columns: 1fr 210px;
      align-items: center;
      gap: 10px;
      text-align: left;
    }

    .about-category-line {
      width: 48px;
      height: 4px;
      margin-bottom: 16px;
      border-radius: 99px;
      background: linear-gradient(90deg, #16A34A, #4ADE80);
    }

    .about-category-intro {
      color: #334155;
      font-size: 15px;
      font-weight: 500;
      line-height: 1.7;
    }

    .about-category-head .about-visual {
      height: 215px;
    }

    .about-category-head .about-visual img {
      height: 200px;
    }

    .about-tier-summary {
      margin-top: 30px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }

    .about-tier-item {
      --c: var(--green);
      min-width: 0;
      min-height: 190px;
      padding: 16px 10px 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      background: #fff;
      border: 1px solid var(--line);
      border-top: 4px solid var(--c);
      border-radius: 18px;
      text-align: center;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .about-tier-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(15, 23, 42, .08);
    }

    .about-tier-beginner {
      --c: #16A34A;
      background: #F8FEFA;
    }

    .about-tier-intermediate {
      --c: #2563EB;
      background: #F8FAFF;
    }

    .about-tier-advance {
      --c: #EA580C;
      background: #FFFBF7;
    }

    .about-tier-icon {
      width: 42px;
      height: 42px;
      margin: -37px auto 9px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--c);
      color: #fff;
      font-size: 20px;
      box-shadow: 0 5px 12px rgba(15, 23, 42, .12);
    }

    .about-tier-name {
      margin-bottom: 7px;
      color: var(--c);
      font-size: 18px;
      font-weight: 800;
    }

    .about-tier-info {
      color: #64748B;
      font-size: 12px;
      line-height: 1.55;
    }

    .about-tier-btn {
      width: calc(100% - 10px);
      min-height: 40px;
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border: 1px solid var(--c);
      border-radius: 999px;
      background: rgba(255, 255, 255, .72);
      color: var(--c);
      font-size: 12px;
      font-weight: 700;
      transition: .2s ease;
    }

    .about-tier-item .about-tier-info:last-of-type {
      margin-bottom: 12px;
    }

    .about-tier-btn:hover {
      background: var(--c);
      color: #fff;
      transform: translateY(-2px);
    }

    /* 08 — AWARDS */
    .awards-section {
      background: linear-gradient(180deg, #F3F7FC, #F7FAFF);
    }

    .award-card {
      position: relative;
      overflow: hidden;
      padding: 30px 34px;
      display: grid;
      grid-template-columns: 290px minmax(0, 1fr);
      gap: 32px;
      align-items: stretch;
      background: radial-gradient(circle at 10% 50%, rgba(251, 191, 36, .12), transparent 32%), linear-gradient(135deg, #fff, #FFFDF7);
      border: 1px solid rgba(226, 232, 240, .95);
      border-radius: 28px;
      box-shadow: 0 18px 48px rgba(154, 91, 0, .08);
    }

    .award-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 6px;
      background: linear-gradient(90deg, #D97706, #FBBF24);
    }

    .award-intro {
      padding-right: 30px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      border-right: 1px solid #F1E8D2;
    }

    .awards-heading {
      max-width: 940px;
      margin: 0 auto 36px;
      text-align: center;
    }

    .awards-heading .section-sub {
      margin-bottom: 0;
    }

    .awards-label {
      color: #B45309;
      background: #FFF7ED;
      border-color: #FED7AA;
    }

    .awards-title {
      color: #B45309;
      background: linear-gradient(90deg, #B45309, #D97706 45%, #F59E0B);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .award-intro img {
      width: 100%;
      max-width: 240px;
      height: auto;
      max-height: 300px;
      object-fit: contain;
      filter: drop-shadow(0 18px 24px rgba(154, 91, 0, .18));
    }

    .award-content {
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .award-content-title {
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 9px;
      color: #9A5B00;
      font-size: 20px;
      font-weight: 700;
    }

    .award-content-title i {
      color: var(--gold);
      font-size: 23px;
    }

    .award-grid {
      display: grid;
      grid-template-columns: 1.18fr repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .award-item {
      min-width: 0;
      padding: 15px 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      text-align: center;
      background: #fff;
      border: 1px solid #F1E8D2;
      border-radius: 18px;
      box-shadow: 0 7px 18px rgba(154, 91, 0, .06);
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .award-item:hover {
      transform: translateY(-3px);
      border-color: #F6D98A;
      box-shadow: 0 12px 24px rgba(154, 91, 0, .10);
    }

    .award-item img {
      width: auto;
      height: 70px;
      margin-bottom: 10px;
      object-fit: contain;
    }

    .award-item.is-gold img {
      height: 100px;
    }

    .award-item-label {
      color: #64748B;
      font-size: 18px;
      font-weight: 700;
      line-height: 1.4;
    }

    .award-item.is-gold .award-item-label {
      font-size: 22px;
    }

    .award-item-value {
      margin-top: 5px;
      color: #B77900;
      font-size: 24px;
      font-weight: 800;
      line-height: 1.2;
    }

    .award-item.is-gold .award-item-value,
    .award-item.is-silver .award-item-value,
    .award-item.is-bronze .award-item-value {
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .award-item.is-gold .award-item-value {
      font-size: 35px;
      background-image: linear-gradient(180deg, #FFF8C5 0%, #F6D365 25%, #D4A017 50%, #B77900 75%, #8C5A00 100%);
    }

    .award-item.is-silver .award-item-value {
      font-size: 32px;
      background-image: linear-gradient(180deg, #FFFFFF 0%, #D9DDE2 20%, #8F969E 45%, #7D8184 60%, #959A9F 80%, #6B7280 100%);
    }

    .award-item.is-bronze .award-item-value {
      font-size: 32px;
      background-image: linear-gradient(180deg, #FFE0B2 0%, #CD7F32 25%, #A85D20 50%, #E6A15C 70%, #8C4A18 100%);
    }

    .award-item small {
      margin-top: 4px;
      color: #94A3B8;
      font-size: 14px;
      line-height: 1.4;
    }

    .award-note {
      margin-top: 18px;
      padding: 17px 18px 18px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      background: #FFFBEB;
      border: 1px solid #FDE68A;
      border-radius: 18px;
      color: #64748B;
    }

    .award-note-title {
      grid-column: 1 / -1;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      color: #9A5B00;
      font-size: 18px;
      font-weight: 700;
      line-height: 1.45;
    }

    .award-note-title i {
      flex: 0 0 auto;
      margin-top: 2px;
      color: var(--gold);
      font-size: 22px;
    }

    .award-note-item {
      min-width: 0;
      padding: 12px 13px;
      display: flex;
      align-items: flex-start;
      gap: 8px;
      background: rgba(255, 255, 255, .72);
      border: 1px solid #FDE9B2;
      border-radius: 14px;
      font-size: 13px;
      line-height: 1.65;
    }

    .award-bullet {
      flex: 0 0 auto;
      margin-top: 6px;
      color: var(--gold);
      font-size: 10px;
    }

    /* 09 — COMPETITION */
    .tiers-section {
      background: radial-gradient(circle at 12% 15%, rgba(37, 99, 235, .08), transparent 28%), radial-gradient(circle at 88% 70%, rgba(14, 165, 233, .06), transparent 25%), linear-gradient(180deg, #F7FAFF, #EEF4FB);
    }

    .tiers-section .section-sub {
      margin-bottom: 28px;
      color: #64748B;
      font-size: 15px;
    }

    /* Countdown */
    .registration-countdown {
      --state: var(--primary);
      --state-soft: #EFF6FF;
      --state-border: #DBEAFE;
      position: relative;
      overflow: hidden;
      width: min(100%, 1000px);
      margin: 0 auto 28px;
      padding: 28px 40px;
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
      align-items: center;
      gap: 36px;
      background: radial-gradient(circle at 16% 50%, rgba(37, 99, 235, .08), transparent 34%), rgba(255, 255, 255, .97);
      border: 1px solid #DBE4EF;
      border-radius: 24px;
      box-shadow: 0 18px 42px rgba(15, 23, 42, .07);
    }

    .registration-countdown::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 4px;
      background: var(--state);
    }

    .registration-countdown.is-upcoming {
      --state: #2563EB;
      --state-soft: #EFF6FF;
      --state-border: #DBEAFE;
    }

    .registration-countdown.is-open {
      --state: #16A34A;
      --state-soft: #F0FDF4;
      --state-border: #BBF7D0;
    }

    .registration-countdown.is-closing {
      --state: #EA580C;
      --state-soft: #FFF7ED;
      --state-border: #FED7AA;
    }

    .registration-countdown.is-closed {
      --state: #DC2626;
      --state-soft: #FEF2F2;
      --state-border: #FECACA;
    }

    .registration-countdown>img {
      width: 100%;
      max-width: 250px;
      height: 240px;
      justify-self: center;
      object-fit: contain;
      filter: drop-shadow(0 18px 22px rgba(37, 99, 235, .16));
      transition: transform .25s ease;
    }

    .registration-countdown:hover>img {
      transform: translateY(-5px) scale(1.025);
    }

    .reg-body {
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      text-align: center;
    }

    .reg-status-label {
      max-width: 100%;
      padding: 7px 22px;
      background: var(--state-soft);
      border: 1px solid var(--state-border);
      border-radius: 999px;
      color: var(--state);
      font-size: 26px;
      font-weight: 800;
      line-height: 1.25;
    }

    .reg-countdown {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 6px;
    }

    .reg-countdown:empty {
      display: none;
    }

    .reg-countdown-unit {
      min-width: 104px;
      padding: 12px 8px 10px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 14px;
      box-shadow: 0 7px 18px rgba(15, 23, 42, .055);
    }

    .reg-countdown-number {
      color: #F97316;
      font-size: 50px;
      font-weight: 900;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .reg-countdown-unit-label {
      margin-top: 6px;
      color: #64748B;
      font-family: 'Sarabun', sans-serif;
      font-size: 13px;
      font-weight: 700;
    }

    .reg-countdown-separator {
      padding: 18px 2px 0;
      color: #CBD5E1;
      font-size: 24px;
      font-weight: 800;
    }

    .reg-status-msg {
      color: var(--state);
      font-size: 20px;
      font-weight: 600;
      line-height: 1.5;
    }

    /* Fee bar */
    .registration-info {
      width: min(100%, 1060px);
      margin: 0 auto 28px;
      display: grid;
      grid-template-columns: 235px repeat(3, minmax(0, 1fr));
      overflow: hidden;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, .07);
    }

    .registration-label {
      position: relative;
      overflow: hidden;
      padding: 18px 28px;
      display: flex;
      align-items: center;
      gap: 14px;
      color: #fff;
      background: linear-gradient(135deg, #1554C7, #2563EB);
    }

    .registration-label-icon {
      flex: 0 0 auto;
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      font-size: 25px;
      transform: rotate(-8deg);
    }

    .registration-label-title {
      font-size: 22px;
      font-weight: 700;
      line-height: 1.15;
      white-space: nowrap;
    }

    .registration-label-sub {
      margin-top: 5px;
      font-family: 'Sarabun', sans-serif;
      font-size: 12px;
      font-weight: 500;
      opacity: .9;
      white-space: nowrap;
    }

    .registration-item {
      position: relative;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .registration-item+.registration-item::before {
      content: '';
      position: absolute;
      left: 0;
      top: 22px;
      bottom: 22px;
      width: 1px;
      background: #DCE4EE;
    }

    .registration-item-icon {
      flex: 0 0 auto;
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 15px;
      color: #1554C7;
      background: var(--primary-soft);
      font-size: 23px;
    }

    .registration-item-label {
      color: #64748B;
      font-family: 'Sarabun', sans-serif;
      font-size: 12px;
      font-weight: 600;
    }

    .registration-item-value {
      margin-top: 3px;
      color: var(--primary);
      font-size: 21px;
      font-weight: 800;
      line-height: 1.25;
      white-space: nowrap;
    }

    /* Tier cards */
    .tiers-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      align-items: stretch;
    }

    .tier-card {
      --tier: #16A34A;
      --tier-soft: #F0FDF4;
      --tier-border: #BBF7D0;
      --tier-bg: #FBFFFC;
      position: relative;
      overflow: hidden;
      padding: 28px 22px 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      background: linear-gradient(180deg, #fff, var(--tier-bg));
      border: 1px solid #DFE7F0;
      border-radius: 22px;
      box-shadow: 0 12px 30px rgba(15, 23, 42, .065);
      transition: transform .22s ease, box-shadow .22s ease;
    }

    .tier-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 6px;
      background: var(--tier);
    }

    .tier-card:hover {
      transform: translateY(-7px);
      box-shadow: 0 22px 48px rgba(15, 23, 42, .12);
    }

    .tier-card.t-i {
      --tier: #2563EB;
      --tier-soft: #EFF6FF;
      --tier-border: #BFDBFE;
      --tier-bg: #FAFDFF;
    }

    .tier-card.t-a {
      --tier: #EA580C;
      --tier-soft: #FFF7ED;
      --tier-border: #FED7AA;
      --tier-bg: #FFFAF7;
    }

    .tier-emoji {
      width: 60px;
      height: 60px;
      margin-bottom: 12px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      background: var(--tier-soft);
      font-size: 32px;
    }

    .tier-name {
      margin-bottom: 8px;
      color: var(--tier);
      font-size: 30px;
      font-weight: 800;
      line-height: 1.2;
    }

    .tier-desc {
      max-width: 300px;
      min-height: 66px;
      margin-bottom: 14px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
    }

    .tier-arena {
      width: 100%;
      margin-bottom: 12px;
      padding: 10px;
      background: radial-gradient(circle at 50% 0%, var(--tier-soft), transparent 80%), #fff;
      border: 1px solid var(--tier-border);
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
    }

    .tier-arena-title {
      color: var(--tier);
      font-size: 18px;
      font-weight: 700;
    }

    .tier-arena img {
      display: block;
      width: 100%;
      max-width: 250px;
      height: 140px;
      margin: 8px auto 0;
      object-fit: contain;
    }

    .tier-meta {
      width: 100%;
      padding: 9px 6px;
      border-top: 1px solid #EEF2F7;
      color: var(--tier);
      font-size: 17px;
      font-weight: 600;
      line-height: 1.45;
    }

    .tier-footer {
      width: 100%;
      margin-top: auto;
      padding-top: 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .tier-badge {
      min-height: 34px;
      padding: 0 14px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border-radius: 999px;
      background: var(--tier-soft);
      color: var(--tier);
      font-size: 16px;
      font-weight: 700;
    }

    .tier-badge i {
      font-size: 18px;
    }

    .tier-reg-btn {
      width: min(100%, 210px);
      min-height: 48px;
      padding: 0 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border: 1px solid var(--tier-border);
      border-radius: 12px;
      background: var(--tier-soft);
      color: var(--tier);
      font-size: 18px;
      font-weight: 700;
      transition: .2s ease;
    }

    a.tier-reg-btn:hover {
      background: var(--tier);
      border-color: var(--tier);
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 8px 18px rgba(15, 23, 42, .09);
    }

    .tier-reg-btn.is-disabled {
      opacity: .55;
      cursor: not-allowed;
      font-size: 15px;
    }

    .tier-reg-btn.is-closed {
      background: #FEE2E2;
      border-color: #FECACA;
      color: #DC2626;
    }

    /* 10 — ORGANIZERS / PARTNERS / SPONSORS */
    .sponsor-section {
      padding: 72px var(--gutter) 78px;
      background: radial-gradient(circle at 10% 20%, rgba(37, 99, 235, .045), transparent 28%), radial-gradient(circle at 90% 80%, rgba(234, 88, 12, .035), transparent 25%), #F8FAFC;
      border-top: 1px solid #E5EAF1;
    }

    .sponsor-container {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
    }

    .brand-heading {
      margin-bottom: 28px;
      text-align: center;
    }

    .brand-eyebrow {
      display: inline-flex;
      margin-bottom: 10px;
      padding: 5px 10px;
      border-radius: 999px;
      color: var(--primary);
      background: var(--primary-soft);
      border: 1px solid #DBEAFE;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.6px;
    }

    .brand-title {
      font-weight: 700;
      line-height: 1.2;
    }

    .brand-title.organizer {
      color: #D97706;
      font-size: 46px;
    }

    .brand-title.partner {
      color: #EFBF04;
      font-size: 42px;
    }

    .brand-title.sponsor {
      color: #A8AEB6;
      font-size: 38px;
    }

    .brand-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 220px));
      justify-content: center;
      gap: 16px;
    }

    .brand-card {
      min-height: 120px;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      background: rgba(255, 255, 255, .92);
      border: 1px solid var(--line);
      border-radius: 15px;
      box-shadow: 0 3px 12px rgba(15, 23, 42, .035);
      transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

    .brand-card:hover {
      transform: translateY(-3px);
      border-color: #CBD5E1;
      box-shadow: 0 10px 25px rgba(15, 23, 42, .08);
    }

    .brand-card img {
      display: block;
      width: auto;
      max-width: 100%;
      max-height: 80px;
      object-fit: contain;
    }

    .organizer-grid .brand-card {
      min-height: 140px;
    }

    .organizer-grid .brand-card img {
      max-height: 110px;
    }

    .brand-placeholder {
      border-style: dashed;
      background: linear-gradient(180deg, #fff, #F8FAFC);
      color: #94A3B8;
      font-size: 11px;
      font-weight: 700;
    }

    .brand-placeholder:hover {
      border-color: #93C5FD;
      color: var(--primary);
    }

    .brand-add-icon {
      width: 30px;
      height: 30px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: #F1F5F9;
      font-size: 19px;
      font-weight: 400;
    }

    .brand-divider {
      position: relative;
      height: 1px;
      margin: 56px 0;
      background: #E8EDF3;
    }

    .brand-divider::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      width: 42px;
      height: 3px;
      transform: translate(-50%, -50%);
      border-radius: 999px;
      background: linear-gradient(90deg, #2563EB, #60A5FA);
    }

    /* 11 — CONTACT FOOTER */
    .contact-section {
      position: relative;
      overflow: hidden;
      padding: 72px var(--gutter) 28px;
      background: radial-gradient(circle at 15% 20%, rgba(96, 165, 250, .18), transparent 28%), radial-gradient(circle at 85% 80%, rgba(37, 99, 235, .22), transparent 30%), linear-gradient(135deg, #0B1220 0%, #172554 58%, #1554C7 100%);
      color: #fff;
    }

    .contact-inner {
      width: 100%;
      max-width: var(--content);
      margin: 0 auto;
    }

    .contact-footer-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr 1.2fr 1.3fr;
      gap: 44px;
      align-items: start;
    }

    .contact-brand-logo {
      display: inline-flex;
      margin-bottom: 18px;
      transition: transform .2s ease, filter .2s ease;
    }

    .contact-brand-logo:hover {
      transform: translateY(-2px);
      filter: drop-shadow(0 0 10px rgba(126, 194, 242, .5));
    }

    .contact-brand-logo img {
      display: block;
      width: auto;
      height: 150px;
      max-width: 190px;
      object-fit: contain;
    }

    .contact-socials {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .contact-social {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(0, 136, 248, .55);
      border-radius: 50%;
      color: #8BC8FA;
      background: rgba(42, 58, 122, .45);
      font-size: 18px;
      transition: .2s ease;
    }

    .contact-social:hover {
      color: #fff;
      background: rgba(58, 115, 237, .35);
      border-color: #5C8DF6;
      transform: translateY(-2px);
    }

    .contact-column-title {
      margin: 2px 0 18px;
      color: #A6C6FC;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .contact-links,
    .contact-details {
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    .contact-link,
    .contact-detail {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      color: #ACD6FF;
      font-size: 16px;
      line-height: 1.55;
      transition: color .2s ease;
    }

    .contact-link:hover,
    a.contact-detail:hover {
      color: #fff;
    }

    .contact-link i,
    .contact-detail i {
      flex: 0 0 24px;
      color: #70B9FF;
      font-size: 22px;
      text-align: center;
    }

    .contact-detail strong {
      display: block;
      margin-bottom: 2px;
      color: #E9E4F5;
      font-size: 16px;
      font-weight: 700;
    }

    .contact-detail .detail-value {
      display: block;
      overflow-wrap: anywhere;
    }

    .contact-footer-bottom {
      margin-top: 52px;
      padding-top: 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      border-top: 1px solid rgba(148, 163, 184, .12);
    }

    .contact-copyright {
      color: #817A98;
      font-size: 11px;
      line-height: 1.6;
    }

    .contact-organizer {
      color: #A99FC4;
      font-size: 12px;
      text-align: right;
    }

    /* 12 — ANIMATION */
    @keyframes floatLogo {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-8px);
      }
    }

    @keyframes bounce {

      0%,
      100% {
        transform: translateX(-50%) translateY(0);
      }

      50% {
        transform: translateX(-50%) translateY(6px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation: none !important;
        transition: none !important;
      }
    }

    /* 13 — RESPONSIVE */

    /* Large desktop */
    @media (min-width: 1440px) {
      :root {
        --content: 1240px;
      }

      .topbar {
        padding-inline: 48px;
      }

      .topbar-nav {
        margin-left: 22px;
        gap: 4px;
      }

      .nav-link {
        padding-inline: 16px;
      }
    }

    /* Laptop */
    @media (max-width: 1199px) {
      :root {
        --gutter: 20px;
      }

      .topbar {
        padding-inline: 20px;
      }

      .topbar-logo img {
        height: 54px;
        max-width: 136px;
      }

      .topbar-nav {
        margin-left: 10px;
        gap: 0;
      }

      .nav-link {
        padding-inline: 9px;
        letter-spacing: .5px;
      }

      .nav-link span:first-child {
        font-size: 15px;
      }

      .nav-link span:last-child {
        font-size: 10px;
      }

      .certificate-btn {
        min-width: 126px;
        padding-inline: 12px;
      }

      .btn-login {
        padding-inline: 13px;
        font-size: 14px;
      }

      .hero {
        padding-top: 124px;
      }

      .hero-logo {
        width: min(760px, 78vw);
      }

      .award-card {
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 24px;
      }

      .award-intro {
        padding-right: 24px;
      }

      .award-intro img {
        max-width: 200px;
      }

      .award-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .registration-countdown {
        grid-template-columns: 210px minmax(0, 1fr);
        gap: 24px;
        padding: 26px 28px;
      }

      .registration-countdown>img {
        height: 210px;
      }

      .reg-countdown-unit {
        min-width: 88px;
      }

      .reg-countdown-number {
        font-size: 42px;
      }

      .registration-info {
        grid-template-columns: 200px repeat(3, minmax(0, 1fr));
      }

      .registration-label {
        padding: 16px 18px;
      }

      .registration-label-title {
        font-size: 19px;
      }

      .registration-item {
        padding: 12px 12px;
        gap: 10px;
      }

      .registration-item-icon {
        width: 42px;
        height: 42px;
        font-size: 20px;
      }

      .registration-item-value {
        font-size: 18px;
      }

      .contact-footer-grid {
        gap: 32px;
      }
    }

    /* Hamburger takes over (nav has 7 items + login, too wide below ~1100px) */
    @media (max-width: 1100px) {
      :root {
        --topbar-h: 70px;
      }

      .topbar-nav,
      .topbar-actions {
        display: none;
      }

      .mobile-menu-toggle {
        display: flex;
      }

      .mobile-menu {
        display: block;
      }

      .topbar-logo img {
        height: 50px;
        max-width: 124px;
      }
    }

    /* Tablet */
    @media (max-width: 900px) {
      .section {
        padding-block: 72px;
      }

      .hero {
        min-height: auto;
        padding: 108px 18px 64px;
      }

      .hero-logo {
        width: min(650px, 86vw);
      }

      .hero-desc {
        font-size: 15px;
      }

      .hero-btn-register {
        min-height: 64px;
        font-size: 32px;
      }

      .hero-btn-secondary {
        font-size: 19px;
      }

      .hero-scroll {
        display: none;
      }

      .event-date-card {
        grid-template-columns: 230px minmax(0, 1fr);
      }

      .event-location-title {
        font-size: 20px;
      }

      .event-location-name {
        font-size: 22px;
      }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .award-card {
        grid-template-columns: 1fr;
        gap: 22px;
        padding: 28px 22px;
      }

      .award-intro {
        padding: 0 0 18px;
        border-right: 0;
        border-bottom: 1px solid #F1E8D2;
      }

      .award-note {
        grid-template-columns: 1fr;
      }

      .registration-countdown {
        grid-template-columns: 1fr;
        gap: 12px;
        padding: 22px 18px;
      }

      .registration-countdown>img {
        height: 170px;
      }

      .reg-status-label {
        font-size: 22px;
      }

      .reg-countdown-unit {
        min-width: 78px;
      }

      .reg-countdown-number {
        font-size: 36px;
      }

      .reg-status-msg {
        font-size: 16px;
      }

      .registration-info {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .registration-label {
        grid-column: 1 / -1;
        justify-content: center;
        padding: 14px 18px;
      }

      .tiers-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .tier-card:last-child {
        grid-column: 1 / -1;
        width: min(100%, 440px);
        justify-self: center;
      }

      .contact-footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 36px 28px;
      }
    }

    /* Mobile */
    @media (max-width: 640px) {
      :root {
        --gutter: 14px;
        --topbar-h: 60px;
      }

      .topbar {
        padding: 0 12px;
      }

      .topbar-logo img {
        height: 42px;
        max-width: 90px;
      }

      .section {
        padding-block: 58px;
      }

      .section-inner {
        max-width: 440px;
      }

      .section-label {
        font-size: 10px;
        padding: 6px 11px;
      }

      .section-title {
        font-size: 28px;
      }

      .section-sub {
        margin-bottom: 26px;
        font-size: 13px;
        line-height: 1.7;
      }

      /* Hero */
      .hero {
        padding: 82px 14px 48px;
      }

      .hero-logo {
        width: min(92vw, 430px);
      }

      .hero-desc {
        max-width: 440px;
        margin: 10px auto 18px;
        padding: 14px;
        border-radius: 16px;
        font-size: 14px;
        line-height: 1.75;
      }

      .hero-actions {
        max-width: 440px;
        gap: 10px;
      }

      .hero-actions-bottom {
        gap: 10px;
      }

      .hero-btn-register {
        min-height: 58px;
        padding: 0 18px;
        border-radius: 16px;
        font-size: 26px;
        letter-spacing: 1px;
      }

      .hero-btn-secondary {
        min-height: 48px;
        padding: 0 10px;
        border-radius: 13px;
        font-size: 15px;
      }

      /* Event card: side-by-side, compact */
      .event-date-card {
        min-height: 165px;
        grid-template-columns: 42% 58%;
        border-radius: 20px;
      }

      .event-date-main {
        padding: 14px 8px;
        border-radius: 19px 0 0 19px;
      }

      .event-date-icon {
        width: 34px;
        height: 34px;
        font-size: 17px;
      }

      .event-date-label {
        font-size: 12px;
      }

      .event-day-number {
        font-size: 46px;
        letter-spacing: -1px;
      }

      .event-day-number.is-range {
        font-size: 32px;
        letter-spacing: 0;
      }

      .event-day-number.is-empty {
        font-size: 36px;
      }

      .event-month {
        font-size: 16px;
      }

      .event-date-range {
        font-size: 11px;
      }

      .event-location-main {
        padding: 16px 12px 16px 18px;
        border-radius: 0 19px 19px 0;
      }

      .event-location-heading {
        gap: 8px;
      }

      .event-location-icon {
        width: 36px;
        height: 36px;
        font-size: 17px;
      }

      .event-location-title {
        font-size: 14px;
      }

      .event-location-line {
        margin: 8px 0 10px;
      }

      .event-location-name {
        font-size: 16px;
      }

      /* About */
      .about-heading {
        margin-bottom: 26px;
      }

      .about-video-wrap {
        margin-bottom: 28px;
        padding: 8px;
        border-radius: 18px;
      }

      .about-video-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        font-size: 18px;
      }

      .about-video-title {
        font-size: 15px;
      }

      .about-video {
        border-radius: 13px;
      }

      .about-card {
        padding: 24px 16px 20px;
        border-radius: 20px;
      }

      .about-card-title {
        font-size: 28px;
      }

      .about-card-desc {
        font-size: 13px;
        line-height: 1.75;
      }

      .about-visual {
        height: 170px;
      }

      .about-visual img {
        height: 155px;
      }

      .about-feature-row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .about-feature {
        min-height: 96px;
      }

      .about-category-head {
        grid-template-columns: 1fr;
        min-height: 0;
        gap: 6px;
        text-align: center;
      }

      .about-category-head .about-visual {
        order: -1;
        height: 160px;
      }

      .about-category-head .about-visual img {
        height: 145px;
      }

      .about-category-line {
        margin-inline: auto;
      }

      .about-tier-summary {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .about-tier-item {
        min-height: 0;
        padding: 16px 14px 14px;
      }

      .about-tier-btn {
        max-width: 240px;
      }

      /* Awards */
      .award-card {
        padding: 22px 14px;
        border-radius: 20px;
      }

      .award-intro img {
        max-width: 140px;
      }

      .awards-heading {
        margin-bottom: 24px;
      }

      .award-content-title {
        font-size: 17px;
        justify-content: center;
      }

      .award-grid {
        gap: 9px;
      }

      .award-item {
        padding: 12px 7px;
        border-radius: 14px;
      }

      .award-item img {
        height: 50px;
        margin-bottom: 6px;
      }

      .award-item.is-gold img {
        height: 64px;
      }

      .award-item-label,
      .award-item.is-gold .award-item-label {
        font-size: 13px;
      }

      .award-item-value {
        font-size: 17px;
      }

      .award-item.is-gold .award-item-value {
        font-size: 24px;
      }

      .award-item.is-silver .award-item-value,
      .award-item.is-bronze .award-item-value {
        font-size: 22px;
      }

      .award-item small {
        font-size: 11px;
      }

      .award-note {
        padding: 12px;
        gap: 8px;
      }

      .award-note-title {
        font-size: 15px;
      }

      .award-note-item {
        font-size: 12px;
      }

      /* Countdown */
      .registration-countdown {
        padding: 18px 10px 16px;
        border-radius: 18px;
      }

      .registration-countdown>img {
        height: 140px;
      }

      .reg-body {
        gap: 10px;
      }

      .reg-status-label {
        padding: 5px 14px;
        font-size: 18px;
      }

      .reg-countdown {
        gap: 3px;
      }

      .reg-countdown-unit {
        min-width: 0;
        width: 60px;
        padding: 8px 3px 7px;
        border-radius: 11px;
      }

      .reg-countdown-number {
        font-size: 26px;
      }

      .reg-countdown-unit-label {
        margin-top: 4px;
        font-size: 10px;
      }

      .reg-countdown-separator {
        padding: 9px 0 0;
        font-size: 15px;
      }

      .reg-status-msg {
        font-size: 13px;
      }

      /* Fee bar: stacked */
      .registration-info {
        grid-template-columns: 1fr;
        border-radius: 16px;
      }

      .registration-item {
        justify-content: flex-start;
        padding: 12px 18px;
      }

      .registration-item+.registration-item::before {
        left: 18px;
        right: 18px;
        top: 0;
        bottom: auto;
        width: auto;
        height: 1px;
      }

      .registration-item-value {
        font-size: 18px;
      }

      /* Tier cards */
      .tiers-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .tier-card,
      .tier-card:last-child {
        grid-column: auto;
        width: 100%;
        padding: 24px 16px 22px;
        border-radius: 20px;
      }

      .tier-name {
        font-size: 26px;
      }

      .tier-desc {
        min-height: 0;
      }

      .tier-meta {
        font-size: 16px;
      }

      .tier-badge {
        font-size: 14px;
      }

      /* Brands */
      .sponsor-section {
        padding-block: 52px 58px;
      }

      .brand-heading {
        margin-bottom: 20px;
      }

      .brand-title.organizer,
      .brand-title.partner,
      .brand-title.sponsor {
        font-size: 28px;
      }

      .brand-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .organizer-grid {
        grid-template-columns: minmax(0, 260px);
      }

      .brand-card {
        min-height: 92px;
        padding: 12px;
        border-radius: 12px;
      }

      .brand-card img {
        max-height: 60px;
      }

      .organizer-grid .brand-card {
        min-height: 110px;
      }

      .organizer-grid .brand-card img {
        max-height: 84px;
      }

      .brand-divider {
        margin: 40px 0;
      }

      /* Footer */
      .contact-section {
        padding: 56px 18px 22px;
      }

