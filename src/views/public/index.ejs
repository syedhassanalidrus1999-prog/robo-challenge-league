                  <div class="tier-footer">
                    <span class="tier-badge"><i class="ti ti-trophy" aria-hidden="true"></i>คะแนนรวม <%= t.score %>
                        คะแนน</span>

                    <% if (regNotYet) { %>
                      <span class="tier-reg-btn is-disabled" aria-disabled="true">
                        <i class="ti ti-clock"></i> เปิดรับสมัครเร็วๆ นี้
                      </span>
                      <% } else if (regClosed) { %>
                        <span class="tier-reg-btn is-disabled is-closed" aria-disabled="true">
                          <i class="ti ti-x"></i> หมดเขตการสมัคร
                        </span>
                        <% } else { %>
                          <a href="<%= t.href %>" class="tier-reg-btn">
                            <i class="ti ti-pencil-plus"></i> สมัครรุ่นนี้
                          </a>
                          <% } %>
                  </div>
                </div>
                <% }); %>
            </div>
      </div>
    </section>

