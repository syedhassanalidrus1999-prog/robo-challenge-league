    /* =========================================================
       RCL MASTER TOPBAR — Based on Competition
       This block intentionally overrides the original topbar CSS.
    ========================================================= */
    /* =========================================================
   RCL TOPBAR
========================================================= */
    .topbar {
      position: fixed;
      inset: 0 0 auto;
      z-index: 1000;
      height: 84px;
      padding: 0 30px;
      display: flex;
      align-items: center;
      gap: 10px;
      background: transparent;
      border-bottom: 1px solid transparent;
      transition: all .3s ease;
    }

    .topbar.scrolled {
      background: rgba(255, 255, 255, .92);
      border-bottom-color: rgba(226, 232, 240, .9);
      box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
      backdrop-filter: blur(16px);
    }

    .topbar-logo {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
    }

    .topbar-logo img {
      width: auto;
      height: 120px;
      object-fit: contain;
    }

    .topbar-nav {
      flex: 1;
      margin-left: 18px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-link {
      min-height: 52px;
      padding: 0 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      border: 0 !important;
      border-radius: 11px;
      background: transparent !important;
      color: #334155;
      font-family: 'Kanit', 'Sarabun', sans-serif;
      font-size: 17px;
      font-weight: 600;
      letter-spacing: 1px;
      line-height: 1.15;
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition: all .2s ease;
    }

    .nav-link span:first-child {
      font-size: 16px;
      font-weight: 700;
    }

    .nav-link span:last-child {
      font-family: 'Kanit', 'Sarabun', sans-serif;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0;
    }

    .nav-link i {
      font-size: 17px;
    }

    .nav-link:hover {
      color: #2563EB;
      background: #F4F8FF !important;
      transform: translateY(-1px);
    }

    .nav-link.active {
      color: #2563EB !important;
      background: #EFF6FF !important;
    }

    /* Certificate */
