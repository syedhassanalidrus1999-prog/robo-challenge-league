      font-weight: 800;
    }

    .about-tier-beginner .about-tier-name {
      color: #16A34A
    }

    .about-tier-intermediate .about-tier-name {
      color: #2563EB
    }

    .about-tier-advance .about-tier-name {
      color: #EA580C
    }

    .about-tier-info {
