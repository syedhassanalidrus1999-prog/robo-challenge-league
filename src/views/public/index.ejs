<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Robo Challenge League 2026</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <style>
    /* =========================================================
   RCL 2026 — MASTER STYLE
   01 Variables / Reset
   02 Global / Sections
   03 Navigation
   04 Dropdown
   05 Hero
   06 Event Date Card
   07 About + Video
   08 Competition Tiers
   09 Footer
   10 Animation
   11 Responsive
========================================================= */

    /* 01 — VARIABLES / RESET */
    :root {
      --primary: #2563EB;
      --primary-dark: #1D4ED8;
      --primary-soft: #EFF6FF;
      --cyan: #0EA5E9;
      --navy: #0F172A;
      --text: #1E293B;
      --muted: #64748B;
      --line: #E2E8F0;
      --page: #F6F9FE;
      --green: #16A34A;
      --orange: #EA580C;
      --shadow-sm: 0 8px 24px rgba(15, 23, 42, .07);
      --shadow-md: 0 18px 45px rgba(37, 99, 235, .12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    html {
      scroll-behavior: smooth
    }

    body {
      min-width: 320px;
      overflow-x: hidden;
      font-family: 'Sarabun', sans-serif;
      color: var(--text);
      background: var(--page);
    }

    a {
      color: inherit;
      text-decoration: none
    }

    /* 02 — GLOBAL / SECTIONS */
    .section {
      padding: 88px 24px
    }

    .section-inner {
      width: 100%;
      max-width: 1180px;
      margin: 0 auto
    }

    .section-label {
      width: max-content;
      margin: 0 auto 14px;
      padding: 7px 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: var(--primary-soft);
      color: var(--primary);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.6px;
      text-align: center;
    }

    .section-title {
      margin-bottom: 12px;
      color: #054394;
      font-family: 'Kanit', sans-serif;
      font-size: clamp(28px, 3vw, 40px);
      font-weight: 600;
      line-height: 1.2;
      text-align: center;
    }

    .section-sub {
      max-width: 920px;
      margin: 0 auto 44px;
      color: #334155;
      font-size: 18px;
      line-height: 1.8;
      text-align: center;
      font-family: 'Kanit', sans-serif;
      font-weight: 700;
    }

    /* 03 — NAVIGATION */
    .topbar {
      position: fixed;
      inset: 0 0 auto;
      z-index: 100;
      height: 84px;
      padding: 0 30px;
      display: flex;
      align-items: center;
      gap: 10px;
      background: transparent;
      border-bottom: 1px solid transparent;
      transition: .3s ease;
    }

    .topbar.scrolled {
      background: rgba(255, 255, 255, .90);
      border-bottom-color: rgba(226, 232, 240, .9);
      box-shadow: 0 4px 18px rgba(15, 23, 42, .04);
      backdrop-filter: blur(16px);
    }

    .topbar-logo {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center
    }

    .topbar-logo img {
      width: auto;
      height: 120px;
      object-fit: contain
    }

    .topbar-nav {
      flex: 1;
      margin-left: 18px;
      display: flex;
      align-items: center;
      gap: 6px
    }

    .nav-link {
      min-height: 52px;
      padding: 0 18px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border: 0;
      border-radius: 11px;
      background: transparent;
      color: #334155;
      font-family: 'Kanit', sans-serif;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 1.5px;
      cursor: pointer;
      transition: .2s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 1.2;
    }

    .certificate-btn {
      transition: all 0.2s ease;
    }

    .certificate-btn:hover {
      background: linear-gradient(135deg, #FDE68A, #FCD34D) !important;
      border-color: #F59E0B !important;
      color: #78350F !important;
      box-shadow: 0 6px 16px rgba(180, 120, 20, 0.28);
      transform: translateY(-2px);
    }

    .certificate-btn:active {
      transform: translateY(0);
      box-shadow: 0 3px 8px rgba(180, 120, 20, 0.20);
    }

    .nav-link span:first-child {
      font-size: 18px;
      font-weight: 700;
    }

    .nav-link span:last-child {
      font-size: 15px;
      margin-top: 2px;
    }

    .nav-link:hover {
      color: var(--primary);
      transform: translateY(-1px)
    }

    .topbar-actions {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 10px
    }

    .btn-reg,
    .btn-login {
      min-height: 52px;
      padding: 0 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border-radius: 11px;
      font: 800 16px 'Sarabun', sans-serif;
      transition: .2s ease;
    }

    .btn-login {
      color: #334155;
      background: #fff;
      border: 1px solid var(--line)
    }

    .btn-login:hover {
      background: #F8FAFC;
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm)
    }

    .btn-reg {
      color: #fff;
      border: 1px solid transparent;
      background: linear-gradient(135deg, #3478F6, #2563EB);
      box-shadow: 0 10px 24px rgba(37, 99, 235, .24)
    }

    .btn-reg:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(37, 99, 235, .30)
    }

    /* 04 — DROPDOWN */
    .dropdown {
      position: relative
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      z-index: 200;
      display: none;
      min-width: 200px;
      padding: 8px;
      background: rgba(255, 255, 255, .98);
      border: 1px solid var(--line);
      border-radius: 14px;
      box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
    }

    .dropdown-item {
      min-height: 42px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-radius: 10px;
      color: #334155;
      font-size: 14px;
      font-weight: 700;
    }

    .dropdown-item:hover {
      background: var(--primary-soft);
      color: var(--primary)
    }

    .dropdown-item i {
      color: #64748B;
      font-size: 17px
    }

    .dropdown-item:first-child:hover {
      background: #FEF2F2;
      color: #DC2626;
    }

    /* 05 — HERO */
    .hero {
      position: relative;
      overflow: hidden;
      min-height: 100vh;
      padding: 140px 24px 84px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      background: linear-gradient(rgba(255, 255, 255, .20), rgba(255, 255, 255, .90)), url('/images/hero-bg.png') center/cover no-repeat;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -230px;
      left: 50%;
      width: 760px;
      height: 760px;
      transform: translateX(-50%);
      border: 1px solid rgba(37, 99, 235, .10);
      border-radius: 50%;
      box-shadow: 0 0 0 70px rgba(37, 99, 235, .025), 0 0 0 150px rgba(37, 99, 235, .018);
    }

    .hero::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 190px;
      background: linear-gradient(135deg, transparent 48%, rgba(37, 99, 235, .04) 49%, rgba(37, 99, 235, .04) 51%, transparent 52%) 0 0/42px 42px;
      mask-image: linear-gradient(to top, black, transparent);
    }

    .hero>* {
      position: relative;
      z-index: 1
    }

    .hero-logo {
      width: min(1000px, 78vw);
      height: auto;
      margin: 0 0 10px;
      object-fit: contain;
      filter: drop-shadow(0 24px 40px rgba(37, 99, 235, .25));
      animation: floatLogo 4s ease-in-out infinite;
    }

    .hero-title {
      margin-bottom: 9px;
      color: var(--navy);
      font-size: clamp(42px, 5vw, 68px);
      font-weight: 900;
      line-height: 1;
      letter-spacing: 4px
    }

    .hero-year {
      margin-bottom: 22px;
      background: linear-gradient(90deg, #1D4ED8, #2563EB 55%, #0EA5E9);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      font-size: clamp(40px, 5.2vw, 72px);
      font-weight: 900;
      line-height: 1.05;
    }

    .hero-sub {
      max-width: 890px;
      margin-bottom: 34px;
      color: #5B6B82;
      font-size: 17px;
      line-height: 1.75
    }

    .hero-actions {
      width: min(100%, 760px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px
    }

    .hero-actions .hero-btn-register {
      width: min(100%, 520px)
    }

    .hero-actions-bottom {
      width: min(100%, 520px);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px
    }

    .hero-btn-primary,
    .hero-btn-secondary {
      min-height: 52px;
      padding: 0 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      border-radius: 14px;
      font: 800 15px 'Sarabun', sans-serif;
      transition: .22s ease;
    }

    .hero-btn-register:hover i {
      transform: rotate(360deg);
      transition: transform 0.8s ease;
    }

    .hero-btn-register i {
      transition: transform 0.8s ease;
    }

    .hero-btn-primary {
      color: #fff;
      border: 1px solid transparent;
      background: linear-gradient(135deg, #3478F6, #2563EB);
      box-shadow: 0 14px 30px rgba(37, 99, 235, .26)
    }

    .hero-btn-primary:hover {
      color: rgb(52, 51, 51);
      transform: translateY(-3px);
      background: linear-gradient(135deg, #f2d13d, #e6d405);
      box-shadow: 0 18px 38px rgba(248, 215, 28, 0.34)
    }

    .hero-actions .hero-btn-primary.hero-btn-register {
      width: 100%;
      min-height: 72px;
      padding: 0 36px;
      border-radius: 18px;
      font-family: 'Kanit', sans-serif;
      font-size: 40px;
      font-weight: 650;
      letter-spacing: 2px;
    }

    .hero-btn-secondary {
      width: 100%;
      min-height: 56px;
      color: #334155;
      background: rgba(255, 255, 255, .84);
      border: 1px solid rgba(203, 213, 225, .9);
      box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
      backdrop-filter: blur(10px);
      font-family: 'Kanit', sans-serif;
      font-size: 23px;
      font-weight: 650;
    }

    .hero-btn-secondary:hover {
      color: var(--primary);
      border-color: #93C5FD;
      transform: translateY(-3px)
    }

    .hero-scroll {
      position: absolute;
      bottom: 24px;
      left: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      color: #94A3B8;
      font-size: 12px;
      transform: translateX(-50%);
      animation: bounce 2s ease-in-out infinite;
    }

    /* 06 — EVENT DATE CARD */
    .event-date-card {
      position: relative;
      width: min(100%, 680px);
      min-height: 205px;
      margin-top: 10px;
      display: grid;
      grid-template-columns: 285px minmax(0, 1fr);
      overflow: visible;
      background: rgba(255, 255, 255, .97);
      border: 1px solid rgba(147, 197, 253, .65);
      border-radius: 27px;
      box-shadow: 0 20px 45px rgba(37, 99, 235, .15), 0 5px 16px rgba(15, 23, 42, .05);
      backdrop-filter: blur(14px);
      text-align: left;
    }

    .event-date-main {
      position: relative;
      overflow: hidden;
      min-height: 205px;
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #fff;
      border-radius: 26px 0 0 26px;
      background: radial-gradient(circle at 80% 15%, rgba(56, 189, 248, .28), transparent 38%), linear-gradient(145deg, #1554C7, #0B347F 55%, #08265E);
    }

    .event-date-main::before {
      content: '';
      position: absolute;
      width: 240px;
      height: 240px;
      top: -95px;
      right: -70px;
      border: 1px solid rgba(255, 255, 255, .07);
      border-radius: 50%;
      box-shadow: 0 0 0 45px rgba(255, 255, 255, .025), 0 0 0 90px rgba(255, 255, 255, .015);
    }

    .event-date-icon {
      position: relative;
      z-index: 2;
      width: 43px;
      height: 43px;
      margin-bottom: 5px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: #fff;
      background: rgba(255, 255, 255, .08);
      border: 1px solid rgba(255, 255, 255, .20);
    }

    .event-date-icon i {
      font-size: 22px
    }

    .event-date-label,
    .event-day-number,
    .event-month,
    .event-date-range {
      position: relative;
      z-index: 2;
      color: #fff;
      font-family: 'Kanit', sans-serif
    }

    .event-date-label {
      margin-bottom: 1px;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.2
    }

    .event-day-number {
      font-size: 70px;
      font-weight: 500;
      line-height: .84;
      letter-spacing: -3px;
      text-shadow: 0 5px 15px rgba(0, 0, 0, .25)
    }

    .event-month {
      margin-top: 6px;
      font-size: 22px;
      font-weight: 500;
      line-height: 1
    }

    .event-date-range {
      margin-top: 5px;
      color: rgba(255, 255, 255, .95);
      font-size: 16px;
      font-weight: 500;
      line-height: 1
    }

    .event-date-arrow {
      position: absolute;
      left: 285px;
      top: 50%;
      z-index: 10;
      width: 52px;
      height: 52px;
      display: grid;
      place-items: center;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      color: var(--primary);
      background: #fff;
      border: 1px solid #BFDBFE;
      box-shadow: 0 7px 20px rgba(37, 99, 235, .17), 0 0 0 5px rgba(255, 255, 255, .62);
    }

    .event-date-arrow i {
      font-size: 25px
    }

    .event-location-main {
      position: relative;
      overflow: hidden;
      min-width: 0;
      padding: 28px 28px 26px 48px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-radius: 0 26px 26px 0;
      background: radial-gradient(circle at 100% 15%, rgba(56, 189, 248, .08), transparent 34%), linear-gradient(135deg, #fff, #F8FBFF);
    }

    .event-location-main::after {
      content: '';
      position: absolute;
      top: 22px;
      right: 20px;
      width: 70px;
      height: 60px;
      opacity: .09;
      background-image: radial-gradient(#2563EB 1.2px, transparent 1.2px);
      background-size: 8px 8px;
    }

    .event-location-heading {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 12px
    }

    .event-location-icon {
      flex: 0 0 auto;
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: #2563EB;
      background: linear-gradient(145deg, #F0F7FF, #E5F1FF);
      border: 1px solid #D5E8FF;
    }

    .event-location-icon i {
      font-size: 23px
    }

    .event-location-title {
      color: #1452C5;
      font-family: 'Kanit', sans-serif;
      font-size: 22px;
      font-weight: 600;
      line-height: 1.2
    }

    .event-location-line {
      position: relative;
      z-index: 2;
      width: 100%;
      height: 1px;
      margin: 12px 0 14px;
      background: linear-gradient(90deg, #BFDBFE, #DCEBFA, transparent)
    }

    .event-location-name {
      position: relative;
      z-index: 2;
      color: #102B5C;
      font-family: 'Kanit', sans-serif;
      font-size: 25px;
      font-weight: 500;
      line-height: 1.2
    }

    /* 07 — ABOUT + VIDEO */
    .about-section {
      position: relative;
      overflow: hidden;
      padding: 82px 24px 88px;
      background: radial-gradient(circle at 12% 18%, rgba(37, 99, 235, .10), transparent 24%), radial-gradient(circle at 88% 78%, rgba(14, 165, 233, .08), transparent 24%), linear-gradient(180deg, #F7FAFF, #F3F7FC);
      border-top: 1px solid #EAF0F7;
    }

    .about-section::before {
      content: '';
      position: absolute;
      top: -150px;
      left: -210px;
      width: 420px;
      height: 420px;
      border: 1px solid rgba(37, 99, 235, .10);
      border-radius: 50%;
      box-shadow: 0 0 0 55px rgba(37, 99, 235, .025), 0 0 0 110px rgba(37, 99, 235, .015);
    }

    .about-section .section-inner {
      position: relative;
      z-index: 1;
      max-width: 1180px
    }

    .about-heading {
      max-width: 940px;
      margin: 0 auto 42px;
      text-align: center
    }

    .about-section .section-title {
      margin-bottom: 16px;
      font-size: clamp(30px, 3.2vw, 44px)
    }

    .about-section .section-sub {
      max-width: 920px;
      margin-bottom: 0;
      font-size: 16px;
      line-height: 1.8
    }

    .about-video-wrap {
      max-width: 960px;
      margin: 0 auto 48px;
      padding: 12px;
      background: rgba(255, 255, 255, .84);
      border: 1px solid rgba(191, 219, 254, .80);
      border-radius: 26px;
      box-shadow: 0 24px 60px rgba(37, 99, 235, .11), 0 4px 14px rgba(15, 23, 42, .04);
    }

    .about-video-head {
      padding: 7px 8px 15px;
      display: flex;
      align-items: center;
      gap: 12px
    }

    .about-video-icon {
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      color: #fff;
      background: linear-gradient(135deg, #2563EB, #38BDF8);
      box-shadow: 0 8px 20px rgba(37, 99, 235, .25)
    }

    .about-video-icon i {
      font-size: 21px
    }

    .about-video-kicker {
      margin-bottom: 2px;
      color: #2563EB;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.8px
    }

    .about-video-title {
      color: #0F172A;
      font-family: 'Kanit', sans-serif;
      font-size: 18px;
      font-weight: 600
    }

    .about-video {
      position: relative;
      overflow: hidden;
      aspect-ratio: 16/9;
      background: #0F172A;
      border-radius: 18px
    }

    .about-video iframe {
      width: 100%;
      height: 100%;
      display: block;
      border: 0
    }

    /* ABOUT CARDS — 2 CARDS + 1 FEATURED AWARD CARD */
    .about-grid {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .about-card {
      position: relative;
      overflow: hidden;
      min-height: 250px;
      padding: 34px 28px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: rgba(255, 255, 255, .96);
      border: 1px solid rgba(226, 232, 240, .95);
      border-radius: 24px;
      box-shadow: 0 14px 36px rgba(15, 23, 42, .06);
      transition: .22s ease;
    }

    .about-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 5px;
      background: linear-gradient(90deg, #2563EB, #60A5FA)
    }

    .about-card:nth-child(2) {
      background: radial-gradient(circle at 10% 50%, rgba(90, 237, 32, 0.12), transparent 32%),
        linear-gradient(135deg, #FFFFFF, #fafff7)
    }

    .about-card:nth-child(1) {
      background: radial-gradient(circle at 10% 50%, rgba(32, 70, 237, 0.12), transparent 32%),
        linear-gradient(135deg, #FFFFFF, #f7f9ff)
    }

    .about-card:nth-child(2)::before {
      background: linear-gradient(90deg, #16A34A, #4ade806a)
    }

    .about-card:nth-child(3)::before {
      background: linear-gradient(90deg, #D97706, #FBBF24)
    }

    .about-card:hover {
      transform: translateY(-7px);
      border-color: #BFDBFE;
      box-shadow: 0 24px 52px rgba(37, 99, 235, .12)
    }

    .about-icon {
      width: 68px;
      height: 68px;
      margin-bottom: 20px;
      display: grid;
      place-items: center;
      border-radius: 20px;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .7);
    }

    .about-icon i {
      font-size: 27px !important
    }

    .about-card-title {
      margin-bottom: 10px;
      color: var(--navy);
      font-family: 'Kanit', sans-serif;
      font-size: 35px;
      font-weight: 700;
      line-height: 1.35
    }

    .about-card-desc {
      max-width: 290px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.75
    }

    /* RCL introduction card */
    .about-card-robo .about-card-content {
      width: 100%;
    }

    .about-card-robo .about-card-desc {
      max-width: 520px;
      font-size: 14px;
      line-height: 1.8;
    }

    .about-card-robo .about-card-desc strong {
      color: #2563EB;
      font-weight: 800;
    }

    /* 3 competition tiers summary */
    .about-card-tiers .about-card-content {
      width: 100%;
    }

    .about-tier-summary {
      width: 100%;
      max-width: 700px;
      margin-top: 8px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }

    .about-tier-item {
      min-width: 0;
      padding: 13px 10px;
      border: 1px solid #E2E8F0;
      border-radius: 15px;
      background: #fff;
      text-align: center;
    }

    .about-tier-beginner {
      border-top: 4px solid #16A34A;
      background: #F7FEF9;
    }

    .about-tier-intermediate {
      border-top: 4px solid #2563EB;
      background: #F7FAFF;
    }

    .about-tier-advance {
      border-top: 4px solid #EA580C;
      background: #FFFAF6;
    }

    .about-tier-name {
      margin-bottom: 5px;
      font-family: 'Kanit', sans-serif;
      font-size: 17px;
      font-weight: 800;
    }

    .about-tier-beginner .about-tier-name {
      color: #16A34A;
    }

    .about-tier-intermediate .about-tier-name {
      color: #2563EB;
    }

    .about-tier-advance .about-tier-name {
      color: #EA580C;
    }

    .about-tier-info {
      color: #64748B;
      font-size: 12px;
      line-height: 1.6;
    }

    /* Featured award card */
    .about-card.award-card {
      grid-column: 1 / -1;
      min-height: 390px;
      padding: 28px 34px;
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 30px;
      align-items: stretch;
      text-align: left;
      background:
        radial-gradient(circle at 10% 50%, rgba(251, 191, 36, .12), transparent 32%),
        linear-gradient(135deg, #FFFFFF, #FFFDF7);
    }

    .award-intro {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding-right: 30px;
      border-right: 1px solid #F1E8D2;
    }

    .award-intro .about-icon {
      margin-bottom: 14px;
      background: #FFF7ED;
      color: #D97706
    }

    .award-intro .about-card-title {
      margin-bottom: 9px;
      font-size: 28px;
      color: #9A5B00
    }

    .award-intro .about-card-desc {
      max-width: 245px;
      font-size: 15px;
      line-height: 1.8
    }

    .award-content {
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center
    }

    .award-content-title {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 14px;
      color: #9A5B00;
      font-family: 'Kanit', sans-serif;
      font-size: 20px;
      font-weight: 700;
    }

    .award-content-title i {
      font-size: 23px;
      color: #D97706
    }

    .award-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .award-item {
      min-height: 116px;
      padding: 15px 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: #fff;
      border: 1px solid #F1E8D2;
      border-radius: 18px;
      box-shadow: 0 7px 18px rgba(154, 91, 0, .06);
      transition: .2s ease;
    }

    .award-item:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 24px rgba(154, 91, 0, .10);
      border-color: #F6D98A
    }

    .award-item-label {
      color: #64748B;
      font-family: 'Kanit', sans-serif;
      font-size: 18px;
      font-weight: 700;
      line-height: 1.4
    }

    .award-item:first-child .award-item-label {
      color: #64748B;
      font-size: 22px;
      font-weight: 700;
      line-height: 1.4
    }

    .award-item-value {
      margin-top: 5px;
      color: #B77900;
      font-family: 'Kanit', sans-serif;
      font-size: 26px;
      font-weight: 800;
      line-height: 1.2
    }

    .award-item:first-child .award-item-value {
      font-size: 35px !important;
      background: linear-gradient(180deg,
          #FFF8C5 0%,
          #F6D365 25%,
          #D4A017 50%,
          #B77900 75%,
          #8C5A00 100%);

      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .award-item:nth-child(2) .award-item-value {
      font-size: 32px !important;
      background: linear-gradient(180deg,
          #FFFFFF 0%,
          #D9DDE2 20%,
          #8F969E 45%,
          #7d8184 60%,
          #959a9f 80%,
          #6B7280 100%);

      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .award-item:nth-child(3) .award-item-value {
      font-size: 32px !important;
      background: linear-gradient(180deg,
          #FFE0B2 0%,
          #CD7F32 25%,
          #A85D20 50%,
          #E6A15C 70%,
          #8C4A18 100%);
      );

      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }


    .award-item small {
      margin-top: 4px;
      color: #94A3B8;
      font-size: 11px;
      line-height: 1.35
    }

    /* Additional awards — full-width heading + 3 equal items */
    .award-note {
      margin-top: 18px;
      padding: 17px 18px 18px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 14px;
      color: #64748B;
      background: #FFFBEB;
      border: 1px solid #FDE68A;
      border-radius: 18px;
    }

    .award-note-title {
      grid-column: 1 / -1;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      color: #9A5B00;
      font-family: 'Kanit', sans-serif;
      font-size: 18px;
      font-weight: 700;
      line-height: 1.45;
      padding-bottom: 4px;
    }

    .award-note-title i {
      flex: 0 0 auto;
      margin-top: 2px;
      color: #D97706;
      font-size: 22px
    }

    .award-note-item {
      min-width: 0;
      padding: 12px 13px;
      display: flex;
      align-items: flex-start;
      gap: 8px;
      background: rgba(255, 255, 255, .72);
      border: 1px solid #FDE9B2;
      border-radius: 14px;
      font-size: 13px;
      line-height: 1.65;
    }

    .award-note-item .award-bullet {
      flex: 0 0 auto;
      color: #D97706;
      font-size: 10px;
      margin-top: 6px
    }

    /* 08 — COMPETITION TIERS */
    #tiers {
      position: relative;
      overflow: hidden;
      padding: 88px 24px 96px;
      background: radial-gradient(circle at 85% 35%, rgba(14, 165, 233, .07), transparent 25%), radial-gradient(circle at 10% 80%, rgba(37, 99, 235, .07), transparent 24%), #F3F7FC;
    }

    #tiers .section-inner {
      max-width: 1180px
    }

    #tiers .section-title {
      margin-bottom: 10px;
      font-size: clamp(32px, 3.3vw, 44px)
    }

    #tiers .section-sub {
      margin-bottom: 42px
    }

    .tiers-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      align-items: stretch
    }

    .tier-card {
      position: relative;
      overflow: hidden;
      min-height: 470px;
      padding: 42px 30px 34px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 26px;
      box-shadow: 0 14px 38px rgba(15, 23, 42, .065);
      transition: .24s ease;
    }

    .tier-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 6px;
      background: var(--tier-color, #2563EB)
    }

    .tier-card.t-b {
      --tier-color: #16A34A
    }

    .tier-card.t-i {
      --tier-color: #2563EB
    }

    .tier-card.t-a {
      --tier-color: #EA580C
    }

    .tier-card:hover {
      transform: translateY(-7px);
      box-shadow: 0 22px 52px rgba(15, 23, 42, .12)
    }

    .tier-emoji {
      width: 76px;
      height: 76px;
      margin: 0 auto 18px;
      display: grid;
      place-items: center;
      border-radius: 22px;
      background: color-mix(in srgb, var(--tier-color) 9%, white);
      font-size: 42px
    }

    .tier-name {
      margin-bottom: 14px;
      font-size: 25px;
      font-weight: 900;
      line-height: 1.2
    }

    .tier-name.green {
      color: #16A34A
    }

    .tier-name.blue {
      color: #2563EB
    }

    .tier-name.orange {
      color: #EA580C
    }

    #tiers .tier-name+.tier-desc {
      min-height: 92px;
      max-width: 310px;
      margin: 0 auto 5px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.75
    }

    #tiers .tier-desc+.tier-desc {
      width: 100%;
      margin: 0 auto 26px;
      padding-top: 18px;
      color: #64748B;
      border-top: 1px solid #EEF2F7;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.5
    }

    .tier-badge {
      min-height: 34px;
      margin-top: auto;
      padding: 0 10px;
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 800
    }

    .tier-badge.green {
      background: #F0FDF4;
      color: #16A34A
    }

    .tier-badge.blue {
      background: #EFF6FF;
      color: #2563EB
    }

    .tier-badge.orange {
      background: #FFF7ED;
      color: #EA580C
    }

    .tier-card>br {
      display: none
    }

    .tier-reg-btn {
      width: min(100%, 168px);
      min-height: 46px;
      margin-top: 18px;
      padding: 0 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border-radius: 12px;
      font-size: 13.5px;
      font-weight: 800;
      transition: .2s ease
    }

    .tier-reg-btn:hover {
      transform: translateY(-3px)
    }

    .tier-reg-btn.green {
      background: #F0FDF4;
      color: #16A34A;
      border: 1px solid #BBF7D0
    }

    .tier-reg-btn.blue {
      background: #EFF6FF;
      color: #2563EB;
      border: 1px solid #BFDBFE
    }

    .tier-reg-btn.orange {
      background: #FFF7ED;
      color: #EA580C;
      border: 1px solid #FED7AA
    }

    /* =========================================================
   REGISTRATION COUNTDOWN
   ========================================================= */
    .registration-countdown {
      margin: 20px auto;
      padding: 15px 15px 15px;
      background:
        radial-gradient(circle at 50% 0%, rgba(37, 99, 235, .08), transparent 80%),
        #ffffff;
      border: 1px solid #E2E8F0;
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
      text-align: center;
      position: relative;
      overflow: hidden;
    }


    /* หัวข้อ เปิดรับสมัครใน */
    .reg-status-label {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px 14px;
      margin-bottom: 18px;
      margin-top: 5px;

      background: #EFF6FF;
      border: 1px solid #DBEAFE;
      border-radius: 999px;

      color: #2563EB;
      font-family: 'Kanit', sans-serif;
      font-size: 50px;
      font-weight: 700;
      letter-spacing: .5px;
    }

    /* กลุ่มตัวเลข */
    .reg-countdown {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 5px;
    }

    /* แต่ละช่อง */
    .reg-countdown-unit {
      min-width: 100px;
      padding: 12px 10px 10px;

      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 12px;

      box-shadow: 0 4px 12px rgba(15, 23, 42, .04);
    }

    /* ตัวเลข */
    .reg-countdown-number {
      color: #ff8c00;
      font-family: 'Kanit', sans-serif;
      font-size: 52px;
      font-weight: 900;
      line-height: 1;
      letter-spacing: -.5px;
    }

    /* หน่วย วัน ชั่วโมง นาที วินาที */
    .reg-countdown-unit-label {
      margin-top: 6px;

      color: #94A3B8;
      font-family: 'Sarabun', sans-serif;
      font-size: 20px;
      font-weight: 700;
    }

    /* : ระหว่างตัวเลข */
    .reg-countdown-separator {
      padding-top: 16px;

      color: #CBD5E1;
      font-family: 'Kanit', sans-serif;
      font-size: 26px;
      font-weight: 800;
    }

    /* ข้อความด้านล่าง */
    .reg-status-msg {
      color: #64748B;
      font-family: 'Kanit', sans-serif;
      font-size: 25px;
      font-weight: 500;
      padding: 20px;
    }

    /* เมื่อเปิดรับสมัครแล้ว */
    .registration-countdown.is-open::before {
      background: linear-gradient(90deg,
          #16A34A,
          #22C55E,
          #4ADE80);
    }

    .registration-countdown.is-open .reg-status-label {
      color: #16A34A;
      border-color: #DCFCE7;
    }

    /* เมื่อใกล้ปิดรับสมัคร */
    .registration-countdown.is-closing::before {
      background: linear-gradient(90deg,
          #EA580C,
          #F97316,
          #FB923C);
    }

    .registration-countdown.is-closing .reg-status-label {
      color: #EA580C;
      border-color: #FFEDD5;
    }

    /* หมดเขต */
    .registration-countdown.is-closed::before {
      background: #DC2626;
    }

    .registration-countdown.is-closed .reg-status-label {
      color: #DC2626;
      background: #FEF2F2;
      border-color: #FECACA;
    }

    /* Mobile */
    @media (max-width: 640px) {
      .registration-countdown {
        padding: 26px 12px 24px;
        border-radius: 15px;
      }

      .reg-countdown {
        gap: 5px;
      }

      .reg-countdown-unit {
        min-width: 58px;
        padding: 10px 6px 9px;
      }

      .reg-countdown-number {
        font-size: 25px;
      }

      .reg-countdown-unit-label {
        font-size: 9px;
      }

      .reg-countdown-separator {
        padding-top: 13px;
        font-size: 20px;
      }

      .reg-status-label {
        font-size: 12px;
      }

      .reg-status-msg {
        font-size: 12px;
      }
    }

    /* =========================================================
   SPONSORS & PARTNERS
   ========================================================= */

    .sponsor-section {
      position: relative;
      padding: 72px 20px 78px;
      background:
        radial-gradient(circle at 10% 20%,
          rgba(37, 99, 235, .045),
          transparent 28%),
        radial-gradient(circle at 90% 80%,
          rgba(234, 88, 12, .035),
          transparent 25%),
        #F8FAFC;

      border-top: 1px solid #E5EAF1;
    }

    .sponsor-container {
      width: min(1100px, 100%);
      margin: 0 auto;
    }


    /* =========================================================
   Heading
   ========================================================= */

    .brand-heading {
      text-align: center;
      margin-bottom: 32px;
    }

    .brand-eyebrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 8px;
      padding: 5px 10px;

      border-radius: 999px;

      font-family: 'Kanit', sans-serif;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 1.8px;
    }

    .partners-eyebrow {
      color: #2563EB;
      background: #EFF6FF;
      border: 1px solid #DBEAFE;
    }

    .sponsors-eyebrow {
      color: #EA580C;
      background: #FFF7ED;
      border: 1px solid #FED7AA;
    }

    .brand-heading h2 {
      margin: 0;

      font-family: 'Kanit', sans-serif;
      font-size: 26px;
      font-weight: 700;

      line-height: 1.25;
      color: #0F172A;
    }

    .brand-heading p {
      max-width: 560px;
      margin: 7px auto 0;

      font-family: 'Sarabun', sans-serif;
      font-size: 12px;
      line-height: 1.6;

      color: #7A8799;
    }


    /* =========================================================
   Logo Grid
   ========================================================= */

    .brand-grid {
      display: grid;
      align-items: stretch;
      justify-content: center;
      gap: 16px;
    }

    .partners-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 220px));
      justify-content: center;
    }


    .sponsors-grid {
      grid-template-columns:
        repeat(5, minmax(120px, 1fr));
    }


    /* =========================================================
   Logo Card
   ========================================================= */

    .brand-card {
      position: relative;

      min-height: 105px;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 18px;

      background: rgba(255, 255, 255, .92);

      border: 1px solid #E2E8F0;
      border-radius: 15px;

      box-shadow:
        0 3px 12px rgba(15, 23, 42, .035);

      transition:
        transform .2s ease,
        border-color .2s ease,
        box-shadow .2s ease;
    }

    .brand-card:hover {
      transform: translateY(-3px);

      border-color: #CBD5E1;

      box-shadow:
        0 10px 25px rgba(15, 23, 42, .08);
    }


    /* Logo */

    .brand-card img {
      display: block;

      max-width: 100%;
      max-height: 62px;

      width: auto;
      height: auto;

      object-fit: contain;

      filter: grayscale(0);
      opacity: 1;

      transition:
        filter .2s ease,
        opacity .2s ease,
        transform .2s ease;
    }

    .brand-card:hover img {
      transform: scale(1.03);
    }


    /* =========================================================
   Partners
   ========================================================= */

    .partners-grid .brand-card {
      min-height: 110px;
    }

    .partners-grid .brand-card img {
      max-height: 150px;
    }


    /* =========================================================
   Sponsors
   ========================================================= */

    .sponsors-grid .brand-card {
      min-height: 130px;
    }

    .sponsors-grid .brand-card img {
      min-height: 100px;
    }



    .sponsor-card {
      padding: 14px 18px;
    }

    .sponsors-grid .brand-card img {
      max-height: 55px;
    }


    /* =========================================================
   Add Logo Card
   ========================================================= */

    .brand-add-card {
      border-style: dashed;

      background:
        linear-gradient(180deg,
          #FFFFFF,
          #F8FAFC);

      color: #94A3B8;

      flex-direction: column;
      gap: 5px;

      font-size: 10px;
      font-weight: 700;
    }

    .brand-add-card:hover {
      border-color: #93C5FD;
      color: #2563EB;

      background: #F8FBFF;
    }

    .brand-add-icon {
      width: 30px;
      height: 30px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background: #F1F5F9;
      color: #94A3B8;

      font-size: 19px;
      font-weight: 400;

      transition: .2s ease;
    }

    .brand-add-card:hover .brand-add-icon {
      background: #DBEAFE;
      color: #2563EB;
    }


    /* =========================================================
   Divider
   ========================================================= */

    .brand-divider {
      position: relative;

      height: 1px;

      margin: 58px 0;

      background: #E8EDF3;
    }

    .brand-divider::before {
      content: "";

      position: absolute;

      left: 50%;
      top: 50%;

      width: 42px;
      height: 3px;

      transform: translate(-50%, -50%);

      border-radius: 999px;

      background:
        linear-gradient(90deg,
          #2563EB,
          #60A5FA);
    }


    /* =========================================================
   Responsive
   ========================================================= */

    @media (max-width: 900px) {

      .partners-grid {
        grid-template-columns:
          repeat(2, minmax(150px, 1fr));
      }

      .sponsors-grid {
        grid-template-columns:
          repeat(3, minmax(120px, 1fr));
      }

    }


    @media (max-width: 600px) {

      .sponsor-section {
        padding: 52px 16px 58px;
      }

      .brand-heading {
        margin-bottom: 24px;
      }

      .brand-heading h2 {
        font-size: 22px;
      }

      .brand-heading p {
        font-size: 11px;
      }

      .partners-grid,
      .sponsors-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap: 10px;
      }

      .brand-card {
        min-height: 88px;
        padding: 13px;
        border-radius: 12px;
      }

      .partners-grid .brand-card {
        min-height: 92px;
      }

      .sponsors-grid .brand-card {
        min-height: 82px;
      }

      .brand-card img {
        max-height: 48px;
      }

      .brand-divider {
        margin: 42px 0;
      }

    }


    @media (max-width: 380px) {

      .partners-grid,
      .sponsors-grid {
        grid-template-columns: 1fr;
      }

    }

    /* =========================================================
       CONTACT — MODERN RCL
       ========================================================= */
    .contact-section {
      position: relative;
      overflow: hidden;
      padding: 92px 24px 86px;
      background:
        radial-gradient(circle at 8% 18%, rgba(37, 99, 235, .10), transparent 25%),
        radial-gradient(circle at 92% 78%, rgba(14, 165, 233, .09), transparent 27%),
        linear-gradient(180deg, #F8FBFF 0%, #F3F7FC 100%);
      border-top: 1px solid #E5EAF1;
    }

    .contact-section::before,
    .contact-section::after {
      content: '';
      position: absolute;
      border: 1px solid rgba(37, 99, 235, .08);
      border-radius: 50%;
      pointer-events: none;
    }

    .contact-section::before {
      width: 420px;
      height: 420px;
      left: -250px;
      top: 80px;
      box-shadow: 0 0 0 55px rgba(37, 99, 235, .025), 0 0 0 110px rgba(37, 99, 235, .015);
    }

    .contact-section::after {
      width: 360px;
      height: 360px;
      right: -220px;
      bottom: -180px;
      border-color: rgba(14, 165, 233, .08);
    }

    .contact-inner {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
      text-align: center;
    }

    .contact-section .section-label {
      margin-bottom: 12px;
      padding: 7px 15px;
      color: #2563EB;
      background: linear-gradient(135deg, #EFF6FF, #E7F2FF);
      border: 1px solid #D8E9FF;
      box-shadow: 0 6px 18px rgba(37, 99, 235, .07);
    }

    .contact-section .section-title {
      margin-bottom: 14px;
      color: #064A9B;
      font-family: 'Kanit', sans-serif;
      font-size: clamp(34px, 4vw, 48px);
      font-weight: 800;
      line-height: 1.1;
    }

    .contact-section .section-title::after {
      content: '';
      display: block;
      width: 210px;
      height: 3px;
      margin: 14px auto 0;
      border-radius: 999px;
      background: linear-gradient(90deg, transparent, #2563EB, #38BDF8, transparent);
    }

    .contact-sub {
      max-width: 820px;
      margin: 0 auto 42px;
      color: #64748B;
      font-family: 'Sarabun', sans-serif;
      font-size: 16px;
      line-height: 1.85;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
      text-align: left;
    }

    .contact-card {
      position: relative;
      min-height: 255px;
      padding: 30px 28px 26px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      color: inherit;
      background:
        radial-gradient(circle at 100% 0%, rgba(37, 99, 235, .055), transparent 35%),
        rgba(255, 255, 255, .96);
      border: 1px solid #DCE6F2;
      border-radius: 22px;
      box-shadow: 0 14px 34px rgba(15, 23, 42, .055), 0 3px 10px rgba(37, 99, 235, .025);
      overflow: hidden;
      transition: transform .24s ease, border-color .24s ease, box-shadow .24s ease;
    }

    .contact-card::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 4px;
      background: linear-gradient(90deg, #2563EB, #38BDF8);
      transform: scaleX(.25);
      transform-origin: left;
      transition: transform .28s ease;
    }

    .contact-card:hover {
      transform: translateY(-7px);
      border-color: #BBD7FF;
      box-shadow: 0 24px 50px rgba(37, 99, 235, .12), 0 5px 14px rgba(15, 23, 42, .05);
    }

    .contact-card:hover::before {
      transform: scaleX(1);
    }

    .contact-icon {
      width: 62px;
      height: 62px;
      margin-bottom: 22px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      color: #2563EB;
      background: linear-gradient(145deg, #F1F7FF, #E4F0FF);
      border: 1px solid #D2E5FF;
      box-shadow: 0 8px 20px rgba(37, 99, 235, .10), inset 0 0 0 5px rgba(255, 255, 255, .55);
      transition: transform .24s ease, box-shadow .24s ease;
    }

    .contact-card:hover .contact-icon {
      transform: translateY(-2px) scale(1.04);
      box-shadow: 0 12px 25px rgba(37, 99, 235, .16), inset 0 0 0 5px rgba(255, 255, 255, .62);
    }

    .contact-icon i {
      font-size: 29px;
    }

    .contact-content {
      width: 100%;
      min-width: 0;
    }

    .contact-label {
      margin-bottom: 5px;
      color: #64748B;
      font-size: 13px;
      font-weight: 700;
    }

    .contact-value {
      color: #0F172A;
      font-family: 'Kanit', sans-serif;
      font-size: 21px;
      font-weight: 700;
      line-height: 1.45;
      word-break: break-word;
    }

    .contact-card:first-child .contact-value {
      color: #1452C5;
      font-size: 27px;
    }

    .contact-card:nth-child(2) .contact-value {
      color: #1452C5;
    }

    .contact-card:nth-child(3) .contact-value {
      font-size: 18px;
      line-height: 1.65;
    }

    .contact-action {
      margin-top: 18px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #2563EB;
      font-family: 'Kanit', sans-serif;
      font-size: 14px;
      font-weight: 700;
    }

    .contact-action i {
      font-size: 17px;
      transition: transform .2s ease;
    }

    .contact-card:hover .contact-action i {
      transform: translateX(4px);
    }

    .contact-support {
      margin-top: 24px;
      padding: 22px 28px;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(230px, .85fr) auto;
      align-items: center;
      gap: 24px;
      text-align: left;
      background: linear-gradient(135deg, rgba(255, 255, 255, .94), rgba(239, 246, 255, .94));
      border: 1px solid #D5E5F8;
      border-radius: 22px;
      box-shadow: 0 12px 30px rgba(37, 99, 235, .07);
    }

    .contact-support-main {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .contact-support-icon {
      flex: 0 0 auto;
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 15px;
      color: #2563EB;
      background: #EFF6FF;
      border: 1px solid #D8E9FF;
    }

    .contact-support-icon i {
      font-size: 23px;
    }

    .contact-support-title {
      color: #1452C5;
      font-family: 'Kanit', sans-serif;
      font-size: 18px;
      font-weight: 800;
    }

    .contact-support-text,
    .contact-hours-text {
      color: #64748B;
      font-size: 13px;
      line-height: 1.5;
    }

    .contact-hours {
      padding-left: 24px;
      border-left: 1px solid #D6E2F0;
    }

    .contact-hours-title {
      color: #334155;
      font-family: 'Kanit', sans-serif;
      font-size: 14px;
      font-weight: 700;
    }

    .contact-message-btn {
      min-height: 48px;
      padding: 0 22px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      white-space: nowrap;
      color: #fff;
      background: linear-gradient(135deg, #3478F6, #2563EB);
      border-radius: 999px;
      box-shadow: 0 10px 24px rgba(37, 99, 235, .22);
      font-family: 'Kanit', sans-serif;
      font-size: 14px;
      font-weight: 700;
      transition: .22s ease;
    }

    .contact-message-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 30px rgba(37, 99, 235, .30);
      background: linear-gradient(135deg, #2563EB, #0EA5E9);
    }

    .contact-message-btn i {
      font-size: 18px;
    }

    @media (max-width: 900px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .contact-card {
        min-height: 185px;
      }

      .contact-support {
        grid-template-columns: 1fr;
      }

