    /* =========================================================
       ABOUT FEATURE CARDS — POLISHED LAYOUT
       Get to Know Us + Competition Categories
    ========================================================= */
    .about-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
      align-items: stretch;
    }

    .about-card.about-card-robo,
    .about-card.about-card-tiers {
      min-height: 610px;
      padding: 30px 30px 26px;
      justify-content: flex-start;
      border-radius: 28px;
      box-shadow: 0 18px 48px rgba(37, 99, 235, .08);
    }

    .about-card.about-card-robo {
      background:
        radial-gradient(circle at 8% 55%, rgba(37, 99, 235, .10), transparent 25%),
        linear-gradient(135deg, #fff 0%, #f7faff 100%);
    }

    .about-card.about-card-tiers {
      background:
        radial-gradient(circle at 92% 18%, rgba(74, 222, 128, .10), transparent 25%),
        linear-gradient(135deg, #fff 0%, #fbfff9 100%);
    }

    .about-card.about-card-robo::before {
      height: 6px;
      background: linear-gradient(90deg, #2563EB, #60A5FA);
    }

    .about-card.about-card-tiers::before {
      height: 6px;
      background: linear-gradient(90deg, #16A34A, #86EFAC);
    }

    .about-card-content {
      position: relative;
      z-index: 1;
      width: 100%;
    }

    .about-visual {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 225px;
      margin: -3px auto 4px;
    }

    .about-visual::before {
      content: "";
      position: absolute;
      width: 190px;
      height: 190px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37, 99, 235, .08), transparent 68%);
    }

    .about-visual-green::before {
      background: radial-gradient(circle, rgba(34, 197, 94, .10), transparent 68%);
    }

    .about-visual img {
      position: relative;
      z-index: 2;
      width: auto;
      height: 205px;
      object-fit: contain;
      filter: drop-shadow(0 16px 18px rgba(15, 23, 42, .10));
      transition: transform .25s ease;
    }

    .about-card:hover .about-visual img {
      transform: translateY(-4px) scale(1.025);
    }

    .about-spark {
      position: absolute;
      width: 8px;
      height: 8px;
      border-radius: 2px;
      background: #60A5FA;
      opacity: .65;
    }

    .about-spark::after {
      content: "";
      position: absolute;
      width: 4px;
      height: 4px;
      border-radius: 1px;
      background: inherit;
      top: 18px;
      left: 18px;
    }

    .spark-1 {
      left: 13%;
      top: 27%
    }

    .spark-2 {
      right: 16%;
      top: 20%
    }

    .spark-3 {
      left: 18%;
      bottom: 19%
    }

    .spark-4 {
      right: 9%;
      top: 22%;
      background: #4ADE80
    }

    .spark-5 {
      right: 18%;
      bottom: 18%;
      background: #86EFAC
    }

    .about-card-title {
      margin-bottom: 10px;
      font-family: 'Kanit', sans-serif;
      font-size: 35px;
      font-weight: 800;
      line-height: 1.15;
    }

    .about-title-blue {
      color: #2563EB;
      background: linear-gradient(90deg, #2563EB, #60A5FA);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .about-title-green {
      color: #15803D;
      background: linear-gradient(90deg, #15803D, #4ADE80);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .about-card-robo .about-card-title {
