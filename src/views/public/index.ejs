      .event-day-number {
        font-size: 40px;
      }

      .event-day-number.is-range {
        font-size: 26px;
      }

      .event-month {
        font-size: 14px;
      }

      .event-location-title {
        font-size: 13px;
      }

      .event-location-name {
        font-size: 15px;
      }

      .reg-countdown-unit {
        width: 50px;
      }

      .reg-countdown-number {
        font-size: 21px;
      }

      .reg-countdown-unit-label {
        font-size: 8px;
      }

      .reg-countdown-separator {
        font-size: 12px;
      }

      .about-feature-row {
        grid-template-columns: 1fr 1fr;
        gap: 7px;
      }
    }

    @media (max-width: 340px) {
      .hero-actions-bottom {
        grid-template-columns: 1fr;
      }
    }

    /* Landscape phones */
    @media (max-width: 900px) and (orientation: landscape) and (max-height: 500px) {
      .hero {
        padding-top: 82px;
      }

      .hero-logo {
        width: min(48vw, 430px);
      }
    }
  </style>
