      <!-- Registration Countdown -->
      <% var regOpen=typeof registrationOpenDate !=='undefined' ? registrationOpenDate : null; var regClose=typeof
        registrationCloseDate !=='undefined' ? registrationCloseDate : null; %>

        <% if (regOpen || regClose) { %>

          <div class="registration-countdown" id="registration-countdown-card">
            <img src="/images/icon/announcement-robot.png" alt="announcement-robot">

            <div class="reg-status-label" id="reg-status-label"></div>

            <div class="reg-countdown" id="reg-countdown"></div>

            <div class="reg-status-msg" id="reg-status-msg"></div>

          </div>

          <script>
            (function () {

              var openDate =
              <%- regOpen ? ("new Date('" + regOpen + "')") : 'null' %>;

              var closeDate =
              <%- regClose ? ("new Date('" + regClose + "')") : 'null' %>;


              function pad(n) {
                return String(n).padStart(2, '0');
              }


              function makeUnit(val, label, showSeparator) {

                return `
                <div class="reg-countdown-unit">
      
                  <div class="reg-countdown-number">
                    ${pad(val)}
                  </div>
      
                  <div class="reg-countdown-unit-label">
                    ${label}
                  </div>
      
                </div>
      
                ${showSeparator
                    ? '<div class="reg-countdown-separator">:</div>'
                    : ''
                  }
              `;
              }


              function tick() {

                var now = new Date();

                var labelEl =
                  document.getElementById('reg-status-label');

                var countEl =
                  document.getElementById('reg-countdown');

                var msgEl =
                  document.getElementById('reg-status-msg');

                var cardEl =
                  document.getElementById('registration-countdown-card');


                if (!labelEl || !countEl || !msgEl) {
                  return;
                }


                /* Reset status */
                if (cardEl) {
                  cardEl.classList.remove(
                    'is-open',
                    'is-closing',
                    'is-closed'
                  );
                }


                var target = null;
                var label = '';
                var msg = '';
                var color = '#2563EB';


                /* =========================================
                   ก่อนเปิดรับสมัคร
                   ========================================= */

                if (openDate && now < openDate) {

                  target = openDate;

                  label = 'เปิดรับสมัครใน';

                  msg =
                    'เตรียมพร้อมได้เลย! การรับสมัครจะเปิดในอีกไม่ช้า';

                  color = '#2563EB';

                  if (cardEl) {
                    cardEl.classList.add('is-open');
                  }

                }


                /* =========================================
                   เปิดรับสมัครแล้ว
                   ========================================= */

                else if (closeDate && now < closeDate) {

                  target = closeDate;

                  label = 'ปิดรับสมัครใน';

                  msg =
                    '🔥 เปิดรับสมัครแล้ว! สมัครก่อนหมดเขต';

                  color = '#EA580C';

                  if (cardEl) {
                    cardEl.classList.add('is-closing');
                  }

                }


                /* =========================================
                   หมดเขตรับสมัคร
                   ========================================= */

                else if (closeDate && now >= closeDate) {

                  if (cardEl) {
                    cardEl.classList.add('is-closed');
                  }

                  labelEl.textContent =
                    'หมดเขตรับสมัครแล้ว';

                  countEl.innerHTML = '';

                  msgEl.textContent =
                    'ขอบคุณทุกทีมที่สมัครเข้าร่วมการแข่งขัน';

                  return;

                }


                /* =========================================
                   ไม่มีวันปิดรับสมัคร
                   ========================================= */

                else {

                  if (cardEl) {
                    cardEl.classList.add('is-open');
                  }

                  labelEl.textContent =
                    'เปิดรับสมัครแล้ว';

                  countEl.innerHTML = '';

                  msgEl.textContent =
                    '🔥 สมัครได้เลยทันที!';

                  return;

                }


                /* =========================================
                   คำนวณเวลา
                   ========================================= */

                var diff =
                  Math.max(0, target - now);

                var days =
                  Math.floor(diff / 86400000);

                var hours =
                  Math.floor(
                    (diff % 86400000) / 3600000
                  );

                var mins =
                  Math.floor(
                    (diff % 3600000) / 60000
                  );

                var secs =
                  Math.floor(
                    (diff % 60000) / 1000
                  );


                /* =========================================
                   แสดงผล
                   ========================================= */

                labelEl.textContent = label;

                labelEl.style.color = color;

                countEl.innerHTML =
                  makeUnit(days, 'วัน', true) +
                  makeUnit(hours, 'ชั่วโมง', true) +
                  makeUnit(mins, 'นาที', true) +
                  makeUnit(secs, 'วินาที', false);

                msgEl.textContent = msg;

                msgEl.style.color = color;

              }


              /* เรียกครั้งแรก */
              tick();

              /* อัปเดตทุก 1 วินาที */
              setInterval(tick, 1000);

            })();
          </script>

          <% } %>

