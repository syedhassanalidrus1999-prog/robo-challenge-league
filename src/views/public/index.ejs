      overflow: hidden;

      background:
        radial-gradient(circle at 16% 50%, rgba(37, 99, 235, .08), transparent 34%),
        radial-gradient(circle at 100% 0%, rgba(14, 165, 233, .07), transparent 32%),
        rgba(255, 255, 255, .97) !important;

      border: 1px solid #dbe4ef !important;
      border-radius: 24px !important;
      box-shadow:
        0 18px 42px rgba(15, 23, 42, .07),
        0 4px 12px rgba(37, 99, 235, .04) !important;
    }

    /* top accent */
    #tiers .registration-countdown::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 4px;
      background: linear-gradient(90deg, #2563eb, #38bdf8, #60a5fa);
    }

    /* Robot */
    #tiers .registration-countdown>img {
      grid-column: 1;
      grid-row: 1 / 5;
      justify-self: center;
      align-self: center;

      width: auto !important;
      height: 300px !important;
      object-fit: contain;
      margin: 0 !important;

      filter: drop-shadow(0 18px 22px rgba(37, 99, 235, .16));
      transition: transform .25s ease, filter .25s ease;
    }

    #tiers .registration-countdown:hover>img {
      transform: translateY(-5px) scale(1.025);
      filter: drop-shadow(0 22px 28px rgba(37, 99, 235, .20));
    }

    /* Countdown content */
    #tiers .reg-status-label {
      grid-column: 2;
      grid-row: 1;
      justify-self: center;

      margin: 0 0 14px !important;
      padding: 7px 20px !important;

      font-family: 'Kanit', sans-serif !important;
      font-size: 25px !important;
      font-weight: 800 !important;
      line-height: 1.25;

      color: #ea580c !important;
      background: #fff7ed !important;
      border: 1px solid #fed7aa !important;
      border-radius: 999px !important;
    }

    #tiers .reg-countdown {
      grid-column: 2;
      grid-row: 2;
      justify-self: center;

      gap: 9px !important;
      margin: 0 !important;
    }

    #tiers .reg-countdown-unit {
      min-width: 82px !important;
      padding: 11px 9px 9px !important;
      border-radius: 14px !important;
      background: #fff !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 7px 18px rgba(15, 23, 42, .055) !important;
    }

    #tiers .reg-countdown-number {
      font-size: 34px !important;
      font-weight: 900 !important;
      color: #f97316 !important;
    }

    #tiers .reg-countdown-unit-label {
      margin-top: 3px !important;
      font-size: 11px !important;
      color: #64748b !important;
    }

    #tiers .reg-countdown-separator {
      padding-top: 13px !important;
      font-size: 20px !important;
      color: #cbd5e1 !important;
    }

    #tiers .reg-status-msg {
      grid-column: 2;
      grid-row: 3;
      align-self: start;
      justify-self: center;

      margin-top: 12px !important;
      padding: 0 !important;
      font-family: 'Kanit', sans-serif !important;
      font-size: 13px !important;
      font-weight: 700 !important;
      text-align: center;
    }

    /* ---------- Category Cards ---------- */
    #tiers .tiers-grid {
      gap: 20px !important;
    }

    #tiers .tier-card {
      min-height: 525px !important;
      padding: 26px 22px 22px !important;

      border-radius: 22px !important;
      border: 1px solid #dfe7f0 !important;

      box-shadow: 0 12px 30px rgba(15, 23, 42, .065) !important;
      transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease !important;
    }

    #tiers .tier-card:hover {
      transform: translateY(-7px) !important;
      box-shadow: 0 22px 48px rgba(15, 23, 42, .12) !important;
    }

    /* Category icon */
    #tiers .tier-emoji {
      width: 58px !important;
      height: 58px !important;
      margin: 0 auto 10px !important;
      border-radius: 17px !important;
      font-size: 31px !important;
    }

    /* Category name */
    #tiers .tier-name {
      margin-bottom: 7px !important;
      font-family: 'Kanit', sans-serif !important;
      font-size: 24px !important;
      font-weight: 800 !important;
    }

    /* Description */
    #tiers .tier-name+.tier-desc {
      min-height: 54px !important;
      max-width: 285px !important;
      margin: 0 auto 12px !important;
      font-size: 12px !important;
      line-height: 1.65 !important;
    }

    /* Arena image box */
    #tiers .tier-card .tier-desc:has(img) {
      width: 100%;
      margin: 0 auto 12px !important;
      padding: 8px 10px 9px !important;
      border-radius: 14px !important;
    }

    #tiers .tier-card .tier-desc:has(img) div {
      font-size: 14px !important;
      font-weight: 800 !important;
    }

    #tiers .tier-card .tier-desc:has(img) img {
      display: block;
      width: 100% !important;
      max-width: 235px !important;
      height: 108px !important;
      object-fit: contain;
      margin: 5px auto 0 !important;
    }

    /* Age / robot information */
    #tiers .tier-card .tier-desc[style*="font-size: 20px"] {
      width: 100%;
      margin: 0 !important;
      padding: 9px 5px !important;
      border-top: 1px solid #eef2f7;
      font-size: 14px !important;
      font-weight: 800 !important;
      line-height: 1.45 !important;
    }

    /* Score badge */
    #tiers .tier-badge {
      min-height: 30px !important;
      margin-top: auto !important;
      padding: 0 12px !important;
      font-size: 11px !important;
    }

    /* Register button */
    #tiers .tier-reg-btn {
      width: min(100%, 175px) !important;
      min-height: 42px !important;
      margin-top: 10px !important;
      border-radius: 11px !important;
      font-family: 'Kanit', sans-serif !important;
      font-size: 15px !important;
      font-weight: 800 !important;
    }

    #tiers .tier-reg-btn:hover {
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 18px rgba(15, 23, 42, .09);
    }

    /* Keep all three cards visually consistent */
    #tiers .tier-card.t-b {
      background: linear-gradient(180deg, #fff 0%, #fbfffc 100%) !important;
    }

    #tiers .tier-card.t-i {
      background: linear-gradient(180deg, #fff 0%, #fafdff 100%) !important;
    }

    #tiers .tier-card.t-a {
      background: linear-gradient(180deg, #fff 0%, #fffaf7 100%) !important;
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 900px) {
      #tiers .registration-countdown {
        grid-template-columns: 250px minmax(0, 1fr);
        column-gap: 12px;
        padding: 22px 18px !important;
      }

      #tiers .registration-countdown>img {
        width: 225px !important;
        height: 225px !important;
      }

      #tiers .reg-countdown-unit {
        min-width: 68px !important;
      }

      #tiers .reg-countdown-number {
        font-size: 29px !important;
      }
    }

    @media (max-width: 720px) {
      #tiers {
        padding: 58px 14px 70px !important;
      }

      #tiers .registration-countdown {
        min-height: 0;
        display: flex !important;
        flex-direction: column;
        padding: 20px 12px 18px !important;
        gap: 8px;
      }

      #tiers .registration-countdown>img {
        width: 190px !important;
        height: 190px !important;
        order: 1;
      }

      #tiers .reg-status-label {
        order: 2;
        margin: 0 !important;
        font-size: 20px !important;
      }

      #tiers .reg-countdown {
        order: 3;
        gap: 4px !important;
      }

      #tiers .reg-countdown-unit {
        min-width: 56px !important;
        padding: 8px 5px !important;
      }

      #tiers .reg-countdown-number {
        font-size: 24px !important;
      }

      #tiers .reg-countdown-unit-label {
        font-size: 9px !important;
      }

      #tiers .reg-countdown-separator {
        padding-top: 11px !important;
        font-size: 16px !important;
      }

      #tiers .reg-status-msg {
        order: 4;
        margin-top: 3px !important;
        font-size: 11px !important;
      }

      #tiers .tiers-grid {
        grid-template-columns: 1fr !important;
      }

      #tiers .tier-card {
        min-height: 0 !important;
      }
    }


    /* =========================================================
   FINAL BALANCED COUNTDOWN HERO
========================================================= */

    #tiers .registration-countdown {
      min-height: 300px !important;
      padding: 20px 50px !important;

      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 55px !important;

      position: relative;
      overflow: hidden;
    }

    /* Robot — slightly smaller so it doesn't dominate */
    #tiers .registration-countdown>img {
      width: 260px !important;
      height: 260px !important;
      flex: 0 0 260px !important;
      margin: 0 !important;
      object-fit: contain !important;
      align-self: center !important;
    }

    /* Countdown content becomes one centered group */
    #tiers .registration-countdown .reg-status-label,
    #tiers .registration-countdown .reg-countdown,
    #tiers .registration-countdown .reg-status-msg {
      position: static !important;
    }

    #tiers .registration-countdown .reg-status-label {
      margin: 0 auto 14px !important;
      width: fit-content;
    }

    #tiers .registration-countdown .reg-countdown {
      margin: 0 auto !important;
      justify-content: center !important;
    }

    #tiers .registration-countdown .reg-status-msg {
      margin: 12px auto 0 !important;
      text-align: center !important;
    }

    /* Put all countdown elements into a real content column */
    #tiers .registration-countdown>img+.reg-status-label {
      /* visual alignment helper */
    }

    #tiers .registration-countdown {
      --countdown-column-width: 430px;
    }

    #tiers .registration-countdown .reg-status-label,
    #tiers .registration-countdown .reg-countdown,
    #tiers .registration-countdown .reg-status-msg {
      width: var(--countdown-column-width);
      max-width: 100%;
    }

    /* Prevent label from stretching */
    #tiers .registration-countdown .reg-status-label {
      width: fit-content;
    }

    /* Countdown numbers */
    #tiers .reg-countdown-unit {
      min-width: 78px !important;
      padding: 10px 8px 9px !important;
    }

    #tiers .reg-countdown-number {
      font-size: 34px !important;
    }

    /* Tablet */
    @media (max-width: 900px) {
      #tiers .registration-countdown {
        gap: 28px !important;
        padding: 20px 28px !important;
      }

      #tiers .registration-countdown>img {
        width: 220px !important;
        height: 220px !important;
        flex-basis: 220px !important;
      }

      #tiers .registration-countdown {
        --countdown-column-width: 360px;
      }

      #tiers .reg-countdown-unit {
        min-width: 68px !important;
      }

      #tiers .reg-countdown-number {
        font-size: 29px !important;
      }
    }

    /* Mobile */
    @media (max-width: 720px) {
      #tiers .registration-countdown {
        min-height: 0 !important;
        padding: 20px 12px 18px !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 8px !important;
      }

      #tiers .registration-countdown>img {
        width: 190px !important;
        height: 190px !important;
        flex: 0 0 auto !important;
      }

      #tiers .registration-countdown {
        --countdown-column-width: 100%;
      }

      #tiers .registration-countdown .reg-status-label {
        font-size: 20px !important;
        margin-bottom: 8px !important;
      }

      #tiers .reg-countdown {
        gap: 4px !important;
      }

      #tiers .reg-countdown-unit {
        min-width: 56px !important;
        padding: 8px 5px !important;
      }

      #tiers .reg-countdown-number {
        font-size: 24px !important;
      }

      #tiers .reg-countdown-unit-label {
        font-size: 9px !important;
      }

      #tiers .reg-countdown-separator {
        padding-top: 11px !important;
        font-size: 16px !important;
      }

      #tiers .registration-countdown .reg-status-msg {
        font-size: 11px !important;
        margin-top: 3px !important;
      }
    }


    /* =========================================================
   FINAL COUNTDOWN BALANCE FIX
   Robot left / countdown centered-right
========================================================= */

    #tiers .registration-countdown {
      min-height: 300px !important;
      padding: 40px 42px !important;
      display: grid !important;
      grid-template-columns: 300px minmax(0, 1fr) !important;
      grid-template-rows: 80px 10px 15px !important;
      column-gap: 38px !important;
      align-items: center !important;
      justify-items: center !important;
      position: relative !important;
      overflow: hidden !important;
    }

    /* Robot */
    #tiers .registration-countdown>img {
      grid-column: 1 !important;
      grid-row: 1 / 4 !important;
      width: auto !important;
      height: 300px !important;
      max-width: 100% !important;
      object-fit: contain !important;
      margin: 0 !important;
      justify-self: center !important;
      align-self: center !important;
    }

    /* Countdown content */
    #tiers .registration-countdown .reg-status-label {
      grid-column: 2 !important;
      grid-row: 1 !important;
      width: fit-content !important;
      max-width: 100% !important;
      margin: 0 auto 12px !important;
      padding: 7px 20px !important;
      white-space: nowrap !important;
      text-align: center !important;
      font-size: 27px !important;
      line-height: 1.2 !important;
    }

    #tiers .registration-countdown .reg-countdown {
      grid-column: 2 !important;
      grid-row: 2 !important;
      width: 100% !important;
      margin: 0 auto !important;
      display: flex !important;
      justify-content: center !important;
      align-items: flex-start !important;
      gap: 9px !important;
    }

    #tiers .registration-countdown .reg-countdown-unit {
      min-width: 120px !important;
      padding: 1px 8px 9px !important;
    }

    #tiers .registration-countdown .reg-countdown-number {
      font-size: 55px !important;
      font-weight: 900 !important;
      line-height: 1 !important;
    }

    #tiers .registration-countdown .reg-countdown-unit-label {
      margin-top: 5px !important;
      font-size: 12px !important;
      line-height: 1.2 !important;
    }

    #tiers .registration-countdown .reg-countdown-separator {
      padding-top: 10px !important;
      font-size: 22px !important;
    }

    #tiers .registration-countdown .reg-status-msg {
      grid-column: 2 !important;
      grid-row: 3 !important;
      width: fit-content !important;
      max-width: 100% !important;
      margin: 10px auto 0 !important;
      padding: 0 !important;
      white-space: nowrap !important;
      text-align: center !important;
      font-size: 30px !important;
      line-height: 1.4 !important;
    }

    /* Tablet */
    @media (max-width: 900px) {
      #tiers .registration-countdown {
        grid-template-columns: 230px minmax(0, 1fr) !important;
        column-gap: 22px !important;
        padding: 20px 26px !important;
      }

      #tiers .registration-countdown>img {
        width: 205px !important;
        height: 205px !important;
      }

      #tiers .registration-countdown .reg-status-label {
        font-size: 23px !important;
      }

      #tiers .registration-countdown .reg-countdown {
        gap: 5px !important;
      }

      #tiers .registration-countdown .reg-countdown-unit {
        min-width: 62px !important;
      }

      #tiers .registration-countdown .reg-countdown-number {
        font-size: 30px !important;
      }
    }

    /* Mobile */
    @media (max-width: 640px) {
      #tiers .registration-countdown {
        min-height: 0 !important;
        padding: 20px 12px 18px !important;
        grid-template-columns: 1fr !important;
        grid-template-rows: auto auto auto auto !important;
        row-gap: 8px !important;
      }

      #tiers .registration-countdown>img {
        grid-column: 1 !important;
        grid-row: 1 !important;
        width: 175px !important;
        height: 175px !important;
      }

      #tiers .registration-countdown .reg-status-label {
        grid-column: 1 !important;
        grid-row: 2 !important;
        font-size: 20px !important;
        margin: 0 auto 5px !important;
      }

      #tiers .registration-countdown .reg-countdown {
        grid-column: 1 !important;
        grid-row: 3 !important;
        gap: 3px !important;
      }

      #tiers .registration-countdown .reg-countdown-unit {
        min-width: 53px !important;
        padding: 8px 4px 7px !important;
      }

      #tiers .registration-countdown .reg-countdown-number {
        font-size: 23px !important;
      }

      #tiers .registration-countdown .reg-countdown-unit-label {
        font-size: 9px !important;
      }

      #tiers .registration-countdown .reg-countdown-separator {
        padding-top: 9px !important;
        font-size: 15px !important;
      }

      #tiers .registration-countdown .reg-status-msg {
        grid-column: 1 !important;
        grid-row: 4 !important;
        white-space: normal !important;
        font-size: 11px !important;
        margin: 2px auto 0 !important;
      }
    }
  </style>

</head>

<body>

  <!-- TOPBAR -->
  <div class="topbar">
    <a href="/" class="topbar-logo">
      <img src="/RCL Logo.png" alt="RCL">
    </a>

    <nav class="topbar-nav">

      <a href="/" class="nav-link">
        <span>HOME</span>
        <span>หน้าหลัก</span>
      </a>

      <a href="/#about" class="nav-link">
        <span>ABOUT US</span>
        <span>เกี่ยวกับเรา</span>
      </a>

      <div class="dropdown">
        <button class="nav-link" type="button">
          <span>COMPETITION</span>
          <span>
            การแข่งขัน
            <i class="ti ti-chevron-down"></i>
          </span>
        </button>

        <div class="dropdown-menu">
          <a href="/#tiers" class="dropdown-item">
            <i class="ti ti-pencil-plus"></i>
            สมัครแข่งขัน
          </a>
          <a href="/competition?view=teams" class="dropdown-item">
            <i class="ti ti-users"></i>
            ทีมที่สมัคร
          </a>
          <a href="/competition?view=board" class="dropdown-item">
            <i class="ti ti-chart-bar"></i>
            ผลสรุปคะแนน
          </a>
        </div>
      </div>

      <a href="/docs" class="nav-link">
        <span>DOCUMENT</span>
        <span>เอกสาร</span>
      </a>

      <a href="/preorder" class="nav-link">
        <span>PRE-ORDER MISSION</span>
        <span>พรีออเดอร์สนามภารกิจ</span>
      </a>

      <a href="/certificate" class="nav-link certificate-btn" target="_blank">
        <span>CERTIFICATE</span>
        <span>เกียรติบัตร</span>
      </a>

    </nav>

    <div class="topbar-actions">
      <a href="/auth/login" class="btn-login">
        <i class="ti ti-lock"></i>
        <span>เข้าสู่ระบบ</span>
      </a>
    </div>
  </div>



  <!-- HERO -->
  <section class="hero" id="home">
    <img src="/RCL home.png" alt="RCL Logo" class="hero-logo">
    <div class="section-sub" style="margin: 20px auto;
      padding: 15px 15px 15px;
      background:
        radial-gradient(circle at 50% 0%, rgba(37, 99, 235, .08), transparent 80%),
        #ffffff;
      border: 1px solid #E2E8F0;
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
      text-align: center;
      position: relative;
      overflow: hidden;"><span style="font-size: medium;">การแข่งขันหุ่นยนต์และการเขียนโปรแกรมเชิงวิศวกรรม
        ที่มุ่งพัฒนาทักษะด้าน Coding, Robotics,
        STEM และการแก้ปัญหา ผ่านภารกิจที่ท้าทายจากสถานการณ์จริง เพื่อส่งเสริมความคิดสร้างสรรค์ การทำงานเป็นทีม
        และเตรียมความพร้อมสู่โลกแห่งเทคโนโลยีในอนาคต</span><br><span style="font-size: 25px; color: #054394;">
        จัดโดย บริษัท โกรทเพาเวอร์ จำกัด (Growth Power Co., Ltd.)</span></div>
    <div class="hero-actions">
      <a href="#tiers" class="hero-btn-primary hero-btn-register">
        <i class="ti ti-pencil-plus"></i> สมัครแข่งขัน
      </a>

      <div class="hero-actions-bottom">
        <a href="/competition?view=teams" class="hero-btn-secondary hero-btn-team">
          <i class="ti ti-users"></i> ดูทีมแข่งขัน
        </a>

        <a href="/competition?view=board" class="hero-btn-secondary hero-btn-score">
          <i class="ti ti-trophy"></i> ดูผลคะแนน
        </a>
      </div>

      <div class="event-date-card">

        <!-- DATE -->
        <div class="event-date-main">
          <div class="event-date-icon">
            <i class="ti ti-calendar"></i>
          </div>
          <div class="event-date-label">วันแข่งขัน</div>
          <% if (eventDate) { %>
            <div class="event-day-number">
              <%= new Date(eventDate).toLocaleDateString('th-TH', {day:'numeric'}) %>
            </div>
            <div class="event-month">
              <%= new Date(eventDate).toLocaleDateString('th-TH', {month:'long'}) %>
            </div>
            <% if (eventDateEnd) { %>
              <div style="color:rgba(255,255,255,.7);font-size:13px;margin-top:4px">ถึง</div>
              <div class="event-date-range">
                <%= new Date(eventDateEnd).toLocaleDateString('th-TH', {day:'numeric', month:'long', year:'numeric'}) %>
              </div>
              <% } else { %>
                <div class="event-date-range">
                  <%= new Date(eventDate).toLocaleDateString('th-TH', {year:'numeric'}) %>
                </div>
                <% } %>
                  <% } else { %>
                    <div class="event-day-number" style="font-size:48px;letter-spacing:0">---</div>
                    <% } %>
        </div>

        <!-- ARROW -->
        <div class="event-date-arrow">
          <i class="ti ti-chevron-right"></i>
        </div>

        <!-- LOCATION -->
        <div class="event-location-main">
          <div class="event-location-heading">
            <div class="event-location-icon">
              <i class="ti ti-map-pin-filled"></i>
            </div>
            <div class="event-location-title">สถานที่จัดการแข่งขัน</div>
          </div>
          <div class="event-location-line"></div>
          <div class="event-location-name">
            <% if (eventDateLabel) { %>
              <%= eventDateLabel %>
                <% } else { %>
                  <span style="color:#94A3B8;font-size:18px">ยังไม่กำหนด</span>
                  <% } %>
          </div>
        </div>
      </div>
    </div>
