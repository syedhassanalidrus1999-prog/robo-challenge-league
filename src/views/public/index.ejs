    /* DROPDOWN */
    .dropdown {
      position: relative;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      z-index: 1100;
      display: none;
      min-width: 215px;
      padding: 8px;
      background: rgba(255, 255, 255, .98);
      border: 1px solid #E2E8F0;
      border-radius: 14px;
      box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
    }

    .dropdown-item {
      min-height: 44px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-radius: 10px;
      color: #334155;
      font-family: 'Kanit', 'Sarabun', sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: all .18s ease;
    }

    .dropdown-item:hover,
    .dropdown-item.active {
      color: #2563EB;
      background: #EFF6FF;
    }

    .dropdown-item:first-child:hover {
      background: #FEF2F2;
      color: #DC2626;
    }

    .dropdown-item i {
      font-size: 17px;
      color: #64748B;
    }

