    desc: 'สำหรับระดับกลาง เหมาะกับนักเรียนที่มีประสบการณ์และต้องการความท้าทายมากขึ้น',
    img: '/images/intermediate home.png', age: 'ไม่เกิน 12 ปี', robot: 'ไม่จำกัดประเภทหุ่นยนต์', score: 180
    },
    {
    cls: 't-a', emoji: '🚀', name: 'Advance', href: '/register/advance',
    desc: 'สำหรับระดับสูง เหมาะกับนักเรียนที่มีทักษะและประสบการณ์สูง พร้อมรับความท้าทาย',
    img: '/images/advance home.png', age: 'ไม่เกิน 18 ปี', robot: 'ไม่จำกัดประเภทหุ่นยนต์', score: 180
    }
    ];
    %>

    <section class="section tiers-section" id="tiers">
      <div class="section-inner">
        <div class="section-label">ประเภทการแข่งขัน</div>
        <h2 class="section-title">Competition Categories</h2>
        <p class="section-sub">3 รุ่นการแข่งขัน ออกแบบมาสำหรับทุกระดับความสามารถ</p>

        <!-- Registration countdown -->
        <% if (regOpen || regClose) { %>
          <div class="registration-countdown" id="registration-countdown-card">
            <img src="/images/icon/announcement-robot.png" alt="announcement-robot">
            <div class="reg-body">
              <div class="reg-status-label" id="reg-status-label"></div>
              <div class="reg-countdown" id="reg-countdown"></div>
              <div class="reg-status-msg" id="reg-status-msg"></div>
            </div>
          </div>

          <script>
            (function () {
              var openDate = <%- regOpen ? ("new Date('" + regOpen + "')") : 'null' %>;
              var closeDate = <%- regClose ? ("new Date('" + regClose + "')") : 'null' %>;

              var cardEl = document.getElementById('registration-countdown-card');
              var labelEl = document.getElementById('reg-status-label');
              var countEl = document.getElementById('reg-countdown');
              var msgEl = document.getElementById('reg-status-msg');
              if (!cardEl || !labelEl || !countEl || !msgEl) return;

              var STATES = ['is-upcoming', 'is-open', 'is-closing', 'is-closed'];
              var timer = null;

              function setState(state) {
                STATES.forEach(function (s) { cardEl.classList.remove(s); });
                cardEl.classList.add(state);
              }

              function pad(n) {
                return String(n).padStart(2, '0');
              }

              function makeUnit(val, label, showSeparator) {
                return '<div class="reg-countdown-unit">' +
                  '<div class="reg-countdown-number">' + pad(val) + '</div>' +
                  '<div class="reg-countdown-unit-label">' + label + '</div>' +
                  '</div>' +
                  (showSeparator ? '<div class="reg-countdown-separator">:</div>' : '');
              }

              function showStatic(state, label, msg) {
                setState(state);
                labelEl.textContent = label;
                countEl.innerHTML = '';
                msgEl.textContent = msg;
                if (timer) clearInterval(timer);
              }

              function tick() {
                var now = new Date();
                var target, label, msg;

                if (openDate && now < openDate) {
                  setState('is-upcoming');
                  target = openDate;
                  label = 'เปิดรับสมัครใน';
                  msg = 'เตรียมพร้อมได้เลย! การรับสมัครจะเปิดในอีกไม่ช้า';
                } else if (closeDate && now < closeDate) {
                  setState('is-closing');
                  target = closeDate;
                  label = 'ปิดรับสมัครใน';
                  msg = '🔥 เปิดรับสมัครแล้ว! สมัครก่อนหมดเขต';
                } else if (closeDate && now >= closeDate) {
                  return showStatic('is-closed', 'หมดเขตรับสมัครแล้ว', 'ขอบคุณทุกทีมที่สมัครเข้าร่วมการแข่งขัน');
                } else {
                  return showStatic('is-open', 'เปิดรับสมัครแล้ว', '🔥 สมัครได้เลยทันที!');
                }

                var diff = Math.max(0, target - now);
                var days = Math.floor(diff / 86400000);
                var hours = Math.floor((diff % 86400000) / 3600000);
                var mins = Math.floor((diff % 3600000) / 60000);
                var secs = Math.floor((diff % 60000) / 1000);

                labelEl.textContent = label;
                countEl.innerHTML =
                  makeUnit(days, 'วัน', true) +
                  makeUnit(hours, 'ชั่วโมง', true) +
                  makeUnit(mins, 'นาที', true) +
                  makeUnit(secs, 'วินาที', false);
                msgEl.textContent = msg;
              }

              tick();
              timer = setInterval(tick, 1000);
            })();
          </script>
          <% } %>

            <!-- Registration fee bar -->
            <div class="registration-info">
              <div class="registration-label">
                <div class="registration-label-icon"><i class="ti ti-ticket"></i></div>
                <div>
                  <div class="registration-label-title">ค่าลงทะเบียน</div>
