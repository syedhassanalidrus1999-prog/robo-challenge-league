<% var tierColor=activeTier==='beginner' ? '#16A34A' : activeTier==='intermediate' ? '#2563EB' : '#EA580C' ; var
  tierLabel=activeTier==='beginner' ? 'Beginner' : activeTier==='intermediate' ? 'Intermediate' : 'Advance' ; var
  tierIcon=activeTier==='beginner' ? 'ti-leaf' : activeTier==='intermediate' ? 'ti-flame' : 'ti-rocket' ; %>

  <style>
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 24px;
    }

    @media(max-width:700px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .stat-card {
      background: #fff;
      border: 1.5px solid #E2E8F0;
      border-radius: 14px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      box-shadow: 0 2px 8px rgba(15, 23, 42, .04);
      cursor: pointer;
      transition: .15s;
      text-decoration: none;
      color: inherit;
    }

    .stat-card:hover {
      border-color: #CBD5E1;
      box-shadow: 0 4px 16px rgba(15, 23, 42, .08);
      transform: translateY(-1px);
    }

    .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    .stat-num {
      font-size: 28px;
      font-weight: 900;
      line-height: 1;
    }

    .stat-lbl {
      font-size: 11px;
      color: #94A3B8;
      font-weight: 600;
      margin-top: 2px;
    }

    .section-hd {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .search-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #fff;
      border: 1.5px solid #E2E8F0;
      border-radius: 10px;
      padding: 8px 14px;
      min-width: 220px;
    }

    .search-wrap input {
      border: none;
      outline: none;
      font-size: 14px;
      font-family: inherit;
      background: transparent;
      flex: 1;
    }

    .tbl-wrap {
      background: #fff;
      border: 1.5px solid #E2E8F0;
      border-radius: 16px;
      overflow: auto;
      box-shadow: 0 4px 14px rgba(15, 23, 42, .04);
    }

    .tbl {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
    }

    .tbl th {
      background: #F8FAFC;
      font-size: 11px;
      font-weight: 800;
      color: #94A3B8;
      text-transform: uppercase;
      letter-spacing: .5px;
      padding: 11px 14px;
      border-bottom: 1.5px solid #E2E8F0;
      white-space: nowrap;
    }

    .tbl td {
      padding: 11px 14px;
      border-bottom: 1px solid #F1F5F9;
      vertical-align: top;
    }

    .tbl tr:last-child td {
      border-bottom: none;
    }

    .tbl tr:hover td {
      background: #FAFBFC;
    }

    .stu-name {
      font-size: 13px;
      color: #334155;
      font-weight: 600;
    }

    .stu-dob {
      font-size: 10px;
      color: #94A3B8;
      margin-top: 1px;
      margin-bottom: 4px;
    }

    .checkin-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-size: 11px;
      font-weight: 700;
      font-family: inherit;
      transition: .15s;
      white-space: nowrap;
    }

    .checkin-btn.on {
      background: #F0FDF4;
      color: #16A34A;
      border: 1.5px solid #BBF7D0;
    }

    .checkin-btn.off {
      background: #F8FAFC;
      color: #94A3B8;
      border: 1.5px solid #E2E8F0;
    }

    .checkin-btn:hover {
      opacity: .75;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }

    .badge-green {
      background: #F0FDF4;
      color: #16A34A;
    }

    .badge-yellow {
      background: #FFFBEB;
      color: #D97706;
    }

    .badge-red {
      background: #FEF2F2;
      color: #DC2626;
    }

    .act-wrap {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      border: 1.5px solid #E2E8F0;
      background: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748B;
      font-size: 15px;
      transition: .15s;
    }

    .btn-icon:hover {
      background: #F1F5F9;
      color: #0F172A;
    }

    .btn-icon.danger:hover {
      background: #FEF2F2;
      color: #DC2626;
      border-color: #FECACA;
    }

    .empty-row td {
      padding: 48px 24px;
      text-align: center;
      color: #94A3B8;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 16px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
      font-family: inherit;
      transition: .15s;
    }

    .btn-primary {
      background: #2563EB;
      color: #fff;
      box-shadow: 0 4px 12px rgba(37, 99, 235, .2);
    }

    .btn-primary:hover {
      background: #1D4ED8;
    }

    .btn-outline {
      background: #fff;
      color: #64748B;
      border: 1.5px solid #E2E8F0;
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 12px;
    }

    .fi {
      width: 100%;
      padding: 10px 12px;
      border: 1.5px solid #CBD5E1;
      border-radius: 10px;
      font-size: 14px;
      font-family: inherit;
      outline: none;
      transition: .15s;
      box-sizing: border-box;
    }

    .fi:focus {
      border-color: #2563EB;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, .1);
    }

    .fl {
      font-size: 12px;
      font-weight: 700;
      color: #64748B;
      margin-bottom: 5px;
    }

    .fg {
      margin-bottom: 12px;
    }
  </style>

  <style>
    /* ===== RCL 2026 Teams Management — Layout Refresh ===== */
    .page-hd {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 22px;
    }

    .page-title {
      font-size: 25px !important;
      font-weight: 800 !important;
      letter-spacing: -.3px;
    }

    .page-title span {
      color: #2563EB
    }

    .stats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      gap: 14px !important;
      margin-bottom: 26px !important;
    }

    .stat-card {
      min-height: 82px;
      padding: 15px 17px !important;
      border-radius: 16px !important;
      box-shadow: 0 4px 16px rgba(15, 23, 42, .045) !important;
    }

    .stat-icon {
      width: 46px !important;
      height: 46px !important;
      border-radius: 13px !important;
    }

    .stat-num {
      font-size: 27px !important
    }

    .stat-lbl {
      font-size: 11px !important
    }

    .section-hd {
      background: #fff;
      border: 1px solid #E2E8F0;
      border-radius: 16px 16px 0 0;
      padding: 15px 17px;
      margin-bottom: 0 !important;
      box-shadow: 0 3px 12px rgba(15, 23, 42, .035);
    }

    .search-wrap {
      min-width: 270px !important;
      border-radius: 11px !important;
      padding: 8px 13px !important;
    }

    .tbl-wrap {
      border-radius: 0 0 16px 16px !important;
      border-top: 0 !important;
      box-shadow: 0 8px 24px rgba(15, 23, 42, .055) !important;
    }

    .tbl {
      min-width: 1120px !important
    }

    .tbl th {
      padding: 12px 14px !important;
      background: #F8FAFC !important;
    }

    .tbl td {
      padding: 13px 14px !important;
    }

    .tbl tbody tr {
      transition: background .15s
    }

    .tbl tr:hover td {
      background: #F8FAFC !important
    }

    .stu-name {
      font-size: 13px !important;
      line-height: 1.45
    }

    .stu-dob {
      font-size: 10px !important
    }

    .checkin-btn {
      margin-top: 3px;
      border-radius: 7px !important;
    }

    .badge {
      padding: 4px 9px !important
    }

    .modal {
      border-radius: 18px !important;
      overflow: hidden;
      box-shadow: 0 24px 70px rgba(15, 23, 42, .18) !important;
    }

    .modal-head {
      padding: 18px 20px !important;
      background: #fff;
      border-bottom: 1px solid #EEF2F7;
    }

    .modal-body {
      padding: 20px !important;
      max-height: 72vh;
      overflow: auto;
    }

    .modal-foot {
      padding: 14px 20px !important;
      background: #F8FAFC;
      border-top: 1px solid #EEF2F7;
    }

    .modal-body>div[style*="grid-template-columns"] {
      margin-bottom: 2px;
    }

    .modal-body .fi {
      min-height: 42px;
    }

    .modal-body .fg {
      margin-bottom: 12px
    }

    .modal-body>div[style*="background:#F8FAFC"] {
      border-radius: 13px !important;
      padding: 14px !important;
      margin-bottom: 11px !important;
    }

    .modal-body>div[style*="background:#F8FAFC"]>div:first-child {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    @media(max-width:900px) {
      .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important
      }

      .page-title {
        font-size: 22px !important
      }
    }

    @media(max-width:640px) {
      .page-hd {
        align-items: flex-start;
        margin-bottom: 16px
      }

      .page-title {
        font-size: 20px !important
      }

      .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 10px !important
      }

      .stat-card {
        min-height: 74px;
        padding: 12px !important
      }

      .stat-icon {
        width: 40px !important;
        height: 40px !important;
        font-size: 19px !important
      }

      .stat-num {
        font-size: 23px !important
      }

      .section-hd {
        padding: 13px;
        align-items: stretch;
      }

      .search-wrap {
        min-width: 0 !important;
        width: 100%;
      }

      .modal-body {
        padding: 16px !important;
        max-height: 75vh;
      }

      .modal-body>div[style*="grid-template-columns:1fr 1fr"] {
        grid-template-columns: 1fr !important;
        gap: 0 !important;
      }

      .modal-body>div[style*="grid-template-columns:1fr 1fr"]>.fg {
        margin-bottom: 10px !important;
      }
    }

    @media print {

      .sidebar,
      .topbar,
      .page-header,
      .action-row,
      .btn,
      select,
      input,
      .search-box {
        display: none !important;
      }

      body {
        background: #fff !important;
      }

      .main-content {
        margin: 0 !important;
        padding: 0 !important;
      }

      #print-header {
        display: block !important;
      }

      @page {
        size: A4 landscape;
        margin: 10mm;
      }

      table {
        font-size: 10px !important;
      }
    }

    #print-header {
      display: none;
    }
  </style>

  <style>
    /* ===== Final UI polish: RCL 2026 Teams ===== */
    body {
      background: #F6F8FC;
    }

    .page-hd {
      margin-bottom: 20px !important;
      padding: 2px 0 0;
    }

    .page-hd-left {
      min-width: 0;
    }

    .page-title {
      color: #0F172A;
      font-size: 26px !important;
      line-height: 1.2;
    }

    .page-title span {
      color: #2563EB;
    }

    .page-subtitle {
      margin-top: 6px;
      color: #94A3B8;
      font-size: 12px;
      font-weight: 500;
    }

    .page-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .btn-export {
      background: #FFFFFF;
      color: #2563EB;
      border: 1px solid #BFDBFE;
      box-shadow: 0 2px 8px rgba(15, 23, 42, .04);
    }

    .btn-export:hover {
      background: #EFF6FF;
      border-color: #93C5FD;
    }

    .btn-add {
      padding-left: 17px !important;
      padding-right: 17px !important;
    }

    .stats-grid {
      margin-bottom: 22px !important;
    }

    .stat-card {
      position: relative;
      min-height: 86px;
      overflow: hidden;
      background: linear-gradient(135deg, #fff 0%, #fbfdff 100%);
    }

    .stat-card::after {
      content: "";
      position: absolute;
      right: -24px;
      bottom: -30px;
      width: 82px;
      height: 82px;
      border-radius: 50%;
      background: rgba(148, 163, 184, .055);
      pointer-events: none;
    }

    .stat-icon {
      box-shadow: inset 0 0 0 1px rgba(15, 23, 42, .025);
    }

    .section-hd {
      position: relative;
      min-height: 62px;
      box-sizing: border-box;
    }

    .section-hd>div:first-child {
      font-size: 16px !important;
    }

    .search-wrap {
      background: #F8FAFC;
    }

    .search-wrap:focus-within {
      background: #fff;
      border-color: #93C5FD !important;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
    }

    .tbl-wrap {
      background: #fff;
    }

    .tbl th:first-child,
    .tbl td:first-child {
      padding-left: 18px !important;
    }

    .tbl th:last-child,
    .tbl td:last-child {
      padding-right: 18px !important;
    }

    .tbl th {
      position: sticky;
      top: 0;
      z-index: 2;
    }

    .tbl td {
      height: 52px;
      box-sizing: border-box;
    }

    .tbl td:nth-child(2) {
      min-width: 145px;
    }

    .tbl td:nth-child(3) {
      min-width: 170px;
    }

    .tbl td:nth-child(4),
    .tbl td:nth-child(5),
    .tbl td:nth-child(6) {
      min-width: 150px;
    }

    .tbl td:nth-child(7) {
      min-width: 115px;
    }

    .tbl td:nth-child(8) {
      min-width: 190px;
    }

    .tbl td:nth-child(9) {
      min-width: 120px;
    }

    .tbl td:nth-child(10) {
      min-width: 105px;
    }

    .tbl td:nth-child(11) {
      min-width: 130px;
    }

    .act-wrap {
      justify-content: flex-start;
    }

    .btn-icon {
      background: #fff;
      transition: all .15s ease;
    }

    .modal-backdrop {
      padding: 18px;
      box-sizing: border-box;
    }

    .modal {
      max-height: calc(100vh - 36px);
    }

    .modal-head {
      position: sticky;
      top: 0;
      z-index: 3;
    }

    .modal-foot {
      position: sticky;
      bottom: 0;
      z-index: 3;
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }

    @media(max-width:900px) {
      .page-hd {
        align-items: flex-start;
      }

      .page-actions {
        margin-top: 2px;
      }
    }

    @media(max-width:640px) {
      .page-hd {
        display: block;
      }

      .page-title {
        font-size: 21px !important;
      }

      .page-subtitle {
        font-size: 11px;
      }

      .page-actions {
        width: 100%;
        margin-top: 12px;
      }

      .page-actions .btn {
        flex: 1;
        justify-content: center;
      }

      .stats-grid {
        margin-bottom: 16px !important;
      }

      .stat-card {
        min-height: 72px;
      }

      .section-hd {
        gap: 12px;
      }

      .section-hd>div:first-child {
        width: 100%;
      }

      .tbl-wrap {
        border-radius: 0 0 14px 14px !important;
      }
    }
  </style>

  <div class="page-hd">
    <div class="page-hd-left">
      <div class="page-title">จัดการทีม <span>RCL 2026</span></div>
      <div class="page-subtitle">
        รายชื่อทีม ผู้เข้าแข่งขัน และข้อมูลโค้ช
      </div>
    </div>
    <div class="page-actions">
      <button onclick="printTeams()" class="btn btn-export">
        <i class="ti ti-printer"></i> Export PDF
      </button>
      <button onclick="openModal('addModal')" class="btn btn-primary btn-add">
        <i class="ti ti-plus"></i> เพิ่มทีม
      </button>
    </div>
  </div>


  <!-- Stats -->
  <div class="stats-grid">
    <a href="/teams?tier=beginner" class="stat-card"
      style="border-color:<%= activeTier==='beginner'?'#16A34A':'#E2E8F0' %>">
      <div class="stat-icon" style="background:#F0FDF4">🌱</div>
      <div>
        <div class="stat-num" style="color:#16A34A">
          <%= counts.beginner||0 %>
        </div>
        <div class="stat-lbl">Beginner</div>
      </div>
    </a>
    <a href="/teams?tier=intermediate" class="stat-card"
      style="border-color:<%= activeTier==='intermediate'?'#2563EB':'#E2E8F0' %>">
      <div class="stat-icon" style="background:#EFF6FF">🔥</div>
      <div>
        <div class="stat-num" style="color:#2563EB">
          <%= counts.intermediate||0 %>
        </div>
        <div class="stat-lbl">Intermediate</div>
      </div>
    </a>
    <a href="/teams?tier=advance" class="stat-card"
      style="border-color:<%= activeTier==='advance'?'#EA580C':'#E2E8F0' %>">
      <div class="stat-icon" style="background:#FFF7ED">🚀</div>
      <div>
        <div class="stat-num" style="color:#EA580C">
          <%= counts.advance||0 %>
        </div>
        <div class="stat-lbl">Advance</div>
      </div>
    </a>
    <a href="/teams" class="stat-card">
      <div class="stat-icon" style="background:#F8FAFC"><i class="ti ti-users" style="color:#64748B"></i></div>
      <div>
        <div class="stat-num" style="color:#0F172A">
          <%= (counts.beginner||0)+(counts.intermediate||0)+(counts.advance||0) %>
        </div>
        <div class="stat-lbl">ทั้งหมด</div>
      </div>
    </a>
  </div>

  <!-- Section header -->
  <div class="section-hd">
    <div style="font-size:16px;font-weight:800;color:<%= tierColor %>;display:flex;align-items:center;gap:8px">
      <i class="ti <%= tierIcon %>"></i> รุ่น <%= tierLabel %>
        <span style="font-size:12px;color:#94A3B8;font-weight:600">
          <%= teams.length %> ทีม
        </span>
    </div>
    <div class="search-wrap">
      <i class="ti ti-search" style="color:#94A3B8"></i>
      <input type="text" id="teamSearch" placeholder="ค้นหาชื่อทีม / สถาบัน..." oninput="filterTeams()">
    </div>
  </div>

  <!-- Table -->
  <div class="tbl-wrap">
    <table class="tbl">
      <thead>
        <tr>
          <th>ID</th>
          <th>ชื่อทีม</th>
          <th>สถาบัน</th>
          <th>นักเรียน 1</th>
          <th>นักเรียน 2</th>
          <th>นักเรียน 3</th>
          <th>โค้ช</th>
          <th>อีเมลโค้ช</th>
          <th>เบอร์โทร</th>
          <th>สถานะ</th>
          <th>โน้ต</th>
          <th>จัดการ</th>
        </tr>
      </thead>
      <tbody id="teamTableBody">
        <% if (!teams || teams.length===0) { %>
          <tr class="empty-row">
            <td colspan="11">
              <i class="ti ti-users-off" style="font-size:36px;opacity:.3;display:block;margin-bottom:8px"></i>
              ยังไม่มีทีมในรุ่นนี้
            </td>
          </tr>
          <% } else { %>
            <% for (var i=0; i < teams.length; i++) { %>
              <% var t=teams[i]; %>
                <tr class="team-row" data-name="<%= (t.name||'').toLowerCase() %>"
                  data-inst="<%= (t.institution||'').toLowerCase() %>">

                  <td><span style="font-size:12px;font-weight:700;color:<%= tierColor %>">
                      <%= t.id %>
                    </span></td>
                  <td style="font-weight:700;font-size:14px;color:#0F172A">
                    <%= t.name %>
                  </td>
                  <td style="font-size:13px;color:#334155">
                    <%= t.institution || '—' %>
                  </td>

                  <!-- นักเรียน 1 -->
                  <td>
                    <% if (t.student_1) { %>
                      <div class="stu-name">
                        <%= t.student_1 %>
                      </div>
                      <% if (t.student_1_dob) { %>
                        <div class="stu-dob">
                          <%= new Date(t.student_1_dob).toLocaleDateString('th-TH') %>
                        </div>
                        <% } %>
                          <form method="POST" action="/teams/<%= t.id %>/checkin/1?tier=<%= activeTier %>"
                            style="display:inline">
                            <button type="submit" class="checkin-btn <%= t.student_1_checked_in ? 'on' : 'off' %>">
                              <i
                                class="ti ti-<%= t.student_1_checked_in ? 'circle-check-filled' : 'circle-dashed' %>"></i>
                              <%= t.student_1_checked_in ? 'มาแล้ว' : 'ยังไม่มา' %>
                            </button>
                          </form>
                          <% } else { %><span style="color:#CBD5E1">—</span>
                            <% } %>
                  </td>

                  <!-- นักเรียน 2 -->
                  <td>
                    <% if (t.student_2) { %>
                      <div class="stu-name">
                        <%= t.student_2 %>
                      </div>
                      <% if (t.student_2_dob) { %>
                        <div class="stu-dob">
                          <%= new Date(t.student_2_dob).toLocaleDateString('th-TH') %>
                        </div>
                        <% } %>
                          <form method="POST" action="/teams/<%= t.id %>/checkin/2?tier=<%= activeTier %>"
                            style="display:inline">
                            <button type="submit" class="checkin-btn <%= t.student_2_checked_in ? 'on' : 'off' %>">
                              <i
                                class="ti ti-<%= t.student_2_checked_in ? 'circle-check-filled' : 'circle-dashed' %>"></i>
                              <%= t.student_2_checked_in ? 'มาแล้ว' : 'ยังไม่มา' %>
                            </button>
                          </form>
                          <% } else { %><span style="color:#CBD5E1">—</span>
                            <% } %>
                  </td>

                  <!-- นักเรียน 3 -->
                  <td>
                    <% if (t.student_3) { %>
                      <div class="stu-name">
                        <%= t.student_3 %>
                      </div>
                      <% if (t.student_3_dob) { %>
                        <div class="stu-dob">
                          <%= new Date(t.student_3_dob).toLocaleDateString('th-TH') %>
                        </div>
                        <% } %>
                          <form method="POST" action="/teams/<%= t.id %>/checkin/3?tier=<%= activeTier %>"
                            style="display:inline">
                            <button type="submit" class="checkin-btn <%= t.student_3_checked_in ? 'on' : 'off' %>">
                              <i
                                class="ti ti-<%= t.student_3_checked_in ? 'circle-check-filled' : 'circle-dashed' %>"></i>
                              <%= t.student_3_checked_in ? 'มาแล้ว' : 'ยังไม่มา' %>
                            </button>
                          </form>
                          <% } else { %><span style="color:#CBD5E1">—</span>
                            <% } %>
                  </td>

                  <td style="font-size:13px;color:#334155">
                    <%= t.coach || '—' %>
                  </td>
                  <td style="font-size:13px;color:#334155">
                    <%= t.coach_email || '—' %>
                  </td>
                  <td style="font-size:13px;color:#334155">
                    <%= t.phone || '—' %>
                  </td>
                  <td>
                    <% if (t.status==='approved' ) { %>
                      <span class="badge badge-green"><i class="ti ti-point-filled"></i> อนุมัติแล้ว</span>
                      <% } else if (t.status==='rejected' ) { %>
                        <span class="badge badge-red"><i class="ti ti-point-filled"></i> ไม่อนุมัติ</span>
                        <% } else { %>
                          <span class="badge badge-yellow"><i class="ti ti-point-filled"></i> รอพิจารณา</span>
                          <% } %>
                  </td>
                  <td style="font-size:12px;color:#64748B;max-width:100px">
                    <%= t.note || '—' %>
                  </td>
                  <td>
                    <div class="act-wrap">
                      <button class="btn-icon" onclick='openEditModal(<%= JSON.stringify(t) %>)' title="แก้ไข">
                        <i class="ti ti-pencil"></i>
                      </button>
                      <form method="POST" action="/teams/<%= t.id %>?_method=DELETE&tier=<%= activeTier %>"
                        style="display:inline" onsubmit="return confirm('ลบทีม <%= t.name %> ใช่ไหม?')">
                        <button type="submit" class="btn-icon danger" title="ลบ">
                          <i class="ti ti-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% } %>
                  <% } %>
      </tbody>
    </table>
  </div>

  <!-- Edit Modal -->
  <div class="modal-backdrop" id="editModal" style="display:none">
    <div class="modal" style="max-width:560px;width:100%">
      <div class="modal-head">
        <div>
          <div class="modal-title">แก้ไขข้อมูลทีม</div>
          <div id="editModalSub" style="font-size:12px;color:#94A3B8"></div>
        </div>
        <button class="modal-close" onclick="closeModal('editModal')"><i class="ti ti-x"></i></button>
      </div>
      <form method="POST" id="editForm">
        <div class="modal-body">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="fg">
              <div class="fl">ชื่อทีม *</div><input class="fi" type="text" name="name" id="edit_name" required>
            </div>
            <div class="fg">
              <div class="fl">สถาบัน / โรงเรียน *</div><input class="fi" type="text" name="institution"
                id="edit_institution" required>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="fg">
              <div class="fl">รุ่น</div>
              <select class="fi" name="tier" id="edit_tier">
                <option value="beginner">Beginner</option>
                <option value="intermediate">Intermediate</option>
                <option value="advance">Advance</option>
              </select>
            </div>
            <div class="fg">
              <div class="fl">สถานะ</div>
              <select class="fi" name="status" id="edit_status">
                <option value="pending">รอพิจารณา</option>
                <option value="approved">อนุมัติแล้ว</option>
                <option value="rejected">ไม่อนุมัติ</option>
              </select>
            </div>
          </div>
          <div style="font-weight:700;font-size:12px;color:#64748B;margin-bottom:10px">สมาชิกทีม</div>
          <% for (var mi=1; mi <=3; mi++) { %>
            <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;padding:12px;margin-bottom:10px">
              <div style="font-size:12px;font-weight:700;color:#2563EB;margin-bottom:8px">นักเรียนคนที่ <%= mi %>
              </div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                <div class="fg" style="margin-bottom:0">
                  <div class="fl">ชื่อ-นามสกุล</div><input class="fi" type="text" name="student_<%= mi %>"
                    id="edit_s<%= mi %>">
                </div>
                <div class="fg" style="margin-bottom:0">
                  <div class="fl">วันเกิด</div><input class="fi" type="date" name="student_<%= mi %>_dob"
                    id="edit_s<%= mi %>_dob">
                </div>
              </div>
            </div>
            <% } %>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <div class="fg" style="margin-bottom:0">
                  <div class="fl">ชื่อโค้ช</div><input class="fi" type="text" name="coach" id="edit_coach">
                </div>
                <div class="fg">
                  <div class="fl">อีเมลโค้ช</div>
                  <input class="fi" type="email" name="coach_email" id="edit_coach_email"
                    placeholder="email@example.com">
                </div>
                <div class="fg" style="margin-bottom:0">
                  <div class="fl">เบอร์โทร</div><input class="fi" type="text" name="phone" id="edit_phone">
                </div>
              </div>
              <div class="fg" style="margin-top:12px">
                <div class="fl">โน้ต</div><input class="fi" type="text" name="note" id="edit_note">
              </div>
        </div>
        <div class="modal-foot">
          <button type="button" class="btn btn-outline" onclick="closeModal('editModal')">ยกเลิก</button>
          <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> บันทึก</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Modal -->
  <div class="modal-backdrop" id="addModal" style="display:none">
    <div class="modal" style="max-width:560px;width:100%">
      <div class="modal-head">
        <div class="modal-title">เพิ่มทีมใหม่</div>
        <button class="modal-close" onclick="closeModal('addModal')"><i class="ti ti-x"></i></button>
      </div>
      <form method="POST" action="/teams">
        <div class="modal-body">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="fg">
              <div class="fl">ชื่อทีม *</div><input class="fi" type="text" name="name" required>
            </div>
            <div class="fg">
              <div class="fl">สถาบัน / โรงเรียน *</div><input class="fi" type="text" name="institution" required>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="fg">
              <div class="fl">รุ่น</div>
              <select class="fi" name="tier">
                <option value="beginner">Beginner</option>
                <option value="intermediate">Intermediate</option>
                <option value="advance">Advance</option>
              </select>
            </div>
            <div class="fg">
              <div class="fl">เบอร์โทร *</div><input class="fi" type="text" name="phone" required>
            </div>
          </div>
          <% for (var ai=1; ai <=3; ai++) { %>
            <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;padding:12px;margin-bottom:10px">
              <div style="font-size:12px;font-weight:700;color:#2563EB;margin-bottom:8px">นักเรียนคนที่ <%= ai %>
              </div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                <div class="fg" style="margin-bottom:0">
                  <div class="fl">ชื่อ-นามสกุล</div><input class="fi" type="text" name="student_<%= ai %>">
                </div>
                <div class="fg" style="margin-bottom:0">
                  <div class="fl">วันเกิด</div><input class="fi" type="date" name="student_<%= ai %>_dob">
                </div>
              </div>
            </div>
            <% } %>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <div class="fg" style="margin-bottom:0">
                  <div class="fl">ชื่อโค้ช</div>
                  <input class="fi" type="text" name="coach" placeholder="ชื่อ-นามสกุลโค้ช">
                </div>
                <div class="fg" style="margin-bottom:0">
                  <div class="fl">อีเมลโค้ช</div>
                  <input class="fi" type="email" name="coach_email" placeholder="email@example.com">
