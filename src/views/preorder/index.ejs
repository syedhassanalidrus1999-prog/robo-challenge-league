<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pre-order สนามแข่งขัน — RCL 2026</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&family=Kanit:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #F5F7FB;
      --surface: #FFFFFF;
      --text: #0F172A;
      --muted: #64748B;
      --line: #E2E8F0;
      --blue: #2563EB;
      --blue-soft: #EFF6FF;
      --green: #16A34A;
      --orange: #EA580C;
      --shadow: 0 8px 24px rgba(15, 23, 42, .06);
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    html {
      scroll-behavior: smooth
    }

    body {
      font-family: 'Kanit', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    a {
      text-decoration: none;
      color: inherit
    }

    button,
    input,
    textarea {
      font-family: 'Kanit', sans-serif;
    }

    .topbar {
      position: fixed;
      inset: 0 0 auto;
      z-index: 1000;
      height: 82px;
      padding: 0 30px;
      display: flex;
      align-items: center;
      gap: 10px;
      background: transparent;
      border-bottom: 1px solid transparent;
      transition: background .25s ease, border-color .25s ease, box-shadow .25s ease;
    }

    .topbar.scrolled {
      background: rgba(255, 255, 255, .92) !important;
      border-bottom-color: rgba(226, 232, 240, .9);
      box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .topbar.scrolled .nav-link {
      color: #334155 !important;
    }

    .topbar-logo {
      flex: 0 0 auto;
      width: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center
    }

    .topbar-logo img {
      display: block;
      width: auto;
      max-width: 130px;
      height: 120px;
      object-fit: contain
    }

    .topbar-nav {
      flex: 1 1 auto;
      min-width: 0;
      margin-left: 18px;
      display: flex;
      align-items: center;
      gap: 6px
    }

    .nav-link {
      min-height: 52px;
      padding: 0 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 4px;
      flex: 0 0 auto;
      border: 0;
      border-radius: 11px;
      background: transparent;
      color: #c8deff;
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition: color .2s ease, background .2s ease, transform .2s ease
    }

    .nav-link span:first-child {
      font-size: 16px;
      line-height: 1.05;
      font-weight: 700;
      letter-spacing: 1px
    }

    .nav-link span:last-child {
      font-size: 13px;
      line-height: 1.05;
      font-weight: 500;
      letter-spacing: 0
    }

    .nav-link i {
      font-size: 17px
    }

    .nav-link:hover {
      color: #2563EB;
      background: #F4F8FF !important;
      transform: translateY(-1px)
    }

    .nav-link.active {
      color: #2563EB !important;
      background: #EFF6FF !important
    }

    .certificate-btn {
      background: linear-gradient(135deg, #FFF7D6, #FEF3C7) !important;
      color: #92400E !important;
      border: 1px solid #FCD34D !important;
      border-radius: 90px !important;
      box-shadow: 0 4px 12px rgba(180, 120, 20, .18)
    }

    .certificate-btn:hover {
      background: linear-gradient(135deg, #FDE68A, #FCD34D) !important;
      color: #78350F !important;
      border-color: #F59E0B !important;
      box-shadow: 0 7px 18px rgba(180, 120, 20, .28);
      transform: translateY(-2px)
    }

    .topbar-actions {
      flex: 0 0 auto;
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 10px
    }

    .btn-reg,
    .btn-login {
      min-height: 52px;
      padding: 0 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border-radius: 11px;
      font: 800 16px 'Sarabun', sans-serif;
      text-decoration: none;
      white-space: nowrap;
      box-sizing: border-box;
      transition: all .2s ease
    }

    .btn-reg {
      color: #fff;
      background: linear-gradient(135deg, #3478F6, #2563EB);
      border: 1px solid transparent;
      box-shadow: 0 10px 24px rgba(37, 99, 235, .24)
    }

    .btn-reg:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(37, 99, 235, .30)
    }

    .btn-login {
      color: #334155;
      background: #fff;
      border: 1px solid #E2E8F0
    }

    .btn-login:hover {
      color: #2563EB;
      background: #F8FAFC;
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(15, 23, 42, .07)
    }

    .btn-login i {
      font-size: 16px
    }

    .dropdown {
      position: relative
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      z-index: 1100;
      display: none;
      min-width: 215px;
      padding: 8px;
      background: rgba(255, 255, 255, .98);
      border: 1px solid #E2E8F0;
      border-radius: 14px;
      box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px)
    }

    .dropdown-item {
      min-height: 44px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-radius: 10px;
      color: #334155;
      font-family: 'Kanit', 'Sarabun', sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: color .18s ease, background .18s ease
    }

    .dropdown-item:hover,
    .dropdown-item.active {
      color: #2563EB;
      background: #EFF6FF
    }

    .dropdown-item:first-child:hover {
      background: #FEF2F2;
      color: #DC2626
    }

    .dropdown-item i {
      font-size: 17px;
      color: #64748B
    }

    .mobile-menu-toggle {
      display: none;
      position: relative;
      z-index: 1202;
      flex: 0 0 44px;
      width: 44px;
      height: 44px;
      padding: 0;
      margin-left: auto;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(148, 163, 184, .35);
      border-radius: 12px;
      background: rgba(255, 255, 255, .96);
      color: #334155;
      box-shadow: 0 6px 18px rgba(15, 23, 42, .07);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent
    }

    .mobile-menu-toggle i {
      font-size: 25px;
      line-height: 1
    }

    .mobile-menu-toggle.is-open {
      color: #2563EB;
      background: #EFF6FF;
      border-color: #BFDBFE
    }

    .mobile-menu {
      display: none;
      position: fixed;
      top: 94px;
      left: 12px;
      right: 12px;
      z-index: 1201;
      max-height: calc(100dvh - 106px);
      overflow-y: auto;
      box-sizing: border-box;
      padding: 8px;
      background: rgba(255, 255, 255, .98);
      border: 1px solid #DBEAFE;
      border-radius: 17px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, .16);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px) scale(.985);
      transform-origin: top center;
      transition: opacity .18s ease, transform .18s ease, visibility .18s ease
    }

    .mobile-menu.is-open {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      transform: translateY(0) scale(1)
    }

    .mobile-menu-item {
      width: 100%;
      min-height: 52px;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      gap: 11px;
      box-sizing: border-box;
      border: 0;
      border-radius: 11px;
      background: transparent;
      color: #334155;
      font-family: 'Kanit', 'Sarabun', sans-serif;
      text-decoration: none;
      text-align: left;
      cursor: pointer
    }

    .mobile-menu-item:hover,
    .mobile-menu-item:active {
      background: #F4F8FF;
      color: #2563EB
    }

    .mobile-menu-item>i:first-child {
      width: 28px;
      min-width: 28px;
      text-align: center;
      font-size: 20px;
      color: #64748B
    }

    .mobile-menu-item>span {
      min-width: 0;
      flex: 1;
      display: flex;
      flex-direction: column;
      line-height: 1.1
    }

    .mobile-menu-item b {
      font-size: 15px;
      font-weight: 800;
      letter-spacing: .2px
    }

    .mobile-menu-item small {
      margin-top: 3px;
      font-size: 11px;
      font-weight: 500;
      color: #94A3B8
    }

    .mobile-menu-arrow {
      width: auto !important;
      min-width: 0 !important;
      font-size: 18px !important;
      color: #94A3B8 !important;
      transition: transform .2s ease
    }

    .mobile-competition-toggle.is-open {
      background: #EFF6FF;
      color: #2563EB
    }

    .mobile-competition-toggle.is-open .mobile-menu-arrow {
      transform: rotate(180deg)
    }

    .mobile-submenu {
      display: none;
      margin: 0 8px 6px 51px;
      padding: 5px;
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 12px
    }

    .mobile-submenu.is-open {
      display: block
    }

    .mobile-submenu-item {
      min-height: 42px;
      padding: 0 10px;
      display: flex;
      align-items: center;
      gap: 9px;
      border-radius: 8px;
      color: #475569;
      font-family: 'Kanit', 'Sarabun', sans-serif;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none
    }

    .mobile-submenu-item:hover {
      color: #2563EB;
      background: #EFF6FF
    }

    .mobile-submenu-item i {
      font-size: 16px;
      color: #64748B
    }

    .mobile-login-item {
      margin-top: 4px;
      border-top: 1px solid #EEF2F6;
      border-radius: 0 0 11px 11px
    }

    @media(min-width:901px) and (max-width:1199px) {
      .topbar {
        height: 78px;
        padding: 0 20px;
        gap: 7px
      }

      .topbar-logo img {
        height: 96px;
        max-width: 112px
      }

      .topbar-nav {
        margin-left: 8px;
        gap: 2px
      }

      .nav-link {
        min-height: 48px;
        padding: 0 10px
      }

      .nav-link span:first-child {
        font-size: 14px;
        letter-spacing: .7px
      }

      .nav-link span:last-child {
        font-size: 11px
      }

      .btn-reg,
      .btn-login {
        min-height: 48px;
        padding: 0 14px;
        font-size: 14px
      }
    }

    @media(min-width:641px) and (max-width:900px) {
      .topbar {
        height: 72px;
        padding: 0 16px;
        gap: 6px
      }

      .topbar-logo img {
        height: 76px;
        max-width: 92px
      }

      .topbar-nav {
        margin-left: 4px;
        gap: 1px
      }

      .nav-link {
        min-height: 46px;
        padding: 0 8px
      }

      .nav-link span:first-child {
        font-size: 12px;
        letter-spacing: .4px
      }

      .nav-link span:last-child {
        font-size: 10px
      }

      .btn-reg,
      .btn-login {
        min-height: 44px;
        padding: 0 11px;
        font-size: 13px
      }

      .mobile-menu-toggle,
      .mobile-menu {
        display: none !important
      }
    }

    @media(max-width:640px) {
      .topbar {
        height: 62px;
        padding: 0 12px;
        gap: 8px;
        border-bottom-color: rgba(226, 232, 240, .9);
        box-shadow: 0 4px 18px rgba(15, 23, 42, .07);
      }

      .topbar-logo img {
        height: 44px;
        max-width: 86px
      }

      .topbar-nav,
      .topbar-actions {
        display: none !important
      }

      .mobile-menu-toggle {
        display: inline-flex !important
      }

      .mobile-menu {
        top: 72px;
        left: 12px;
        right: 12px;
        max-height: calc(100dvh - 84px)
      }
    }

    @media(max-width:430px) {
      .topbar {
        height: 60px;
        padding: 0 9px
      }

      .topbar-logo img {
        height: 40px;
        max-width: 76px
      }

      .mobile-menu-toggle {
        flex-basis: 42px;
        width: 42px;
        height: 42px
      }

      .mobile-menu {
        top: 70px;
        left: 9px;
        right: 9px;
        max-height: calc(100dvh - 80px)
      }
    }

    @media(max-width:380px) {
      .topbar {
        height: 58px;
        padding: 0 8px
      }

      .topbar-logo img {
        height: 38px;
        max-width: 72px
      }

      .mobile-menu-toggle {
        flex-basis: 40px;
        width: 40px;
        height: 40px
      }

      .mobile-menu {
        top: 67px;
        left: 8px;
        right: 8px
      }

      .mobile-menu-item {
        min-height: 48px
      }
    }

    @media(max-width:900px) and (orientation:landscape) {
      .mobile-menu {
        max-height: calc(100dvh - 76px)
      }
    }

    .promo-banner {
      background: linear-gradient(135deg, #EA580C, #DC2626);
      padding: 10px 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .promo-banner-text {
      color: #fff;
      font-size: 20px;
      font-weight: 800
    }

    .promo-countdown {
      background: rgba(255, 255, 255, .18);
      border-radius: 999px;
      padding: 4px 11px;
      color: #fff;
      font-size: 18px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .page-hero {
      margin-top: 0;
      background: radial-gradient(circle at 15% 20%, rgba(96, 165, 250, .18), transparent 28%), radial-gradient(circle at 85% 80%, rgba(37, 99, 235, .22), transparent 30%), linear-gradient(135deg, #0B1220 0%, #172554 58%, #1554C7 100%);
      padding: 90px 10px 30px;
      text-align: center;
    }

    .page-hero-eyebrow {
      color: #60A5FA;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      margin-bottom: 5px;
    }

    .page-hero-title {
      color: #fff;
      font-size: clamp(22px, 4vw, 40px);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 5px;
    }

    .page-hero-sub {
      color: rgba(255, 255, 255, .68);
      font-size: 12px
    }

    .page-wrap {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
      padding: 28px 0 52px;
    }

    .section-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 14px;
      margin: 0 0 13px;
    }

    .section-heading-title {
      font-size: 21px;
      line-height: 1.25;
      font-weight: 700;
      color: var(--text);
    }

    .section-heading-sub {
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
    }

    .field-showcase {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 28px;
    }

    .field-showcase-card {
      --field-color: #2563EB;
      background: var(--surface);
      border: 1.5px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: var(--shadow);
      cursor: pointer;
      transition: transform .18s, border-color .18s, box-shadow .18s;
    }

    .field-showcase-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(15, 23, 42, .09)
    }

    .field-showcase-card.active {
      border-color: var(--field-color);
      box-shadow: 0 0 0 2px var(--field-color), 0 14px 30px rgba(15, 23, 42, .10);
    }

    .field-showcase-image {
      position: relative;
      aspect-ratio: 2/1;
      overflow: hidden;
      background: #E2E8F0;
    }

    .field-showcase-image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover
    }

    .field-showcase-card.active .field-showcase-image:after {
      content: 'กำลังเลือก';
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 4px 9px;
      border-radius: 999px;
      background: rgba(15, 23, 42, .78);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
    }

    .field-level-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      color: #fff;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 800;
      z-index: 2;
      box-shadow: 0 3px 9px rgba(15, 23, 42, .18);
    }

    .field-showcase-body {
      padding: 15px 16px 14px
    }

    .field-showcase-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .field-spec-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px 14px;
    }

    .field-mini-spec {
      font-size: 11px;
      line-height: 1.45;
      color: var(--muted);
    }

    .field-mini-spec strong {
      display: block;
      color: #334155;
      font-size: 11px;
      font-weight: 800;
      margin-bottom: 1px;
    }

    .field-select-hint {
      display: flex;
      align-items: center;
      gap: 5px;
      border-top: 1px solid #F1F5F9;
      margin-top: 12px;
      padding-top: 10px;
      color: var(--blue);
      font-size: 11px;
      font-weight: 800;
    }

    .product-options-wrap {
      display: none;
      margin: 0 0 24px;
      animation: productReveal .2s ease-out;
    }

    .product-options-wrap.active {
      display: block
    }

    @keyframes productReveal {
      from {
        opacity: 0;
        transform: translateY(-5px)
      }

      to {
        opacity: 1;
        transform: translateY(0)
      }
    }

    .product-options-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      color: #fff;
      padding: 13px 16px;
      border-radius: 14px 14px 0 0;
    }

    .product-options-head-title {
      font-size: 18px;
      font-weight: 700;
      line-height: 1.25;
    }

    .product-options-head-sub {
      font-size: 11px;
      opacity: .86;
      margin-top: 2px;
    }

    .choose-field-btn {
      border: 1px solid rgba(255, 255, 255, .3);
      background: rgba(255, 255, 255, .15);
      color: #fff;
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }

    .product-options-body {
      background: #F8FAFC;
      border: 1px solid var(--line);
      border-top: 0;
      border-radius: 0 0 14px 14px;
      padding: 10px;
    }

    .product-options-list {
      display: flex;
      flex-direction: column;
      gap: 8px
    }

    .product-item {
      width: 100%;
      min-height: auto;
      background: #fff;
      border: 1.5px solid var(--line);
      border-radius: 11px;
      padding: 10px 14px;
      display: grid;
      grid-template-columns: 220px 28px minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: .15s;
    }

    .product-item:hover {
      border-color: #BFDBFE;
      box-shadow: 0 4px 14px rgba(37, 99, 235, .07)
    }

    .product-item.is-selected {
      border-color: var(--blue);
      box-shadow: 0 0 0 1px var(--blue), 0 5px 15px rgba(37, 99, 235, .08);
      background: #FCFEFF;
    }

    .product-thumb {
      width: 210px;
      height: 100px;
      min-width: 64px;
      min-height: 64px;
      border-radius: 8px;
      overflow: hidden;
      background: #F1F5F9;
      border: 1px solid var(--line);
    }

    .product-thumb img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover
    }

    .product-content {
      min-width: 0;
      width: 100%;
      overflow: hidden;
    }

    .product-item-name {
      font-size: 18px;
      line-height: 1.35;
      font-weight: 800;
      color: #0F172A;
    }

    .product-item-desc {
      font-size: 14px;
      line-height: 1.4;
      color: var(--muted);
      margin-top: 1px;
    }

    .price-wrap {
      min-width: 105px;
      text-align: right;
      justify-self: end;
      white-space: nowrap;
    }

    .price-discount-badge {
      display: inline-block;
      color: #DC2626;
      background: #FEF2F2;
      border-radius: 999px;
      padding: 2px 6px;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 2px;
    }

    .price-original {
      color: #94A3B8;
      text-decoration: line-through;
      font-size: 17px;
      line-height: 1.1;
    }

    .price-promo {
      color: #DC2626;
      font-size: 25px;
      line-height: 1.15;
      font-weight: 900;
    }

    .price-normal {
      font-size: 25px;
      font-weight: 900
    }

    .custom-checkbox {
      width: 24px;
      height: 24px;
      border: 2px solid #CBD5E1;
      border-radius: 7px;
      background: #fff;
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 14px;
      flex-shrink: 0;
    }

    .custom-checkbox i {
      display: none
    }

    .qty-wrap {
      display: flex;
      align-items: center;
      gap: 7px;
      margin-top: 6px;
    }

    .qty-label {
      font-size: 10px;
      color: var(--muted);
      font-weight: 700
    }

    .qty-control {
      display: flex;
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 7px;
      overflow: hidden;
      background: #fff
    }

    .qty-btn {
      width: 25px;
      height: 25px;
      border: 0;
      background: #F8FAFC;
      color: #334155;
      cursor: pointer;
      font-weight: 800;
    }

    .qty-num {
      width: 38px;
      height: 25px;
      border: 0;
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
      text-align: center;
      font-size: 11px;
      outline: none;
    }

    .checkout-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 18px;
      align-items: start;
      margin-top: 20px;
    }

    .checkout-main {
      min-width: 0
    }

    .sidebar-sticky {
      position: sticky;
      top: 76px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .form-card,
    .summary-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }

    .form-card {
      padding: 20px
    }

    .form-card-title,
    .summary-head {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 16px;
      font-weight: 700;
      color: #0F172A;
    }

    .form-card-title {
      padding-bottom: 12px;
      margin-bottom: 16px;
      border-bottom: 1px solid #F1F5F9;
    }

    .form-card-title i,
    .summary-head i {
      color: var(--blue)
    }

    .fg {
      display: flex;
      flex-direction: column;
      gap: 5px;
      margin-bottom: 12px
    }

    .fl {
      font-size: 11px;
      font-weight: 800;
      color: #475569
    }

    .fi {
      width: 100%;
      padding: 10px 12px;
      border: 1.5px solid var(--line);
      border-radius: 9px;
      background: #fff;
      color: #1E293B;
      font-size: 13px;
      outline: none;
      transition: .15s;
    }

    .fi:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
    }

    .form-grid-2,
    .form-grid-3 {
      display: grid;
      gap: 12px;
      margin-bottom: 12px;
    }

    .form-grid-2 {
      grid-template-columns: 1fr 1fr
    }

    .form-grid-3 {
      grid-template-columns: 1fr 1fr 1fr
    }

    textarea.fi {
      min-height: 78px;
      resize: vertical
    }

    .info-note {
      margin-top: 12px;
      background: #FFF7ED;
      border: 1px solid #FED7AA;
      border-radius: 10px;
      padding: 10px 12px;
      color: #92400E;
      font-size: 11px;
      display: flex;
      gap: 8px;
      line-height: 1.5;
    }

    #field-detail-card {
      display: none
    }

    .summary-head {
      padding: 14px 16px;
      border-bottom: 1px solid #F1F5F9;
    }

    .summary-body {
      padding: 14px 16px
    }

    .summary-empty {
      padding: 20px 10px;
      text-align: center;
      color: #94A3B8;
      font-size: 11px;
    }

    .summary-divider {
      height: 1px;
      background: #F1F5F9;
      margin: 12px 0
    }

    .summary-line {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 6px 0;
      font-size: 11px;
    }

    .summary-line-name {
      flex: 1;
      color: #334155
    }

    .summary-line-qty {
      color: #94A3B8
    }

    .summary-line-price {
      font-weight: 800;
      color: #0F172A
    }

    .summary-total-row {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 10px;
      padding-top: 5px;
    }

    .summary-total-label {
      font-size: 12px;
      font-weight: 800;
      color: #334155
    }

    .summary-total-price {
      font-size: 24px;
      font-weight: 900;
      color: #DC2626
    }

    .btn-submit {
      width: 100%;
      margin-top: 13px;
      border: 0;
      border-radius: 10px;
      padding: 12px 14px;
      background: var(--blue);
      color: #fff;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 6px 14px rgba(37, 99, 235, .18);
    }

    .btn-submit:disabled {
      opacity: .45;
      cursor: not-allowed;
      box-shadow: none
    }

    .trust-note {
      margin-top: 9px;
      text-align: center;
      color: #64748B;
      font-size: 10px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4px;
    }

    .field-detail-head {
      display: flex;
      align-items: center;
      gap: 7px;
      color: #fff;
      padding: 10px 14px;
      border-radius: 10px 10px 0 0;
      font-weight: 800
    }

    .field-detail-body {
      padding: 12px
    }

    .field-detail-empty {
      text-align: center;
      color: #94A3B8;
      font-size: 11px;
      padding: 20px
    }

    @media(max-width:1050px) {
      .checkout-layout {
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 16px
      }

      .product-item {
        grid-template-columns: 68px 26px minmax(0, 1fr) 105px;
        gap: 10px;
      }

      .product-thumb {
        width: 58px;
        height: 58px;
        min-width: 58px;
        min-height: 58px;
      }

      .price-wrap {
        min-width: 105px
      }
    }

    @media(max-width:900px) {
      .page-wrap {
        width: min(100% - 28px, 760px)
      }

      .field-showcase {
        grid-template-columns: 1fr;
        gap: 14px
      }

      .checkout-layout {
        grid-template-columns: 1fr;
        margin-top: 22px
      }

      .sidebar-sticky {
        position: static
      }

      .summary-card {
        order: -1
      }
    }

    @media(max-width:640px) {
      .price-normal {
        font-size: 20px;
        font-weight: 900
      }

      .page-wrap {
        width: calc(100% - 24px);
        padding: 24px 0 42px
      }

      .page-hero {
        padding: 82px 16px 30px;
      }

      .page-hero-title {
        font-size: clamp(24px, 7vw, 32px);
        line-height: 1.25;
      }

      .page-hero-sub {
        font-size: 13px;
        line-height: 1.55;
      }

      .section-heading {
        margin-bottom: 12px;
      }

      .section-heading-title {
        font-size: 19px;
        line-height: 1.3;
      }

      .section-heading-sub {
        font-size: 12px;
        line-height: 1.5;
      }

      .field-showcase {
        gap: 14px;
        margin-bottom: 24px;
      }

      .field-showcase-card {
        border-radius: 16px
      }

      .field-showcase-image {
        aspect-ratio: 16/9;
      }

      .field-showcase-body {
        padding: 15px;
      }

      .field-showcase-title {
        font-size: 18px;
        margin-bottom: 9px;
      }

      .field-spec-grid {
        gap: 9px 14px;
      }

      .field-select-hint {
        margin-top: 11px;
        padding-top: 10px;
      }

      .product-options-head {
        padding: 12px
      }

      .product-options-head-title {
        font-size: 16px
      }

      .product-item {
        min-height: 84px;
        grid-template-columns: 58px 22px minmax(0, 1fr) auto;
        gap: 8px;
        padding: 10px;
      }

      .product-thumb {
        width: 58px;
        height: 58px;
        min-width: 58px;
        min-height: 58px;
      }

      .price-wrap {
        min-width: 82px
      }

      .price-promo {
        font-size: 20px
      }

      .form-card {
        padding: 17px
      }

      .summary-body {
        padding: 14px
      }

      .form-grid-2,
      .form-grid-3 {
        grid-template-columns: 1fr
      }
    }

    .success-wrap {
      min-height: 100vh;
      padding: 116px 24px 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 18% 20%, rgba(34, 197, 94, .07), transparent 28%), radial-gradient(circle at 82% 80%, rgba(37, 99, 235, .06), transparent 30%), var(--bg);
    }

    .success-card {
      width: min(100%, 520px);
      padding: 38px 36px 34px;
      text-align: center;
      background: #fff;
      border: 1px solid #E2E8F0;
      border-radius: 20px;
      box-shadow: 0 18px 50px rgba(15, 23, 42, .10);
    }

    .success-card .btn-outline,
    .success-card .btn-solid {
      min-height: 44px;
      padding: 0 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border-radius: 10px;
      font-family: 'Sarabun', sans-serif;
      font-size: 14px;
      font-weight: 800;
      transition: all .2s ease;
    }

    .success-card .btn-outline {
      color: #2563EB;
      background: #fff;
      border: 1px solid #BFDBFE;
    }

    .success-card .btn-outline:hover {
      background: #EFF6FF;
      border-color: #93C5FD;
      transform: translateY(-1px);
    }

    .success-card .btn-solid {
      color: #fff;
      background: linear-gradient(135deg, #3478F6, #2563EB);
      border: 1px solid transparent;
      box-shadow: 0 6px 14px rgba(37, 99, 235, .18);
    }

    .success-card .btn-solid:hover {
      transform: translateY(-1px);
      box-shadow: 0 9px 20px rgba(37, 99, 235, .25);
    }

    @media(max-width:640px) {
      .success-wrap {
        padding: 92px 16px 32px;
      }

      .success-card {
        padding: 30px 20px 26px;
        border-radius: 18px;
      }
    }
  </style>
</head>

