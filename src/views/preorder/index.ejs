                      emoji: '🚀' , img: '/images/field-advance.png' , missions: 7, score: 125, age: 'อายุไม่เกิน 18 ปี'
                      } ]; var tierList=hasTiers ? tiers : []; function norm(v) { return String(v==null ? '' :
                      v).toLowerCase().trim(); } fields.forEach(function (f, i) { var tests=[ function (t) { return
                      norm(t.key)===f.key; }, function (t) { return norm(t.label)===f.key; }, function (t) { var
                      k=norm(t.key); return !!k && (f.key.indexOf(k)===0 || k.indexOf(f.key)===0); } ]; var idx=-1;
                      tests.forEach(function (test) { if (idx>= 0) return;
                      tierList.forEach(function (t, j) { if (idx < 0 && test(t)) idx=j; }); }); if (idx < 0 &&
