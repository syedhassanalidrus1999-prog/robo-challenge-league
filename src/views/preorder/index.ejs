                      </div>
                    </div>
                  </div>

                  <div class="section-heading">
                    <div>
                      <div class="section-heading-title">🛒 เลือกสินค้า Pre-order</div>
                      <div class="section-heading-sub">คลิกสนามด้านบนเพื่อเลือกสินค้าของรุ่นนั้น</div>
                    </div>
                  </div>

                  <div>
                    <% for (var ti=0; ti < tiers.length; ti++) { %>
                      <% var t=tiers[ti]; %>
                        <div class="product-options-wrap" id="options-<%= t.key %>">
                          <div class="product-options-head" style="background:<%= t.accent || t.color %>">
                            <div>
                              <div class="product-options-head-title">
                                <%= t.emoji %> เลือกสินค้า <%= t.label %>
                              </div>
                              <div class="product-options-head-sub">เลือกได้หลายรายการ และกำหนดจำนวนที่ต้องการ</div>
                            </div>
                            <button type="button" class="choose-field-btn" onclick="closeProductOptions(event)"
                              style="background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.25);color:#fff">
                              <i class="ti ti-x"></i> ปิด
                            </button>
                          </div>
                          <div class="product-options-body">
                            <div class="product-options-list">
                              <% for (var ii=0; ii < t.items.length; ii++) { %>
                                <% var item=t.items[ii]; %>
                                  <div class="product-item" id="item-<%= item.key %>"
                                    onclick="toggleItem('<%= item.key %>',this)">
                                    <div class="product-thumb"><img src="/images/product/product-<%= item.key %>.png"
                                        alt="<%= item.name %>" onerror="this.style.display='none'"></div>
                                    <div class="custom-checkbox" id="cb-<%= item.key %>"><i class="ti ti-check"></i>
                                    </div>
                                    <div class="product-content">
                                      <div class="product-item-name">
                                        <%= item.name %>
                                      </div>
                                      <div class="product-item-desc">
                                        <%= item.desc %>
                                      </div>
                                      <div class="qty-wrap" id="qty-wrap-<%= item.key %>" style="display:none">
                                        <span class="qty-label">จำนวน:</span>
                                        <div class="qty-control">
                                          <button type="button" class="qty-btn"
                                            onclick="changeQty('<%= item.key %>',-1,event)">−</button>
                                          <input class="qty-num" type="number" id="qty-<%= item.key %>" value="1"
                                            min="1" max="99" oninput="updateSummary()">
                                          <button type="button" class="qty-btn"
                                            onclick="changeQty('<%= item.key %>',1,event)">+</button>
                                        </div>
                                      </div>
                                    </div>
                                    <div class="price-wrap">
                                      <% if (promoActive && item.hasDiscount) { %>
                                        <div class="price-discount-badge">-<%= item.discountPct %>%</div>
                                        <div class="price-original">
                                          ฿<%= item.priceFormatted %>
                                        </div>
                                        <div class="price-promo">
                                          ฿<%= item.promoPriceFormatted %> 
                                        </div>
                                        <% } else { %>
                                          <div class="price-normal" style="color:<%= t.accent %>">
                                            ฿<%= item.priceFormatted %>.- 
                                          </div>
                                          <% } %>
                                    </div>
                                  </div>
                                  <% } %>
                            </div>
                          </div>
                        </div>
                        <% } %>

                          <div class="checkout-layout">
                            <div class="checkout-main">
                              <div class="form-card">
                                <div class="form-card-title"><i class="ti ti-school"></i> ข้อมูลผู้สั่งซื้อ</div>
                                <div class="fg">
                                  <div class="fl">ชื่อโรงเรียน / สถาบัน *</div>
                                  <input class="fi" name="school_name" placeholder="ชื่อโรงเรียนหรือสถาบัน" required
                                    value="<%= formData.school_name || '' %>">
                                </div>
                                <div class="form-grid-2">
                                  <div class="fg" style="margin-bottom:0">
                                    <div class="fl">ชื่อผู้ติดต่อ *</div>
                                    <input class="fi" name="contact_name" placeholder="ชื่อ-นามสกุล" required
                                      value="<%= formData.contact_name || '' %>">
                                  </div>
                                  <div class="fg" style="margin-bottom:0">
                                    <div class="fl">เบอร์โทรศัพท์ *</div>
                                    <input class="fi" name="phone" type="tel" placeholder="0XX-XXX-XXXX" required
                                      value="<%= formData.phone || '' %>">
                                  </div>
                                </div>
                                <div class="fg" style="margin-top:12px">
                                  <div class="fl">อีเมล (ไม่บังคับ)</div>
                                  <input class="fi" name="email" type="email" placeholder="email@example.com"
                                    value="<%= formData.email || '' %>">
                                </div>

                                <!-- วิธีรับสินค้า — เลือกก่อนกรอกที่อยู่ -->
                                <div class="fg" style="margin-top:4px">
                                  <div class="fl">วิธีรับสินค้า *</div>
                                  <div style="display:flex;flex-direction:column;gap:8px;margin-top:4px">
                                    <label
                                      style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:10px 14px;border:1.5px solid var(--line);border-radius:9px;background:#fff">
                                      <input type="radio" name="shipping_method" value="pickup" required
                                        onchange="updateShipping(this.value)">
                                      <span><b style="font-size:13px">มารับเอง</b><span
                                          style="font-size:12px;color:#16A34A;font-weight:700;margin-left:6px">ฟรี</span></span>
                                    </label>
                                    <label
                                      style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:10px 14px;border:1.5px solid var(--line);border-radius:9px;background:#fff">
                                      <input type="radio" name="shipping_method" value="delivery"
                                        onchange="updateShipping(this.value)">
                                      <span><b style="font-size:13px">จัดส่ง</b><span
                                          style="font-size:12px;color:#EA580C;font-weight:700;margin-left:6px">+100
                                          บาท</span></span>
                                    </label>
                                  </div>
                                </div>

                                <!-- ที่อยู่จัดส่ง — แสดงเฉพาะเมื่อเลือก "จัดส่ง" -->
                                <div id="address-section"
                                  style="display:<%= formData.shipping_method === 'delivery' ? 'block' : 'none' %>">
                                  <div class="fg" style="margin-top:12px">
                                    <div class="fl">ที่อยู่สำหรับจัดส่ง *</div>
                                    <input class="fi" name="address" id="address-input"
                                      placeholder="ที่อยู่ เลขที่ ซอย ถนน ตำบล/แขวง"
                                      value="<%= formData.address || '' %>">
                                  </div>
                                  <div class="form-grid-3">
                                    <div class="fg" style="margin-bottom:0">
                                      <div class="fl">อำเภอ / เขต</div>
                                      <input class="fi" name="district" placeholder="อำเภอ / เขต"
                                        value="<%= formData.district || '' %>">
                                    </div>
                                    <div class="fg" style="margin-bottom:0">
                                      <div class="fl">จังหวัด</div>
                                      <input class="fi" name="province" placeholder="จังหวัด"
                                        value="<%= formData.province || '' %>">
                                    </div>
                                    <div class="fg" style="margin-bottom:0">
                                      <div class="fl">รหัสไปรษณีย์</div>
                                      <input class="fi" name="zipcode" placeholder="XXXXX"
                                        value="<%= formData.zipcode || '' %>">
                                    </div>
                                  </div>
                                </div>

                                <div class="fg" style="margin-top:12px">
                                  <div class="fl">หมายเหตุ (ไม่บังคับ)</div>
                                  <textarea class="fi" name="note" placeholder="ข้อมูลเพิ่มเติม"
                                    style="min-height:70px;resize:vertical"><%= formData.note || '' %></textarea>
                                </div>
                              </div>
                              <div class="info-note">
                                <i class="ti ti-info-circle" style="flex-shrink:0;margin-top:1px"></i>
                                <span>กรุณาตรวจสอบข้อมูลให้ถูกต้องก่อนยืนยัน
                                  ทีมงานจะติดต่อกลับเพื่อยืนยันและแจ้งรายละเอียดการชำระเงิน</span>
                              </div>
                            </div>

                            <div class="sidebar-sticky">
                              <div class="field-detail-card" id="field-detail-card">
                                <div class="field-detail-head" id="field-detail-head" style="background:#64748B"><i
                                    class="ti ti-map"></i><span id="field-detail-title">รายละเอียดสนาม</span></div>
                                <div id="field-detail-body">
                                  <div class="field-detail-empty"><i class="ti ti-hand-click"></i> คลิก
                                    "ดูรายละเอียดสนาม"<br>เพื่อแสดงข้อมูลสนาม</div>
                                </div>
                              </div>
                              <div class="summary-card">
                                <div class="summary-head"><i class="ti ti-clipboard-list"></i> สรุปคำสั่งซื้อ</div>
                                <div class="summary-body">
                                  <% if (promoActive) { %>
                                    <div
                                      style="background:#FEF2F2;border:1px solid #FECDD3;border-radius:8px;padding:8px 12px;margin-bottom:12px;font-size:12px;color:#DC2626;font-weight:700;display:flex;align-items:center;gap:6px">
                                      <i class="ti ti-tag"></i> โปรโมชั่น ลดสูงสุด <%= maxDiscount %>%
                                    </div>
                                    <% } %>
                                      <div id="summary-items">
                                        <div class="summary-empty"><i
                                            class="ti ti-shopping-cart"></i>เลือกสินค้าเพื่อดูสรุป</div>
                                      </div>
                                      <div class="summary-divider"></div>
                                      <% if (promoActive) { %>
                                        <div
                                          style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
                                          <span style="color:#64748B">ราคาก่อนลด</span><span
                                            style="color:#94A3B8;text-decoration:line-through"
                                            id="summary-original">฿0</span>
                                        </div>
                                        <div
                                          style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:8px">
                                          <span style="color:#DC2626;font-weight:700">ส่วนลดรวม</span><span
                                            style="color:#DC2626;font-weight:700" id="summary-discount">-฿0</span>
                                        </div>
                                        <% } %>
                                          <div
                                            style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:8px">
                                            <span style="color:#64748B">ค่าจัดส่ง</span><span style="font-weight:700"
                                              id="summary-shipping">ฟรี</span>
                                          </div>
                                          <div class="summary-total-row">
                                            <span class="summary-total-label">ยอดรวมทั้งสิ้น</span><span
                                              class="summary-total-price" id="summary-total">฿0</span>
                                          </div>
                                          <button type="submit" class="btn-submit" id="submitBtn" disabled>
                                            <i class="ti ti-shopping-bag"></i> ยืนยันการสั่งซื้อ (Pre-order)
                                          </button>
                                          <div class="trust-note"><i class="ti ti-shield-check"></i>
                                            ข้อมูลของท่านปลอดภัย 100%</div>
                                </div>
                              </div>
                            </div>
                          </div>
                  </div>
                </div>
              </form>

              <% } %>

                <script>
                  var PROMO_ACTIVE = <%= promoActive ? 'true' : 'false' %>;
                  var PRICES_ORIGINAL = {};
                  var PRICES_FINAL = {};
    <% for (var ti = 0; ti < tiers.length; ti++) { %>
      <% for (var ii = 0; ii < tiers[ti].items.length; ii++) { %>
        <% var _item = tiers[ti].items[ii]; %>
                        PRICES_ORIGINAL['<%= _item.key %>'] = <%= _item.price %>;
                      PRICES_FINAL['<%= _item.key %>'] = <%= _item.promoPrice %>;
      <% } %>
    <% } %>
    var NAMES = {};
    <% for (var ti = 0; ti < tiers.length; ti++) { %>
      <% for (var ii = 0; ii < tiers[ti].items.length; ii++) { %>
        <% var _item = tiers[ti].items[ii]; %>
                        NAMES['<%= _item.key %>'] = '<%= _item.name %>';
      <% } %>
    <% } %>
    var CB_COLORS = {
                    'beginner-full': '#16A34A', 'beginner-mat': '#16A34A', 'beginner-field': '#7C3AED', 'beginner-mission': '#EA580C',
                    'intermediate-full': '#2563EB', 'intermediate-mat': '#2563EB', 'intermediate-field': '#7C3AED', 'intermediate-mission': '#EA580C',
                    'advance-full': '#EA580C', 'advance-mat': '#EA580C', 'advance-field': '#7C3AED', 'advance-mission': '#EA580C'
                  };
                  var checkedItems = {};
                  var activeFieldKey = null;
                  var SHIPPING_FEE = 0;

                  function updateShipping(val) {
                    SHIPPING_FEE = val === 'delivery' ? 100 : 0;
                    var section = document.getElementById('address-section');
                    var addressInput = document.getElementById('address-input');
                    if (section) {
                      section.style.display = val === 'delivery' ? 'block' : 'none';
                      if (addressInput) addressInput.required = val === 'delivery';
                    }
                    updateSummary();
                  }

                  function openProductOptions(tier, card) {
                    document.querySelectorAll('.field-showcase-card').forEach(function (c) { c.classList.remove('active'); c.style.removeProperty('--field-color'); });
                    document.querySelectorAll('.product-options-wrap').forEach(function (o) { o.classList.remove('active'); });
                    var target = document.getElementById('options-' + tier); if (!target) return;
                    var colorMap = { beginner: '#16A34A', intermediate: '#2563EB', advance: '#EA580C' };
                    if (card) { card.classList.add('active'); card.style.setProperty('--field-color', colorMap[tier] || '#2563EB'); }
                    target.classList.add('active'); activeFieldKey = tier;
                    setTimeout(function () { target.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 30);
                  }
                  function closeProductOptions(e) {
                    if (e) e.stopPropagation();
                    document.querySelectorAll('.field-showcase-card').forEach(function (c) { c.classList.remove('active'); c.style.removeProperty('--field-color'); });
                    document.querySelectorAll('.product-options-wrap').forEach(function (o) { o.classList.remove('active'); });
                    activeFieldKey = null;
                  }
                  function toggleItem(id, el) {
                    if (event && event.target.closest && event.target.closest('.qty-control')) return;
                    var isChecked = checkedItems[id]; var cb = document.getElementById('cb-' + id); var qtyWrap = document.getElementById('qty-wrap-' + id);
                    if (isChecked) { delete checkedItems[id]; el.style.borderColor = '#E2E8F0'; el.classList.remove('is-selected'); cb.style.background = '#fff'; cb.style.borderColor = '#CBD5E1'; cb.querySelector('i').style.opacity = '0'; qtyWrap.style.display = 'none'; }
                    else { checkedItems[id] = 1; var color = CB_COLORS[id] || '#2563EB'; el.style.borderColor = color; el.classList.add('is-selected'); cb.style.background = color; cb.style.borderColor = color; cb.querySelector('i').style.opacity = '1'; qtyWrap.style.display = 'flex'; }
                    updateSummary();
                  }
                  function changeQty(id, delta, e) {
                    if (e) e.stopPropagation();
                    var input = document.getElementById('qty-' + id);
                    var val = Math.max(1, Math.min(99, (parseInt(input.value) || 1) + delta));
                    input.value = val; if (checkedItems[id]) checkedItems[id] = val; updateSummary();
                  }
                  function updateSummary() {
                    Object.keys(checkedItems).forEach(function (id) { var input = document.getElementById('qty-' + id); if (input) checkedItems[id] = parseInt(input.value) || 1; });
                    var keys = Object.keys(checkedItems);
                    if (keys.length === 0) {
                      document.getElementById('summary-items').innerHTML = '<div class="summary-empty"><i class="ti ti-shopping-cart"></i>เลือกสินค้าเพื่อดูสรุป</div>';
                      document.getElementById('summary-total').textContent = '฿0';
                      if (document.getElementById('summary-original')) document.getElementById('summary-original').textContent = '฿0';
                      if (document.getElementById('summary-discount')) document.getElementById('summary-discount').textContent = '-฿0';
                      document.getElementById('submitBtn').disabled = true; document.getElementById('items_json').value = ''; return;
                    }
                    var totalOriginal = 0, totalFinal = 0, html = '';
                    keys.forEach(function (id) {
                      var qty = checkedItems[id]; var origPrice = PRICES_ORIGINAL[id] || 0; var finalPrice = PROMO_ACTIVE ? (PRICES_FINAL[id] || 0) : origPrice;
                      totalOriginal += origPrice * qty; totalFinal += finalPrice * qty;
                      html += '<div class="summary-line"><div><div class="summary-line-name">' + (NAMES[id] || id) + '</div><div class="summary-line-qty">' + qty + ' ชุด x ' + finalPrice.toLocaleString() + ' บาท</div></div><div class="summary-line-price">฿' + (finalPrice * qty).toLocaleString() + '</div></div>';
                    });
                    document.getElementById('summary-items').innerHTML = html;
                    var grandTotal = totalFinal + SHIPPING_FEE;
                    document.getElementById('summary-total').textContent = '฿' + grandTotal.toLocaleString();
                    if (document.getElementById('summary-shipping')) document.getElementById('summary-shipping').textContent = SHIPPING_FEE > 0 ? '+' + '฿' + SHIPPING_FEE.toLocaleString() : 'ฟรี';
                    if (document.getElementById('summary-original')) document.getElementById('summary-original').textContent = '฿' + totalOriginal.toLocaleString();
                    if (document.getElementById('summary-discount')) document.getElementById('summary-discount').textContent = '-' + '฿' + (totalOriginal - totalFinal).toLocaleString();
                    document.getElementById('submitBtn').disabled = false;
                    document.getElementById('items_json').value = JSON.stringify(checkedItems);
                  }
                  document.getElementById('preorderForm') && document.getElementById('preorderForm').addEventListener('submit', function (e) {
                    if (Object.keys(checkedItems).length === 0) { e.preventDefault(); alert('กรุณาเลือกสินค้าอย่างน้อย 1 รายการ'); return; }
                    var shipping = document.querySelector('input[name="shipping_method"]:checked');
                    if (!shipping) { e.preventDefault(); alert('กรุณาเลือกวิธีรับสินค้า'); return; }
                    if (shipping.value === 'delivery') { var addr = document.getElementById('address-input'); if (addr && !addr.value.trim()) { e.preventDefault(); alert('กรุณากรอกที่อยู่สำหรับจัดส่ง'); return; } }
                  });

                  // restore state on page load (form error case)
                  (function () {
                    var checked = document.querySelector('input[name="shipping_method"]:checked');
                    if (checked) updateShipping(checked.value);
                  })();
                </script>

                <script>
                  (function () {
                    var dropdowns = document.querySelectorAll('.dropdown');
                    for (var i = 0; i < dropdowns.length; i++) {
                      (function (dd) {
                        var menu = dd.querySelector('.dropdown-menu'), trigger = dd.querySelector('.nav-link'), timer;
                        if (!menu || !trigger) return;
                        trigger.addEventListener('click', function (e) { if (window.innerWidth <= 640) { e.preventDefault(); e.stopPropagation(); return } e.preventDefault(); menu.style.display = menu.style.display === 'block' ? 'none' : 'block'; });
                        dd.addEventListener('mouseenter', function () { if (window.innerWidth > 640) { clearTimeout(timer); menu.style.display = 'block'; } });
                        dd.addEventListener('mouseleave', function () { if (window.innerWidth > 640) { timer = setTimeout(function () { menu.style.display = 'none'; }, 200); } });
                      })(dropdowns[i]);
                    }
                  })();
                  (function () {
                    var toggle = document.querySelector('.mobile-menu-toggle'), menu = document.getElementById('mobileMenu'), competition = document.querySelector('.mobile-competition-toggle'), submenu = document.querySelector('.mobile-submenu');
                    if (!toggle || !menu) return;
                    function setOpen(open) { menu.classList.toggle('is-open', open); toggle.classList.toggle('is-open', open); toggle.setAttribute('aria-expanded', open ? 'true' : 'false'); toggle.setAttribute('aria-label', open ? 'ปิดเมนู' : 'เปิดเมนู'); toggle.innerHTML = open ? '<i class="ti ti-x"></i>' : '<i class="ti ti-menu-2"></i>'; if (!open) { if (competition) { competition.classList.remove('is-open'); competition.setAttribute('aria-expanded', 'false'); } if (submenu) submenu.classList.remove('is-open'); } }
                    toggle.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); setOpen(!menu.classList.contains('is-open')); }, true);
                    var links = menu.querySelectorAll('a'); for (var j = 0; j < links.length; j++)links[j].addEventListener('click', function () { setOpen(false); });
                    document.addEventListener('click', function (e) { if (window.innerWidth <= 640 && menu.classList.contains('is-open') && !menu.contains(e.target) && !toggle.contains(e.target)) setOpen(false); });
                    window.addEventListener('resize', function () { if (window.innerWidth > 640) setOpen(false); });
                  })();
                  window.addEventListener('scroll', function () { var topbar = document.querySelector('.topbar'); if (window.scrollY > 10) { topbar.classList.add('scrolled'); } else { topbar.classList.remove('scrolled'); } });
                </script>
</body>

</html>