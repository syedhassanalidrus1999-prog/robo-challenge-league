            <script>
              /* ================= PRE-ORDER ================= */
              (function () {
                var form = document.getElementById('preorderForm');
                if (!form) return;

                var PROMO_ACTIVE = form.dataset.promoActive === '1';
                var PRODUCTS = {};
                document.querySelectorAll('.product-item[data-key]').forEach(function (el) {
                  var price = Number(el.dataset.price) || 0;
                  var promo = Number(el.dataset.promoPrice);
                  PRODUCTS[el.dataset.key] = {
                    name: el.dataset.name || el.dataset.key,
                    price: price,
                    promoPrice: isNaN(promo) ? price : promo
                  };
                });
                var CB_COLORS = {
                  'beginner-field': '#7C3AED', 'intermediate-field': '#7C3AED', 'advance-field': '#7C3AED',
                  'beginner-mission': '#EA580C', 'intermediate-mission': '#EA580C', 'advance-mission': '#EA580C'
                };
                var SHIPPING_DELIVERY = 100;

                var checkedItems = {};
                var shippingFee = 0;

                var emptyHint = document.getElementById('product-options-empty');
                var fieldCards = Array.prototype.slice.call(document.querySelectorAll('.field-showcase-card'));
                var optionWraps = Array.prototype.slice.call(document.querySelectorAll('.product-options-wrap'));
                var emptyDefault = emptyHint ? emptyHint.innerHTML : '';

                function money(n) {
                  return '฿' + Number(n).toLocaleString();
                }

                /* ---------- Field cards → product options ---------- */
                function closeOptions() {
                  fieldCards.forEach(function (c) { c.classList.remove('active'); c.setAttribute('aria-expanded', 'false'); });
                  optionWraps.forEach(function (o) { o.classList.remove('active'); });
                  if (emptyHint) {
                    emptyHint.innerHTML = emptyDefault;
                    emptyHint.classList.remove('is-hidden');
                  }
                }

                function openOptions(card) {
                  var target = card.dataset.target ? document.getElementById(card.dataset.target) : null;
                  closeOptions();
                  if (!target) {
                    if (emptyHint) {
                      emptyHint.innerHTML = '<i class="ti ti-package-off"></i> ยังไม่มีสินค้าสำหรับสนามนี้';
                      emptyHint.classList.remove('is-hidden');
                    }
                    return;
                  }
                  card.classList.add('active');
                  card.setAttribute('aria-expanded', 'true');
                  target.classList.add('active');
                  if (emptyHint) emptyHint.classList.add('is-hidden');
                  setTimeout(function () { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 30);
                }

                fieldCards.forEach(function (card) {
                  card.addEventListener('click', function () {
                    if (card.classList.contains('active')) return closeOptions();
                    openOptions(card);
                  });
                  card.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
                  });
                });

                document.querySelectorAll('[data-close-options]').forEach(function (btn) {
                  btn.addEventListener('click', function (e) { e.stopPropagation(); closeOptions(); });
                });

                /* ---------- Product items ---------- */
                function qtyInput(key) {
                  return document.getElementById('qty-' + key);
                }

                function readQty(key) {
                  var input = qtyInput(key);
                  var v = Math.max(1, Math.min(99, parseInt(input && input.value, 10) || 1));
                  return v;
                }

                function toggleItem(el) {
                  if (el.classList.contains('is-soldout')) return;
                  var key = el.dataset.key;

                  if (checkedItems[key]) {
                    delete checkedItems[key];
                    el.classList.remove('is-selected');
                    el.setAttribute('aria-checked', 'false');
                  } else {
                    checkedItems[key] = readQty(key);
                    el.style.setProperty('--sel', CB_COLORS[key] || el.dataset.color || '#2563EB');
                    el.classList.add('is-selected');
                    el.setAttribute('aria-checked', 'true');
                  }
                  updateSummary();
                }

                document.querySelectorAll('.product-item').forEach(function (el) {
                  el.addEventListener('click', function (e) {
                    if (e.target.closest('.qty-control')) return;
                    toggleItem(el);
                  });
                  el.addEventListener('keydown', function (e) {
                    if (e.target !== el) return;
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleItem(el); }
                  });

                  el.querySelectorAll('[data-qty]').forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                      e.stopPropagation();
                      var key = el.dataset.key;
                      var input = qtyInput(key);
                      input.value = Math.max(1, Math.min(99, readQty(key) + Number(btn.dataset.qty)));
                      if (checkedItems[key]) checkedItems[key] = readQty(key);
                      updateSummary();
                    });
                  });

                  var input = qtyInput(el.dataset.key);
                  if (input) {
                    input.addEventListener('input', function () {
                      if (checkedItems[el.dataset.key]) checkedItems[el.dataset.key] = readQty(el.dataset.key);
                      updateSummary();
                    });
                    input.addEventListener('blur', function () { input.value = readQty(el.dataset.key); });
                  }
                });

                /* ---------- Summary ---------- */
                function setText(id, text) {
                  var el = document.getElementById(id);
                  if (el) el.textContent = text;
                }

                function updateSummary() {
                  var keys = Object.keys(checkedItems);
                  var itemsEl = document.getElementById('summary-items');
                  var submitBtn = document.getElementById('submitBtn');
                  var itemsJson = document.getElementById('items_json');

                  setText('summary-shipping', shippingFee > 0 ? '+' + money(shippingFee) : 'ฟรี');

                  if (keys.length === 0) {
                    itemsEl.innerHTML = '<div class="summary-empty"><i class="ti ti-shopping-cart"></i>เลือกสินค้าเพื่อดูสรุป</div>';
                    setText('summary-total', money(0));
                    setText('summary-original', money(0));
                    setText('summary-discount', '-' + money(0));
                    submitBtn.disabled = true;
                    itemsJson.value = '';
                    return;
                  }

                  var totalOriginal = 0, totalFinal = 0;
                  itemsEl.innerHTML = '';

                  keys.forEach(function (key) {
                    var qty = checkedItems[key];
                    var p = PRODUCTS[key] || { name: key, price: 0, promoPrice: 0 };
                    var finalPrice = PROMO_ACTIVE ? p.promoPrice : p.price;
                    totalOriginal += p.price * qty;
                    totalFinal += finalPrice * qty;

                    var line = document.createElement('div');
                    line.className = 'summary-line';
                    line.innerHTML = '<div><div class="summary-line-name"></div><div class="summary-line-qty"></div></div><div class="summary-line-price"></div>';
                    line.querySelector('.summary-line-name').textContent = p.name;
                    line.querySelector('.summary-line-qty').textContent = qty + ' ชุด × ' + finalPrice.toLocaleString() + ' บาท';
                    line.querySelector('.summary-line-price').textContent = money(finalPrice * qty);
                    itemsEl.appendChild(line);
                  });

                  setText('summary-total', money(totalFinal + shippingFee));
                  setText('summary-original', money(totalOriginal));
                  setText('summary-discount', '-' + money(totalOriginal - totalFinal));
                  submitBtn.disabled = false;
                  itemsJson.value = JSON.stringify(checkedItems);
                }

                /* ---------- Shipping / receipt ---------- */
                function updateShipping(val) {
                  var isDelivery = val === 'delivery';
                  shippingFee = isDelivery ? SHIPPING_DELIVERY : 0;
                  document.getElementById('address-section').classList.toggle('is-open', isDelivery);
                  document.getElementById('address-input').required = isDelivery;
                  updateSummary();
                }

                function updateReceipt(val) {
                  var wants = val === 'yes';
                  document.getElementById('receipt-section').classList.toggle('is-open', wants);
                  document.getElementById('receipt_name').required = wants;
                  document.getElementById('receipt_address').required = wants;
                }

                document.querySelectorAll('input[name="shipping_method"]').forEach(function (r) {
                  r.addEventListener('change', function () { updateShipping(r.value); });
                });
                document.querySelectorAll('input[name="receipt"]').forEach(function (r) {
                  r.addEventListener('change', function () { updateReceipt(r.value); });
                });

                /* ---------- Submit guard ---------- */
                form.addEventListener('submit', function (e) {
                  if (Object.keys(checkedItems).length === 0) {
                    e.preventDefault();
                    alert('กรุณาเลือกสินค้าอย่างน้อย 1 รายการ');
                    return;
                  }
                  var shipping = document.querySelector('input[name="shipping_method"]:checked');
                  if (!shipping) {
                    e.preventDefault();
                    alert('กรุณาเลือกวิธีรับสินค้า');
                    return;
                  }
                  if (shipping.value === 'delivery' && !document.getElementById('address-input').value.trim()) {
                    e.preventDefault();
                    alert('กรุณากรอกที่อยู่สำหรับจัดส่ง');
                  }
                });

                /* ---------- Restore state after a server-side error ---------- */
                var s = document.querySelector('input[name="shipping_method"]:checked');
                if (s) updateShipping(s.value);
                var r = document.querySelector('input[name="receipt"]:checked');
                if (r) updateReceipt(r.value);
                updateSummary();
              })();
            </script>

            <% } %>

              <script>
                /* Mobile / tablet hamburger menu */
                (function () {
                  var toggle = document.querySelector('.mobile-menu-toggle');
                  var mobileMenu = document.querySelector('.mobile-menu');
                  var competitionToggle = document.querySelector('.mobile-menu-competition-toggle');
                  var subMenu = document.querySelector('.mobile-submenu');
                  if (!toggle || !mobileMenu) return;

                  function closeMobileMenu() {
                    toggle.classList.remove('is-open');
                    toggle.setAttribute('aria-expanded', 'false');
                    toggle.setAttribute('aria-label', 'เปิดเมนู');
                    mobileMenu.classList.remove('is-open');
                    mobileMenu.setAttribute('aria-hidden', 'true');
                  }

                  toggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var isOpen = mobileMenu.classList.toggle('is-open');
                    toggle.classList.toggle('is-open', isOpen);
                    toggle.setAttribute('aria-expanded', String(isOpen));
                    toggle.setAttribute('aria-label', isOpen ? 'ปิดเมนู' : 'เปิดเมนู');
                    mobileMenu.setAttribute('aria-hidden', String(!isOpen));
                  });

                  if (competitionToggle && subMenu) {
                    competitionToggle.addEventListener('click', function () {
                      var isOpen = subMenu.classList.toggle('is-open');
                      competitionToggle.classList.toggle('is-open', isOpen);
                      competitionToggle.setAttribute('aria-expanded', String(isOpen));
                    });
                  }

                  mobileMenu.querySelectorAll('a').forEach(function (link) {
                    link.addEventListener('click', closeMobileMenu);
                  });

                  document.addEventListener('click', function (e) {
                    if (!mobileMenu.contains(e.target) && !toggle.contains(e.target)) closeMobileMenu();
                  });

                  document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') closeMobileMenu();
                  });

                  window.addEventListener('resize', function () {
                    if (window.innerWidth > 1100) closeMobileMenu();
                  });
                })();

                /* Desktop dropdown (hover with small delay, click also works) */
                document.querySelectorAll('.dropdown').forEach(function (dd) {
                  var menu = dd.querySelector('.dropdown-menu');
                  var btn = dd.querySelector('button');
                  var timer;

                  function show() { clearTimeout(timer); menu.style.display = 'block'; }
                  function hideSoon() { timer = setTimeout(function () { menu.style.display = 'none'; }, 200); }

                  dd.addEventListener('mouseenter', show);
                  dd.addEventListener('mouseleave', hideSoon);
                  btn.addEventListener('click', function () {
                    menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
                  });
                });
              </script>

  </body>

  </html>