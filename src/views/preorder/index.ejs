                    { label: 'ระดับ', value: 'Advance' },
                    { label: 'ขนาดสนาม', value: '236 × 114 ซม.' },
                    { label: 'วัสดุ', value: 'PPคุณภาพสูง กันน้ำ' },
                    { label: 'การใช้งาน', value: 'ใช้ซ้ำได้ / พับเก็บง่าย' },
                    { label: 'ภารกิจ', value: '5 ภารกิจ' },
                    { label: 'คะแนนสูงสุด', value: '100 คะแนน' },
                    { label: 'เหมาะสำหรับ', value: 'ระดับสูง อายุ 12 ปีขึ้นไป' }
                  ]
                }
              }

              var checkedItems = {}

              function showDetail(tier, e) {
                if (e) e.stopPropagation()
                var overview = document.getElementById('field-overview-' + tier)
                if (!overview) return

                document.querySelectorAll('.field-overview.is-focused').forEach(function (el) {
                  el.classList.remove('is-focused')
                })
                overview.classList.add('is-focused')

                overview.scrollIntoView({
                  behavior: 'smooth',
                  block: window.innerWidth < 900 ? 'start' : 'nearest'
                })

                setTimeout(function () {
                  overview.classList.remove('is-focused')
                }, 1200)
              }
              function toggleItem(id, el) {
                if (event && event.target.closest && event.target.closest('.qty-control')) return
                if (event && event.target.closest && event.target.closest('.detail-btn')) return
                var isChecked = checkedItems[id]
                var cb = document.getElementById('cb-' + id)
                var qtyWrap = document.getElementById('qty-wrap-' + id)
                if (isChecked) {
                  delete checkedItems[id]
                  el.classList.remove('is-selected')
                  el.style.borderColor = '#E2E8F0'
                  cb.style.background = '#fff'
                  cb.style.borderColor = '#CBD5E1'
                  cb.querySelector('i').style.opacity = '0'
                  qtyWrap.style.display = 'none'
                } else {
                  checkedItems[id] = 1
                  el.classList.add('is-selected')
                  var color = CB_COLORS[id]
                  el.style.borderColor = color
                  el.style.setProperty('--selected-color', color)
                  cb.style.background = color
                  cb.style.borderColor = color
                  cb.querySelector('i').style.opacity = '1'
                  qtyWrap.style.display = 'flex'
                }
                updateSummary()
              }

              function changeQty(id, delta, e) {
                if (e) e.stopPropagation()
                var input = document.getElementById('qty-' + id)
                var val = Math.max(1, Math.min(99, (parseInt(input.value) || 1) + delta))
                input.value = val
                if (checkedItems[id]) checkedItems[id] = val
                updateSummary()
              }

              function updateSummary() {
                Object.keys(checkedItems).forEach(function (id) {
                  var input = document.getElementById('qty-' + id)
                  if (input) checkedItems[id] = parseInt(input.value) || 1
                })
                var keys = Object.keys(checkedItems)
                if (keys.length === 0) {
                  document.getElementById('summary-items').innerHTML = '<div class="summary-empty"><i class="ti ti-shopping-cart"></i>เลือกสินค้าเพื่อดูสรุป</div>'
                  document.getElementById('summary-total').textContent = '0.-'
                  document.getElementById('submitBtn').disabled = true
                  document.getElementById('items_json').value = ''
                  return
                }
                var total = 0
                var html = ''
                keys.forEach(function (id) {
                  var qty = checkedItems[id]
                  var price = PRICES[id] * qty
                  total += price
                  html += '<div class="summary-line"><div><div class="summary-line-name">' + NAMES[id] + '</div>'
                    + '<div class="summary-line-qty">' + qty + ' ชุด × ' + PRICES[id].toLocaleString() + ' บาท</div></div>'
                    + '<div class="summary-line-price">' + price.toLocaleString() + '.-</div></div>'
                })
                document.getElementById('summary-items').innerHTML = html
                document.getElementById('summary-total').textContent = total.toLocaleString() + '.-'
                document.getElementById('submitBtn').disabled = false
                document.getElementById('items_json').value = JSON.stringify(checkedItems)
              }

              document.getElementById('preorderForm') && document.getElementById('preorderForm').addEventListener('submit', function (e) {
                if (Object.keys(checkedItems).length === 0) {
                  e.preventDefault()
                  alert('กรุณาเลือกสินค้าอย่างน้อย 1 รายการ')
                }
              })
            </script>
</body>

</html>