<% var hasTiers=typeof tiers !=='undefined' && Array.isArray(tiers); var fd=typeof formData !=='undefined' && formData ?
  formData : {}; %>
  <!DOCTYPE html>
  <html lang="th">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pre-order สนามแข่งขัน — RCL 2026</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800;900&family=Sarabun:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
    <style>
      /* =========================================================
       RCL 2026 — PRE-ORDER PAGE
       01 Tokens / Reset
       02 Topbar + Dropdown   (same as every page)
       03 Mobile menu         (same as every page)
       04 Hero / promo / alert
       05 Section heading + field showcase
       06 Product options
       07 Checkout form
       08 Summary
       09 Success state
       10 Responsive
    ========================================================= */

      /* 01 — TOKENS / RESET */
      :root {
        --primary: #2563EB;
        --primary-soft: #EFF6FF;
        --blue: #2563EB;
        --blue-soft: #EFF6FF;
        --green: #16A34A;
        --orange: #EA580C;
        --red: #DC2626;
        --bg: #F5F7FB;
        --surface: #FFFFFF;
        --text: #0F172A;
        --muted: #64748B;
        --line: #E2E8F0;
        --shadow: 0 8px 24px rgba(15, 23, 42, .06);
        --content: 1180px;
        --gutter: 24px;
        --topbar-h: 82px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        min-width: 320px;
        min-height: 100vh;
        overflow-x: hidden;
        color: var(--text);
        background: var(--bg);
        font-family: 'Kanit', 'Sarabun', sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input,
      textarea {
        font: inherit;
      }

      :focus-visible {
        outline: 3px solid #93C5FD;
        outline-offset: 2px;
      }

      /* 02 — TOPBAR + DROPDOWN (solid on this page — no hero behind it) */
      .topbar {
        position: fixed;
        inset: 0 0 auto;
        z-index: 1000;
        height: var(--topbar-h);
        padding: 0 30px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, .92);
        border-bottom: 1px solid rgba(226, 232, 240, .9);
        box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
      }

      .topbar-logo {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
      }

      .topbar-logo img {
        display: block;
        width: auto;
        height: 58px;
        max-width: 150px;
        object-fit: contain;
      }

      .topbar-nav {
        flex: 1 1 auto;
        min-width: 0;
        margin-left: 18px;
        display: flex;
        align-items: center;
        gap: 2px;
      }

      .nav-link {
        min-height: 52px;
        padding: 0 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        border: 0;
        border-radius: 11px;
        background: transparent;
        color: #334155;
        font-family: 'Kanit', sans-serif;
        font-weight: 700;
        letter-spacing: 1px;
        line-height: 1.15;
        white-space: nowrap;
        cursor: pointer;
        transition: color .2s ease, transform .2s ease;
      }

      .nav-link span:first-child {
        font-size: 17px;
        font-weight: 800;
      }

      .nav-link span:last-child {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 1px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .2px;
      }

      .nav-link:hover,
      .nav-link.active {
        color: var(--primary);
        transform: translateY(-1px);
      }

      .certificate-btn {
        min-width: 150px;
        padding: 8px 16px;
        border: 1px solid #F6D365;
        border-radius: 999px;
        background: linear-gradient(135deg, #FFF8D8, #FFF0B8);
        color: #92400E;
        box-shadow: 0 6px 16px rgba(180, 120, 20, .12);
      }

      .certificate-btn:hover {
        background: linear-gradient(135deg, #FDE68A, #FCD34D);
        border-color: #F59E0B;
        color: #78350F;
      }

      .topbar-actions {
        flex: 0 0 auto;
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .btn-login {
        min-height: 52px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid #E2E8F0;
        border-radius: 11px;
        background: #fff;
        color: #334155;
        white-space: nowrap;
        transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
      }

      .btn-login:hover {
        background: #F8FAFC;
        transform: translateY(-1px);
        box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
      }

      .dropdown {
        position: relative;
      }

      .dropdown-menu {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        z-index: 1100;
        display: none;
        min-width: 205px;
        padding: 8px;
        background: rgba(255, 255, 255, .98);
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
      }

      .dropdown-item {
        min-height: 42px;
        padding: 0 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 10px;
        color: #334155;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
      }

      .dropdown-item i {
        color: #64748B;
        font-size: 17px;
      }

      .dropdown-item:hover,
      .dropdown-item.active {
        background: var(--primary-soft);
        color: var(--primary);
      }

      .dropdown-item.active i {
        color: var(--primary);
      }

      /* 03 — MOBILE MENU (shown ≤1100px) */
      .mobile-menu-toggle,
      .mobile-menu {
        display: none;
      }

      .mobile-menu-toggle {
        margin-left: auto;
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border: 1px solid rgba(148, 163, 184, .35);
        border-radius: 12px;
        background: rgba(255, 255, 255, .92);
        color: #1E3A8A;
        box-shadow: 0 5px 16px rgba(15, 23, 42, .08);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }

      .mobile-menu-toggle span {
        width: 21px;
        height: 2px;
        border-radius: 999px;
        background: currentColor;
        transition: transform .22s ease, opacity .18s ease;
      }

      .mobile-menu-toggle.is-open span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }

      .mobile-menu-toggle.is-open span:nth-child(2) {
        opacity: 0;
      }

      .mobile-menu-toggle.is-open span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }

      .mobile-menu {
        position: fixed;
        top: calc(var(--topbar-h) + 6px);
        right: 12px;
        z-index: 999;
        width: min(380px, calc(100% - 24px));
        max-height: calc(100dvh - var(--topbar-h) - 18px);
        overflow-y: auto;
        padding: 8px;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-8px) scale(.985);
        transform-origin: top right;
        background: rgba(255, 255, 255, .98);
        border: 1px solid #DBEAFE;
        border-radius: 18px;
        box-shadow: 0 20px 50px rgba(15, 23, 42, .18);
        transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
      }

      .mobile-menu.is-open {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
        transform: none;
      }

      .mobile-menu-link,
      .mobile-menu-competition-toggle {
        width: 100%;
        min-height: 50px;
        padding: 9px 12px;
        display: flex;
        align-items: center;
        gap: 11px;
        border: 0;
        border-radius: 12px;
        background: transparent;
        color: #334155;
        font-family: 'Kanit', sans-serif;
        font-size: 15px;
        font-weight: 700;
        text-align: left;
        cursor: pointer;
      }

      .mobile-menu-link:hover,
      .mobile-menu-link.active,
      .mobile-menu-competition-toggle:hover,
      .mobile-menu-competition-toggle.active {
        color: var(--primary);
        background: var(--primary-soft);
      }

      .mobile-menu-link>i,
      .mobile-menu-competition-toggle>i:first-child {
        width: 28px;
        flex: 0 0 28px;
        display: grid;
        place-items: center;
        color: var(--primary);
        font-size: 19px;
      }

      .mobile-menu-link-text {
        min-width: 0;
        display: flex;
        flex-direction: column;
        line-height: 1.15;
      }

      .mobile-menu-link-text strong {
        font-size: 15px;
        font-weight: 800;
      }

      .mobile-menu-link-text small {
        margin-top: 2px;
        color: #64748B;
        font-size: 11px;
        font-weight: 500;
      }

      .mobile-chevron {
        margin-left: auto;
        color: #64748B;
        font-size: 17px;
        transition: transform .2s ease;
      }

      .mobile-menu-competition-toggle.is-open .mobile-chevron {
        transform: rotate(180deg);
      }

      .mobile-submenu {
        display: none;
        margin: 0 8px 6px 51px;
        padding: 5px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
      }

      .mobile-submenu.is-open {
        display: block;
      }

      .mobile-submenu a {
        min-height: 42px;
        padding: 8px 10px;
        display: flex;
        align-items: center;
        gap: 9px;
        border-radius: 9px;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
      }

      .mobile-submenu a:hover,
      .mobile-submenu a.active {
        color: var(--primary);
        background: var(--primary-soft);
      }

      .mobile-submenu a i {
        color: #64748B;
        font-size: 16px;
      }

      .mobile-menu-divider {
        height: 1px;
        margin: 6px 4px;
        background: #E2E8F0;
      }

      .mobile-login>i {
        color: #475569 !important;
      }

      /* 04 — HERO / PROMO / ALERT */
      .page-hero {
        padding: calc(var(--topbar-h) + 34px) 16px 34px;
        background:
          radial-gradient(circle at 15% 20%, rgba(96, 165, 250, .18), transparent 28%),
          radial-gradient(circle at 85% 80%, rgba(37, 99, 235, .22), transparent 30%),
          linear-gradient(135deg, #0B1220 0%, #172554 58%, #1554C7 100%);
        text-align: center;
      }

      .page-hero-eyebrow {
        margin-bottom: 6px;
        color: #60A5FA;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 2.5px;
      }

      .page-hero-title {
        margin-bottom: 6px;
        color: #fff;
        font-size: clamp(26px, 4vw, 42px);
        font-weight: 700;
        line-height: 1.2;
      }

      .page-hero-sub {
        color: rgba(255, 255, 255, .72);
        font-size: 15px;
      }

      .promo-banner {
        padding: 10px 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        background: linear-gradient(135deg, #EA580C, #DC2626);
        text-align: center;
      }

      .promo-banner-text {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #fff;
        font-size: 20px;
        font-weight: 800;
      }

      .promo-countdown {
        padding: 4px 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .18);
        color: #fff;
        font-size: 16px;
        font-weight: 600;
      }

      .page-wrap {
        width: 100%;
        max-width: calc(var(--content) + var(--gutter) * 2);
        margin: 0 auto;
        padding: 28px var(--gutter) 56px;
      }

      .alert-error {
        margin-bottom: 20px;
        padding: 12px 16px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        background: #FEF2F2;
        border: 1px solid #FECACA;
        border-radius: 10px;
        color: #B91C1C;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.5;
      }

      .alert-error i {
        flex-shrink: 0;
        margin-top: 2px;
        font-size: 18px;
      }

      /* 05 — SECTION HEADING + FIELD SHOWCASE */
      .section-heading {
        margin-bottom: 14px;
      }

      .section-heading-title {
        color: var(--text);
        font-size: 22px;
        font-weight: 700;
        line-height: 1.3;
      }

      .section-heading-sub {
        margin-top: 3px;
        color: var(--muted);
        font-size: 14px;
      }

      .field-showcase {
        margin-bottom: 30px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }

      .field-showcase-card {
        --field-color: #16A34A;
        overflow: hidden;
        background: var(--surface);
        border: 1.5px solid var(--line);
        border-radius: 18px;
        box-shadow: var(--shadow);
        cursor: pointer;
        transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
      }

      .field-showcase-card.tier-intermediate {
        --field-color: #2563EB;
      }

      .field-showcase-card.tier-advance {
        --field-color: #EA580C;
      }

      .field-showcase-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(15, 23, 42, .09);
      }

      .field-showcase-card.active {
        border-color: var(--field-color);
        box-shadow: 0 0 0 2px var(--field-color), 0 14px 30px rgba(15, 23, 42, .10);
      }

      .field-showcase-image {
        position: relative;
        overflow: hidden;
        aspect-ratio: 2 / 1;
        background: #E2E8F0;
      }

      .field-showcase-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .field-level-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        padding: 5px 11px;
        border-radius: 999px;
        background: var(--field-color);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 3px 9px rgba(15, 23, 42, .18);
      }

      .field-showcase-card.active .field-showcase-image::after {
        content: 'กำลังเลือก';
        position: absolute;
        top: 10px;
        right: 10px;
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(15, 23, 42, .78);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
      }

      .field-showcase-body {
        padding: 16px;
      }

      .field-showcase-title {
        margin-bottom: 10px;
        color: var(--field-color);
        font-size: 20px;
        font-weight: 700;
      }

      .field-spec-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px 14px;
      }

      .field-mini-spec {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.45;
      }

      .field-mini-spec strong {
        display: block;
        margin-bottom: 1px;
        color: #334155;
        font-size: 12px;
        font-weight: 700;
      }

      .field-select-hint {
        margin-top: 12px;
        padding-top: 10px;
        display: flex;
        align-items: center;
        gap: 5px;
        border-top: 1px solid #F1F5F9;
        color: var(--field-color);
        font-size: 13px;
        font-weight: 700;
      }

      /* 06 — PRODUCT OPTIONS */
      .product-options-empty {
        margin-bottom: 24px;
        padding: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #fff;
        border: 1.5px dashed #CBD5E1;
        border-radius: 14px;
        color: #94A3B8;
        font-size: 15px;
        text-align: center;
      }

      .product-options-empty.is-hidden {
        display: none;
      }

      .product-options-wrap {
        display: none;
        margin-bottom: 24px;
        scroll-margin-top: calc(var(--topbar-h) + 16px);
        animation: productReveal .2s ease-out;
      }

      .product-options-wrap.active {
        display: block;
      }

      @keyframes productReveal {
        from {
          opacity: 0;
          transform: translateY(-5px);
        }

        to {
          opacity: 1;
          transform: none;
        }
      }

      .product-options-head {
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-radius: 14px 14px 0 0;
        color: #fff;
      }

      .product-options-head-title {
        font-size: 19px;
        font-weight: 700;
        line-height: 1.25;
      }

      .product-options-head-sub {
        margin-top: 2px;
        font-size: 13px;
        opacity: .88;
      }

      .choose-field-btn {
        flex: 0 0 auto;
        padding: 7px 12px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .28);
        border-radius: 9px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
      }

      .choose-field-btn:hover {
        background: rgba(255, 255, 255, .26);
      }

      .product-options-body {
        padding: 10px;
        background: #F8FAFC;
        border: 1px solid var(--line);
        border-top: 0;
        border-radius: 0 0 14px 14px;
      }

      .product-options-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .product-item {
        --sel: #2563EB;
        width: 100%;
        padding: 10px 16px 10px 10px;
        display: grid;
        grid-template-columns: 160px 26px minmax(0, 1fr) auto;
        align-items: center;
        gap: 14px;
        background: #fff;
        border: 1.5px solid var(--line);
        border-radius: 12px;
        cursor: pointer;
        transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
      }

      .product-item:hover {
        border-color: #BFDBFE;
        box-shadow: 0 4px 14px rgba(37, 99, 235, .07);
      }

      .product-item.is-selected {
        border-color: var(--sel);
        box-shadow: 0 0 0 1px var(--sel), 0 5px 15px rgba(37, 99, 235, .08);
        background: #FCFEFF;
      }

      .product-thumb {
        width: 160px;
        aspect-ratio: 2 / 1;
        overflow: hidden;
        background: #F1F5F9;
        border: 1px solid var(--line);
        border-radius: 9px;
      }

      .product-thumb img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .custom-checkbox {
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        background: #fff;
        border: 2px solid #CBD5E1;
        border-radius: 7px;
        color: #fff;
        font-size: 15px;
        transition: background .15s ease, border-color .15s ease;
      }

      .custom-checkbox i {
        opacity: 0;
        transition: opacity .15s ease;
      }

      .product-item.is-selected .custom-checkbox {
        background: var(--sel);
        border-color: var(--sel);
      }

      .product-item.is-selected .custom-checkbox i {
        opacity: 1;
      }

      .product-content {
        min-width: 0;
      }

      .product-item-name {
        color: var(--text);
        font-size: 18px;
        font-weight: 700;
        line-height: 1.35;
      }

      .product-item-desc {
        margin-top: 2px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.45;
      }

      .qty-wrap {
        margin-top: 8px;
        display: none;
        align-items: center;
        gap: 8px;
      }

      .product-item.is-selected .qty-wrap {
        display: flex;
      }

      .qty-label {
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
      }

      .qty-control {
        display: flex;
        align-items: center;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .qty-btn {
        width: 32px;
        height: 32px;
        border: 0;
        background: #F8FAFC;
        color: #334155;
        font-size: 16px;
        font-weight: 800;
        cursor: pointer;
      }

      .qty-btn:hover {
        background: #EFF6FF;
        color: var(--blue);
      }

      .qty-num {
        width: 46px;
        height: 32px;
        border: 0;
        border-left: 1px solid var(--line);
        border-right: 1px solid var(--line);
        outline: none;
        font-size: 15px;
        text-align: center;
        -moz-appearance: textfield;
      }

      .qty-num::-webkit-outer-spin-button,
      .qty-num::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }

      .price-wrap {
        min-width: 110px;
        justify-self: end;
        text-align: right;
        white-space: nowrap;
      }

      .price-discount-badge {
        margin-bottom: 2px;
        padding: 2px 7px;
        display: inline-block;
        border-radius: 999px;
        background: #FEF2F2;
        color: var(--red);
        font-size: 13px;
        font-weight: 800;
      }

      .price-original {
        color: #94A3B8;
        font-size: 16px;
        line-height: 1.1;
        text-decoration: line-through;
      }

      .price-promo,
      .price-normal {
        font-size: 25px;
        font-weight: 900;
        line-height: 1.15;
      }

      .price-promo {
        color: var(--red);
      }

      .price-soldout {
        padding: 6px 16px;
        display: inline-block;
        background: #F1F5F9;
        border: 1px solid #E2E8F0;
        border-radius: 999px;
        color: #64748B;
        font-size: 18px;
        font-weight: 700;
      }

      .product-item.is-soldout {
        background: #F8FAFC;
        cursor: not-allowed;
      }

      .product-item.is-soldout:hover {
        border-color: var(--line);
        box-shadow: none;
      }

      .product-item.is-soldout .product-thumb img {
        filter: grayscale(1);
        opacity: .55;
      }

      .product-item.is-soldout .product-item-name,
      .product-item.is-soldout .product-item-desc {
        opacity: .55;
      }

      .product-item.is-soldout .custom-checkbox {
        background: #F1F5F9;
        border-color: #E2E8F0;
      }

      /* 07 — CHECKOUT FORM */
      .checkout-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 20px;
        align-items: start;
      }

      .checkout-main {
        min-width: 0;
      }

      .form-card,
      .summary-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: var(--shadow);
      }

      .form-card {
        padding: 22px;
      }

      .form-card-title,
      .summary-head {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text);
        font-size: 18px;
        font-weight: 700;
      }

      .form-card-title {
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid #F1F5F9;
      }

      .form-card-title i,
      .summary-head i {
        color: var(--blue);
      }

      .fg {
        margin-bottom: 14px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .fl {
        color: #475569;
        font-size: 14px;
        font-weight: 600;
      }

      .fi {
        width: 100%;
        padding: 11px 13px;
        background: #fff;
        border: 1.5px solid var(--line);
        border-radius: 10px;
        color: #1E293B;
        font-size: 15px;
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
      }

      .fi:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
      }

      textarea.fi {
        min-height: 76px;
        resize: vertical;
      }

      .form-grid-2,
      .form-grid-3 {
        margin-bottom: 14px;
        display: grid;
        gap: 12px;
      }

      .form-grid-2 {
        grid-template-columns: 1fr 1fr;
      }

      .form-grid-3 {
        grid-template-columns: 1fr 1fr 1fr;
      }

      .form-grid-2 .fg,
      .form-grid-3 .fg {
        margin-bottom: 0;
      }

      .choice-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }

      .choice {
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        border: 1.5px solid var(--line);
        border-radius: 10px;
        cursor: pointer;
        transition: border-color .15s ease, background .15s ease;
      }

      .choice:hover {
        border-color: #BFDBFE;
      }

      .choice:has(input:checked) {
        border-color: var(--blue);
        background: var(--blue-soft);
      }

      .choice input {
        flex: 0 0 auto;
        width: 18px;
        height: 18px;
        accent-color: var(--blue);
      }

      .choice-title {
        font-size: 15px;
        font-weight: 600;
      }

      .choice-tag {
        margin-left: 6px;
        font-size: 13px;
        font-weight: 700;
      }

      .choice-tag.is-free {
        color: var(--green);
      }

      .choice-tag.is-extra {
        color: var(--orange);
      }

      .reveal-section {
        display: none;
      }

      .reveal-section.is-open {
        display: block;
      }

      .info-note {
        margin-top: 12px;
        padding: 12px 14px;
        display: flex;
        gap: 8px;
        background: #FFF7ED;
        border: 1px solid #FED7AA;
        border-radius: 10px;
        color: #92400E;
        font-size: 14px;
        line-height: 1.55;
      }

      .info-note i {
        flex-shrink: 0;
        margin-top: 2px;
      }

      /* 08 — SUMMARY */
      .sidebar-sticky {
        position: sticky;
        top: calc(var(--topbar-h) + 16px);
      }

      .summary-head {
        padding: 15px 18px;
        border-bottom: 1px solid #F1F5F9;
      }

      .summary-body {
        padding: 16px 18px;
      }

      .summary-promo {
        margin-bottom: 12px;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        background: #FEF2F2;
        border: 1px solid #FECDD3;
        border-radius: 8px;
        color: var(--red);
        font-size: 14px;
        font-weight: 700;
      }

      .summary-empty {
        padding: 20px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        color: #94A3B8;
        font-size: 14px;
        text-align: center;
      }

      .summary-empty i {
        font-size: 26px;
        opacity: .6;
      }

      .summary-line {
        padding: 7px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-size: 14px;
      }

      .summary-line-name {
        color: #334155;
        font-weight: 600;
      }

      .summary-line-qty {
        color: #94A3B8;
        font-size: 12px;
      }

      .summary-line-price {
        color: var(--text);
        font-weight: 800;
        white-space: nowrap;
      }

      .summary-divider {
        height: 1px;
        margin: 12px 0;
        background: #F1F5F9;
      }

      .summary-row {
        margin-bottom: 6px;
        display: flex;
        justify-content: space-between;
        gap: 10px;
        color: #64748B;
        font-size: 14px;
      }

      .summary-row .is-strike {
        color: #94A3B8;
        text-decoration: line-through;
      }

      .summary-row.is-discount {
        color: var(--red);
        font-weight: 700;
      }

      .summary-row .is-strong {
        color: var(--text);
        font-weight: 700;
      }

      .summary-total-row {
        padding-top: 8px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;
      }

      .summary-total-label {
        color: #334155;
        font-size: 15px;
        font-weight: 700;
      }

      .summary-total-price {
        color: var(--red);
        font-size: 28px;
        font-weight: 900;
        line-height: 1.1;
      }

      .btn-submit {
        width: 100%;
        min-height: 50px;
        margin-top: 14px;
        padding: 0 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 0;
        border-radius: 11px;
        background: var(--blue);
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 6px 14px rgba(37, 99, 235, .18);
        transition: background .2s ease, transform .2s ease;
      }

      .btn-submit:hover:not(:disabled) {
        background: #1D4ED8;
        transform: translateY(-1px);
      }

      .btn-submit:disabled {
        opacity: .45;
        cursor: not-allowed;
        box-shadow: none;
      }

      .trust-note {
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        color: #64748B;
        font-size: 12px;
      }

      /* 09 — SUCCESS STATE */
      .success-wrap {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        padding: calc(var(--topbar-h) + 30px) 24px 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
          radial-gradient(circle at 16% 18%, rgba(59, 130, 246, .10), transparent 30%),
          radial-gradient(circle at 84% 78%, rgba(37, 99, 235, .09), transparent 32%),
          linear-gradient(180deg, #F8FAFC 0%, #F5F7FB 100%);
      }

      .success-card {
        position: relative;
        z-index: 1;
        width: min(100%, 500px);
        padding: 30px 34px 32px;
        background: rgba(255, 255, 255, .97);
        border: 1px solid rgba(226, 232, 240, .95);
        border-radius: 22px;
        box-shadow: 0 24px 60px rgba(15, 23, 42, .10);
        text-align: center;
      }

      .success-visual {
        position: relative;
        width: 116px;
        height: 116px;
        margin: 0 auto 12px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: radial-gradient(circle, #EFF6FF 0%, #F8FBFF 68%, rgba(239, 246, 255, 0) 70%);
      }

      .success-visual::before {
        content: '';
        width: 58px;
        height: 72px;
        background: #fff;
        border: 3px solid #60A5FA;
        border-radius: 9px;
        transform: rotate(-5deg);
        box-shadow: 0 8px 20px rgba(37, 99, 235, .10);
      }

      .success-visual::after {
        content: '✓';
        position: absolute;
        right: 20px;
        bottom: 18px;
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--blue);
        color: #fff;
        font-family: Arial, sans-serif;
        font-size: 21px;
        font-weight: 700;
        box-shadow: 0 7px 18px rgba(37, 99, 235, .25);
      }

      .success-visual-icon {
        position: absolute;
        z-index: 2;
        color: #60A5FA;
        font-size: 29px;
        transform: translateY(-2px);
      }

      .success-title {
        margin-bottom: 14px;
        color: var(--text);
        font-size: 22px;
        font-weight: 800;
        line-height: 1.35;
      }

      .success-order-box {
        margin: 0 auto 16px;
        padding: 10px 18px 12px;
        background: linear-gradient(135deg, #EFF6FF, #EAF2FF);
        border: 1px solid #DBEAFE;
        border-radius: 16px;
      }

      .success-order-label {
        color: #64748B;
        font-size: 13px;
      }

      .success-order-id {
        color: var(--blue);
        font-size: 38px;
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: 2px;
      }

      .success-note {
        margin: 0 auto 20px;
        color: #64748B;
        font-size: 17px;
        line-height: 1.7;
      }

      .line-pill {
        margin: 6px 0;
        padding: 6px 16px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #F0FDF4;
        border: 1px solid #BBF7D0;
        border-radius: 999px;
        color: var(--green);
        font-weight: 800;
      }

      .line-pill:hover {
        background: #DCFCE7;
      }

      .success-deadline {
        display: block;
        margin-top: 4px;
        color: var(--red);
        font-weight: 800;
      }

      .success-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .btn-outline,
      .btn-solid {
        min-height: 46px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 11px;
        font-size: 15px;
        font-weight: 600;
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease;
      }

      .btn-outline {
        background: #fff;
        border: 1px solid #BFDBFE;
        color: var(--blue);
      }

      .btn-outline:hover {
        background: #F8FBFF;
        border-color: #93C5FD;
        transform: translateY(-2px);
      }

      .btn-solid {
        background: linear-gradient(135deg, #3478F6, #2563EB);
        border: 1px solid transparent;
        color: #fff;
        box-shadow: 0 8px 18px rgba(37, 99, 235, .20);
      }

      .btn-solid:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(37, 99, 235, .28);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }

      /* 10 — RESPONSIVE */
      @media (min-width: 1440px) {
        .topbar {
          padding-inline: 48px;
        }

        .topbar-nav {
          margin-left: 22px;
          gap: 4px;
        }

        .nav-link {
          padding-inline: 16px;
        }
      }

      @media (max-width: 1199px) {
        :root {
          --gutter: 20px;
        }

        .topbar {
          padding-inline: 20px;
        }

        .topbar-logo img {
          height: 54px;
          max-width: 136px;
        }

        .topbar-nav {
          margin-left: 10px;
          gap: 0;
        }

        .nav-link {
          padding-inline: 9px;
          letter-spacing: .5px;
        }

        .nav-link span:first-child {
          font-size: 15px;
        }

        .nav-link span:last-child {
          font-size: 10px;
        }

        .certificate-btn {
          min-width: 126px;
          padding-inline: 12px;
        }

        .btn-login {
          padding-inline: 13px;
          font-size: 14px;
        }

        .checkout-layout {
          grid-template-columns: minmax(0, 1fr) 320px;
        }

        .product-item {
          grid-template-columns: 120px 26px minmax(0, 1fr) auto;
        }

        .product-thumb {
          width: 120px;
        }
      }

      @media (max-width: 1100px) {
        :root {
          --topbar-h: 70px;
        }

        .topbar-nav,
        .topbar-actions {
          display: none;
        }

        .mobile-menu-toggle {
          display: flex;
        }

        .mobile-menu {
          display: block;
        }

        .topbar-logo img {
          height: 50px;
          max-width: 124px;
        }
      }

      @media (max-width: 900px) {
        .field-showcase {
          grid-template-columns: 1fr;
          gap: 14px;
        }

        .field-showcase-image {
          aspect-ratio: 16 / 7;
        }

        /* Form first, summary + submit after it — natural reading order on one column */
        .checkout-layout {
          grid-template-columns: 1fr;
        }

        .sidebar-sticky {
          position: static;
        }
      }

      @media (max-width: 640px) {
        :root {
          --gutter: 12px;
          --topbar-h: 60px;
        }

        .topbar {
          padding: 0 12px;
        }

        .topbar-logo img {
          height: 42px;
          max-width: 90px;
        }

        .page-hero {
          padding: calc(var(--topbar-h) + 24px) 16px 26px;
        }

        .page-hero-sub {
          font-size: 14px;
          line-height: 1.55;
        }

        .promo-banner-text {
          font-size: 16px;
        }

        .promo-countdown {
          font-size: 13px;
        }

        .page-wrap {
          padding-top: 22px;
          padding-bottom: 40px;
        }

        .section-heading-title {
          font-size: 19px;
        }

        .section-heading-sub {
          font-size: 13px;
        }

        .field-showcase-image {
          aspect-ratio: 16 / 9;
        }

        .field-showcase-body {
          padding: 14px;
        }

        .field-showcase-title {
          font-size: 18px;
        }

        .product-options-head {
          padding: 12px;
        }

        .product-options-head-title {
          font-size: 16px;
        }

        .product-options-head-sub {
          font-size: 12px;
        }

        /* thumb | content  /  thumb | price — checkbox sits on the thumbnail */
        .product-item {
          position: relative;
          padding: 10px;
          grid-template-columns: 72px minmax(0, 1fr) auto;
          grid-template-areas: "thumb content price";
          gap: 10px;
        }

        .product-thumb {
          grid-area: thumb;
          width: 72px;
          aspect-ratio: 1;
        }

        .product-content {
          grid-area: content;
        }

        .price-wrap {
          grid-area: price;
          min-width: 0;
          align-self: start;
        }

        .custom-checkbox {
          position: absolute;
          top: 6px;
          left: 6px;
          width: 22px;
          height: 22px;
          box-shadow: 0 2px 6px rgba(15, 23, 42, .15);
        }

        .product-item-name {
          font-size: 15px;
        }

        .product-item-desc {
          font-size: 12px;
        }

        .price-original {
          font-size: 13px;
        }

        .price-promo,
        .price-normal {
          font-size: 19px;
        }

        .price-discount-badge {
          font-size: 11px;
        }

        .price-soldout {
          padding: 4px 11px;
          font-size: 14px;
        }

        .form-card {
          padding: 16px;
        }

        .form-grid-2,
        .form-grid-3,
        .choice-list {
          grid-template-columns: 1fr;
        }

        /* 16px inputs stop iOS from zooming in on focus */
        .fi,
        .qty-num {
          font-size: 16px;
        }

        .summary-body {
          padding: 14px;
        }

        .success-wrap {
          padding: calc(var(--topbar-h) + 24px) 16px 30px;
        }

        .success-card {
          padding: 26px 20px 25px;
          border-radius: 19px;
        }

        .success-visual {
          width: 100px;
          height: 100px;
          margin-bottom: 9px;
        }

        .success-title {
          font-size: 19px;
        }

        .success-order-id {
          font-size: 34px;
        }

        .success-note {
          font-size: 16px;
          margin-bottom: 17px;
        }

        .btn-outline,
        .btn-solid {
          flex: 1 1 140px;
          min-height: 44px;
          padding: 0 14px;
          font-size: 14px;
        }
      }
    </style>
  </head>

