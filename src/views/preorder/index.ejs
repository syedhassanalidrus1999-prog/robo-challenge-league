<!DOCTYPE html>

<html lang="th">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Pre-order สนามแข่งขัน — RCL 2026</title>
  <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&amp;family=Kanit:wght@400;500;600;700;800&amp;display=swap"
    rel="stylesheet" />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    body {
      font-family: 'Sarabun', sans-serif;
      background: #F4F7FB;
      color: #1E293B;
      min-height: 100vh
    }

    a {
      text-decoration: none;
      color: inherit
    }

    .topbar {
      height: 60px;
      background: #fff;
      border-bottom: 1px solid #E2E8F0;
      display: flex;
      align-items: center;
      padding: 0 20px;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 1px 4px rgba(0, 0, 0, .06)
    }

    .topbar-logo img {
      height: 36px;
      object-fit: contain
    }

    .topbar-title {
      font-size: 15px;
      font-weight: 800;
      color: #1E293B;
      flex: 1
    }

    .topbar {
  position: fixed;
  inset: 0 0 auto;
  z-index: 100;

  height: 84px;
  padding: 0 30px;

  display: flex;
  align-items: center;
  gap: 10px;

  background: transparent;
  border-bottom: 1px solid transparent;

  transition: .3s ease;
}

.topbar.scrolled {
  background: rgba(255,255,255,.90);
  border-bottom-color: rgba(226,232,240,.9);
  box-shadow: 0 4px 18px rgba(15,23,42,.04);
  backdrop-filter: blur(16px);
}

.topbar-logo {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
}

.topbar-logo img {
  width: auto;
  height: 120px;
  object-fit: contain;
}

.topbar-nav {
  flex: 1;
  margin-left: 18px;

  display: flex;
  align-items: center;
  gap: 6px;
}

.nav-link {
  min-height: 52px;
  padding: 0 18px;

  display: inline-flex;
  align-items: center;
  gap: 7px;

  border: 0;
  border-radius: 11px;
  background: transparent;

  color: #334155;

  font-family: 'Kanit', sans-serif;
  font-size: 18px;
  font-weight: 600;
  letter-spacing: 1.5px;

  cursor: pointer;
  transition: .2s ease;
}

.nav-link:hover {
  color: #2563EB;
  transform: translateY(-1px);
}


/* =========================
   Dropdown
========================= */

.dropdown {
  position: relative;
}

.dropdown-menu {
  position: absolute;
  top: calc(100% + 10px);
  left: 0;
  z-index: 200;

  display: none;

  min-width: 200px;
  padding: 8px;

  background: rgba(255,255,255,.98);

  border: 1px solid #E2E8F0;
  border-radius: 14px;

  box-shadow: 0 18px 44px rgba(15,23,42,.14);
}

.dropdown-item {
  min-height: 42px;
  padding: 0 12px;

  display: flex;
  align-items: center;
  gap: 10px;

  border-radius: 10px;

  color: #334155;

  font-size: 14px;
  font-weight: 700;
}

.dropdown-item:hover {
  background: #EFF6FF;
  color: #2563EB;
}

.dropdown-item i {
  color: #64748B;
  font-size: 17px;
}


/* =========================
   Login
========================= */

.topbar-actions {
  margin-left: auto;

  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-login {
  min-height: 52px;
  padding: 0 20px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  color: #334155;
  background: #fff;

  border: 1px solid #E2E8F0;
  border-radius: 11px;

  font: 800 16px 'Sarabun', sans-serif;

  transition: .2s ease;
}

.btn-login:hover {
  background: #F8FAFC;
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(15,23,42,.07);
}

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 14px;
      border-radius: 8px;
      border: 1px solid #E2E8F0;
      background: #fff;
      color: #64748B;
      font-size: 13px;
      font-weight: 700;
      font-family: 'Sarabun', sans-serif;
      cursor: pointer;
      transition: .15s
    }

    .btn-back:hover {
      background: #F8FAFC
    }

    .page-hero {
      padding: 28px 20px;
      text-align: center;
      background: url('/images/preorder-hero-bg.png') center/cover no-repeat;
    }

    .page-hero-eyebrow {
      color: #60A5FA;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      margin-bottom: 6px
    }

    .page-hero-title {
      font-family: 'Kanit', sans-serif;
      font-size: clamp(20px, 4vw, 30px);
      font-weight: 700;
      color: #fff;
      margin-bottom: 4px
    }

    .page-hero-sub {
      color: rgba(255, 255, 255, .6);
      font-size: 13px
    }

    .page-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px 16px 48px;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 24px;
      align-items: start
    }

    .tier-group {
      margin-bottom: 20px
    }

    .tier-group-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
      padding: 10px 14px;
      border-radius: 10px;
      font-family: 'Kanit', sans-serif;
      font-size: 16px;
      font-weight: 700
    }

    .product-item {
      background: #fff;
      border: 2px solid #E2E8F0;
      border-radius: 14px;
      padding: 14px 16px;
      display: grid;
      grid-template-columns: 28px 1fr auto;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: all .18s;
      margin-bottom: 8px
    }

    .product-item:hover {
      box-shadow: 0 6px 18px rgba(37, 99, 235, .08)
    }

    .custom-checkbox {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      border: 2px solid #CBD5E1;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      transition: .15s;
      background: #fff
    }

    .custom-checkbox i {
      font-size: 14px;
      color: #fff;
      opacity: 0;
      transition: .15s
    }

    .product-item-name {
      font-size: 13px;
      font-weight: 800;
      color: #0F172A;
      margin-bottom: 2px
    }

    .product-item-desc {
      font-size: 11px;
      color: #64748B;
      line-height: 1.4
    }

    .product-item-price {
      font-family: 'Kanit', sans-serif;
      font-size: 16px;
      font-weight: 800;
      white-space: nowrap
    }

    .detail-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      font-weight: 700;
      color: #2563EB;
      background: #EFF6FF;
      border: none;
      border-radius: 6px;
      padding: 3px 8px;
      cursor: pointer;
      margin-top: 5px;
      font-family: 'Sarabun', sans-serif;
      transition: .15s
    }

    .detail-btn:hover {
      background: #DBEAFE
    }

    .qty-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 6px
    }

    .qty-label {
      font-size: 11px;
      font-weight: 700;
      color: #64748B
    }

    .qty-control {
      display: flex;
      align-items: center;
      border: 1.5px solid #E2E8F0;
      border-radius: 8px;
      overflow: hidden
    }

    .qty-btn {
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      background: #F8FAFC;
      border: none;
      cursor: pointer;
      font-size: 16px;
      color: #475569;
      transition: .15s;
      font-family: inherit
    }

    .qty-btn:hover {
      background: #EFF6FF;
      color: #2563EB
    }

    .qty-num {
      width: 32px;
      text-align: center;
      font-size: 13px;
      font-weight: 800;
      border: none;
      outline: none;
      background: #fff;
      font-family: inherit;
      color: #0F172A
    }

    .form-card {
      background: #fff;
      border: 1px solid #E2E8F0;
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 14px;
      box-shadow: 0 2px 8px rgba(15, 23, 42, .04)
    }

    .form-card-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 800;
      color: #0F172A;
      margin-bottom: 16px;
      padding-bottom: 10px;
      border-bottom: 1px solid #F1F5F9
    }

    .form-card-title i {
      color: #2563EB;
      font-size: 18px
    }

    .form-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px
    }

    .form-grid-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px
    }

    .fg {
      display: flex;
      flex-direction: column;
      gap: 5px;
      margin-bottom: 12px
    }

    .fg:last-child {
      margin-bottom: 0
    }

    .fl {
      font-size: 11px;
      font-weight: 700;
      color: #64748B;
      letter-spacing: .5px;
      text-transform: uppercase
    }

    .fi {
      padding: 10px 12px;
      border: 1.5px solid #E2E8F0;
      border-radius: 9px;
      font-size: 14px;
      font-family: 'Sarabun', sans-serif;
      color: #1E293B;
      background: #fff;
      outline: none;
      width: 100%;
      transition: border-color .15s
    }

    .fi:focus {
      border-color: #2563EB;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, .1)
    }

    .sidebar-sticky {
      position: sticky;
      top: 76px;
      display: flex;
      flex-direction: column;
      gap: 14px
    }

    /* FIELD DETAIL SIDEBAR */
    .field-detail-card {
      background: #fff;
      border: 1px solid #E2E8F0;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(15, 23, 42, .04);
      transition: all .3s
    }

    .field-detail-head {
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: background .3s
    }

    .field-detail-img {
      width: 100%;
      aspect-ratio: 2/1;
      object-fit: cover;
      display: block
    }

    .field-detail-mockup {
      width: 100%;
      aspect-ratio: 2/1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: background .3s
    }

    .field-detail-mockup i {
      font-size: 48px;
      opacity: .3
    }

    .field-detail-mockup-text {
      font-size: 12px;
      font-weight: 700;
      opacity: .5;
      text-align: center;
      line-height: 1.5
    }

    .field-specs {
      padding: 14px 16px
    }

    .field-spec-row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      border-bottom: 1px solid #F8FAFC;
      font-size: 12px
    }

    .field-spec-row:last-child {
      border-bottom: none
    }

    .field-spec-label {
      color: #64748B;
      font-weight: 600
    }

    .field-spec-value {
      color: #1E293B;
      font-weight: 700;
      text-align: right
    }

    .field-detail-empty {
      padding: 32px 16px;
      text-align: center;
      color: #CBD5E1;
      font-size: 13px
    }

    .field-detail-empty i {
      font-size: 36px;
      display: block;
      margin-bottom: 8px
    }

    /* SUMMARY */
    .summary-card {
      background: #fff;
      border: 1px solid #E2E8F0;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(15, 23, 42, .04)
    }

    .summary-head {
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 800;
      color: #0F172A;
      border-bottom: 1px solid #F1F5F9;
      display: flex;
      align-items: center;
      gap: 8px
    }

    .summary-head i {
      color: #2563EB
    }

    .summary-body {
      padding: 14px 16px
    }

    .summary-empty {
      text-align: center;
      color: #CBD5E1;
      font-size: 12px;
      padding: 16px 0
    }

    .summary-empty i {
      font-size: 28px;
      display: block;
      margin-bottom: 6px
    }

    .summary-line {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
      padding: 6px 0;
      border-bottom: 1px solid #F8FAFC;
      font-size: 12px
    }

    .summary-line-name {
      color: #334155;
      font-weight: 700;
      flex: 1
    }

    .summary-line-qty {
      color: #94A3B8;
      font-size: 11px
    }

    .summary-line-price {
      font-weight: 800;
      color: #0F172A;
      white-space: nowrap
    }

    .summary-divider {
      height: 1px;
      background: #E2E8F0;
      margin: 10px 0
    }

    .summary-total-row {
      display: flex;
      justify-content: space-between;
      align-items: center
    }

    .summary-total-label {
      font-size: 13px;
      font-weight: 800;
      color: #0F172A
    }

    .summary-total-price {
      font-family: 'Kanit', sans-serif;
      font-size: 24px;
      font-weight: 800;
      color: #EA580C
    }

    .btn-submit {
      width: 100%;
      min-height: 50px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #2563EB, #1D4ED8);
      color: #fff;
      font-family: 'Sarabun', sans-serif;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: .2s;
      box-shadow: 0 10px 24px rgba(37, 99, 235, .28);
      margin-top: 12px
    }

    .btn-submit:hover {
      transform: translateY(-2px)
    }

    .btn-submit:disabled {
      background: #CBD5E1;
      box-shadow: none;
      cursor: not-allowed;
      transform: none
    }

    .trust-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 8px;
      font-size: 11px;
      color: #64748B
    }

    .trust-note i {
      color: #16A34A
    }

    .footer-badges {
      background: #fff;
      border: 1px solid #E2E8F0;
      border-radius: 16px;
      display: grid;
      grid-template-columns: repeat(3, 1fr)
    }

    .footer-badge {
      padding: 16px 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      text-align: center;
      border-right: 1px solid #F1F5F9
    }

    .footer-badge:last-child {
      border-right: none
    }

    .footer-badge-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #EFF6FF;
      display: grid;
      place-items: center;
      color: #2563EB;
      font-size: 18px
    }

    .footer-badge-title {
      font-size: 11px;
      font-weight: 800;
      color: #0F172A
    }

    .footer-badge-sub {
      font-size: 10px;
      color: #64748B;
      line-height: 1.5
    }

    .alert-error {
      background: #FEF2F2;
      border: 1px solid #FECDD3;
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 16px;
      color: #DC2626;
      font-size: 13px;
      display: flex;
      gap: 8px
    }

    .info-note {
      background: #FFF7ED;
      border: 1px solid #FED7AA;
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 12px;
      color: #92400E;
      display: flex;
      gap: 8px;
      margin-bottom: 14px
    }

    .success-wrap {
      max-width: 560px;
      margin: 48px auto;
      padding: 0 16px
    }

    .success-card {
      background: #fff;
      border: 1px solid #E2E8F0;
      border-radius: 20px;
      padding: 48px 32px;
      text-align: center;
      box-shadow: 0 8px 32px rgba(15, 23, 42, .06)
    }

    .btn-outline {
      padding: 10px 20px;
      border-radius: 10px;
      border: 1.5px solid #E2E8F0;
      background: #fff;
      color: #334155;
      font-size: 13px;
      font-weight: 700;
      font-family: 'Sarabun', sans-serif;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px
    }

    .btn-solid {
      padding: 10px 20px;
      border-radius: 10px;
      border: none;
      background: #2563EB;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      font-family: 'Sarabun', sans-serif;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px
    }

    @media(max-width:900px) {
      .page-wrap {
        grid-template-columns: 1fr
      }

      .sidebar-sticky {
        position: static;
        order: -1
      }
    }

    @media(max-width:640px) {

      .form-grid-2,
      .form-grid-3 {
        grid-template-columns: 1fr
      }

      .footer-badges {
        grid-template-columns: 1fr
      }

      .footer-badge {
        border-right: none;
        border-bottom: 1px solid #F1F5F9
      }

      .footer-badge:last-child {
        border-bottom: none
      }
    }
  </style>
  <style id="modern-ui-overrides">
