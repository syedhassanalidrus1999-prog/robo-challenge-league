/* =========================
   LOGO
========================= */

.topbar-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;

    height: 72px;
}

.topbar-logo img {
    width: auto;
    height: 48px;

    object-fit: contain;
    display: block;
}


/* =========================
   NAV MENU
========================= */

.topbar-nav {
    display: flex;
    align-items: center;

    margin-left: 24px;
    gap: 4px;

    flex: 1;
}


/* เมนูหลัก */

.nav-link {
    position: relative;

    height: 44px;
    padding: 0 16px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    border: 0 !important;
    border-radius: 9px;

    background: transparent !important;

    color: #26364D;

    font-family: 'Kanit', sans-serif;
    font-size: 16px;
    font-weight: 600;

    letter-spacing: .2px;

    text-decoration: none;
    white-space: nowrap;

    cursor: pointer;

    transition:
        color .2s ease,
        background .2s ease,
        transform .2s ease;
}


/* Hover */

.nav-link:hover {
    color: #1555B8;

    background: #F1F6FF !important;

    transform: translateY(-1px);
}


/* =========================
   ACTIVE — เอกสาร
========================= */

.nav-link.docs-active {
    color: #1555B8 !important;
    background: #EFF6FF !important;
}


/* =========================
   PRE-ORDER
========================= */

.nav-link.preorder-active {
    color: #EA580C !important;

    font-weight: 700;
}

.nav-link.preorder-active:hover {
    color: #EA580C !important;
    background: #FFF7ED !important;
}


/* Icon Pre-order */

.nav-link.preorder-active i {
    font-size: 17px;
}


/* =========================
   DROPDOWN
========================= */

.dropdown {
    position: relative;
}


/* ลูกศร */

.dropdown > .nav-link i {
    font-size: 13px;
    transition: transform .2s ease;
}


/* เปิด dropdown ตอน hover */

.dropdown:hover > .nav-link i {
    transform: rotate(180deg);
}


/* Dropdown box */

.dropdown-menu {
    position: absolute;

    top: calc(100% + 8px);
    left: 0;

    min-width: 210px;

    padding: 7px;

    display: none;

    background: rgba(255, 255, 255, .98);

    border: 1px solid #E2E8F0;
    border-radius: 13px;

    box-shadow:
        0 16px 40px rgba(15, 23, 42, .12),
        0 3px 10px rgba(15, 23, 42, .04);

    backdrop-filter: blur(12px);

    animation: navDropdown .16s ease;
}


/* Hover แล้วแสดง */

.dropdown:hover .dropdown-menu {
    display: block;
}


/* Dropdown item */

.dropdown-item {
    min-height: 42px;

    padding: 0 12px;

    display: flex;
    align-items: center;

    gap: 10px;

    border-radius: 9px;

    color: #334155;

    font-family: 'Sarabun', sans-serif;
    font-size: 14px;
    font-weight: 700;

    text-decoration: none;

    transition: .18s ease;
}


.dropdown-item:hover {
    color: #2563EB;
    background: #EFF6FF;
}


/* Dropdown icon */

.dropdown-item i {
    width: 20px;

    color: #64748B;
    font-size: 17px;

    text-align: center;
}

.dropdown-item:hover i {
    color: #2563EB;
}


/* =========================
   LOGIN
========================= */

.topbar-actions {
    margin-left: auto;

    display: flex;
    align-items: center;
}


.btn-login {
    height: 46px;

    padding: 0 18px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    background: #fff;

    border: 1px solid #DCE4EF;
    border-radius: 10px;

    color: #334155;

    font-family: 'Sarabun', sans-serif;
    font-size: 14px;
    font-weight: 800;

    text-decoration: none;

    transition: .2s ease;
}


.btn-login:hover {
    color: #1555B8;

    border-color: #BFD0E7;

    background: #F8FAFF;

    box-shadow:
        0 6px 18px rgba(37, 99, 235, .08);

    transform: translateY(-1px);
}


.btn-login i {
    font-size: 15px;
}


/* =========================
   DROPDOWN ANIMATION
========================= */

@keyframes navDropdown {

    from {
        opacity: 0;
        transform: translateY(-5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}


/* =========================
   MOBILE
========================= */

