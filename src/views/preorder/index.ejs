  </div>



  <% if (success) { %>
    <div class="success-wrap">
      <div class="success-card">
        <div
          style="width:80px;height:80px;border-radius:50%;background:#F0FDF4;margin:0 auto 20px;display:grid;place-items:center;font-size:40px">
          &#9989;</div>
        <div style="font-family:'Kanit',sans-serif;font-size:24px;font-weight:700;color:#0F172A;margin-bottom:8px">
          Pre-order สำเร็จ!</div>
        <div style="font-size:14px;color:#64748B;line-height:1.7;margin-bottom:20px">ทีมงานจะติดต่อกลับภายใน <strong>1-2
            วันทำการ</strong></div>
        <div
          style="background:#F0FDF4;border:1px solid #BBF7D0;border-radius:10px;padding:14px;margin-bottom:24px;font-size:13px;color:#15803D">
          <i class="ti ti-phone"></i> สอบถาม: <strong>081-882-0502</strong>
        </div>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
          <a href="/preorder" class="btn-outline"><i class="ti ti-plus"></i> Pre-order เพิ่ม</a>
          <a href="/" class="btn-solid"><i class="ti ti-home"></i> กลับหน้าหลัก</a>
        </div>
      </div>
    </div>
    <% } else { %>


      <div class="page-hero">
        <div class="page-hero-eyebrow">PRE-ORDER</div>
        <div class="page-hero-title">สนามแข่งขัน RCL 2026</div>
        <div class="page-hero-sub">เลือกได้หลายรายการ — คลิกสินค้าเพื่อดูรายละเอียดสนาม</div>
      </div>

      <% if (promoActive) { %>

        <div class="promo-banner">
          <div class="promo-banner-text"><i class="ti ti-tag"></i> โปรโมชั่นพิเศษ! ลด <%= promoPercent %>% ทุกรายการ
          </div>
          <% if (promoEndDate) { %>
            <div class="promo-countdown"><i class="ti ti-clock"></i> <span>หมดเขต: <%= new
                  Date(promoEndDate).toLocaleDateString('th-TH', {day:'numeric',month:'long',year:'numeric'}) %></span>
            </div>
            <% } %>
        </div>
        <% } %>

          <% if (errorMsg) { %>
            <div style="max-width:1100px;margin:16px auto;padding:0 16px">
              <div class="alert-error"><i class="ti ti-alert-circle"></i>
                <%= errorMsg %>
              </div>
            </div>
            <% } %>

              <form method="POST" action="/preorder" id="preorderForm">
                <input type="hidden" name="items_json" id="items_json" value="">

                <div class="page-wrap">

                  <div class="section-heading">
                    <div>
                      <div class="section-heading-title">🏙️ รายละเอียดสนามแข่งขัน</div>
                      <div class="section-heading-sub">เปรียบเทียบสนามแต่ละระดับก่อนเลือกสินค้า</div>
                    </div>
                  </div>

                  <div class="field-showcase">
                    <div class="field-showcase-card" onclick="openProductOptions('beginner', this)">
                      <div class="field-showcase-image">
                        <img src="/images/field-beginner.png" alt="สนาม Beginner">
                        <span class="field-level-badge" style="background:#16A34A">🌱 Beginner</span>
                      </div>
                      <div class="field-showcase-body">
                        <div class="field-showcase-title">สนาม Beginner</div>
                        <div class="field-spec-grid">
                          <div class="field-mini-spec"><strong>ขนาดสนาม</strong>236 × 114 ซม.</div>
                          <div class="field-mini-spec"><strong>ภารกิจ</strong>4 ภารกิจ</div>
                          <div class="field-mini-spec"><strong>คะแนนสูงสุด</strong>50 คะแนน</div>
                          <div class="field-mini-spec"><strong>เหมาะสำหรับ</strong>อายุไม่เกิน 9 ปี</div>
                          <div class="field-mini-spec"><strong>วัสดุ</strong>ไวนิลคุณภาพสูง กันน้ำ</div>
                          <div class="field-mini-spec"><strong>การใช้งาน</strong>ใช้ซ้ำได้ / พับเก็บง่าย</div>
                        </div>
                        <div class="field-select-hint"><i class="ti ti-hand-click"></i> คลิกเพื่อดูสินค้า</div>
                      </div>
                    </div>

                    <div class="field-showcase-card" onclick="openProductOptions('intermediate', this)">
                      <div class="field-showcase-image">
                        <img src="/images/field-intermediate.png" alt="สนาม Intermediate">
                        <span class="field-level-badge" style="background:#2563EB">🔥 Intermediate</span>
                      </div>
                      <div class="field-showcase-body">
                        <div class="field-showcase-title">สนาม Intermediate</div>
                        <div class="field-spec-grid">
                          <div class="field-mini-spec"><strong>ขนาดสนาม</strong>236 × 114 ซม.</div>
                          <div class="field-mini-spec"><strong>ภารกิจ</strong>5 ภารกิจ</div>
                          <div class="field-mini-spec"><strong>คะแนนสูงสุด</strong>100 คะแนน</div>
                          <div class="field-mini-spec"><strong>เหมาะสำหรับ</strong>อายุ 10–14 ปี</div>
                          <div class="field-mini-spec"><strong>วัสดุ</strong>ไวนิลคุณภาพสูง กันน้ำ</div>
                          <div class="field-mini-spec"><strong>การใช้งาน</strong>ใช้ซ้ำได้ / พับเก็บง่าย</div>
                        </div>
                        <div class="field-select-hint"><i class="ti ti-hand-click"></i> คลิกเพื่อดูสินค้า</div>
                      </div>
                    </div>

                    <div class="field-showcase-card" onclick="openProductOptions('advance', this)">
                      <div class="field-showcase-image">
                        <img src="/images/field-advance.png" alt="สนาม Advance">
                        <span class="field-level-badge" style="background:#EA580C">🚀 Advance</span>
                      </div>
                      <div class="field-showcase-body">
                        <div class="field-showcase-title">สนาม Advance</div>
                        <div class="field-spec-grid">
                          <div class="field-mini-spec"><strong>ขนาดสนาม</strong>236 × 114 ซม.</div>
                          <div class="field-mini-spec"><strong>ภารกิจ</strong>5 ภารกิจ</div>
                          <div class="field-mini-spec"><strong>คะแนนสูงสุด</strong>100 คะแนน</div>
                          <div class="field-mini-spec"><strong>เหมาะสำหรับ</strong>อายุ 12 ปีขึ้นไป</div>
                          <div class="field-mini-spec"><strong>วัสดุ</strong>ไวนิลคุณภาพสูง กันน้ำ</div>
                          <div class="field-mini-spec"><strong>การใช้งาน</strong>ใช้ซ้ำได้ / พับเก็บง่าย</div>
                        </div>
                        <div class="field-select-hint"><i class="ti ti-hand-click"></i> คลิกเพื่อดูสินค้า</div>
                      </div>
                    </div>
                  </div>

                  <div class="section-heading">
                    <div>
                      <div class="section-heading-title">🛒 เลือกสินค้า Pre-order</div>
                      <div class="section-heading-sub">คลิกสนามด้านบนเพื่อเลือกสินค้าของรุ่นนั้น</div>
                    </div>
                  </div>

                  <div>


                    <% for (var ti=0; ti < tiers.length; ti++) { %>
                      <% var t=tiers[ti]; %>
                        <div class="product-options-wrap" id="options-<%= t.key %>">
                          <div class="product-options-head" style="background:<%= t.accent || t.color %>">
                            <div>
                              <div class="product-options-head-title">
                                <%= t.emoji %> เลือกสินค้า <%= t.label %>
                              </div>
                              <div class="product-options-head-sub">เลือกได้หลายรายการ และกำหนดจำนวนที่ต้องการ</div>
                            </div>
                            <button type="button" class="choose-field-btn" onclick="closeProductOptions(event)"
                              style="background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.25);color:#fff">
                              <i class="ti ti-x"></i> ปิด
                            </button>
                          </div>

                          <div class="product-options-body">
                            <div class="product-options-list">
                              <% for (var ii=0; ii < t.items.length; ii++) { %>
                                <% var item=t.items[ii]; %>
                                  <div class="product-item" id="item-<%= item.key %>"
                                    onclick="toggleItem('<%= item.key %>',this)">
                                    <div class="product-thumb">
                                      <img src="<%= '/images/product/product-' + item.key + '.png' %>"
                                        alt="<%= item.name %>" onerror="this.style.display='none'">
                                    </div>
                                    <div class="custom-checkbox" id="cb-<%= item.key %>"><i class="ti ti-check"></i>
                                    </div>
                                    <div class="product-content">
                                      <div class="product-item-name">
                                        <%= item.name %>
                                      </div>
                                      <div class="product-item-desc">
                                        <%= item.desc %>
                                      </div>
                                      <div class="qty-wrap" id="qty-wrap-<%= item.key %>" style="display:none">
                                        <span class="qty-label">จำนวน:</span>
                                        <div class="qty-control">
                                          <button type="button" class="qty-btn"
                                            onclick="changeQty('<%= item.key %>',-1,event)">−</button>
                                          <input class="qty-num" type="number" id="qty-<%= item.key %>" value="1"
                                            min="1" max="99" oninput="updateSummary()">
                                          <button type="button" class="qty-btn"
                                            onclick="changeQty('<%= item.key %>',1,event)">+</button>
                                        </div>
                                      </div>
                                    </div>
                                    <div class="price-wrap">
                                      <% if (promoActive) { %>
                                        <div class="price-discount-badge">-<%= promoPercent %>%</div>
                                        <div class="price-original">
                                          <%= item.priceFormatted %>.-
                                        </div>
                                        <div class="price-promo">
                                          <%= item.promoPriceFormatted %>.- <span
                                              style="font-size:10px;font-weight:600;color:#94A3B8">บาท</span>
                                        </div>
                                        <% } else { %>
                                          <div class="price-normal" style="color:<%= t.accent %>">
                                            <%= item.priceFormatted %>.- <span
                                                style="font-size:10px;font-weight:600;color:#94A3B8">บาท</span>
                                          </div>
                                          <% } %>
                                    </div>
                                  </div>
                                  <% } %>
                            </div>
                          </div>
                        </div>
                        <% } %>

                          <div class="checkout-layout">
                            <div class="checkout-main">
                              <div class="form-card">
                                <div class="form-card-title"><i class="ti ti-school"></i> ข้อมูลผู้สั่งซื้อ</div>
                                <div class="fg">
                                  <div class="fl">ชื่อโรงเรียน / สถาบัน *</div>
                                  <input class="fi" name="school_name" placeholder="ชื่อโรงเรียนหรือสถาบัน" required
                                    value="<%= formData.school_name || '' %>">
                                </div>
                                <div class="form-grid-2">
                                  <div class="fg" style="margin-bottom:0">
                                    <div class="fl">ชื่อผู้ติดต่อ *</div>
                                    <input class="fi" name="contact_name" placeholder="ชื่อ-นามสกุล" required
                                      value="<%= formData.contact_name || '' %>">
                                  </div>
                                  <div class="fg" style="margin-bottom:0">
                                    <div class="fl">เบอร์โทรศัพท์ *</div>
                                    <input class="fi" name="phone" type="tel" placeholder="0XX-XXX-XXXX" required
                                      value="<%= formData.phone || '' %>">
                                  </div>
                                </div>
                                <div class="fg" style="margin-top:12px">
                                  <div class="fl">อีเมล (ไม่บังคับ)</div>
                                  <input class="fi" name="email" type="email" placeholder="email@example.com"
                                    value="<%= formData.email || '' %>">
                                </div>
                                <div class="fg">
                                  <div class="fl">ที่อยู่สำหรับจัดส่ง *</div>
                                  <input class="fi" name="address" placeholder="ที่อยู่ เลขที่ ซอย ถนน ตำบล/แขวง"
                                    value="<%= formData.address || '' %>">
                                </div>
                                <div class="form-grid-3">
                                  <div class="fg" style="margin-bottom:0">
                                    <div class="fl">อำเภอ / เขต</div>
                                    <input class="fi" name="district" placeholder="อำเภอ / เขต"
                                      value="<%= formData.district || '' %>">
                                  </div>
                                  <div class="fg" style="margin-bottom:0">
                                    <div class="fl">จังหวัด</div>
                                    <input class="fi" name="province" placeholder="จังหวัด"
                                      value="<%= formData.province || '' %>">
                                  </div>
                                  <div class="fg" style="margin-bottom:0">
                                    <div class="fl">รหัสไปรษณีย์</div>
                                    <input class="fi" name="zipcode" placeholder="XXXXX"
                                      value="<%= formData.zipcode || '' %>">
                                  </div>
                                </div>
                                <div class="fg" style="margin-top:12px">
                                  <div class="fl">หมายเหตุ (ไม่บังคับ)</div>
                                  <textarea class="fi" name="note" placeholder="ข้อมูลเพิ่มเติม"
                                    style="min-height:70px;resize:vertical"><%= formData.note || '' %></textarea>
                                </div>
                              </div>

                              <div class="info-note">
                                <i class="ti ti-info-circle" style="flex-shrink:0;margin-top:1px"></i>
                                <span>กรุณาตรวจสอบข้อมูลให้ถูกต้องก่อนยืนยัน
                                  ทีมงานจะติดต่อกลับเพื่อยืนยันและแจ้งรายละเอียดการชำระเงิน</span>
                              </div>

                            </div>
                            <div class="sidebar-sticky">
                              <div class="field-detail-card" id="field-detail-card">
                                <div class="field-detail-head" id="field-detail-head" style="background:#64748B">
                                  <i class="ti ti-map"></i>
                                  <span id="field-detail-title">รายละเอียดสนาม</span>
                                </div>
                                <div id="field-detail-body">
                                  <div class="field-detail-empty">
                                    <i class="ti ti-hand-click"></i>
                                    คลิก "ดูรายละเอียดสนาม"<br>เพื่อแสดงข้อมูลสนาม
                                  </div>
                                </div>
                              </div>

                              <div class="summary-card">
                                <div class="summary-head"><i class="ti ti-clipboard-list"></i> สรุปคำสั่งซื้อ</div>
                                <div class="summary-body">
                                  <% if (promoActive) { %>
                                    <div
                                      style="background:#FEF2F2;border:1px solid #FECDD3;border-radius:8px;padding:8px 12px;margin-bottom:12px;font-size:12px;color:#DC2626;font-weight:700;display:flex;align-items:center;gap:6px">
                                      <i class="ti ti-tag"></i> โปรโมชั่น ลด <%= promoPercent %>%
                                    </div>
                                    <% } %>
                                      <div id="summary-items">
                                        <div class="summary-empty"><i
                                            class="ti ti-shopping-cart"></i>เลือกสินค้าเพื่อดูสรุป</div>
                                      </div>
                                      <div class="summary-divider"></div>
                                      <% if (promoActive) { %>
                                        <div
                                          style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
                                          <span style="color:#64748B">ราคาก่อนลด</span>
                                          <span style="color:#94A3B8;text-decoration:line-through"
                                            id="summary-original">0.-</span>
                                        </div>
                                        <div
                                          style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:8px">
                                          <span style="color:#DC2626;font-weight:700">ส่วนลด <%= promoPercent %>%</span>
                                          <span style="color:#DC2626;font-weight:700" id="summary-discount">-0.-</span>
                                        </div>
                                        <% } %>
                                          <div class="summary-total-row">
                                            <span class="summary-total-label">ยอดรวมทั้งสิ้น</span>
                                            <span class="summary-total-price" id="summary-total">0.-</span>
                                          </div>
                                          <div style="font-size:11px;color:#EA580C;margin-top:4px;text-align:right">*
                                            ยังไม่รวมค่าจัดส่ง</div>
                                          <button type="submit" class="btn-submit" id="submitBtn" disabled>
                                            <i class="ti ti-shopping-bag"></i> ยืนยันการสั่งซื้อ (Pre-order)
                                          </button>
                                          <div class="trust-note"><i class="ti ti-shield-check"></i>
                                            ข้อมูลของท่านปลอดภัย
                                            100%
                                          </div>
                                </div>
                              </div>
                            </div>
                          </div>
                  </div>
              </form>

              <% } %>

                <script>
                  var PROMO_ACTIVE = <%= promoActive ? 'true' : 'false' %>;
                  var PROMO_PERCENT = <%= promoPercent || 0 %>;
                  var PRICES_ORIGINAL = {
                    'beginner-full': 2500, 'beginner-mat': 2400, 'beginner-field': 500, 'beginner-mission': 500,
                    'intermediate-full': 2500, 'intermediate-mat': 2400, 'intermediate-field': 500, 'intermediate-mission': 500,
                    'advance-full': 2500, 'advance-mat': 2400, 'advance-field': 500, 'advance-mission': 500
                  };
                  var PRICES_FINAL = {
                    'beginner-full':<%= Math.round(2500 * (1 - promoPercent / 100)) %>, 'beginner-mat':<%= Math.round(2400 * (1 - promoPercent / 100)) %>, 'beginner-field':<%= Math.round(500 * (1 - promoPercent / 100)) %>, 'beginner-mission':<%= Math.round(500 * (1 - promoPercent / 100)) %>,
                    'intermediate-full':<%= Math.round(2500 * (1 - promoPercent / 100)) %>, 'intermediate-mat':<%= Math.round(2400 * (1 - promoPercent / 100)) %>, 'intermediate-field':<%= Math.round(500 * (1 - promoPercent / 100)) %>, 'intermediate-mission':<%= Math.round(500 * (1 - promoPercent / 100)) %>,
                    'advance-full':<%= Math.round(2500 * (1 - promoPercent / 100)) %>, 'advance-mat':<%= Math.round(2400 * (1 - promoPercent / 100)) %>, 'advance-field':<%= Math.round(500 * (1 - promoPercent / 100)) %>, 'advance-mission':<%= Math.round(500 * (1 - promoPercent / 100)) %>
};
                  var NAMES = {
                    'beginner-full': 'เซตสนาม Beginner', 'beginner-mat': 'สนามอย่างเดียว Beginner', 'beginner-field': 'ไฟล์สนาม Beginner', 'beginner-mission': 'ชิ้นส่วนภารกิจ Beginner',
                    'intermediate-full': 'เซตสนาม Intermediate', 'intermediate-mat': 'สนามอย่างเดียว Intermediate', 'intermediate-field': 'ไฟล์สนาม Intermediate', 'intermediate-mission': 'ชิ้นส่วนภารกิจ Intermediate',
                    'advance-full': 'เซตสนาม Advance', 'advance-mat': 'สนามอย่างเดียว Advance', 'advance-field': 'ไฟล์สนาม Advance', 'advance-mission': 'ชิ้นส่วนภารกิจ Advance'
                  };
                  var CB_COLORS = {
                    'beginner-full': '#16A34A', 'beginner-mat': '#16A34A', 'beginner-field': '#7C3AED', 'beginner-mission': '#EA580C',
                    'intermediate-full': '#2563EB', 'intermediate-mat': '#2563EB', 'intermediate-field': '#7C3AED', 'intermediate-mission': '#EA580C',
                    'advance-full': '#EA580C', 'advance-mat': '#EA580C', 'advance-field': '#7C3AED', 'advance-mission': '#EA580C'
                  };
                  var FIELD_DATA = {
                    beginner: { title: 'สนาม Beginner', color: '#16A34A', img: '/images/field-beginner.png', specs: [{ label: 'ขนาดสนาม', value: '236 x 114 ซม.' }, { label: 'วัสดุ', value: 'ไวนิลคุณภาพสูง กันน้ำ' }, { label: 'การใช้งาน', value: 'ใช้ซ้ำได้ / พับเก็บง่าย' }, { label: 'ภารกิจ', value: '4 ภารกิจ' }, { label: 'คะแนนสูงสุด', value: '50 คะแนน' }, { label: 'เหมาะสำหรับ', value: 'อายุไม่เกิน 9 ปี' }] },
                    intermediate: { title: 'สนาม Intermediate', color: '#2563EB', img: '/images/field-intermediate.png', specs: [{ label: 'ขนาดสนาม', value: '236 x 114 ซม.' }, { label: 'วัสดุ', value: 'ไวนิลคุณภาพสูง กันน้ำ' }, { label: 'การใช้งาน', value: 'ใช้ซ้ำได้ / พับเก็บง่าย' }, { label: 'ภารกิจ', value: '5 ภารกิจ' }, { label: 'คะแนนสูงสุด', value: '100 คะแนน' }, { label: 'เหมาะสำหรับ', value: 'อายุ 10-14 ปี' }] },
                    advance: { title: 'สนาม Advance', color: '#EA580C', img: '/images/field-advance.png', specs: [{ label: 'ขนาดสนาม', value: '236 x 114 ซม.' }, { label: 'วัสดุ', value: 'ไวนิลคุณภาพสูง กันน้ำ' }, { label: 'การใช้งาน', value: 'ใช้ซ้ำได้ / พับเก็บง่าย' }, { label: 'ภารกิจ', value: '5 ภารกิจ' }, { label: 'คะแนนสูงสุด', value: '100 คะแนน' }, { label: 'เหมาะสำหรับ', value: 'อายุ 12 ปีขึ้นไป' }] }
                  };

                  var checkedItems = {};

                  function showDetail(tier, e) {
                    if (e) e.stopPropagation();
                    var data = FIELD_DATA[tier];
                    if (!data) return;
                    document.getElementById('field-detail-head').style.background = data.color;
                    document.getElementById('field-detail-title').textContent = data.title;
                    var specsHtml = data.specs.map(function (s) {
                      return '<div class="field-spec-row"><span class="field-spec-label">' + s.label + '</span><span class="field-spec-value">' + s.value + '</span></div>';
                    }).join('');
                    document.getElementById('field-detail-body').innerHTML =
                      '<img src="' + data.img + '" alt="' + data.title + '" style="width:100%;aspect-ratio:2/1;object-fit:cover;display:block" onerror="this.style.display=\'none\'">'
                      + '<div class="field-specs"><div style="font-size:12px;font-weight:800;color:#0F172A;margin-bottom:8px">ข้อมูลสนาม</div>' + specsHtml + '</div>';
                    if (window.innerWidth < 900) {
                      document.getElementById('field-detail-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                  }


                  var activeFieldKey = null;

                  function openProductOptions(tier, card) {
                    var allCards = document.querySelectorAll('.field-showcase-card');
                    allCards.forEach(function (c) {
                      c.classList.remove('active');
                      c.style.removeProperty('--field-color');
                    });

                    var allOptions = document.querySelectorAll('.product-options-wrap');
                    allOptions.forEach(function (o) {
                      o.classList.remove('active');
                    });

                    var target = document.getElementById('options-' + tier);
                    if (!target) return;

                    var colorMap = {
                      beginner: '#16A34A',
                      intermediate: '#2563EB',
                      advance: '#EA580C'
                    };

                    if (card) {
                      card.classList.add('active');
                      card.style.setProperty('--field-color', colorMap[tier] || '#2563EB');
                    }

                    target.classList.add('active');
                    activeFieldKey = tier;

                    setTimeout(function () {
                      target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }, 30);
                  }

                  function closeProductOptions(e) {
                    if (e) e.stopPropagation();

                    document.querySelectorAll('.field-showcase-card').forEach(function (c) {
                      c.classList.remove('active');
                      c.style.removeProperty('--field-color');
                    });

                    document.querySelectorAll('.product-options-wrap').forEach(function (o) {
                      o.classList.remove('active');
                    });

                    activeFieldKey = null;
                  }

                  function toggleItem(id, el) {
                    if (event && event.target.closest && event.target.closest('.qty-control')) return;
                    if (event && event.target.closest && event.target.closest('.detail-btn')) return;
                    var isChecked = checkedItems[id];
                    var cb = document.getElementById('cb-' + id);
                    var qtyWrap = document.getElementById('qty-wrap-' + id);
                    if (isChecked) {
                      delete checkedItems[id];
                      el.style.borderColor = '#E2E8F0';
                      el.classList.remove('is-selected');
                      cb.style.background = '#fff';
                      cb.style.borderColor = '#CBD5E1';
                      cb.querySelector('i').style.opacity = '0';
                      qtyWrap.style.display = 'none';
                    } else {
                      checkedItems[id] = 1;
                      var color = CB_COLORS[id] || '#2563EB';
                      el.style.borderColor = color;
                      el.classList.add('is-selected');
                      cb.style.background = color;
                      cb.style.borderColor = color;
                      cb.querySelector('i').style.opacity = '1';
                      qtyWrap.style.display = 'flex';
                    }
                    updateSummary();
                  }

                  function changeQty(id, delta, e) {
                    if (e) e.stopPropagation();
                    var input = document.getElementById('qty-' + id);
                    var val = Math.max(1, Math.min(99, (parseInt(input.value) || 1) + delta));
                    input.value = val;
                    if (checkedItems[id]) checkedItems[id] = val;
                    updateSummary();
                  }

                  function updateSummary() {
                    Object.keys(checkedItems).forEach(function (id) {
                      var input = document.getElementById('qty-' + id);
                      if (input) checkedItems[id] = parseInt(input.value) || 1;
                    });
                    var keys = Object.keys(checkedItems);
                    if (keys.length === 0) {
                      document.getElementById('summary-items').innerHTML = '<div class="summary-empty"><i class="ti ti-shopping-cart"></i>เลือกสินค้าเพื่อดูสรุป</div>';
                      document.getElementById('summary-total').textContent = '0.-';
                      if (document.getElementById('summary-original')) document.getElementById('summary-original').textContent = '0.-';
                      if (document.getElementById('summary-discount')) document.getElementById('summary-discount').textContent = '-0.-';
                      document.getElementById('submitBtn').disabled = true;
                      document.getElementById('items_json').value = '';
                      return;
                    }
                    var totalOriginal = 0;
                    var totalFinal = 0;
                    var html = '';
                    keys.forEach(function (id) {
                      var qty = checkedItems[id];
                      var origPrice = PRICES_ORIGINAL[id] || 0;
                      var finalPrice = PROMO_ACTIVE ? (PRICES_FINAL[id] || 0) : origPrice;
                      totalOriginal += origPrice * qty;
                      totalFinal += finalPrice * qty;
                      html += '<div class="summary-line"><div>'
                        + '<div class="summary-line-name">' + (NAMES[id] || id) + '</div>'
                        + '<div class="summary-line-qty">' + qty + ' ชุด x ' + finalPrice.toLocaleString() + ' บาท</div>'
                        + '</div><div class="summary-line-price">' + (finalPrice * qty).toLocaleString() + '.-</div></div>';
                    });
                    document.getElementById('summary-items').innerHTML = html;
                    document.getElementById('summary-total').textContent = totalFinal.toLocaleString() + '.-';
                    if (document.getElementById('summary-original')) {
                      document.getElementById('summary-original').textContent = totalOriginal.toLocaleString() + '.-';
                    }
                    if (document.getElementById('summary-discount')) {
                      document.getElementById('summary-discount').textContent = '-' + (totalOriginal - totalFinal).toLocaleString() + '.-';
                    }
                    document.getElementById('submitBtn').disabled = false;
                    document.getElementById('items_json').value = JSON.stringify(checkedItems);
                  }

                  document.getElementById('preorderForm') && document.getElementById('preorderForm').addEventListener('submit', function (e) {
                    if (Object.keys(checkedItems).length === 0) {
                      e.preventDefault();
                      alert('กรุณาเลือกสินค้าอย่างน้อย 1 รายการ');
                    }
                  });
                </script>

                <script>
                  /* TOPBAR DROPDOWN */
                  document.querySelectorAll('.dropdown').forEach(function (dd) {
                    var menu = dd.querySelector('.dropdown-menu');
                    var timer;

                    dd.addEventListener('mouseenter', function () {
                      clearTimeout(timer);
                      menu.style.display = 'block';
                    });

                    dd.addEventListener('mouseleave', function () {
                      timer = setTimeout(function () {
                        menu.style.display = 'none';
                      }, 200);
                    });

                    menu.addEventListener('mouseenter', function () {
                      clearTimeout(timer);
                    });

                    menu.addEventListener('mouseleave', function () {
                      timer = setTimeout(function () {
                        menu.style.display = 'none';
                      }, 200);
                    });
                  });

                  /* TOPBAR SCROLL */
                  window.addEventListener('scroll', function () {
                    var topbar = document.querySelector('.topbar');
                    if (!topbar) return;

                    if (window.scrollY > 10) {
                      topbar.classList.add('scrolled');
                    } else {
                      topbar.classList.remove('scrolled');
                    }
                  });
                </script>

</body>

</html>