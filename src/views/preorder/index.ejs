<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pre-order สนามแข่งขัน — RCL 2026</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700;800&family=Kanit:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #F5F7FB;
      --surface: #FFFFFF;
      --text: #0F172A;
      --muted: #64748B;
      --line: #E2E8F0;
      --blue: #2563EB;
      --blue-soft: #EFF6FF;
      --green: #16A34A;
      --orange: #EA580C;
      --shadow: 0 8px 24px rgba(15, 23, 42, .06);
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    html {
      scroll-behavior: smooth
    }

    body {
      font-family: 'Sarabun', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    a {
      text-decoration: none;
      color: inherit
    }

    button,
    input,
    textarea {
      font-family: 'Sarabun', sans-serif
    }


    /* =========================================================
   RCL TOPBAR
========================================================= */
    .topbar {
      position: fixed;
      inset: 0 0 auto;
      z-index: 1000;
      height: 84px;
      padding: 0 30px;
      display: flex;
      align-items: center;
      gap: 10px;
      background: transparent;
      border-bottom: 1px solid transparent;
      transition: all .3s ease;
    }

    .topbar.scrolled {
      background: rgba(255, 255, 255, .92);
      border-bottom-color: rgba(226, 232, 240, .9);
      box-shadow: 0 4px 18px rgba(15, 23, 42, .06);
      backdrop-filter: blur(16px);
    }

    .topbar-logo {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
    }

    .topbar-logo img {
      width: auto;
      height: 120px;
      object-fit: contain;
    }

    .topbar-nav {
      flex: 1;
      margin-left: 18px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-link {
      min-height: 52px;
      padding: 0 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      border: 0 !important;
      border-radius: 11px;
      background: transparent !important;
      color: #334155;
      font-family: 'Kanit', 'Sarabun', sans-serif;
      font-size: 17px;
      font-weight: 600;
      letter-spacing: 1px;
      line-height: 1.15;
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition: all .2s ease;
    }

    .nav-link span:first-child {
      font-size: 16px;
      font-weight: 700;
    }

    .nav-link span:last-child {
      font-family: 'Kanit', 'Sarabun', sans-serif;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0;
    }

    .nav-link i {
      font-size: 17px;
    }

    .nav-link:hover {
      color: #2563EB;
      background: #F4F8FF !important;
      transform: translateY(-1px);
    }

    .nav-link.active {
      color: #2563EB !important;
      background: #EFF6FF !important;
    }

    /* Certificate */
    .certificate-btn {
      background: linear-gradient(135deg, #FFF7D6, #FEF3C7) !important;
      color: #92400E !important;
      border: 1px solid #FCD34D !important;
      border-radius: 90px !important;
      box-shadow: 0 4px 12px rgba(180, 120, 20, .18);
    }

    .certificate-btn:hover {
      background: linear-gradient(135deg, #FDE68A, #FCD34D) !important;
      color: #78350F !important;
      border-color: #F59E0B !important;
      box-shadow: 0 7px 18px rgba(180, 120, 20, .28);
      transform: translateY(-2px);
    }

    .certificate-btn:active {
      transform: translateY(0);
      box-shadow: 0 3px 8px rgba(180, 120, 20, .20);
    }

    .topbar-actions {
      flex: 0 0 auto;
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-reg,
    .btn-login {
      min-height: 52px;
      padding: 0 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border-radius: 11px;
      font: 800 16px 'Sarabun', sans-serif;
      text-decoration: none;
      transition: all .2s ease;
    }

    .btn-reg {
      color: #fff;
      background: linear-gradient(135deg, #3478F6, #2563EB);
      border: 1px solid transparent;
      box-shadow: 0 10px 24px rgba(37, 99, 235, .24);
    }

    .btn-reg:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(37, 99, 235, .30);
    }

    .btn-login {
      color: #334155;
      background: #fff;
      border: 1px solid #E2E8F0;
    }

    .btn-login:hover {
      color: #2563EB;
      background: #F8FAFC;
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
    }

    /* DROPDOWN */
    .dropdown {
      position: relative;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      z-index: 1100;
      display: none;
      min-width: 215px;
      padding: 8px;
      background: rgba(255, 255, 255, .98);
      border: 1px solid #E2E8F0;
      border-radius: 14px;
      box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
    }

    .dropdown-item {
      min-height: 44px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-radius: 10px;
      color: #334155;
      font-family: 'Kanit', 'Sarabun', sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: all .18s ease;
    }

    .dropdown-item:hover,
    .dropdown-item.active {
      color: #2563EB;
      background: #EFF6FF;
    }

    .dropdown-item:first-child:hover {
      background: #FEF2F2;
      color: #DC2626;
    }

    .dropdown-item i {
      font-size: 17px;
      color: #64748B;
    }

    /* Responsive — Laptop */
    @media (min-width:901px) and (max-width:1199px) {
      .topbar {
        padding: 0 20px;
      }

      .topbar-logo img {
        height: 92px;
      }

      .nav-link {
        padding: 0 11px;
      }

      .nav-link span:first-child {
        font-size: 14px;
      }

      .nav-link span:last-child {
        font-size: 12px;
      }

      .btn-reg,
      .btn-login {
        padding: 0 14px;
        font-size: 14px;
      }
    }

    /* Responsive — Tablet */
    @media (min-width:641px) and (max-width:900px) {
      .topbar {
        height: 72px;
        padding: 0 16px;
      }

      .topbar-logo img {
        height: 70px;
      }

      .topbar-nav {
        margin-left: 4px;
        gap: 2px;
      }

      .nav-link {
        min-height: 44px;
        padding: 0 8px;
      }

      .nav-link span:first-child {
        font-size: 12px;
      }

      .nav-link span:last-child {
        font-size: 10px;
      }

      .btn-reg,
      .btn-login {
        min-height: 44px;
        padding: 0 12px;
        font-size: 13px;
      }
    }

    /* Responsive — Mobile */
    @media (max-width:640px) {
      .topbar {
        height: 60px;
        padding: 0 12px;
      }

      .topbar-logo img {
        height: 46px;
        max-width: 92px;
      }

      .topbar-nav {
        margin-left: 2px;
        gap: 0;
      }

      .topbar-nav>a.nav-link {
        display: none;
      }

      .nav-link {
        min-height: 40px;
        padding: 0 7px;
      }

      .nav-link span:first-child {
        font-size: 11px;
      }

      .nav-link span:last-child {
        font-size: 9px;
      }

      .topbar-actions {
        gap: 4px;
      }

      .btn-reg {
        min-height: 40px;
        padding: 0 10px;
        font-size: 12px;
      }

      .btn-login {
        width: 40px;
        min-width: 40px;
        min-height: 40px;
        padding: 0;
        font-size: 0;
      }

      .btn-login i {
        font-size: 18px;
      }

      .dropdown-menu {
        position: fixed;
        top: 58px;
        left: 10px;
        right: 10px;
        min-width: 0;
      }
    }

    @media (max-width:430px) {
      .topbar-logo img {
        height: 40px;
        max-width: 76px;
      }

      .nav-link {
        padding: 0 5px;
      }
    }

    @media (max-width:360px) {
      .topbar-logo img {
        max-width: 64px;
      }

      .nav-link {
        padding: 0 4px;
      }
    }



    /* Promotion / hero */
    .promo-banner {
      background: linear-gradient(135deg, #EA580C, #DC2626);
      padding: 10px 18px 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .promo-banner-text {
      color: #fff;
      font-size: 20px;
      font-weight: 800
    }

    .promo-countdown {
      background: rgba(255, 255, 255, .18);
      border-radius: 999px;
      padding: 4px 11px;
      color: #fff;
      font-size: 18px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .page-hero {
      background:
        radial-gradient(circle at 15% 20%, rgba(96, 165, 250, .18), transparent 28%),
        radial-gradient(circle at 85% 80%, rgba(37, 99, 235, .22), transparent 30%),
        linear-gradient(135deg, #0B1220 0%, #172554 58%, #1554C7 100%);
      padding: 90px 10px 30px;
      text-align: center;
    }

    .page-hero-eyebrow {
      color: #60A5FA;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      margin-bottom: 5px;
    }

    .page-hero-title {
      font-family: 'Kanit', sans-serif;
      color: #fff;
      font-size: clamp(22px, 4vw, 40px);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 5px;
    }

    .page-hero-sub {
      color: rgba(255, 255, 255, .68);
      font-size: 12px
    }


    /* Main container */
    .page-wrap {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
      padding: 28px 0 52px;
    }

    .section-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 14px;
      margin: 0 0 13px;
    }

    .section-heading-title {
      font-family: 'Kanit', sans-serif;
      font-size: 21px;
      line-height: 1.25;
      font-weight: 700;
      color: var(--text);
    }

    .section-heading-sub {
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
    }

    /* Field cards */
    .field-showcase {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 28px;
    }

    .field-showcase-card {
      --field-color: #2563EB;
      background: var(--surface);
      border: 1.5px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: var(--shadow);
      cursor: pointer;
      transition: transform .18s, border-color .18s, box-shadow .18s;
    }

    .field-showcase-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(15, 23, 42, .09)
    }

    .field-showcase-card.active {
      border-color: var(--field-color);
      box-shadow: 0 0 0 2px var(--field-color), 0 14px 30px rgba(15, 23, 42, .10);
    }

    .field-showcase-image {
      position: relative;
      aspect-ratio: 2 / 1;
      overflow: hidden;
      background: #E2E8F0;
    }

    .field-showcase-image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover
    }

    .field-showcase-card.active .field-showcase-image:after {
      content: 'กำลังเลือก';
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 4px 9px;
      border-radius: 999px;
      background: rgba(15, 23, 42, .78);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
    }

    .field-level-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      color: #fff;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 800;
      z-index: 2;
      box-shadow: 0 3px 9px rgba(15, 23, 42, .18);
    }

    .field-showcase-body {
      padding: 15px 16px 14px
    }

    .field-showcase-title {
      font-family: 'Kanit', sans-serif;
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .field-spec-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px 14px;
    }

    .field-mini-spec {
      font-size: 11px;
      line-height: 1.45;
      color: var(--muted);
    }

    .field-mini-spec strong {
      display: block;
      color: #334155;
      font-size: 11px;
      font-weight: 800;
      margin-bottom: 1px;
    }

    .field-select-hint {
      display: flex;
      align-items: center;
      gap: 5px;
      border-top: 1px solid #F1F5F9;
      margin-top: 12px;
      padding-top: 10px;
      color: var(--blue);
      font-size: 11px;
      font-weight: 800;
    }

    /* Product options */
    .product-options-wrap {
      display: none;
      margin: 0 0 24px;
      animation: productReveal .2s ease-out;
    }

    .product-options-wrap.active {
      display: block
    }

    @keyframes productReveal {
      from {
        opacity: 0;
        transform: translateY(-5px)
      }

      to {
        opacity: 1;
        transform: translateY(0)
      }
    }

    .product-options-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      color: #fff;
      padding: 13px 16px;
      border-radius: 14px 14px 0 0;
    }

    .product-options-head-title {
      font-family: 'Kanit', sans-serif;
      font-size: 18px;
      font-weight: 700;
      line-height: 1.25;
    }

    .product-options-head-sub {
      font-size: 11px;
      opacity: .86;
      margin-top: 2px;
    }

    .choose-field-btn {
      border: 1px solid rgba(255, 255, 255, .3);
      background: rgba(255, 255, 255, .15);
      color: #fff;
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }

    .product-options-body {
      background: #F8FAFC;
      border: 1px solid var(--line);
      border-top: 0;
      border-radius: 0 0 14px 14px;
      padding: 10px;
    }

    .product-options-list {
      display: flex;
      flex-direction: column;
      gap: 8px
    }

    .product-item {
      width: 100%;
      min-height: auto;
      background: #fff;
      border: 1.5px solid var(--line);
      border-radius: 11px;
      padding: 10px 14px;
      display: grid;
      grid-template-columns: 220px 28px minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: .15s;
    }

    .product-item:hover {
      border-color: #BFDBFE;
      box-shadow: 0 4px 14px rgba(37, 99, 235, .07)
    }

    .product-item.is-selected {
      border-color: var(--blue);
      box-shadow: 0 0 0 1px var(--blue), 0 5px 15px rgba(37, 99, 235, .08);
      background: #FCFEFF;
    }

    .product-thumb {
      width: 210px;
      height: 100px;
      min-width: 64px;
      min-height: 64px;
      border-radius: 8px;
      overflow: hidden;
      background: #F1F5F9;
      border: 1px solid var(--line);
    }

    .product-thumb img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover
    }

    .product-content {
      min-width: 0;
      width: 100%;
      overflow: hidden;
    }

    .product-item-name {
      font-size: 18px;
      line-height: 1.35;
      font-weight: 800;
      color: #0F172A;
    }

    .product-item-desc {
      font-size: 14px;
      line-height: 1.4;
      color: var(--muted);
      margin-top: 1px;
    }

    .price-wrap {
      min-width: 105px;
      text-align: right;
      justify-self: end;
      white-space: nowrap;
    }

    .price-discount-badge {
      display: inline-block;
      color: #DC2626;
      background: #FEF2F2;
      border-radius: 999px;
      padding: 2px 6px;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 2px;
    }

    .price-original {
      color: #94A3B8;
      text-decoration: line-through;
      font-size: 17px;
      line-height: 1.1;
    }

    .price-promo {
      color: #DC2626;
      font-size: 25px;
      line-height: 1.15;
      font-weight: 900;
    }

    .price-normal {
      font-size: 16px;
      font-weight: 900
    }

    .custom-checkbox {
      width: 24px;
      height: 24px;
      border: 2px solid #CBD5E1;
      border-radius: 7px;
      background: #fff;
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 14px;
      flex-shrink: 0;
    }

    .custom-checkbox i {
      display: none
    }

    .qty-wrap {
      display: flex;
      align-items: center;
      gap: 7px;
      margin-top: 6px;
    }

    .qty-label {
      font-size: 10px;
      color: var(--muted);
      font-weight: 700
    }

    .qty-control {
      display: flex;
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 7px;
      overflow: hidden;
      background: #fff
    }

    .qty-btn {
      width: 25px;
      height: 25px;
      border: 0;
      background: #F8FAFC;
      color: #334155;
      cursor: pointer;
      font-weight: 800;
    }

    .qty-num {
      width: 38px;
      height: 25px;
      border: 0;
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
      text-align: center;
      font-size: 11px;
      outline: none;
    }

    /* Buyer + summary */
    .checkout-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 18px;
      align-items: start;
      margin-top: 20px;
    }

    .checkout-main {
      min-width: 0
    }

    .sidebar-sticky {
      position: sticky;
      top: 76px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .form-card,
    .summary-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }

    .form-card {
      padding: 20px
    }

    .form-card-title,
    .summary-head {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Kanit', sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: #0F172A;
    }

    .form-card-title {
      padding-bottom: 12px;
      margin-bottom: 16px;
      border-bottom: 1px solid #F1F5F9;
    }

    .form-card-title i,
    .summary-head i {
      color: var(--blue)
    }

    .fg {
      display: flex;
      flex-direction: column;
      gap: 5px;
      margin-bottom: 12px
    }

    .fl {
      font-size: 11px;
      font-weight: 800;
      color: #475569
    }

    .fi {
      width: 100%;
      padding: 10px 12px;
      border: 1.5px solid var(--line);
      border-radius: 9px;
      background: #fff;
      color: #1E293B;
      font-size: 13px;
      outline: none;
      transition: .15s;
    }

    .fi:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
    }

    .form-grid-2,
    .form-grid-3 {
      display: grid;
      gap: 12px;
      margin-bottom: 12px;
    }

    .form-grid-2 {
      grid-template-columns: 1fr 1fr
    }

    .form-grid-3 {
      grid-template-columns: 1fr 1fr 1fr
    }

    textarea.fi {
      min-height: 78px;
      resize: vertical
    }

    .info-note {
      margin-top: 12px;
      background: #FFF7ED;
      border: 1px solid #FED7AA;
      border-radius: 10px;
      padding: 10px 12px;
      color: #92400E;
      font-size: 11px;
      display: flex;
      gap: 8px;
      line-height: 1.5;
    }

    .footer-badges {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin-top: 12px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 14px;
      overflow: hidden;
    }

    .footer-badge {
      padding: 15px 10px;
      text-align: center;
      border-right: 1px solid #F1F5F9;
    }

    .footer-badge:last-child {
      border-right: 0
    }

    .footer-badge-icon {
      width: 36px;
      height: 36px;
      margin: 0 auto 6px;
      border-radius: 50%;
      background: var(--blue-soft);
      color: var(--blue);
      display: grid;
      place-items: center;
      font-size: 17px;
    }

    .footer-badge-title {
      font-size: 11px;
      font-weight: 800;
      color: #0F172A
    }

    .footer-badge-sub {
      font-size: 10px;
      color: var(--muted);
      line-height: 1.45;
      margin-top: 2px
    }

    /* Hide legacy field-detail panel because field details are now above */
    #field-detail-card {
      display: none
    }

    .summary-head {
      padding: 14px 16px;
      border-bottom: 1px solid #F1F5F9;
    }

    .summary-body {
      padding: 14px 16px
    }

    .summary-empty {
      padding: 20px 10px;
      text-align: center;
      color: #94A3B8;
      font-size: 11px;
    }

    .summary-divider {
      height: 1px;
      background: #F1F5F9;
      margin: 12px 0
    }

    .summary-line {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 6px 0;
      font-size: 11px;
    }

    .summary-line-name {
      flex: 1;
      color: #334155
    }

    .summary-line-qty {
      color: #94A3B8
    }

    .summary-line-price {
      font-weight: 800;
      color: #0F172A
    }

    .summary-total-row {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 10px;
      padding-top: 5px;
    }

    .summary-total-label {
      font-size: 12px;
      font-weight: 800;
      color: #334155
    }

    .summary-total-price {
      font-size: 24px;
      font-weight: 900;
      color: #DC2626
    }

    .btn-submit {
      width: 100%;
      margin-top: 13px;
      border: 0;
      border-radius: 10px;
      padding: 12px 14px;
      background: var(--blue);
      color: #fff;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 6px 14px rgba(37, 99, 235, .18);
    }

    .btn-submit:disabled {
      opacity: .45;
      cursor: not-allowed;
      box-shadow: none
    }

    .trust-note {
      margin-top: 9px;
      text-align: center;
      color: #64748B;
      font-size: 10px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4px;
    }

    /* Existing field detail data styles, kept for JS compatibility */
    .field-detail-head {
      display: flex;
      align-items: center;
      gap: 7px;
      color: #fff;
      padding: 10px 14px;
      border-radius: 10px 10px 0 0;
      font-weight: 800
    }

    .field-detail-body {
      padding: 12px
    }

    .field-detail-empty {
      text-align: center;
      color: #94A3B8;
      font-size: 11px;
      padding: 20px
    }



    /* =========================================================
   RESPONSIVE — SINGLE SOURCE OF TRUTH
   ========================================================= */
    @media(min-width:1440px) {
      .topbar {
        padding-inline: 48px
      }
    }

    @media(min-width:901px) and (max-width:1199px) {
      .topbar {
        padding: 0 20px
      }

      .topbar-logo {
        width: 106px;
        flex: 0 0 106px;
        display: inline-flex;
        align-items: center;
      }

      .topbar-logo img {
        width: auto;
        height: 120px;
        max-width: 82px
      }

      .topbar-nav {
        margin-left: 3px;
        gap: 2px
      }

      .nav-link {
        padding: 0 11px;
        font-size: 14px
      }

      .btn-login {
        padding: 0 13px;
        font-size: 13px
      }
    }

    @media(max-width:1050px) {
      .checkout-layout {
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 16px
      }

      .product-item {
        grid-template-columns: 68px 26px minmax(0, 1fr) 105px;
        gap: 10px;
      }

      .product-thumb {
        width: 58px;
        height: 58px;
        min-width: 58px;
        min-height: 58px;
      }

      .price-wrap {
        min-width: 105px
      }
    }

    @media(max-width:900px) {
      .topbar {
        height: 68px;
        padding: 0 18px
      }

      .topbar-logo {
        width: 88px;
        flex-basis: 88px
      }

      .topbar-logo img {
        height: 40px;
        max-width: 82px
      }

      .topbar-nav {
        margin-left: 2px;
        gap: 2px
      }

      .nav-link {
        min-height: 44px;
        padding: 0 10px;
        font-size: 14px;
        letter-spacing: .2px
      }

      .btn-login {
        min-height: 44px;
        padding: 0 12px;
        font-size: 13px
      }

      .page-wrap {
        width: min(100% - 28px, 760px)
      }

      .field-showcase {
        grid-template-columns: 1fr;
        gap: 14px
      }

      .checkout-layout {
        grid-template-columns: 1fr;
        margin-top: 22px
      }

      .sidebar-sticky {
        position: static
      }

      .summary-card {
        order: -1
      }
    }

    @media(max-width:640px) {
      .topbar {
        height: 60px;
        padding: 0 12px
      }

      .topbar-logo {
        width: 78px;
        flex-basis: 78px
      }

      .topbar-logo img {
        height: 38px;
        max-width: 74px
      }

      .topbar-nav {
        margin-left: 0;
        gap: 0;
        overflow: hidden
      }

      .nav-link {
        min-height: 40px;
        padding: 0 7px;
        font-size: 12px;
        letter-spacing: 0
      }

      .topbar-actions {
        gap: 4px
      }

      .btn-login {
        width: 40px;
        min-width: 40px;
        height: 40px;
        min-height: 40px;
        padding: 0;
        border-radius: 10px;
        font-size: 0;
      }

      .btn-login i {
        font-size: 18px
      }

      .dropdown-menu {
        position: fixed;
        top: 58px;
        left: 10px;
        right: 10px;
        min-width: 0
      }

      .page-wrap {
        width: calc(100% - 20px);
        padding: 20px 0 40px
      }

      .page-hero {
        padding: 24px 14px
      }

      .section-heading-title {
        font-size: 19px
      }

      .field-showcase {
        gap: 12px
      }

      .field-showcase-card {
        border-radius: 16px
      }

      .field-showcase-image {
        aspect-ratio: 16/8.8
      }

      .field-showcase-body {
        padding: 13px
      }

      .field-showcase-title {
        font-size: 17px
      }

      .product-options-head {
        padding: 12px
      }

      .product-options-head-title {
        font-size: 16px
      }

      .product-item {
        min-height: 84px;
        grid-template-columns: 60px 22px minmax(0, 1fr) auto;
        gap: 8px;
        padding: 9px;
      }

      .product-thumb {
        width: 58px;
        height: 58px;
        min-width: 58px;
        min-height: 58px;
      }

      .price-wrap {
        min-width: 82px
      }

      .price-promo {
        font-size: 16px
      }

      .form-card {
        padding: 17px
      }

      .summary-body {
        padding: 14px
      }

      .form-grid-2,
      .form-grid-3 {
        grid-template-columns: 1fr
      }

      .footer-badges {
        grid-template-columns: 1fr
      }

      .footer-badge {
        border-right: 0;
        border-bottom: 1px solid #F1F5F9
      }

      .footer-badge:last-child {
        border-bottom: 0
      }
    }

    @media(max-width:430px) {
      .topbar-logo img {
        height: 34px;
        max-width: 68px
      }

      .nav-link {
        padding: 0 5px;
        font-size: 11px
      }
    }

    @media(max-width:360px) {
      .topbar-logo img {
        max-width: 60px
      }

      .nav-link {
        padding: 0 4px;
        font-size: 10px
      }
    }
  </style>
</head>

<body>

  <!-- TOPBAR -->
  <div class="topbar">
