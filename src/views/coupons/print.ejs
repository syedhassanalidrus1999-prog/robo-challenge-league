<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>พิมพ์คูปองรายทีม — Robo Challenge League</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Kanit:wght@500;600;700&family=Sarabun:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <style>
        @page {
            size: A4 portrait;
            margin: 8mm;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: #E2E8F0;
            color: #0F172A;
            font-family: 'Sarabun', sans-serif;
        }

        .toolbar {
            position: sticky;
            top: 0;
            z-index: 5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            padding: 12px 20px;
            background: #0F172A;
            color: #fff;
            font-size: 14px;
        }

        .toolbar a,
        .toolbar button {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            height: 38px;
            padding: 0 14px;
            border-radius: 10px;
            border: 0;
            font: inherit;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
        }

        .toolbar a {
            background: rgba(255, 255, 255, .12);
            color: #fff;
        }

        .toolbar button {
            background: #2563EB;
            color: #fff;
        }

        .paper {
            width: 194mm;
            margin: 16px auto;
            background: #fff;
            box-shadow: 0 6px 24px rgba(15, 23, 42, .12);
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* คูปอง 1 ใบ = 1 ทีม 1 วัน */
        .coupon {
            position: relative;
            height: 69mm;
            padding: 5mm;
            display: grid;
            grid-template-columns: 30mm 1fr;
            gap: 4mm;
            border-right: 1px dashed #94A3B8;
            border-bottom: 1px dashed #94A3B8;
            break-inside: avoid;
            page-break-inside: avoid;
            overflow: hidden;
        }

        .coupon:nth-child(2n) {
            border-right: 0;
        }

        .left {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .qr {
            width: 30mm;
            height: 30mm;
        }

        .qr svg {
            display: block;
            width: 100%;
            height: 100%;
        }

        .code {
            margin-top: 1.5mm;
            font-family: ui-monospace, Menlo, Consolas, monospace;
            font-size: 9.5pt;
            font-weight: 700;
            letter-spacing: .4px;
        }

        .meals {
            margin-top: 3mm;
            width: 100%;
            padding: 1.5mm 0;
            border-radius: 2mm;
            background: #0F172A;
            color: #fff;
            text-align: center;
            line-height: 1.15;
        }

        .meals b {
            display: block;
            font-family: 'Kanit', sans-serif;
            font-size: 18pt;
            font-weight: 700;
        }

        .meals span {
            font-size: 7.5pt;
        }

        .info {
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .brand {
            font-size: 7.5pt;
            font-weight: 700;
            color: #2563EB;
            letter-spacing: .4px;
        }

        .type {
            margin-top: .5mm;
            font-family: 'Kanit', sans-serif;
            font-size: 12pt;
            font-weight: 700;
        }

        .team {
            margin-top: 1mm;
            font-family: 'Kanit', sans-serif;
            font-size: 11pt;
            font-weight: 600;
            line-height: 1.2;
            overflow-wrap: anywhere;
        }

        .sub {
            font-size: 8pt;
            color: #64748B;
        }

        .holder {
            margin-top: 1.5mm;
            font-size: 8.5pt;
            color: #0F172A;
        }

        .holder b {
            font-weight: 700;
        }

        .members {
            margin-top: 1mm;
            font-size: 8pt;
            color: #334155;
            line-height: 1.35;
            list-style: none;
        }

        .members li::before {
            content: "• ";
            color: #94A3B8;
        }

        .day {
            margin-top: auto;
            padding-top: 1.5mm;
            border-top: 1px solid #E2E8F0;
            font-size: 9.5pt;
            font-weight: 700;
        }

        .note {
            font-size: 7pt;
            color: #94A3B8;
        }

        .used-stamp {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-12deg);
            padding: 2mm 5mm;
            border: 2px solid #DC2626;
            border-radius: 2mm;
            color: #DC2626;
            font-family: 'Kanit', sans-serif;
            font-size: 16pt;
            font-weight: 700;
            background: rgba(255, 255, 255, .85);
        }

        .empty {
            padding: 12mm;
            text-align: center;
            color: #94A3B8;
        }

        @media print {
            body {
                background: #fff;
            }

            .toolbar {
                display: none;
            }

            .paper {
                width: auto;
                margin: 0;
                box-shadow: none;
            }
        }
    </style>
</head>

<body>
    <div class="toolbar">
        <a href="<%= backUrl %>"><i class="ti ti-arrow-left"></i> กลับ</a>
        <span>
            <%= teamCount %> ทีม · <%= items.length %> ใบ · ตัดตามเส้นประ · A4 แนวตั้ง ไม่ย่อขนาด
        </span>
        <button type="button" onclick="window.print()"><i class="ti ti-printer"></i> พิมพ์</button>
    </div>

    <div class="paper">
        <% if (!items.length) { %>
            <div class="empty">ไม่มีคูปองสำหรับพิมพ์</div>
            <% } else { %>
                <div class="grid">
                    <% items.forEach(function (c) { %>
                        <div class="coupon">
                            <div class="left">
                                <div class="qr"><%- c.qr %></div>
                                <div class="code">
                                    <%= c.code %>
                                </div>
                                <div class="meals"><b>
                                        <%= c.maxMeals %>
                                    </b><span>ชุดสูงสุด</span></div>
                            </div>
                            <div class="info">
                                <div class="brand">ROBO CHALLENGE LEAGUE</div>
                                <div class="type">คูปอง<%= couponLabel %> (ทั้งทีม)</div>
                                <div class="team">
                                    <%= c.teamId %> · <%= c.team %>
                                </div>
                                <div class="sub">
                                    <%= c.institution %> · <%= c.tierLabel %>
                                </div>
                                <div class="holder">ผู้รับ: <b>
                                        <%= c.coach || 'ตัวแทนทีม' %>
                                    </b>
                                    <%= c.coach ? ' (โค้ช)' : '' %>
                                </div>
                                <ul class="members">
                                    <% c.students.forEach(function (n) { %>
                                        <li>
                                            <%= n %>
                                        </li>
                                        <% }) %>
                                </ul>
                                <div class="day">
                                    <%= c.day %>
                                </div>
                                <div class="note">ใช้ได้ 1 ครั้ง · ได้ตามจำนวนนักเรียนที่ Check-in + โค้ช 1 ชุด</div>
                            </div>
                            <% if (c.used) { %>
                                <div class="used-stamp">ใช้แล้ว</div>
                                <% } %>
                        </div>
                        <% }) %>
                </div>
                <% } %>
    </div>
</body>

</html>