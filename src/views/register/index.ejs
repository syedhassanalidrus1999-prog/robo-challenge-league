    <!DOCTYPE html>
    <html lang="th">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>สมัครแข่งขัน — Robo Challenge League</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
        <link
            href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800;900&family=Sarabun:wght@400;500;600;700;800&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="/css/style.css">
        <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
        <style>
            /* =========================================================
       RCL 2026 — REGISTER PAGE (tier select / form / success)
       01 Tokens / Reset
       02 Topbar + Dropdown   (same as every page)
       03 Mobile menu         (same as every page)
       04 Page shell / hero
       05 Tier selection
       06 Form
       07 Success
       08 Responsive
    ========================================================= */

            /* 01 — TOKENS / RESET */
            :root {
                --primary: #2563EB;
                --primary-dark: #1D4ED8;
                --primary-soft: #EFF6FF;
                --green: #16A34A;
                --ink: #0F172A;
                --muted: #64748B;
                --line: #E2E8F0;
                --surface-soft: #F8FAFC;
                --content: 920px;
                --gutter: 24px;
                --topbar-h: 82px;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                min-width: 320px;
                min-height: 100vh;
                overflow-x: hidden;
                color: var(--ink);
                background:
                    radial-gradient(circle at 15% 5%, rgba(37, 99, 235, .10), transparent 28%),
                    radial-gradient(circle at 85% 10%, rgba(22, 163, 74, .08), transparent 24%),
                    #F4F7FB;
                font-family: 'Kanit', 'Sarabun', sans-serif;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            button,
            input {
                font: inherit;
            }

            :focus-visible {
                outline: 3px solid #93C5FD;
                outline-offset: 2px;
            }

            /* 02 — TOPBAR + DROPDOWN (solid on this page — no hero behind it) */
            .topbar {
                position: fixed;
                inset: 0 0 auto;
                z-index: 1000;
                height: var(--topbar-h);
                padding: 0 30px;
                display: flex;
                align-items: center;
                gap: 10px;
                background: rgba(255, 255, 255, .92);
                border-bottom: 1px solid rgba(226, 232, 240, .9);
                box-shadow: 0 4px 18px rgba(15, 23, 42, .05);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
            }

            .topbar-logo {
                flex: 0 0 auto;
                display: inline-flex;
                align-items: center;
            }

            .topbar-logo img {
                display: block;
                width: auto;
                height: 58px;
                max-width: 150px;
                object-fit: contain;
            }

            .topbar-nav {
                flex: 1 1 auto;
                min-width: 0;
                margin-left: 18px;
                display: flex;
                align-items: center;
                gap: 2px;
            }

            .nav-link {
                min-height: 52px;
                padding: 0 14px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 2px;
                border: 0;
                border-radius: 11px;
                background: transparent;
                color: #334155;
                font-family: 'Kanit', sans-serif;
                font-weight: 700;
                letter-spacing: 1px;
                line-height: 1.15;
                white-space: nowrap;
                cursor: pointer;
                transition: color .2s ease, transform .2s ease;
            }

            .nav-link span:first-child {
                font-size: 17px;
                font-weight: 800;
            }

            .nav-link span:last-child {
                display: flex;
                align-items: center;
                gap: 5px;
                margin-top: 1px;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: .2px;
            }

            .nav-link:hover,
            .nav-link.active {
                color: var(--primary);
                transform: translateY(-1px);
            }

            .certificate-btn {
                min-width: 150px;
                padding: 8px 16px;
                border: 1px solid #F6D365;
                border-radius: 999px;
                background: linear-gradient(135deg, #FFF8D8, #FFF0B8);
                color: #92400E;
                box-shadow: 0 6px 16px rgba(180, 120, 20, .12);
            }

            .certificate-btn:hover {
                background: linear-gradient(135deg, #FDE68A, #FCD34D);
                border-color: #F59E0B;
                color: #78350F;
            }

            .topbar-actions {
                flex: 0 0 auto;
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .btn-login {
                min-height: 52px;
                padding: 0 18px;
                display: inline-flex;
                align-items: center;
                gap: 7px;
                border: 1px solid #E2E8F0;
                border-radius: 11px;
                background: #fff;
                color: #334155;
                white-space: nowrap;
                transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
            }

            .btn-login:hover {
                background: #F8FAFC;
                transform: translateY(-1px);
                box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
            }

            .dropdown {
                position: relative;
            }

            .dropdown-menu {
                position: absolute;
                top: calc(100% + 8px);
                left: 0;
                z-index: 1100;
                display: none;
                min-width: 205px;
                padding: 8px;
                background: rgba(255, 255, 255, .98);
                border: 1px solid #E2E8F0;
                border-radius: 14px;
                box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
            }

            .dropdown-item {
                min-height: 42px;
                padding: 0 12px;
                display: flex;
                align-items: center;
                gap: 10px;
                border-radius: 10px;
                color: #334155;
                font-size: 14px;
                font-weight: 700;
                white-space: nowrap;
            }

            .dropdown-item i {
                color: #64748B;
                font-size: 17px;
            }

            .dropdown-item:hover,
            .dropdown-item.active {
                background: var(--primary-soft);
                color: var(--primary);
            }

            .dropdown-item.active i {
                color: var(--primary);
            }

            /* 03 — MOBILE MENU (shown ≤1100px) */
            .mobile-menu-toggle,
            .mobile-menu {
                display: none;
            }

            .mobile-menu-toggle {
                margin-left: auto;
                width: 44px;
                height: 44px;
                flex: 0 0 44px;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 5px;
                border: 1px solid rgba(148, 163, 184, .35);
                border-radius: 12px;
                background: rgba(255, 255, 255, .92);
                color: #1E3A8A;
                box-shadow: 0 5px 16px rgba(15, 23, 42, .08);
                cursor: pointer;
                -webkit-tap-highlight-color: transparent;
            }

            .mobile-menu-toggle span {
                width: 21px;
                height: 2px;
                border-radius: 999px;
                background: currentColor;
                transition: transform .22s ease, opacity .18s ease;
            }

            .mobile-menu-toggle.is-open span:nth-child(1) {
                transform: translateY(7px) rotate(45deg);
            }

            .mobile-menu-toggle.is-open span:nth-child(2) {
                opacity: 0;
            }

            .mobile-menu-toggle.is-open span:nth-child(3) {
                transform: translateY(-7px) rotate(-45deg);
            }

            .mobile-menu {
                position: fixed;
                top: calc(var(--topbar-h) + 6px);
                right: 12px;
                z-index: 999;
                width: min(380px, calc(100% - 24px));
                max-height: calc(100dvh - var(--topbar-h) - 18px);
                overflow-y: auto;
                padding: 8px;
                visibility: hidden;
                opacity: 0;
                pointer-events: none;
                transform: translateY(-8px) scale(.985);
                transform-origin: top right;
                background: rgba(255, 255, 255, .98);
                border: 1px solid #DBEAFE;
                border-radius: 18px;
                box-shadow: 0 20px 50px rgba(15, 23, 42, .18);
                transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
            }

            .mobile-menu.is-open {
                visibility: visible;
                opacity: 1;
                pointer-events: auto;
                transform: none;
            }

            .mobile-menu-link,
            .mobile-menu-competition-toggle {
                width: 100%;
                min-height: 50px;
                padding: 9px 12px;
                display: flex;
                align-items: center;
                gap: 11px;
                border: 0;
                border-radius: 12px;
                background: transparent;
                color: #334155;
                font-family: 'Kanit', sans-serif;
                font-size: 15px;
                font-weight: 700;
                text-align: left;
                cursor: pointer;
            }

            .mobile-menu-link:hover,
            .mobile-menu-competition-toggle:hover,
            .mobile-menu-competition-toggle.active {
                color: var(--primary);
                background: var(--primary-soft);
            }

            .mobile-menu-link>i,
            .mobile-menu-competition-toggle>i:first-child {
                width: 28px;
                flex: 0 0 28px;
                display: grid;
                place-items: center;
                color: var(--primary);
                font-size: 19px;
            }

            .mobile-menu-link-text {
                min-width: 0;
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }

            .mobile-menu-link-text strong {
                font-size: 15px;
                font-weight: 800;
            }

            .mobile-menu-link-text small {
                margin-top: 2px;
                color: #64748B;
                font-size: 11px;
                font-weight: 500;
            }

            .mobile-chevron {
                margin-left: auto;
                color: #64748B;
                font-size: 17px;
                transition: transform .2s ease;
            }

            .mobile-menu-competition-toggle.is-open .mobile-chevron {
                transform: rotate(180deg);
            }

            .mobile-submenu {
                display: none;
                margin: 0 8px 6px 51px;
                padding: 5px;
                background: #F8FAFC;
                border: 1px solid #E2E8F0;
                border-radius: 12px;
            }

            .mobile-submenu.is-open {
                display: block;
            }

            .mobile-submenu a {
                min-height: 42px;
                padding: 8px 10px;
                display: flex;
                align-items: center;
                gap: 9px;
                border-radius: 9px;
                color: #475569;
                font-size: 13px;
                font-weight: 600;
            }

            .mobile-submenu a:hover,
            .mobile-submenu a.active {
                color: var(--primary);
                background: var(--primary-soft);
            }

            .mobile-submenu a i {
                color: #64748B;
                font-size: 16px;
            }

            .mobile-menu-divider {
                height: 1px;
                margin: 6px 4px;
                background: #E2E8F0;
            }

            .mobile-login>i {
                color: #475569 !important;
            }

            /* 04 — PAGE SHELL / HERO */
            .reg-page {
                --tier: #2563EB;
                --tier-soft: #EFF6FF;
                --tier-border: #BFDBFE;
                width: 100%;
                max-width: calc(var(--content) + var(--gutter) * 2);
                margin: 0 auto;
                padding: calc(var(--topbar-h) + 36px) var(--gutter) 64px;
            }

            .reg-page.is-wide {
                --content: 1100px;
            }

            .reg-hero {
                margin-bottom: 26px;
                text-align: center;
            }

            .reg-hero-emoji {
                width: 64px;
                height: 64px;
                margin: 0 auto 12px;
                display: grid;
                place-items: center;
                border-radius: 20px;
                background: var(--tier-soft);
                border: 1px solid var(--tier-border);
                font-size: 32px;
            }

            .reg-hero-title {
                color: var(--ink);
                font-size: clamp(28px, 4vw, 38px);
                font-weight: 800;
                line-height: 1.2;
            }

            .reg-hero-title span {
                color: var(--tier);
            }

            .reg-hero-sub {
                margin-top: 6px;
                color: var(--muted);
                font-size: 16px;
            }

            .tier-meta-chips {
                margin-top: 12px;
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 8px;
            }

            .chip {
                padding: 5px 12px;
                display: inline-flex;
                align-items: center;
                gap: 5px;
                background: #fff;
                border: 1px solid var(--tier-border);
                border-radius: 999px;
                color: var(--tier);
                font-size: 14px;
                font-weight: 600;
            }

            .alert-error {
                margin-bottom: 18px;
                padding: 12px 16px;
                display: flex;
                align-items: flex-start;
                gap: 8px;
                background: #FEF2F2;
                border: 1px solid #FECDD3;
                border-radius: 12px;
                color: #DC2626;
                font-size: 15px;
                line-height: 1.5;
            }

            .alert-error i {
                flex-shrink: 0;
                margin-top: 2px;
                font-size: 18px;
            }

            /* 05 — TIER SELECTION */
            .tier-cards {
                margin-bottom: 22px;
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 20px;
            }

            .tier-card {
                --tier: #16A34A;
                --tier-soft: #F0FDF4;
                --tier-border: #BBF7D0;
                position: relative;
                overflow: hidden;
                padding: 28px 22px 22px;
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
                background: linear-gradient(180deg, #fff, color-mix(in srgb, var(--tier-soft) 45%, white));
                border: 1px solid #DFE7F0;
                border-radius: 22px;
                box-shadow: 0 12px 30px rgba(15, 23, 42, .065);
                transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
            }

            .tier-card::before {
                content: '';
                position: absolute;
                inset: 0 0 auto;
                height: 6px;
                background: var(--tier);
            }

            .tier-card:hover {
                transform: translateY(-6px);
                border-color: var(--tier-border);
                box-shadow: 0 0 0 3px color-mix(in srgb, var(--tier) 12%, transparent), 0 20px 44px rgba(15, 23, 42, .11);
            }

            .tier-card.t-intermediate {
                --tier: #2563EB;
                --tier-soft: #EFF6FF;
                --tier-border: #BFDBFE;
            }

            .tier-card.t-advance {
                --tier: #EA580C;
                --tier-soft: #FFF7ED;
                --tier-border: #FED7AA;
            }

            .tier-icon {
                width: 62px;
                height: 62px;
                margin-bottom: 12px;
                display: grid;
                place-items: center;
                border-radius: 18px;
                background: var(--tier-soft);
                font-size: 32px;
            }

            .tier-name {
                margin-bottom: 6px;
                color: var(--tier);
                font-size: 26px;
                font-weight: 800;
            }

            .tier-desc {
                min-height: 66px;
                margin-bottom: 14px;
                color: var(--muted);
                font-size: 14px;
                line-height: 1.6;
            }

            .tier-facts {
                width: 100%;
                margin-bottom: 16px;
                display: grid;
                gap: 0;
            }

            .tier-fact {
                padding: 9px 4px;
                display: flex;
                justify-content: space-between;
                gap: 10px;
                border-top: 1px solid #EEF2F7;
                font-size: 14px;
            }

            .tier-fact span:first-child {
                color: var(--muted);
            }

            .tier-fact span:last-child {
                color: var(--tier);
                font-weight: 600;
                text-align: right;
            }

            .tier-cta {
                width: 100%;
                min-height: 48px;
                margin-top: auto;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                border: 1px solid var(--tier-border);
                border-radius: 12px;
                background: var(--tier-soft);
                color: var(--tier);
                font-size: 17px;
                font-weight: 700;
                transition: background .2s ease, color .2s ease;
            }

            .tier-card:hover .tier-cta {
                background: var(--tier);
                border-color: var(--tier);
                color: #fff;
            }

            .info-strip {
                padding: 14px 18px;
                display: flex;
                align-items: flex-start;
                gap: 10px;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 14px;
                color: var(--muted);
                font-size: 15px;
                line-height: 1.6;
            }

            .info-strip i {
                flex-shrink: 0;
                margin-top: 3px;
                color: var(--primary);
                font-size: 18px;
            }

            .info-strip strong {
                color: var(--green);
            }

            /* 06 — FORM */
            .form-card {
                overflow: hidden;
                background: rgba(255, 255, 255, .97);
                border: 1px solid rgba(226, 232, 240, .95);
                border-top: 5px solid var(--tier);
                border-radius: 22px;
                box-shadow: 0 22px 60px rgba(15, 23, 42, .10);
            }

            .form-section {
                padding: 26px 30px;
            }

            .form-section+.form-section {
                border-top: 1px solid #EEF2F7;
            }

            .form-section-head {
                margin-bottom: 16px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .form-section-icon {
                flex: 0 0 auto;
                width: 36px;
                height: 36px;
                display: grid;
                place-items: center;
                border-radius: 11px;
                background: var(--tier-soft);
                color: var(--tier);
                font-size: 19px;
            }

            .form-section-title {
                color: var(--ink);
                font-size: 19px;
                font-weight: 700;
            }

            .form-section-sub {
                color: var(--muted);
                font-size: 13px;
            }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 14px 16px;
            }

            .form-grid .span-2 {
                grid-column: 1 / -1;
            }

            .fg {
                min-width: 0;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .fl {
                color: #475569;
                font-size: 14px;
                font-weight: 600;
            }

            .fl .req {
                color: #DC2626;
            }

            .fl .opt {
                color: #94A3B8;
                font-weight: 400;
            }

            .fi {
                width: 100%;
                min-height: 46px;
                padding: 10px 13px;
                background: #fff;
                border: 1.5px solid #CBD5E1;
                border-radius: 10px;
                color: var(--ink);
                font-family: 'Sarabun', 'Kanit', sans-serif;
                font-size: 15px;
                outline: none;
                transition: border-color .15s ease, box-shadow .15s ease;
            }

            .fi:focus {
                border-color: var(--tier);
                box-shadow: 0 0 0 3px color-mix(in srgb, var(--tier) 14%, transparent);
            }

            .member-list-form {
                display: grid;
                gap: 12px;
            }

            .member-block {
                padding: 16px;
                display: grid;
                grid-template-columns: 34px minmax(0, 1fr);
                gap: 12px;
                background: var(--surface-soft);
                border: 1px solid var(--line);
                border-radius: 14px;
            }

            .member-num {
                width: 34px;
                height: 34px;
                display: grid;
                place-items: center;
                border-radius: 10px;
                background: var(--tier-soft);
                border: 1px solid var(--tier-border);
                color: var(--tier);
                font-weight: 800;
            }

            .member-fields {
                display: grid;
                grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
                gap: 12px 14px;
            }

            .fee-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 10px;
            }

            .fee-item {
                padding: 14px 10px;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 12px;
                text-align: center;
            }

            .fee-label {
                color: var(--muted);
                font-size: 13px;
                font-weight: 600;
            }

            .fee-value {
                margin-top: 2px;
                color: var(--tier);
                font-size: 24px;
                font-weight: 800;
                line-height: 1.2;
            }

            .fee-value small {
                font-size: 13px;
                font-weight: 600;
            }

            .fee-note {
                margin-top: 2px;
                color: #94A3B8;
                font-size: 12px;
            }

            .form-actions {
                padding: 18px 30px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                background: var(--surface-soft);
                border-top: 1px solid #EEF2F7;
            }

            .btn {
                min-height: 48px;
                padding: 0 20px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                border: none;
                border-radius: 11px;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: transform .15s ease, background .15s ease, box-shadow .15s ease;
            }

            .btn:hover {
                transform: translateY(-1px);
            }

            .btn-primary {
                min-width: 170px;
                background: var(--tier);
                color: #fff;
                box-shadow: 0 8px 18px color-mix(in srgb, var(--tier) 28%, transparent);
            }

            .btn-primary:hover {
                filter: brightness(.94);
            }

            .btn-secondary {
                background: #fff;
                border: 1px solid #CBD5E1;
                color: #334155;
            }

            .btn-secondary:hover {
                background: #F8FAFC;
            }

            /* 07 — SUCCESS */
            .success-card {
                overflow: hidden;
                max-width: 780px;
                margin: 0 auto;
                background: rgba(255, 255, 255, .97);
                border: 1px solid rgba(226, 232, 240, .95);
                border-radius: 24px;
                box-shadow: 0 22px 60px rgba(15, 23, 42, .10);
                text-align: center;
            }

            .success-banner {
                position: relative;
                overflow: hidden;
                padding: 34px 30px 28px;
                background: linear-gradient(135deg, #EFF6FF 0%, #F0FDF4 100%);
                border-bottom: 1px solid #E6EEF8;
            }

            .success-icon {
                width: 76px;
                height: 76px;
                margin: 0 auto 14px;
                display: grid;
                place-items: center;
                background: #fff;
                border: 1px solid #D1FAE5;
                border-radius: 24px;
                color: #22C55E;
                font-size: 40px;
                box-shadow: 0 12px 28px rgba(22, 163, 74, .16);
            }

            .success-title {
                margin-bottom: 6px;
                font-size: 28px;
                font-weight: 800;
            }

            .success-subtitle {
                color: var(--muted);
                font-size: 15px;
            }

            .success-id-label {
                margin-top: 18px;
                color: var(--muted);
                font-size: 13px;
            }

            .success-id {
                margin: 4px 0 10px;
                padding: 10px 28px;
                display: inline-block;
                background: #fff;
                border: 1px solid #DBEAFE;
                border-radius: 14px;
                color: var(--primary);
                font-size: 38px;
                font-weight: 800;
                letter-spacing: 3px;
                box-shadow: 0 10px 24px rgba(37, 99, 235, .10);
            }

            .team-meta {
                color: var(--muted);
                font-size: 15px;
            }

            .team-meta strong {
                color: var(--ink);
            }

            .team-meta .tier-tag {
                margin-left: 4px;
                padding: 2px 10px;
                display: inline-block;
                border-radius: 999px;
                background: var(--tier-soft);
                color: var(--tier);
                font-weight: 600;
            }

            .success-body {
                padding: 24px 30px 30px;
            }

            .line-box {
                margin-bottom: 18px;
                padding: 16px 18px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 18px;
                background: linear-gradient(180deg, #F0FDF4, #F7FFF9);
                border: 1px solid #BBF7D0;
                border-radius: 16px;
                text-align: left;
            }

            .line-box-left {
                display: flex;
                align-items: flex-start;
                gap: 12px;
            }

            .line-icon {
                flex: 0 0 auto;
                width: 42px;
                height: 42px;
                display: grid;
                place-items: center;
                border-radius: 12px;
                background: #DCFCE7;
                color: var(--green);
                font-size: 24px;
            }

            .line-box-title {
                margin-bottom: 2px;
                color: #15803D;
                font-size: 16px;
                font-weight: 700;
            }

            .line-copy {
                color: #166534;
                font-size: 14px;
                line-height: 1.55;
            }

            .line-id {
                flex: 0 0 auto;
                padding: 9px 14px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: #fff;
                border: 1px solid #BBF7D0;
                border-radius: 10px;
                color: var(--green);
                font-size: 18px;
                font-weight: 700;
                white-space: nowrap;
                transition: background .15s ease;
            }

            .line-id:hover {
                background: #DCFCE7;
            }

            .info-card {
                padding: 18px;
                background: var(--surface-soft);
                border: 1px solid var(--line);
                border-radius: 16px;
                text-align: left;
            }

            .info-title {
                margin-bottom: 14px;
                display: flex;
                align-items: center;
                gap: 7px;
                color: #475569;
                font-size: 16px;
                font-weight: 700;
            }

            .info-grid {
                margin-bottom: 16px;
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 14px 24px;
            }

            .info-label {
                margin-bottom: 2px;
                color: #94A3B8;
                font-size: 13px;
            }

            .info-value {
                color: var(--ink);
                font-size: 16px;
                font-weight: 600;
                overflow-wrap: anywhere;
            }

            .member-list {
                padding-top: 12px;
                border-top: 1px solid var(--line);
            }

            .member-list-title {
                margin-bottom: 6px;
                color: #94A3B8;
                font-size: 13px;
            }

            .member-row {
                padding: 8px 0;
                display: flex;
                justify-content: space-between;
                gap: 16px;
                border-bottom: 1px solid #EEF2F7;
                font-size: 15px;
            }

            .member-row:last-child {
                border-bottom: 0;
            }

            .member-name {
                font-weight: 600;
            }

            .member-date {
                color: var(--muted);
                white-space: nowrap;
            }

            .status-note {
                margin: 18px 0;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                color: var(--muted);
                font-size: 14px;
            }

            .status-dot {
                flex: 0 0 auto;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #F59E0B;
                box-shadow: 0 0 0 4px #FEF3C7;
            }

            .action-row {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 10px;
            }

            .action-row .btn-primary {
                --tier: #2563EB;
            }

            @media (prefers-reduced-motion: reduce) {

                *,
                *::before,
                *::after {
                    transition: none !important;
                }
            }

            /* 08 — RESPONSIVE */
            @media (min-width: 1440px) {
                .topbar {
                    padding-inline: 48px;
                }

                .topbar-nav {
                    margin-left: 22px;
                    gap: 4px;
                }

                .nav-link {
                    padding-inline: 16px;
                }
            }

            @media (max-width: 1199px) {
                :root {
                    --gutter: 20px;
                }

                .topbar {
                    padding-inline: 20px;
                }

                .topbar-logo img {
                    height: 54px;
                    max-width: 136px;
                }

                .topbar-nav {
                    margin-left: 10px;
                    gap: 0;
                }

                .nav-link {
                    padding-inline: 9px;
                    letter-spacing: .5px;
                }

                .nav-link span:first-child {
                    font-size: 15px;
                }

                .nav-link span:last-child {
                    font-size: 10px;
                }

                .certificate-btn {
                    min-width: 126px;
                    padding-inline: 12px;
                }

                .btn-login {
                    padding-inline: 13px;
                    font-size: 14px;
                }
            }

            @media (max-width: 1100px) {
                :root {
                    --topbar-h: 70px;
                }

                .topbar-nav,
                .topbar-actions {
                    display: none;
                }

                .mobile-menu-toggle {
                    display: flex;
                }

                .mobile-menu {
                    display: block;
                }

                .topbar-logo img {
                    height: 50px;
                    max-width: 124px;
                }
            }

            @media (max-width: 900px) {
                .tier-cards {
                    grid-template-columns: 1fr;
                    max-width: 520px;
                    margin-inline: auto;
                }

                .tier-desc {
                    min-height: 0;
                }
            }

            @media (max-width: 640px) {
                :root {
                    --gutter: 12px;
                    --topbar-h: 60px;
                }

                .topbar {
                    padding: 0 12px;
                }

                .topbar-logo img {
                    height: 42px;
                    max-width: 90px;
                }

                .reg-page {
                    padding-top: calc(var(--topbar-h) + 22px);
                    padding-bottom: 40px;
                }

                .reg-hero {
                    margin-bottom: 20px;
                }

                .reg-hero-emoji {
                    width: 54px;
                    height: 54px;
                    border-radius: 16px;
                    font-size: 27px;
                }

                .reg-hero-sub {
                    font-size: 14px;
                }

                .chip {
                    font-size: 13px;
                }

                .form-card {
                    border-radius: 18px;
                }

                .form-section {
                    padding: 20px 16px;
                }

                .form-section-title {
                    font-size: 17px;
                }

                .form-grid,
                .member-fields,
                .fee-grid {
                    grid-template-columns: 1fr;
                }

                .member-block {
                    padding: 14px 12px;
                    grid-template-columns: 1fr;
                    gap: 10px;
                }

                .member-num {
                    width: auto;
                    height: auto;
                    padding: 4px 10px;
                    justify-self: start;
                    font-size: 14px;
                }

                .member-num::before {
                    content: 'คนที่ ';
                    font-weight: 600;
                }

                .fee-item {
                    display: flex;
                    align-items: baseline;
                    justify-content: space-between;
                    gap: 8px;
                    text-align: left;
                    padding: 12px 14px;
                }

                .fee-note {
                    display: none;
                }

                .fee-value {
                    font-size: 20px;
                }

                /* 16px inputs stop iOS from zooming in on focus */
                .fi {
                    font-size: 16px;
                }

                .form-actions {
                    padding: 16px;
                    flex-direction: column-reverse;
                }

                .form-actions .btn {
                    width: 100%;
                }

                .success-banner {
                    padding: 26px 16px 22px;
                }

                .success-title {
                    font-size: 22px;
                }

                .success-id {
                    font-size: 28px;
                    padding: 10px 18px;
                }

                .success-body {
                    padding: 18px 14px 22px;
                }

                .line-box {
                    flex-direction: column;
                    align-items: stretch;
                }

                .line-id {
                    justify-content: center;
                }

                .info-grid {
                    grid-template-columns: 1fr;
                    gap: 12px;
                }

                .member-row {
                    flex-direction: column;
                    gap: 2px;
                }

                .action-row .btn {
                    width: 100%;
                }
            }
        </style>
    </head>

    <body>

        <!-- TOPBAR -->
        <header class="topbar">
            <a href="/" class="topbar-logo">
                <img src="/RCL Logo.png" alt="RCL">
            </a>

            <button class="mobile-menu-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav class="topbar-nav">
                <a href="/" class="nav-link">
                    <span>HOME</span>
                    <span>หน้าหลัก</span>
                </a>

                <a href="/#about" class="nav-link">
                    <span>ABOUT US</span>
                    <span>เกี่ยวกับเรา</span>
                </a>

                <a href="/#awards" class="nav-link">
                    <span>AWARDS</span>
                    <span>รางวัล</span>
                </a>

                <div class="dropdown">
                    <button class="nav-link active" type="button">
                        <span>COMPETITION</span>
                        <span>การแข่งขัน <i class="ti ti-chevron-down"></i></span>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/#tiers" class="dropdown-item active"><i class="ti ti-pencil-plus"></i>สมัครแข่งขัน</a>
                        <a href="/competition?view=teams" class="dropdown-item"><i
                                class="ti ti-users"></i>ทีมที่สมัคร</a>
                        <a href="/competition?view=board" class="dropdown-item"><i
                                class="ti ti-chart-bar"></i>ผลสรุปคะแนน</a>
                    </div>
                </div>

                <a href="/docs" class="nav-link">
                    <span>DOCUMENT</span>
                    <span>เอกสาร</span>
                </a>

                <a href="/preorder" class="nav-link">
                    <span>PRE-ORDER MISSION</span>
                    <span>พรีออเดอร์สนามภารกิจ</span>
                </a>

                <a href="/certificate" class="nav-link certificate-btn">
                    <span>CERTIFICATE</span>
                    <span>เกียรติบัตร</span>
                </a>
            </nav>

            <div class="topbar-actions">
                <a href="/auth/login" class="btn-login">
                    <i class="ti ti-lock"></i>
                    <span>เข้าสู่ระบบ</span>
                </a>
            </div>

            <!-- MOBILE / TABLET MENU -->
            <div class="mobile-menu" aria-hidden="true">
                <a href="/" class="mobile-menu-link">
                    <i class="ti ti-home"></i>
                    <span class="mobile-menu-link-text"><strong>HOME</strong><small>หน้าหลัก</small></span>
                </a>

                <a href="/#about" class="mobile-menu-link">
                    <i class="ti ti-info-circle"></i>
                    <span class="mobile-menu-link-text"><strong>ABOUT US</strong><small>เกี่ยวกับเรา</small></span>
                </a>

                <a href="/#awards" class="mobile-menu-link">
                    <i class="ti ti-award"></i>
                    <span class="mobile-menu-link-text"><strong>AWARDS</strong><small>รางวัล</small></span>
                </a>

                <button class="mobile-menu-competition-toggle active" type="button" aria-expanded="false">
                    <i class="ti ti-trophy"></i>
                    <span class="mobile-menu-link-text"><strong>COMPETITION</strong><small>การแข่งขัน</small></span>
                    <i class="ti ti-chevron-down mobile-chevron"></i>
                </button>

                <div class="mobile-submenu">
                    <a href="/#tiers"><i class="ti ti-pencil-plus"></i>สมัครแข่งขัน</a>
                    <a href="/competition?view=teams"><i class="ti ti-users"></i>ทีมที่สมัคร</a>
                    <a href="/competition?view=board"><i class="ti ti-chart-bar"></i>ผลสรุปคะแนน</a>
                </div>

                <a href="/docs" class="mobile-menu-link">
                    <i class="ti ti-file-text"></i>
                    <span class="mobile-menu-link-text"><strong>DOCUMENT</strong><small>เอกสาร</small></span>
                </a>

                <a href="/preorder" class="mobile-menu-link">
                    <i class="ti ti-shopping-cart"></i>
                    <span class="mobile-menu-link-text"><strong>PRE-ORDER
                            MISSION</strong><small>พรีออเดอร์สนามภารกิจ</small></span>
                </a>

                <a href="/certificate" class="mobile-menu-link" target="_blank">
                    <i class="ti ti-certificate"></i>
                    <span class="mobile-menu-link-text"><strong>CERTIFICATE</strong><small>เกียรติบัตร</small></span>
                </a>

                <div class="mobile-menu-divider"></div>

                <a href="/auth/login" class="mobile-menu-link mobile-login">
                    <i class="ti ti-lock"></i>
                    <span class="mobile-menu-link-text"><strong>เข้าสู่ระบบ</strong><small>Login</small></span>
                </a>
            </div>
        </header>

        <% if (isSuccess) { %>

            <!-- ================= SUCCESS ================= -->
            <main class="reg-page" style="<%= themeStyle %>">
                <div class="success-card">
                    <div class="success-banner">
                        <div class="success-icon"><i class="ti ti-circle-check"></i></div>
                        <h1 class="success-title">ส่งใบสมัครสำเร็จ!</h1>
                        <div class="success-subtitle">บันทึกข้อมูลเรียบร้อยแล้ว กรุณาเก็บรหัสทีมไว้สำหรับยืนยันการสมัคร
                        </div>
                        <div class="success-id-label">รหัสทีมของคุณ</div>
                        <div class="success-id">
                            <%= teamId %>
                        </div>
                        <div class="team-meta">
                            <strong>
                                <%= teamName %>
                            </strong>
                            <span class="tier-tag">
                                <%= T.emoji %>
                                    <%= T.label %>
                            </span>
                        </div>
                    </div>

                    <div class="success-body">
                        <div class="line-box">
                            <div class="line-box-left">
                                <div class="line-icon"><i class="ti ti-brand-line"></i></div>
                                <div>
                                    <div class="line-box-title">ขั้นตอนต่อไป: ยืนยันและชำระค่าสมัคร</div>
                                    <div class="line-copy">แคปหน้าจอนี้ แล้วส่งผ่าน LINE พร้อมแจ้งรหัสทีมของคุณ</div>
                                </div>
                            </div>
                            <a href="https://line.me/R/ti/p/@rcl.robo" target="_blank" rel="noopener" class="line-id">
                                <i class="ti ti-brand-line"></i> @rcl.robo
                            </a>
                        </div>

                        <div class="info-card">
                            <div class="info-title"><i class="ti ti-clipboard-check"></i> ข้อมูลที่กรอก — กรุณาตรวจสอบ
                            </div>
                            <div class="info-grid">
                                <div>
                                    <div class="info-label">ชื่อทีม</div>
                                    <div class="info-value">
                                        <%= fd.name || '—' %>
                                    </div>
                                </div>
                                <div>
                                    <div class="info-label">สถาบัน / โรงเรียน</div>
                                    <div class="info-value">
                                        <%= fd.institution || '—' %>
                                    </div>
                                </div>
                                <div>
                                    <div class="info-label">เบอร์โทรติดต่อ</div>
                                    <div class="info-value">
                                        <%= fd.phone || '—' %>
                                    </div>
                                </div>
                                <div>
                                    <div class="info-label">ผู้ควบคุมทีม</div>
                                    <div class="info-value">
                                        <%= fd.coach || '—' %>
                                    </div>
                                </div>
                                <div>
                                    <div class="info-label">อีเมลผู้ควบคุมทีม</div>
                                    <div class="info-value">
                                        <%= fd.coach_email || '—' %>
                                    </div>
                                </div>
                            </div>

                            <div class="member-list">
                                <div class="member-list-title">สมาชิกทีม</div>
                                <% [1, 2, 3].forEach(function (n) { if (fd['student_' + n]) { %>
                                    <div class="member-row">
                                        <span class="member-name">
                                            <%= n %>. <%= fd['student_' + n] %>
                                        </span>
                                        <span class="member-date">
                                            <%= fmtDob(fd['student_' + n + '_dob' ]) %>
                                        </span>
                                    </div>
                                    <% } }); %>
                            </div>
                        </div>

                        <div class="status-note">
                            <span class="status-dot"></span>
                            <span>สถานะใบสมัครจะเปลี่ยนเป็น <strong>อนุมัติแล้ว</strong>
                                หลังชำระค่าสมัครเรียบร้อย</span>
                        </div>

                        <div class="action-row">
                            <a href="/register" class="btn btn-secondary"><i class="ti ti-plus"></i> สมัครทีมอื่น</a>
                            <a href="/" class="btn btn-primary"><i class="ti ti-home"></i> กลับหน้าหลัก</a>
                        </div>
                    </div>
                </div>
            </main>

            <% } else if (curTier) { %>

                <!-- ================= FORM ================= -->
                <main class="reg-page" style="<%= themeStyle %>">
                    <div class="reg-hero">
                        <div class="reg-hero-emoji" aria-hidden="true">
                            <%= T.emoji %>
                        </div>
                        <h1 class="reg-hero-title">สมัครรุ่น <span>
                                <%= T.label %>
                            </span></h1>
                        <div class="reg-hero-sub">กรอกข้อมูลให้ครบถ้วน แล้วกดส่งใบสมัคร</div>
                        <div class="tier-meta-chips">
                            <span class="chip"><i class="ti ti-cake"></i> อายุ<%= T.age %></span>
                            <span class="chip"><i class="ti ti-robot"></i> หุ่นยนต์: <%= T.robot %></span>
                        </div>
                    </div>

                    <% if (typeof errorMsg !=='undefined' && errorMsg) { %>
                        <div class="alert-error"><i class="ti ti-alert-circle"></i><span>
                                <%= errorMsg %>
                            </span></div>
                        <% } %>

                            <form method="POST" action="/register">
                                <input type="hidden" name="tier" value="<%= curTier %>">

                                <div class="form-card">

                                    <!-- Team -->
                                    <section class="form-section">
                                        <div class="form-section-head">
                                            <span class="form-section-icon"><i class="ti ti-users-group"></i></span>
                                            <div>
                                                <h2 class="form-section-title">ข้อมูลทีม</h2>
                                                <div class="form-section-sub">ชื่อทีมจะแสดงในรายชื่อทีมและผลคะแนน</div>
                                            </div>
                                        </div>

                                        <div class="form-grid">
                                            <div class="fg">
                                                <label class="fl" for="f-name">ชื่อทีม <span
                                                        class="req">*</span></label>
                                                <input class="fi" id="f-name" name="name" placeholder="ชื่อทีม" required
                                                    value="<%= fd.name || '' %>">
                                            </div>
                                            <div class="fg">
                                                <label class="fl" for="f-institution">สถาบัน / โรงเรียน <span
                                                        class="req">*</span></label>
                                                <input class="fi" id="f-institution" name="institution"
                                                    placeholder="ชื่อสถาบัน" required
                                                    value="<%= fd.institution || '' %>">
                                            </div>
                                            <div class="fg">
                                                <label class="fl" for="f-phone">เบอร์โทรติดต่อ <span
                                                        class="req">*</span></label>
                                                <input class="fi" id="f-phone" name="phone" type="tel"
                                                    placeholder="0XX-XXX-XXXX" required value="<%= fd.phone || '' %>">
                                            </div>
                                            <div class="fg">
                                                <label class="fl" for="f-coach">ชื่อผู้ควบคุมทีม <span
                                                        class="req">*</span></label>
                                                <input class="fi" id="f-coach" name="coach"
                                                    placeholder="ชื่อ-นามสกุล ครูผู้ควบคุมทีม" required
                                                    value="<%= fd.coach || '' %>">
                                            </div>
                                            <div class="fg span-2">
                                                <label class="fl" for="f-coach-email">อีเมลผู้ควบคุมทีม <span
                                                        class="req">*</span></label>
                                                <input class="fi" id="f-coach-email" type="email" name="coach_email"
                                                    placeholder="email@example.com" required
                                                    value="<%= fd.coach_email || '' %>">
                                            </div>
                                        </div>
                                    </section>

                                    <!-- Members -->
                                    <section class="form-section">
                                        <div class="form-section-head">
                                            <span class="form-section-icon"><i class="ti ti-user-plus"></i></span>
                                            <div>
                                                <h2 class="form-section-title">สมาชิกทีม</h2>
                                                <div class="form-section-sub">ทีมละ 2–3 คน อายุ<%= T.age %>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="member-list-form">
                                            <% [1, 2, 3].forEach(function (n) { var required=n < 3; %>
                                                <div class="member-block">
                                                    <div class="member-num">
                                                        <%= n %>
                                                    </div>
                                                    <div class="member-fields">
                                                        <div class="fg">
                                                            <label class="fl" for="f-s<%= n %>">
                                                                ผู้แข่งขันคนที่ <%= n %>
                                                                    <% if (required) { %><span class="req">*</span>
                                                                        <% } else { %><span
                                                                                class="opt">(ไม่บังคับ)</span>
                                                                            <% } %>
                                                            </label>
                                                            <input class="fi" id="f-s<%= n %>" name="student_<%= n %>"
                                                                placeholder="ชื่อ-นามสกุล" <%=required ? 'required' : ''
                                                                %> value="<%= fd['student_' + n] || '' %>">
                                                        </div>
                                                        <div class="fg">
                                                            <label class="fl" for="f-s<%= n %>-dob">
                                                                วันเกิด <% if (required) { %><span class="req">*</span>
                                                                    <% } %>
                                                            </label>
                                                            <input class="fi" id="f-s<%= n %>-dob" type="date"
                                                                name="student_<%= n %>_dob" <%=required ? 'required'
                                                                : '' %> value="<%= fd['student_' + n + '_dob' ] || '' %>
                                                                ">
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                    </section>

                                    <!-- Fee -->
                                    <section class="form-section">
                                        <div class="form-section-head">
                                            <span class="form-section-icon"><i class="ti ti-ticket"></i></span>
                                            <div>
                                                <h2 class="form-section-title">ค่าลงทะเบียน</h2>
                                                <div class="form-section-sub">ชำระผ่าน LINE @rcl.robo หลังส่งใบสมัคร
                                                </div>
                                            </div>
                                        </div>

                                        <div class="fee-grid">
                                            <div class="fee-item">
                                                <div class="fee-label">ค่าลงทะเบียน</div>
                                                <div class="fee-value">2,000 <small>บาท</small></div>
                                                <div class="fee-note">ต่อทีม / การแข่งขัน</div>
                                            </div>
                                            <div class="fee-item">
                                                <div class="fee-label">สมาชิกในทีม</div>
                                                <div class="fee-value">2–3 <small>คน</small></div>
                                                <div class="fee-note">ต่อทีม</div>
                                            </div>
                                            <div class="fee-item">
                                                <div class="fee-label">ครูผู้ควบคุมทีม</div>
                                                <div class="fee-value">1 <small>คน</small></div>
                                                <div class="fee-note">ต่อทีม</div>
                                            </div>
                                        </div>
                                    </section>

                                    <div class="form-actions">
                                        <a href="/register" class="btn btn-secondary"><i class="ti ti-arrow-left"></i>
                                            เลือกรุ่นอื่น</a>
                                        <button type="submit" class="btn btn-primary"><i class="ti ti-send"></i>
                                            ส่งใบสมัคร</button>
                                    </div>
                                </div>
                            </form>
                </main>

                <% } else { %>

                    <!-- ================= TIER SELECTION ================= -->
                    <main class="reg-page is-wide">
                        <div class="reg-hero">
                            <h1 class="reg-hero-title">สมัคร<span>แข่งขัน</span></h1>
                            <div class="reg-hero-sub">เลือกรุ่นที่ต้องการสมัครแข่งขัน</div>
                        </div>

                        <div class="tier-cards">
                            <% ['beginner', 'intermediate' , 'advance' ].forEach(function (key) { var t=TIER_INFO[key];
                                %>
                                <a href="/register/<%= key %>" class="tier-card t-<%= key %>">
                                    <div class="tier-icon">
                                        <%= t.emoji %>
                                    </div>
                                    <div class="tier-name">
                                        <%= t.label %>
                                    </div>
                                    <div class="tier-desc">
                                        <%= t.desc %>
                                    </div>
                                    <div class="tier-facts">
                                        <div class="tier-fact"><span>รุ่นอายุ</span><span>
                                                <%= t.age %>
                                            </span></div>
                                        <div class="tier-fact"><span>หุ่นยนต์</span><span>
                                                <%= t.robot %>
                                            </span></div>
                                        <div class="tier-fact"><span>คะแนนรวม</span><span>
                                                <%= t.score %> คะแนน
                                            </span></div>
                                    </div>
                                    <span class="tier-cta"><i class="ti ti-pencil-plus"></i> สมัครรุ่นนี้</span>
                                </a>
                                <% }); %>
                        </div>

                        <div class="info-strip">
                            <i class="ti ti-info-circle"></i>
                            <span>หลังสมัครสำเร็จ กรุณาแคปหน้าจอรหัสทีมและส่งใน LINE <strong>@rcl.robo</strong>
                                เพื่อยืนยันและชำระค่าสมัคร</span>
                        </div>
                    </main>

                    <% } %>

                        <script>
                            /* Mobile / tablet hamburger menu */
                            (function () {
                                var toggle = document.querySelector('.mobile-menu-toggle');
                                var mobileMenu = document.querySelector('.mobile-menu');
                                var competitionToggle = document.querySelector('.mobile-menu-competition-toggle');
                                var subMenu = document.querySelector('.mobile-submenu');
                                if (!toggle || !mobileMenu) return;

                                function closeMobileMenu() {
                                    toggle.classList.remove('is-open');
                                    toggle.setAttribute('aria-expanded', 'false');
                                    toggle.setAttribute('aria-label', 'เปิดเมนู');
                                    mobileMenu.classList.remove('is-open');
                                    mobileMenu.setAttribute('aria-hidden', 'true');
                                }

                                toggle.addEventListener('click', function (e) {
                                    e.stopPropagation();
                                    var isOpen = mobileMenu.classList.toggle('is-open');
                                    toggle.classList.toggle('is-open', isOpen);
                                    toggle.setAttribute('aria-expanded', String(isOpen));
                                    toggle.setAttribute('aria-label', isOpen ? 'ปิดเมนู' : 'เปิดเมนู');
                                    mobileMenu.setAttribute('aria-hidden', String(!isOpen));
                                });

                                if (competitionToggle && subMenu) {
                                    competitionToggle.addEventListener('click', function () {
                                        var isOpen = subMenu.classList.toggle('is-open');
                                        competitionToggle.classList.toggle('is-open', isOpen);
                                        competitionToggle.setAttribute('aria-expanded', String(isOpen));
                                    });
                                }

                                mobileMenu.querySelectorAll('a').forEach(function (link) {
                                    link.addEventListener('click', closeMobileMenu);
                                });

                                document.addEventListener('click', function (e) {
                                    if (!mobileMenu.contains(e.target) && !toggle.contains(e.target)) closeMobileMenu();
                                });

                                document.addEventListener('keydown', function (e) {
                                    if (e.key === 'Escape') closeMobileMenu();
                                });

                                window.addEventListener('resize', function () {
                                    if (window.innerWidth > 1100) closeMobileMenu();
                                });
                            })();

                            /* Desktop dropdown (hover with small delay, click also works) */
                            document.querySelectorAll('.dropdown').forEach(function (dd) {
                                var menu = dd.querySelector('.dropdown-menu');
                                var btn = dd.querySelector('button');
                                var timer;

                                function show() { clearTimeout(timer); menu.style.display = 'block'; }
                                function hideSoon() { timer = setTimeout(function () { menu.style.display = 'none'; }, 200); }

                                dd.addEventListener('mouseenter', show);
                                dd.addEventListener('mouseleave', hideSoon);
                                btn.addEventListener('click', function () {
                                    menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
                                });
                            });
                        </script>

    </body>

    </html>