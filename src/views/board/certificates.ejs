<% var allTemplates=Array.isArray(templates) ? templates : []; var selectedTier=(typeof tier !=='undefined' && tier) ?
    tier : ((typeof activeTier !=='undefined' && activeTier) ? activeTier : 'beginner' ); var tierLabels={
    beginner: 'Beginner' , intermediate: 'Intermediate' , advance: 'Advance' }; var tierColors={ beginner: '#16A34A' ,
    intermediate: '#2563EB' , advance: '#EA580C' }; var currentTierLabel=tierLabels[selectedTier] || selectedTier; var
    currentTierColor=tierColors[selectedTier] || '#2563EB' ; var certTypes=[ { type: 'participation' ,
    label: '🎖 เกียรติบัตรเข้าร่วม' }, { type: 'coach' , label: '📜 เกียรติบัตรโค้ช' , note: '(ใช้ชื่อโค้ชของทีม)' }, { type: 'rank_1' , label: '🏆 เกียรติบัตรอันดับ 1' }, { type: 'rank_2' ,
    label: '🥈 เกียรติบัตรอันดับ 2' }, { type: 'rank_3' , label: '🥉 เกียรติบัตรอันดับ 3' }, { type: 'gold' ,
    label: '🥇 เกียรติบัตรทอง' , note: '(คะแนน >80%)' , borderColor: '#F59E0B' , headBg: '#FFFBEB' }, { type: 'silver' ,
    label: '🥈 เกียรติบัตรเงิน' , note: '(คะแนน 51-80%)' , borderColor: '#94A3B8' , headBg: '#F8FAFC' }, {
    type: 'bronze' , label: '🥉 เกียรติบัตรทองแดง' , note: '(คะแนน 30-50%)' , borderColor: '#B45309' , headBg: '#FFF7ED'
    } ]; function numOr(value, fallback) { var n=Number(value); return (value !==null && value !==undefined && value
    !=='' && !isNaN(n)) ? n : fallback; } %>

    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@700&display=swap" rel="stylesheet">

    <style>
        /* ========================= PAGE ========================= */

        .cert-toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 18px;
        }

        .current-tier-header {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 9px 14px;
            border-radius: 10px;
            background: color-mix(in srgb, var(--tier-color) 8%, #ffffff);
            border: 1px solid color-mix(in srgb, var(--tier-color) 25%, #E2E8F0);
        }

        .current-tier-icon {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: var(--tier-color);
            color: #fff;
            font-size: 17px;
            flex-shrink: 0;
        }

        .current-tier-info {
            line-height: 1.25;
        }

        .current-tier-label {
            color: #64748B;
            font-size: 10px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .current-tier-name {
            color: #334155;
            font-size: 15px;
            font-weight: 500;
        }

        .current-tier-name strong {
            color: var(--tier-color);
            font-weight: 800;
        }

        .sample-name-box {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 10px;
            background: #fff;
            border: 1px solid #E2E8F0;
            font-size: 12px;
            color: #475569;
            font-weight: 700;
        }

        .sample-name-box input {
            width: 220px;
            height: 30px;
            padding: 4px 8px;
            border: 1px solid #E2E8F0;
            border-radius: 6px;
            font-size: 13px;
        }

        .sample-name-box input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, .1);
        }

        .cert-section {
            margin-bottom: 32px;
        }

        /* ========================= GRID / CARD ========================= */

        .cert-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
        }

        .cert-card {
            position: relative;
            border: 1.5px solid #E2E8F0;
            border-radius: 12px;
            overflow: hidden;
            background: #FFFFFF;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .cert-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
        }

        .cert-card-head {
            min-height: 54px;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            box-sizing: border-box;
            background: #F8FAFC;
            border-bottom: 1px solid #E2E8F0;
            font-size: 13px;
            font-weight: 700;
        }

        .cert-card-title {
            min-width: 0;
            line-height: 1.4;
        }

        .cert-card-title small {
            display: block;
            margin-top: 3px;
            color: #64748B;
            font-size: 11px;
            font-weight: 500;
        }

        .badge-has-bg {
            flex-shrink: 0;
            padding: 3px 8px;
            border-radius: 999px;
            background: #F0FDF4;
            border: 1px solid #BBF7D0;
            color: #16A34A;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        /* ========================= PREVIEW ========================= */

        .cert-preview-area {
            position: relative;
            width: 100%;
            background: #F1F5F9;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            min-height: 240px;
            user-select: none;
        }

        .cert-image-stage {
            position: relative;
            display: block;
            width: 100%;
            line-height: 0;
            overflow: hidden;
        }

        .cert-preview {
            display: block;
            width: 100%;
            height: auto;
            max-width: 100%;
            user-select: none;
            -webkit-user-drag: none;
        }

        .cert-no-bg {
            width: 100%;
            min-height: 240px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #94A3B8;
            font-size: 12px;
            background: #F8FAFC;
            text-align: center;
        }

        .cert-no-bg i {
            font-size: 32px;
            opacity: .8;
        }

        /* ชื่อตัวอย่าง: ขนาดคำนวณจากสัดส่วนไฟล์จริง */
        .name-preview {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            z-index: 20;
            font-family: 'Sarabun', sans-serif;
            font-weight: 700;
            line-height: 1;
            white-space: nowrap;
            pointer-events: none;
            color: #111827;
        }

        /* ========================= MARKER ========================= */

        .name-marker {
            position: absolute;
            left: 50%;
            top: 50%;
            width: 0;
            height: 0;
            z-index: 30;
            cursor: grab;
            touch-action: none;
            user-select: none;
        }

        .name-marker.dragging {
            cursor: grabbing;
        }

        .marker-dot {
            position: absolute;
            left: -7px;
            top: -7px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #EF4444;
            border: 3px solid #FFFFFF;
            box-sizing: border-box;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .35);
        }

        .marker-cross-x,
        .marker-cross-y {
            position: absolute;
            background: #EF4444;
            opacity: .55;
        }

        .marker-cross-x {
            left: -30px;
            top: -1px;
            width: 60px;
            height: 2px;
        }

        .marker-cross-y {
            left: -1px;
            top: -30px;
            width: 2px;
            height: 60px;
        }

        .marker-label {
            position: absolute;
            left: 12px;
            top: 14px;
            padding: 5px 8px;
            border-radius: 7px;
            background: rgba(15, 23, 42, .9);
            color: #FFFFFF;
            font-size: 10px;
            line-height: 1.35;
            white-space: nowrap;
            box-shadow: 0 3px 12px rgba(0, 0, 0, .25);
            pointer-events: none;
            opacity: 0;
            transition: opacity .15s ease;
        }

        .name-marker:hover .marker-label,
        .name-marker.dragging .marker-label {
            opacity: 1;
        }

        /* ========================= FORM ========================= */

        .cert-card-foot {
            padding: 12px 14px;
            border-top: 1px solid #F1F5F9;
            background: #FFFFFF;
        }

        .cert-card-foot>form>label {
            display: block;
            margin-bottom: 5px;
            color: #475569;
            font-size: 11px;
            font-weight: 700;
        }

        .background-input {
            display: block;
            width: 100%;
            margin-bottom: 6px;
            font-size: 11px;
        }

        .selected-file {
            display: none;
            margin-bottom: 8px;
            padding: 5px 8px;
            border-radius: 6px;
            background: #EFF6FF;
            border: 1px solid #BFDBFE;
            color: #2563EB;
            font-size: 10px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .selected-file.show {
            display: block;
        }

        .pos-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 8px;
        }

        .pos-title {
            min-width: 64px;
            color: #475569;
            font-size: 11px;
            font-weight: 700;
        }

        .pos-label {
            color: #64748B;
            font-size: 11px;
        }

        .pos-input {
            width: 58px;
            height: 28px;
            padding: 4px 6px;
            border: 1px solid #E2E8F0;
            border-radius: 6px;
            box-sizing: border-box;
            color: #334155;
            font-size: 12px;
            background: #FFFFFF;
        }

        .pos-input:focus {
            outline: none;
            border-color: #2563EB;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, .1);
        }

        .size-btn {
            width: 28px;
            height: 28px;
            border: 1px solid #E2E8F0;
            border-radius: 6px;
            background: #F8FAFC;
            color: #334155;
            font-size: 15px;
            font-weight: 800;
            cursor: pointer;
            line-height: 1;
        }

        .size-btn:hover {
            background: #EFF6FF;
            border-color: #93C5FD;
        }

        .size-input {
            width: 66px;
        }

        .size-range {
            flex: 1 1 100%;
            width: 100%;
            margin: 2px 0 0;
            accent-color: #2563EB;
        }

        .size-auto-note {
            color: #94A3B8;
            font-size: 10px;
        }

        .color-input {
            width: 34px;
            height: 28px;
            padding: 2px;
            border: 1px solid #E2E8F0;
            border-radius: 6px;
            background: #fff;
            cursor: pointer;
        }

        .color-code {
            color: #64748B;
            font-size: 11px;
            font-family: monospace;
        }

        .position-hint {
            margin-bottom: 8px;
            padding: 6px 8px;
            border-radius: 6px;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            color: #64748B;
            font-size: 10px;
            line-height: 1.4;
            text-align: center;
        }

        .cert-save-btn {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        @media (max-width: 640px) {
            .cert-grid {
                grid-template-columns: 1fr;
            }

            .cert-card-head {
                padding: 10px 12px;
            }

            .cert-card-foot {
                padding: 12px;
            }

            .current-tier-header,
            .sample-name-box {
                width: 100%;
                box-sizing: border-box;
            }

            .sample-name-box input {
                flex: 1;
                width: auto;
            }
        }
    </style>


    <!-- ========================= TOOLBAR =========================
     หัวข้อหน้า + ปุ่มเลือก tier อยู่ใน topbar ของ layout แล้ว
     จึงไม่แสดงซ้ำในหน้านี้
============================================================== -->

    <div class="cert-toolbar">

        <div class="current-tier-header" style="--tier-color:<%= currentTierColor %>;">
            <div class="current-tier-icon"><i class="ti ti-trophy"></i></div>
            <div class="current-tier-info">
                <div class="current-tier-label">กำลังจัดการเกียรติบัตร</div>
                <div class="current-tier-name">ระดับ <strong>
                        <%= currentTierLabel %>
                    </strong></div>
            </div>
        </div>

        <label class="sample-name-box">
            <i class="ti ti-eye"></i> ชื่อตัวอย่างพรีวิว
            <input type="text" id="sampleName" value="ด.ญ. ตัวอย่าง นามสมมติ" maxlength="80">
        </label>

    </div>


    <!-- ========================= GRID ========================= -->

    <div class="cert-section">
        <div class="cert-grid">

            <% certTypes.forEach(function (ct) { var tpl=allTemplates.find(function (t) { return t.cert_type===ct.type
                && t.tier===selectedTier; }); var initialX=numOr(tpl && tpl.name_x, 50); var initialY=numOr(tpl &&
                tpl.name_y, 50); var initialSize=numOr(tpl && tpl.name_font_size, '' ); var initialColor=(tpl &&
                /^#[0-9a-fA-F]{6}$/.test(tpl.name_color || '' )) ? tpl.name_color : '#111827' ; var
                cardStyle=ct.borderColor ? 'border-color:' + ct.borderColor : '' ; var headStyle=ct.headBg
                ? 'background:' + ct.headBg : '' ; var markerStyle='left:' + initialX + '%;top:' + initialY + '%;' ; %>

                <div class="cert-card" style="<%= cardStyle %>">

                    <!-- HEADER -->
                    <div class="cert-card-head" style="<%= headStyle %>">
                        <div class="cert-card-title">
                            <%= ct.label %>
                                <% if (ct.note) { %><small>
                                        <%= ct.note %>
                                    </small>
                                    <% } %>
                        </div>

                        <% if (tpl && tpl.background_url) { %>
                            <span class="badge-has-bg">✓ มี Background</span>
                            <% } %>
                    </div>

                    <!-- PREVIEW -->
                    <div class="cert-preview-area">
                        <% if (tpl && tpl.background_url) { %>
                            <div class="cert-image-stage">
                                <img src="<%= tpl.background_url %>" alt="<%= ct.label %>" class="cert-preview">
                                <div class="name-preview" style="<%= markerStyle %>"></div>
                                <div class="name-marker" style="<%= markerStyle %>">
                                    <div class="marker-cross-x"></div>
                                    <div class="marker-cross-y"></div>
                                    <div class="marker-dot"></div>
                                    <div class="marker-label">
                                        X: <b class="marker-x">
                                            <%= initialX %>
                                        </b>% &nbsp;
                                        Y: <b class="marker-y">
                                            <%= initialY %>
                                        </b>%
                                    </div>
                                </div>
                            </div>
                            <% } else { %>
                                <div class="cert-no-bg">
                                    <i class="ti ti-photo-off"></i>
                                    <div>ยังไม่มี Background</div>
                                </div>
                                <% } %>
                    </div>

                    <!-- FORM -->
                    <div class="cert-card-foot">
                        <form method="POST" action="/board/certificates/upload" enctype="multipart/form-data">

                            <input type="hidden" name="tier" value="<%= selectedTier %>">
                            <input type="hidden" name="cert_type" value="<%= ct.type %>">

                            <label>BACKGROUND (.JPG / .PNG, A4)</label>
                            <input type="file" name="background" class="background-input"
                                accept=".jpg,.jpeg,.png,image/jpeg,image/png">
                            <div class="selected-file"></div>

                            <!-- ตำแหน่ง -->
                            <div class="pos-row">
                                <span class="pos-title">ตำแหน่งชื่อ</span>
                                <span class="pos-label">X%:</span>
                                <input type="number" name="name_x" class="pos-input name-x-input"
                                    value="<%= initialX %>" min="0" max="100" step="0.5">
                                <span class="pos-label">Y%:</span>
                                <input type="number" name="name_y" class="pos-input name-y-input"
                                    value="<%= initialY %>" min="0" max="100" step="0.5">
                            </div>

                            <!-- ขนาดตัวอักษร (px บนไฟล์จริง, เว้นว่าง = อัตโนมัติ) -->
                            <div class="pos-row">
                                <span class="pos-title">ขนาดชื่อ</span>
                                <button type="button" class="size-btn size-minus" title="เล็กลง">−</button>
                                <input type="number" name="name_font_size" class="pos-input size-input name-size-input"
                                    value="<%= initialSize %>" min="20" max="400" step="2" placeholder="อัตโนมัติ">
                                <button type="button" class="size-btn size-plus" title="ใหญ่ขึ้น">+</button>
                                <span class="pos-label">px</span>
                                <span class="size-auto-note"></span>
                                <input type="range" class="size-range" min="20" max="400" step="2">
                            </div>

                            <!-- สี -->
                            <div class="pos-row">
                                <span class="pos-title">สีชื่อ</span>
                                <input type="color" name="name_color" class="color-input name-color-input"
                                    value="<%= initialColor %>">
                                <span class="color-code">
                                    <%= initialColor %>
                                </span>
                            </div>

                            <div class="position-hint">
                                🖱️ คลิกบนภาพเพื่อวางตำแหน่งชื่อ หรือลากจุด 🔴<br>
                                ชื่อตัวอย่างบนภาพแสดงขนาดเทียบกับไฟล์จริง
                            </div>

                            <button type="submit" class="btn btn-primary btn-sm cert-save-btn">
                                <i class="ti ti-upload"></i> บันทึก
                            </button>

                        </form>
                    </div>

                </div>

                <% }); %>

        </div>
    </div>


    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ต้องตรงกับ certificate.js
            var A4_LONG = 3508;
            var AUTO_SIZE_RATIO = 0.045;
            var MIN_SIZE = 20;
            var MAX_SIZE = 400;

            var sampleInput = document.getElementById('sampleName');
            var cardUpdaters = [];

            function clamp(value, min, max, fallback) {
                var n = Number(value);
                if (isNaN(n)) return fallback;
                return Math.max(min, Math.min(max, n));
            }

            // ความกว้างของไฟล์ผลลัพธ์ (เหมือน getCanvasSize ใน certificate.js)
            function getCanvasWidth(img) {
                if (!img || !img.naturalWidth || !img.naturalHeight) return null;
                if (img.naturalHeight > img.naturalWidth) {
                    return Math.round((img.naturalWidth / img.naturalHeight) * A4_LONG);
                }
                return A4_LONG;
            }

            document.querySelectorAll('.cert-card').forEach(function (card) {

                var previewArea = card.querySelector('.cert-preview-area');
                var fileInput = card.querySelector('.background-input');
                var selectedFile = card.querySelector('.selected-file');
                var inputX = card.querySelector('.name-x-input');
                var inputY = card.querySelector('.name-y-input');
                var inputSize = card.querySelector('.name-size-input');
                var rangeSize = card.querySelector('.size-range');
                var btnMinus = card.querySelector('.size-minus');
                var btnPlus = card.querySelector('.size-plus');
                var autoNote = card.querySelector('.size-auto-note');
                var inputColor = card.querySelector('.name-color-input');
                var colorCode = card.querySelector('.color-code');

                if (!previewArea || !inputX || !inputY || !inputSize) return;

                var x = clamp(inputX.value, 0, 100, 50);
                var y = clamp(inputY.value, 0, 100, 50);

                function getStage() { return card.querySelector('.cert-image-stage'); }
                function getImage() { return card.querySelector('.cert-preview'); }

                // ขนาดที่ใช้จริง: ค่าที่กรอก หรือค่าอัตโนมัติ
                function getEffectiveSize() {
                    if (inputSize.value !== '') {
                        return clamp(inputSize.value, MIN_SIZE, MAX_SIZE, MIN_SIZE);
                    }
                    var canvasWidth = getCanvasWidth(getImage());
                    return canvasWidth ? Math.round(canvasWidth * AUTO_SIZE_RATIO) : 112;
                }

                function render() {
                    x = clamp(x, 0, 100, 50);
                    y = clamp(y, 0, 100, 50);

                    var stage = getStage();
                    var img = getImage();
                    var size = getEffectiveSize();

                    rangeSize.value = size;
                    autoNote.textContent = inputSize.value === '' ? '(อัตโนมัติ ' + size + ')' : '';
                    colorCode.textContent = inputColor.value;

                    if (!stage) return;

                    var marker = stage.querySelector('.name-marker');
                    var preview = stage.querySelector('.name-preview');

                    if (marker) {
                        marker.style.left = x + '%';
                        marker.style.top = y + '%';
                        marker.querySelector('.marker-x').textContent = Math.round(x * 10) / 10;
                        marker.querySelector('.marker-y').textContent = Math.round(y * 10) / 10;
                    }

                    if (preview) {
                        var canvasWidth = getCanvasWidth(img);
                        var scale = canvasWidth ? stage.clientWidth / canvasWidth : 0;

                        preview.style.left = x + '%';
                        preview.style.top = y + '%';
                        preview.style.fontSize = (size * scale) + 'px';
                        preview.style.color = inputColor.value;
                        preview.textContent = (sampleInput && sampleInput.value.trim()) || 'ชื่อผู้เข้าแข่งขัน';
                        preview.style.visibility = scale ? 'visible' : 'hidden';
                    }
                }

                function syncInputs() {
                    inputX.value = Math.round(x * 10) / 10;
                    inputY.value = Math.round(y * 10) / 10;
                }

                function setFromPointer(event, stage) {
                    var rect = stage.getBoundingClientRect();
                    if (rect.width <= 0 || rect.height <= 0) return;
                    x = ((event.clientX - rect.left) / rect.width) * 100;
                    y = ((event.clientY - rect.top) / rect.height) * 100;
                    render();
                    syncInputs();
                }

                function ensureOverlay(stage) {
                    if (!stage.querySelector('.name-preview')) {
                        var preview = document.createElement('div');
                        preview.className = 'name-preview';
                        stage.appendChild(preview);
                    }

                    var marker = stage.querySelector('.name-marker');

                    if (!marker) {
                        marker = document.createElement('div');
                        marker.className = 'name-marker';
                        marker.innerHTML =
                            '<div class="marker-cross-x"></div>' +
                            '<div class="marker-cross-y"></div>' +
                            '<div class="marker-dot"></div>' +
                            '<div class="marker-label">X: <b class="marker-x"></b>% &nbsp; Y: <b class="marker-y"></b>%</div>';
                        stage.appendChild(marker);
                    }

                    if (marker.dataset.ready !== '1') {
                        marker.dataset.ready = '1';
                        var dragging = false;

                        marker.addEventListener('pointerdown', function (event) {
                            dragging = true;
                            marker.classList.add('dragging');
                            marker.setPointerCapture(event.pointerId);
                            event.preventDefault();
                            event.stopPropagation();
                        });

                        marker.addEventListener('pointermove', function (event) {
                            if (dragging) setFromPointer(event, stage);
                        });

                        function stopDrag(event) {
                            dragging = false;
                            marker.classList.remove('dragging');
                            try { marker.releasePointerCapture(event.pointerId); } catch (e) { }
                        }

                        marker.addEventListener('pointerup', stopDrag);
                        marker.addEventListener('pointercancel', stopDrag);
                    }

                    if (stage.dataset.clickReady !== '1') {
                        stage.dataset.clickReady = '1';
                        stage.addEventListener('click', function (event) {
                            if (event.target.closest('.name-marker')) return;
                            setFromPointer(event, stage);
                        });
                    }

                    var img = stage.querySelector('.cert-preview');
                    if (img && !img.complete) {
                        img.addEventListener('load', render, { once: true });
                    }
                }

                // ---------- เริ่มต้น ----------
                var initialStage = getStage();
                if (initialStage) ensureOverlay(initialStage);
                render();

                // ---------- ตำแหน่ง ----------
                inputX.addEventListener('input', function () { x = clamp(this.value, 0, 100, 50); render(); });
                inputY.addEventListener('input', function () { y = clamp(this.value, 0, 100, 50); render(); });

                // ---------- ขนาด ----------
                function setSize(value) {
                    inputSize.value = clamp(Math.round(value), MIN_SIZE, MAX_SIZE, MIN_SIZE);
                    render();
                }

                inputSize.addEventListener('input', render);
                inputSize.addEventListener('change', function () {
                    if (this.value !== '') setSize(this.value);
                });
                rangeSize.addEventListener('input', function () { setSize(this.value); });
                btnMinus.addEventListener('click', function () { setSize(getEffectiveSize() - 4); });
                btnPlus.addEventListener('click', function () { setSize(getEffectiveSize() + 4); });

                // ---------- สี ----------
                inputColor.addEventListener('input', render);

                // ---------- อัปโหลดภาพใหม่ ----------
                fileInput.addEventListener('change', function () {
                    var file = this.files && this.files[0];

                    if (!file) {
                        selectedFile.textContent = '';
                        selectedFile.classList.remove('show');
                        return;
                    }

                    if (['image/jpeg', 'image/png'].indexOf(file.type) === -1) {
                        alert('กรุณาเลือกไฟล์ JPG หรือ PNG เท่านั้น');
                        this.value = '';
                        return;
                    }

                    selectedFile.textContent = 'ไฟล์ที่เลือก: ' + file.name;
                    selectedFile.classList.add('show');

                    var stage = getStage();

                    if (!stage) {
                        previewArea.innerHTML = '';
                        stage = document.createElement('div');
                        stage.className = 'cert-image-stage';
                        previewArea.appendChild(stage);
                    }

                    var img = getImage();

                    if (!img) {
                        img = document.createElement('img');
                        img.className = 'cert-preview';
                        img.alt = 'Certificate Background';
                        stage.prepend(img);
                    }

                    var objectUrl = URL.createObjectURL(file);

                    img.onload = function () {
                        URL.revokeObjectURL(objectUrl);
                        render();
                    };

                    img.src = objectUrl;
                    ensureOverlay(stage);
                    render();
                });

                cardUpdaters.push(render);
            });

            // ชื่อตัวอย่างเปลี่ยน / หน้าจอเปลี่ยนขนาด / ฟอนต์โหลดเสร็จ → วาดใหม่ทุกใบ
            function renderAll() { cardUpdaters.forEach(function (fn) { fn(); }); }

            if (sampleInput) sampleInput.addEventListener('input', renderAll);
            window.addEventListener('resize', renderAll);
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(renderAll);
        });
    </script>