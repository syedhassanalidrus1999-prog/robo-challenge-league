<div class="page-hd">
    <div class="page-title"><span>เกณฑ์</span>คะแนนแต่ละรุ่น</div>
</div>

<% ['beginner','intermediate','advance'].forEach(function(t) { %>
    <div class="card" style="margin-bottom:16px">
        <div class="card-hd">
            <div class="card-title"
                style="color:<%= t==='beginner'?'#16A34A':t==='intermediate'?'#2563EB':'#EA580C' %>">
                <%= t==='beginner' ?'Beginner':t==='intermediate' ?'Intermediate':'Advance' %>
                    <span style="font-size:12px;color:#64748B;font-weight:400;margin-left:8px">
                        รวม <%= criteria.filter(function(c){return c.tier===t}).reduce(function(s,c){return
                            s+parseFloat(c.max_score)},0) %> คะแนน
                    </span>
            </div>
            <button class="btn btn-primary btn-sm" onclick="openAddModal('<%= t %>')">
                <i class="ti ti-plus"></i> เพิ่มภารกิจ
            </button>
        </div>
        <div style="overflow-x:auto">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>ชื่อภารกิจ</th>
                        <th>คะแนน/ชิ้น (เต็ม)</th>
                        <th>คะแนน/ชิ้น (บางส่วน)</th>
                        <th>จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    <% criteria.filter(function(c){return c.tier===t}).forEach(function(c) { %>
                        <tr>
                            <td style="color:#94A3B8;font-family:'Inter',monospace">
                                <%= c.mission %>
                            </td>
                            <td><span class="team-name">
                                    <%= c.name %>
                                </span></td>
                            <td>
                                <span
                                    style="font-size:16px;font-weight:700;color:<%= t==='beginner'?'#16A34A':t==='intermediate'?'#2563EB':'#EA580C' %>">
                                    <%= c.max_score %>
                                </span> คะแนน
                            </td>
                            <td>
                                <% if (c.score_type==='both' ) { %>
                                    <span style="font-size:14px;font-weight:700;color:#D97706">
                                        <%= c.score_partial %>
                                    </span> คะแนน
                                    <% } else { %>
                                        <span style="color:#CBD5E1">—</span>
                                        <% } %>
                            </td>
                            <td>
                                <div class="action-row">
                                    <button class="btn btn-secondary btn-sm" data-id="<%= c.id %>" data-name="<%= c.name %>" data-max="<%= c.max_score %>"
                                        data-tier="<%= c.tier %>" data-type="<%= c.score_type || 'full_only' %>" data-partial="<%= c.score_partial || 0 %>"
                                        onclick="openEditModalFromBtn(this)">
                                        <i class="ti ti-edit"></i> แก้ไข
                                    </button>
                                    <form method="POST"
                                        action="/board/criteria/<%= c.id %>?_method=DELETE&tier=<%= c.tier %>"
                                        onsubmit="return confirm('ลบภารกิจ <%= c.name %>?')">
                                        <button type="submit" class="btn btn-danger btn-sm"><i
                                                class="ti ti-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                            <% if (criteria.filter(function(c){return c.tier===t}).length===0) { %>
                                <tr>
                                    <td colspan="5">
                                        <div class="empty"><i class="ti ti-list-x"></i>ยังไม่มีภารกิจ</div>
                                    </td>
                                </tr>
                                <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <% }) %>

        <!-- Modal เพิ่มภารกิจ -->
        <div id="addModal" class="modal-backdrop" style="display:none">
            <div class="modal" style="max-width:460px">
                <div class="modal-hd">
                    <div>
                        <div class="modal-title">เพิ่มภารกิจใหม่</div>
                        <div class="modal-sub" id="addModalSub"></div>
                    </div>
                    <button class="modal-close" onclick="closeModal('addModal')"><i class="ti ti-x"></i></button>
                </div>
                <form method="POST" action="/board/criteria">
                    <div class="modal-body">
                        <input type="hidden" name="tier" id="add_tier">
                        <div class="fg" style="margin-bottom:12px">
                            <div class="fl">ชื่อภารกิจ *</div>
                            <input class="fi" name="name" placeholder="เช่น ภารกิจที่ 5" required>
                        </div>
                        <div class="fg" style="margin-bottom:12px">
                            <div class="fl">คะแนนต่อชิ้น (เข้าเต็ม) *</div>
                            <input class="fi" name="max_score" type="number" min="1" max="999" step="0.5"
                                placeholder="เช่น 10" required>
                        </div>
                        <div class="fg" style="margin-bottom:12px">
                            <div class="fl">ประเภทการให้คะแนน</div>
                            <div style="display:flex;gap:10px;margin-top:4px">
                                <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                                    <input type="radio" name="score_type" value="full_only" checked
                                        onchange="togglePartial('add',this.value)">
                                    เข้าเต็มอย่างเดียว
                                </label>
                                <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                                    <input type="radio" name="score_type" value="both"
                                        onchange="togglePartial('add',this.value)">
                                    มีเข้าบางส่วนด้วย
                                </label>
                            </div>
                        </div>
                        <div class="fg" id="add_partial_row" style="display:none">
                            <div class="fl">คะแนนต่อชิ้น (เข้าบางส่วน)</div>
                            <input class="fi" name="score_partial" id="add_score_partial" type="number" min="0"
                                max="999" step="0.5" placeholder="เช่น 5">
                        </div>
                    </div>
                    <div class="modal-foot">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">ยกเลิก</button>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> เพิ่ม</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal แก้ไขภารกิจ -->
        <div id="editModal" class="modal-backdrop" style="display:none">
            <div class="modal" style="max-width:460px">
                <div class="modal-hd">
                    <div>
                        <div class="modal-title">แก้ไขภารกิจ</div>
                    </div>
                    <button class="modal-close" onclick="closeModal('editModal')"><i class="ti ti-x"></i></button>
                </div>
                <form id="editForm" method="POST">
                    <input type="hidden" name="_method" value="PUT">
                    <input type="hidden" name="tier" id="edit_tier">
                    <div class="modal-body">
                        <div class="fg" style="margin-bottom:12px">
                            <div class="fl">ชื่อภารกิจ *</div>
                            <input class="fi" name="name" id="edit_name" required>
                        </div>
                        <div class="fg" style="margin-bottom:12px">
                            <div class="fl">คะแนนต่อชิ้น (เข้าเต็ม) *</div>
                            <input class="fi" name="max_score" id="edit_max" type="number" min="1" max="999" step="0.5"
                                required>
                        </div>
                        <div class="fg" style="margin-bottom:12px">
                            <div class="fl">ประเภทการให้คะแนน</div>
                            <div style="display:flex;gap:10px;margin-top:4px">
                                <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                                    <input type="radio" name="score_type" id="edit_type_full" value="full_only"
                                        onchange="togglePartial('edit',this.value)">
                                    เข้าเต็มอย่างเดียว
                                </label>
                                <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                                    <input type="radio" name="score_type" id="edit_type_both" value="both"
                                        onchange="togglePartial('edit',this.value)">
                                    มีเข้าบางส่วนด้วย
                                </label>
                            </div>
                        </div>
                        <div class="fg" id="edit_partial_row" style="display:none">
                            <div class="fl">คะแนนต่อชิ้น (เข้าบางส่วน)</div>
                            <input class="fi" name="score_partial" id="edit_score_partial" type="number" min="0"
                                max="999" step="0.5">
                        </div>
                    </div>
                    <div class="modal-foot">
                        <button type="button" class="btn btn-secondary"
                            onclick="closeModal('editModal')">ยกเลิก</button>
                        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i>
                            บันทึก</button>
                    </div>
                </form>
            </div>
        </div>

        <script>
            function togglePartial(prefix, val) {
                var row = document.getElementById(prefix + '_partial_row')
                row.style.display = val === 'both' ? 'block' : 'none'
            }

            function openAddModal(tier) {
                document.getElementById('add_tier').value = tier
                var label = tier === 'beginner' ? 'Beginner' : tier === 'intermediate' ? 'Intermediate' : 'Advance'
                document.getElementById('addModalSub').textContent = 'รุ่น ' + label
                document.getElementById('add_partial_row').style.display = 'none'
                openModal('addModal')
            }

            function openEditModalFromBtn(btn) {
                    openCriteriaEditModal(
                        btn.dataset.id,
                        btn.dataset.name,
                        btn.dataset.max,
                        btn.dataset.tier,
                        btn.dataset.type,
                        btn.dataset.partial
                    )
                }

                function openCriteriaEditModal(id, name, maxScore, tier, scoreType, scorePartial) {
                    document.getElementById('editForm').action = '/board/criteria/' + id + '?_method=PUT'
                    document.getElementById('edit_name').value = name
                    document.getElementById('edit_max').value = maxScore
                    document.getElementById('edit_tier').value = tier
                    document.getElementById('edit_score_partial').value = scorePartial || 0
                    if (scoreType === 'both') {
                        document.getElementById('edit_type_both').checked = true
                        document.getElementById('edit_partial_row').style.display = 'block'
                    } else {
                        document.getElementById('edit_type_full').checked = true
                        document.getElementById('edit_partial_row').style.display = 'none'
                    }
                    openModal('editModal')
                }

            function openEditModal(id, name, maxScore, tier, scoreType, scorePartial) {
                document.getElementById('editForm').action = '/board/criteria/' + id + '?_method=PUT'
                document.getElementById('edit_name').value = name
                document.getElementById('edit_max').value = maxScore
                document.getElementById('edit_tier').value = tier
                document.getElementById('edit_score_partial').value = scorePartial || 0
                if (scoreType === 'both') {
                    document.getElementById('edit_type_both').checked = true
                    document.getElementById('edit_partial_row').style.display = 'block'
                } else {
                    document.getElementById('edit_type_full').checked = true
                    document.getElementById('edit_partial_row').style.display = 'none'
                }
                openModal('editModal')
            }
        </script>