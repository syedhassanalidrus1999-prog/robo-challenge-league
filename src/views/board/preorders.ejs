<div class="page-hd">
    <div class="page-title"><span>Pre-order</span> สนามแข่งขัน</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
        <a href="/board/preorders" class="btn btn-secondary btn-sm">ทั้งหมด</a>
        <a href="/board/preorders?status=pending" class="btn btn-secondary btn-sm" style="color:#D97706">รอยืนยัน</a>
        <a href="/board/preorders?status=confirmed" class="btn btn-secondary btn-sm"
            style="color:#2563EB">ยืนยันแล้ว</a>
        <a href="/board/preorders?status=shipped" class="btn btn-secondary btn-sm" style="color:#16A34A">จัดส่งแล้ว</a>
    </div>
</div>

<div class="card">
    <div style="overflow-x:auto">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>โรงเรียน</th>
                    <th>ผู้ติดต่อ</th>
                    <th>ที่อยู่</th>
                    <th>สินค้าที่สั่ง</th>
                    <th>ยอดรวม</th>
                    <th>สถานะ</th>
                    <th>วันที่</th>
                    <th>ใบเสร็จ</th>
                    <th>จัดการ</th>
                </tr>
            </thead>
            <tbody>
                <% if (preorders.length===0) { %>
                    <tr>
                        <td colspan="8">
                            <div class="empty"><i class="ti ti-inbox"></i>ยังไม่มี Pre-order</div>
                        </td>
                    </tr>
                    <% } %>
                        <% preorders.forEach(function(p) { var parsedItems={}; try { parsedItems=p.items_json ?
                            JSON.parse(p.items_json) : {}; } catch(e) { parsedItems={}; } var
                            itemKeys=Object.keys(parsedItems); function getItemName(k) { var names={ 'beginner-full'
                            : 'เซตสนาม Beginner' ,'beginner-mat' : 'แผ่นสนาม Beginner' , 'beginner-field' : 'ไฟล์สนาม Beginner' , 'beginner-mission'
                            : 'ชิ้นส่วนภารกิจ Beginner' , 'intermediate-full' : 'เซตสนาม Intermediate'
                            , 'intermediate-mat' : 'แผ่นสนาม Intermediate' , 'intermediate-field' : 'ไฟล์สนาม Intermediate' , 'intermediate-mission'
                            : 'ชิ้นส่วนภารกิจ Intermediate' , 'advance-full' : 'เซตสนาม Advance' ,'advance-mat' : 'แผ่นสนาม Advance' , 'advance-field'
                            : 'ไฟล์สนาม Advance' , 'advance-mission' : 'ชิ้นส่วนภารกิจ Advance' }; return names[k] || k;
                            } function getItemColor(k) { var colors={ 'beginner-full' : '#16A34A' , 'beginner-mat' : '#FBBF24' , 'beginner-field'
                            : '#7C3AED' , 'beginner-mission' : '#EA580C' , 'intermediate-full' : '#2563EB'
                            , 'intermediate-mat' : '#FBBF24' , 'intermediate-field' : '#7C3AED' , 'intermediate-mission' : '#EA580C' , 'advance-full'
                            : '#EA580C' , 'advance-mat' : '#FBBF24' , 'advance-field' : '#7C3AED' , 'advance-mission' : '#EA580C' }; return
                            colors[k] || '#475569' ; } %>
                            <tr>
                                <td style="color:#94A3B8;font-size:12px">#<%= p.id %>
                                </td>
                                <td>
                                    <div style="font-weight:700">
                                        <%= p.school_name %>
                                    </div>
                                    <% if (p.province) { %>
                                        <div style="font-size:11px;color:#94A3B8">
                                            <%= p.province %>
                                        </div>
                                        <% } %>
                                </td>
                                
                                <td>
                                    <div style="font-size:13px">
                                        <%= p.contact_name %>
                                    </div>
                                    <div style="font-size:11px;color:#94A3B8">
                                        <%= p.phone %>
                                    </div>
                                    <% if (p.email) { %>
                                        <div style="font-size:11px;color:#94A3B8">
                                            <%= p.email %>
                                        </div>
                                        <% } %>
                                </td>
                                <td style="font-size:12px;min-width:180px">
                                    <% if (p.address) { %>
                                        <div>
                                            <%= p.address %>
                                        </div>
                                        <% } %>
                                            <% if (p.district || p.province) { %>
                                                <div style="color:#64748B">
                                                    <%= [p.district, p.province, p.zipcode].filter(Boolean).join(' ') %>
                                        </div>
                                    <% } %>
                                    <% if (!p.address && !p.province) { %>
                                        <span style="color:#CBD5E1">—</span>
                                    <% } %>
                                </td>
                                <td style="min-width:200px">
                                    <% if (itemKeys.length> 0) { %>
                                        <% itemKeys.forEach(function(k) { %>
                                            <div style="display:flex;align-items:center;gap:4px;margin-bottom:4px">
                                                <span
                                                    style="font-size:12px;font-weight:700;color:<%= getItemColor(k) %>">
                                                    <%= getItemName(k) %>
                                                </span>
                                                <span style="font-size:11px;color:#94A3B8">x <%= parsedItems[k] %>
                                                        </span>
                                            </div>
                                            <% }); %>
                                                <% } else { %>
                                                    <span style="color:#CBD5E1">-</span>
                                                    <% } %>
                                    <div style="margin-top:6px;padding-top:6px;border-top:1px solid #F1F5F9">
                                        <% if (p.shipping_method==='delivery' ) { %>
                                            <span
                                                style="font-size:11px;background:#FFF7ED;color:#EA580C;border:1px solid #FED7AA;border-radius:999px;padding:2px 8px;font-weight:700">
                                                <i class="ti ti-truck"></i> จัดส่ง
                                            </span>
                                            <% } else { %>
                                                <span
                                                    style="font-size:11px;background:#F0FDF4;color:#16A34A;border:1px solid #BBF7D0;border-radius:999px;padding:2px 8px;font-weight:700">
                                                    <i class="ti ti-walking"></i> รับเอง
                                                </span>
                                                <% } %>
                                    </div>
                                </td>
                                <td style="font-weight:700;color:#2563EB">
                                    <%= (p.total_price || 0).toLocaleString() %> B
                                </td>
                                
                                <td>
                                    <% if (p.status==='pending' ) { %>
                                        <span class="badge badge-blue badge-dot">รอยืนยัน</span>
                                        <% } else if (p.status==='confirmed' ) { %>
                                            <span class="badge badge-green badge-dot">ยืนยันแล้ว</span>
                                            <% } else if (p.status==='shipped' ) { %>
                                                <span class="badge"
                                                    style="background:#F0FDF4;color:#16A34A">จัดส่งแล้ว</span>
                                                <% } else { %>
                                                    <span class="badge badge-red badge-dot">ยกเลิก</span>
                                                    <% } %>
                                </td>
                                <td style="font-size:12px;color:#64748B">
                                    <%= new Date(p.created_at).toLocaleDateString('th-TH',
                                        {day:'numeric',month:'short',year:'numeric'}) %>
                                </td>
                            <td>
                                <% if (p.receipt==='yes' ) { %>
                                    <button type="button" onclick="openReceiptModal(this)" data-name="<%= p.receipt_name || '' %>"
                                        data-address="<%= p.receipt_address || '' %>" data-zipcode="<%= p.receipt_zipcode || '' %>"
                                        data-tax="<%= p.receipt_tax_id || '' %>" class="btn btn-sm"
                                        style="background:#EFF6FF;color:#2563EB;border:1px solid #BFDBFE">
                                        <i class="ti ti-receipt"></i> ดูใบเสร็จ
                                    </button>
                                    <% } else { %>
                                        <span style="color:#94A3B8;font-size:12px">ไม่รับ</span>
                                        <% } %>
                            </td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:6px">
                                        <form method="POST" action="/board/preorders/<%= p.id %>/status">
                                            <select name="status" class="fi" style="font-size:12px;padding:4px 8px;width:auto"
                                                onchange="this.form.submit()">
                                                <option value="pending" <%=p.status==='pending' ?'selected':'' %>>รอยืนยัน</option>
                                                <option value="confirmed" <%=p.status==='confirmed' ?'selected':'' %>>ยืนยันแล้ว</option>
                                                <option value="shipped" <%=p.status==='shipped' ?'selected':'' %>>จัดส่งแล้ว</option>
                                                <option value="cancelled" <%=p.status==='cancelled' ?'selected':'' %>>ยกเลิก</option>
                                            </select>
                                        </form>
                                        <form method="POST" action="/board/preorders/<%= p.id %>?_method=DELETE"
                                            onsubmit="return confirm('ลบ Pre-order #<%= p.id %> ใช่ไหม?')">
                                            <button type="submit" class="btn btn-sm"
                                                style="background:#FEF2F2;color:#DC2626;border:1px solid #FECDD3;white-space:nowrap">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                                
                            </tr>
                            <% }); %>
            </tbody>
        </table>
    </div>
</div>

<div id="receiptModal"
    style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center">
    <div
        style="background:#fff;border-radius:16px;padding:24px;width:min(420px,90vw);box-shadow:0 20px 50px rgba(0,0,0,.2)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
            <div style="font-size:16px;font-weight:700"><i class="ti ti-receipt"></i> ข้อมูลใบเสร็จ</div>
            <button onclick="document.getElementById('receiptModal').style.display='none'"
                style="border:0;background:none;font-size:20px;cursor:pointer;color:#64748B">✕</button>
        </div>
        <div style="font-size:11px;font-weight:800;color:#475569">ชื่อในใบเสร็จ</div>
        <div id="r_name" style="font-size:14px;font-weight:600;padding:6px 0 12px"></div>
        <div style="font-size:11px;font-weight:800;color:#475569">ที่อยู่</div>
        <div id="r_address" style="font-size:14px;padding:6px 0 12px;line-height:1.6"></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div>
                <div style="font-size:11px;font-weight:800;color:#475569">รหัสไปรษณีย์</div>
                <div id="r_zipcode" style="font-size:14px;padding:6px 0"></div>
            </div>
            <div>
                <div style="font-size:11px;font-weight:800;color:#475569">เลขผู้เสียภาษี</div>
                <div id="r_tax_id" style="font-size:14px;padding:6px 0"></div>
            </div>
        </div>
    </div>
</div>

<script>
   function openReceiptModal(btn) {
        document.getElementById('r_name').textContent = btn.getAttribute('data-name') || '—';
        document.getElementById('r_address').textContent = btn.getAttribute('data-address') || '—';
        document.getElementById('r_zipcode').textContent = btn.getAttribute('data-zipcode') || '—';
        document.getElementById('r_tax_id').textContent = btn.getAttribute('data-tax') || '—';
        var modal = document.getElementById('receiptModal');
        modal.style.display = 'flex';
    }

    // ปิดเมื่อคลิก background
    document.getElementById('receiptModal').addEventListener('click', function (e) {
        if (e.target === this) this.style.display = 'none';
    });
</script>