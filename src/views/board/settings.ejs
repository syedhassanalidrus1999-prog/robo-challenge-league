<div class="page-hd">
    <div class="page-title"><span>ตั้งค่า</span>ระบบ</div>
</div>

<div class="card" style="max-width:500px">
    <div class="card-hd">
        <div class="card-title">วันแข่งขัน</div>
    </div>
    <form method="POST" action="/board/settings">
        <div class="card-body">
            <div class="fg" style="margin-bottom:14px">
                <div class="fl">วันที่เริ่ม</div>
                <input class="fi" type="date" name="event_date" value="<%= settings.event_date || '' %>">
            </div>
            <div class="fg" style="margin-bottom:14px">
                <div class="fl">วันที่สิ้นสุด (ไม่บังคับ)</div>
                <input class="fi" type="date" name="event_date_end" value="<%= settings.event_date_end || '' %>">
                <div style="font-size:11px;color:#94A3B8;margin-top:4px">ถ้าไม่กำหนดวันเริ่ม จะแสดงเป็น "เร็วๆ นี้"
                </div>
            </div>
            <div class="fg" style="margin-bottom:14px">
                <div class="fl">สถานที่ (ไม่บังคับ)</div>
                <input class="fi" type="text" name="event_date_label" value="<%= settings.event_date_label || '' %>"
                    placeholder="เช่น ณ โรงเรียน ROBO Champion Academy">
            </div>
        </div>
        <div class="modal-foot" style="padding:14px 16px">
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i> บันทึก
            </button>
        </div>
    </form>
</div>

<div class="card" style="max-width:500px;margin-top:16px">
    <div class="card-hd">
        <div class="card-title">โปรโมชั่น Pre-order</div>
    </div>
    <form method="POST" action="/board/settings">
        <div class="card-body">
            <div class="fg" style="margin-bottom:14px">
                <div class="fl">เปิดโปรโมชั่น</div>
                <div style="display:flex;align-items:center;gap:10px;margin-top:4px">
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                        <input type="radio" name="promo_active" value="1" <%=settings.promo_active==='1' ? 'checked'
                            : '' %>>
                        เปิด
                    </label>
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                        <input type="radio" name="promo_active" value="0" <%=settings.promo_active !=='1' ? 'checked'
                            : '' %>>
                        ปิด
                    </label>
                </div>
            </div>
            <div class="fg" style="margin-bottom:14px">
                <div class="fl">วันหมดอายุโปรโมชั่น</div>
                <input class="fi" type="date" name="promo_end_date" value="<%= settings.promo_end_date || '' %>">
                <div style="font-size:11px;color:#94A3B8;margin-top:4px">ถึงวันนี้แล้วโปรโมชั่นจะหยุดแสดงอัตโนมัติ</div>
            </div>
        </div>
        <div class="modal-foot" style="padding:14px 16px">
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i> บันทึก
            </button>
        </div>
    </form>
</div>

<style>
    .price-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        font-weight: 800;
        color: #334155;
        margin-bottom: 8px;
        padding-bottom: 6px;
        border-bottom: 1px solid #F1F5F9;
    }

    .price-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1.1fr;
        gap: 12px;
        margin-bottom: 14px;
    }

    .soldout-tag {
        font-size: 11px;
        font-weight: 700;
        color: #DC2626;
        background: #FEF2F2;
        border: 1px solid #FECACA;
        border-radius: 999px;
        padding: 1px 9px;
    }

    @media (max-width:520px) {
        .price-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="card" style="max-width:500px;margin-top:16px">
    <div class="card-hd">
        <div class="card-title">ราคาสินค้า Pre-order</div>
    </div>
    <form method="POST" action="/board/settings">
        <div class="card-body">
            <div
                style="font-size:11px;color:#64748B;margin-bottom:14px;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:8px;padding:10px">
                ราคาเหล่านี้ใช้กับทุก tier (Beginner / Intermediate / Advance)<br>
                ส่วนลดแยกต่อสินค้า — ใส่ 0 หากไม่ต้องการลดสินค้านั้น (ต้องเปิดโปรโมชั่นด้วย)<br>
                สถานะ "สินค้าหมด" — หน้า Pre-order จะแสดงคำว่า "หมด" แทนราคา และเลือกสินค้านั้นไม่ได้
            </div>

            <!-- เซตสนาม -->
            <div class="price-head">
                <span>เซตสนาม (full)</span>
                <% if (settings.soldout_full==='1' ) { %><span class="soldout-tag">หมด</span>
                    <% } %>
            </div>
            <div class="price-grid">
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">ราคา (บาท)</div>
                    <input class="fi" type="number" name="price_full" min="0"
                        value="<%= settings.price_full || '3450' %>" placeholder="3450">
                </div>
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">ส่วนลด (%)</div>
                    <input class="fi" type="number" name="discount_full" min="0" max="99"
                        value="<%= settings.discount_full || '0' %>" placeholder="0">
                </div>
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">สถานะ</div>
                    <select class="fi" name="soldout_full">
                        <option value="0" <%=settings.soldout_full !=='1' ? 'selected' : '' %>>มีสินค้า</option>
                        <option value="1" <%=settings.soldout_full==='1' ? 'selected' : '' %>>สินค้าหมด</option>
                    </select>
                </div>
            </div>

            <!-- สนามอย่างเดียว -->
            <div class="price-head">
                <span>สนามอย่างเดียว (mat)</span>
                <% if (settings.soldout_mat==='1' ) { %><span class="soldout-tag">หมด</span>
                    <% } %>
            </div>
            <div class="price-grid">
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">ราคา (บาท)</div>
                    <input class="fi" type="number" name="price_mat" min="0" value="<%= settings.price_mat || '2850' %>"
                        placeholder="2850">
                </div>
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">ส่วนลด (%)</div>
                    <input class="fi" type="number" name="discount_mat" min="0" max="99"
                        value="<%= settings.discount_mat || '0' %>" placeholder="0">
                </div>
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">สถานะ</div>
                    <select class="fi" name="soldout_mat">
                        <option value="0" <%=settings.soldout_mat !=='1' ? 'selected' : '' %>>มีสินค้า</option>
                        <option value="1" <%=settings.soldout_mat==='1' ? 'selected' : '' %>>สินค้าหมด</option>
                    </select>
                </div>
            </div>

            <!-- ไฟล์สนาม -->
            <div class="price-head">
                <span>ไฟล์สนาม (field)</span>
                <% if (settings.soldout_field==='1' ) { %><span class="soldout-tag">หมด</span>
                    <% } %>
            </div>
            <div class="price-grid">
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">ราคา (บาท)</div>
                    <input class="fi" type="number" name="price_field" min="0"
                        value="<%= settings.price_field || '625' %>" placeholder="625">
                </div>
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">ส่วนลด (%)</div>
                    <input class="fi" type="number" name="discount_field" min="0" max="99"
                        value="<%= settings.discount_field || '0' %>" placeholder="0">
                </div>
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">สถานะ</div>
                    <select class="fi" name="soldout_field">
                        <option value="0" <%=settings.soldout_field !=='1' ? 'selected' : '' %>>มีสินค้า</option>
                        <option value="1" <%=settings.soldout_field==='1' ? 'selected' : '' %>>สินค้าหมด</option>
                    </select>
                </div>
            </div>

            <!-- ชิ้นส่วนภารกิจ -->
            <div class="price-head">
                <span>ชิ้นส่วนภารกิจ (mission)</span>
                <% if (settings.soldout_mission==='1' ) { %><span class="soldout-tag">หมด</span>
                    <% } %>
            </div>
            <div class="price-grid" style="margin-bottom:0">
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">ราคา (บาท)</div>
                    <input class="fi" type="number" name="price_mission" min="0"
                        value="<%= settings.price_mission || '600' %>" placeholder="600">
                </div>
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">ส่วนลด (%)</div>
                    <input class="fi" type="number" name="discount_mission" min="0" max="99"
                        value="<%= settings.discount_mission || '0' %>" placeholder="0">
                </div>
                <div class="fg" style="margin-bottom:0">
                    <div class="fl">สถานะ</div>
                    <select class="fi" name="soldout_mission">
                        <option value="0" <%=settings.soldout_mission !=='1' ? 'selected' : '' %>>มีสินค้า</option>
                        <option value="1" <%=settings.soldout_mission==='1' ? 'selected' : '' %>>สินค้าหมด</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="modal-foot" style="padding:14px 16px">
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i> บันทึก
            </button>
        </div>
    </form>
</div>

<div class="card" style="max-width:500px;margin-top:16px">
    <div class="card-hd">
        <div class="card-title">วันรับสมัคร</div>
    </div>
    <form method="POST" action="/board/settings">
        <div class="card-body">
            <div class="fg" style="margin-bottom:14px">
                <div class="fl">วันเปิดรับสมัคร</div>
                <input class="fi" type="datetime-local" name="registration_open_date"
                    value="<%= settings.registration_open_date || '' %>">
            </div>
            <div class="fg" style="margin-bottom:14px">
                <div class="fl">วันปิดรับสมัคร</div>
                <input class="fi" type="datetime-local" name="registration_close_date"
                    value="<%= settings.registration_close_date || '' %>">
                <div style="font-size:11px;color:#94A3B8;margin-top:4px">ถึงเวลานี้แล้วปุ่มสมัครจะปิดอัตโนมัติ</div>
            </div>
        </div>
        <div class="modal-foot" style="padding:14px 16px">
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i> บันทึก
            </button>
        </div>
    </form>
</div>